---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found — RepMaths" description="The page you're looking for doesn't exist.">
  <section style="text-align:center; padding:60px 20px;">
    <h1>404 — Page Not Found</h1>
    <p style="color:var(--text-muted); margin-bottom:24px;">
      The calculator or page you're looking for doesn't exist or has moved.
    </p>
    <a href="/" class="btn-primary" style="display:inline-block; width:auto; padding:14px 28px; text-decoration:none;">
      Back to Homepage
    </a>
  </section>
</Base>
