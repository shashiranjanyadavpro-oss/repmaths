---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';

const popularTools = toolsData.slice(0, 6);
---

<Base
  title="404 — Page Not Found | RepMaths"
  description="The page you are looking for does not exist. Browse our free strength, training, and nutrition calculators instead."
  noindex={true}
>
  <section class="hero">
    <h1>404 — Page Not Found</h1>
    <p>
      The page you are looking for does not exist or may have been moved.
    </p>
  </section>

  <section class="calc-card" style="text-align:center;">
    <p style="margin:0 0 8px;">
      Try one of our popular calculators instead:
    </p>

    <div class="tool-grid">
      {popularTools.map((tool) => (
        <a class="tool-card" href={tool.url}>
          <span class="icon" aria-hidden="true">{tool.icon}</span>
          <span class="name">{tool.name}</span>
        </a>
      ))}
    </div>

    <p style="margin:20px 0 0;">
      <a href="/">&larr; Back to all calculators</a>
    </p>
  </section>

  <style>
    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px;
      margin-top: 16px;
    }

    .tool-card {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 12px;
      text-align: center;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.9rem;
      display: block;
      margin-top: 8px;
    }
  </style>
</Base>
