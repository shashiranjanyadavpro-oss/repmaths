---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';

const clusterLabels: Record<string, string> = {
  strength: "1RM & Strength Calculators",
  training: "Training & Programming",
  equipment: "Plate & Equipment",
  nutrition: "Nutrition & Body Composition",
};

const clusterOrder = ["strength", "training", "equipment", "nutrition"];

const groupedTools = clusterOrder
  .map((clusterId) => ({
    id: clusterId,
    label: clusterLabels[clusterId],
    tools: toolsData.filter((t) => t.cluster === clusterId),
  }))
  .filter((group) => group.tools.length > 0);
---

<Base
  title="Free Fitness Calculators — 1RM, TDEE, BMI & More | RepMaths"
  description="25+ free fitness calculators for strength, training, and nutrition — 1RM, TDEE, BMI, macros, body fat, and more. Built on established formulas. No sign-up."
>
  <section class="hero">
    <h1>Free Fitness Calculators for Strength, Nutrition &amp; Body Composition</h1>
    <p>
      {toolsData.length}+ instant, reliable tools for lifters, athletes, and
      anyone tracking fitness — built on established formulas, no sign-up
      required.
    </p>

    <p class="hero-answer">
      RepMaths is a free collection of fitness calculators covering
      strength, training, nutrition, and body composition — each built on
      established, cited formulas such as Mifflin-St Jeor, the US Navy
      body-fat method, and ISSN protein guidelines.
    </p>

    <ul class="trust-list">
      <li>✓ No sign-up required</li>
      <li>✓ Formulas and sources cited on every page</li>
      <li>✓ Works in lb and kg</li>
    </ul>
  </section>

  {groupedTools.map((group) => (
    <section class="cluster-section">
      <h2>
        <a class="cluster-link" href={`/tools/${group.id}/`}>
          {group.label}
        </a>
      </h2>
      <div class="tool-grid">
        {group.tools.map((tool) => (
          <a class="tool-card" href={tool.url}>
            <span class="icon" aria-hidden="true">{tool.icon}</span>
            <span class="name">{tool.name}</span>
            <span class="desc">{tool.shortDesc}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <style>
    .hero-answer {
      max-width: 34rem;
      margin: 8px auto 18px;
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .trust-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px 18px;
      margin: 0 0 8px;
      padding: 0;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .cluster-section {
      margin: 32px 0 40px;
    }

    .cluster-section h2 {
      font-size: 1.3rem;
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .cluster-link {
      color: var(--text);
      text-decoration: none;
      display: inline-block;
    }

    .cluster-link:hover {
      color: var(--accent);
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
    }
  </style>
</Base>
