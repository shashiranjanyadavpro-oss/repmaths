---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';

const clusterLabels: Record<string, string> = {
  strength: "1RM & Strength Calculators",
  training: "Training & Programming",
  equipment: "Plate & Equipment",
  nutrition: "Nutrition & Body Composition",
};

const clusterOrder = ["strength", "training", "equipment", "nutrition"];

const groupedTools = clusterOrder
  .map((id) => ({
    id,
    label: clusterLabels[id],
    tools: toolsData.filter((t) => t.cluster === id),
  }))
  .filter((g) => g.tools.length > 0);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "RepMaths Fitness Calculators",
  description: `Free fitness calculators — ${toolsData.length} tools for strength, training, nutrition and body composition.`,
  numberOfItems: toolsData.length,
  itemListElement: toolsData.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.name,
    url: `https://repmaths.com${tool.url}`,
  })),
};
---

<Base
  title="Free Fitness Calculators — 1RM, TDEE, BMI & More | RepMaths"
  description="Free fitness calculators for strength, nutrition & body composition. Calculate 1RM, TDEE, BMI, macros, body fat & protein intake instantly."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />

  <section class="intro">
    <h1>
      Free Fitness Calculators for Strength, Nutrition &amp; Body Composition
    </h1>

    <p class="tagline">
      {toolsData.length} free tools. No sign-up. Formulas cited.
    </p>

    <div class="search-wrap">
      <div class="search-input-wrap">
        <svg
          class="search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>

        <input
          type="search"
          id="tool-search"
          placeholder="Search calculators — 1RM, TDEE, BMI…"
          aria-label="Search calculators"
          autocomplete="off"
        />
      </div>

      <p
        id="search-count"
        class="search-count"
        aria-live="polite"
        hidden
      ></p>
    </div>
  </section>

  {
    groupedTools.map((group) => (
      <section class="cluster-section">
        <div class="cluster-head">
          <h2>
            <a class="cluster-link" href={`/tools/${group.id}/`}>
              {group.label}
            </a>
          </h2>

          <a
            class="cluster-view-all"
            href={`/tools/${group.id}/`}
            aria-hidden="true"
            tabindex="-1"
          >
            View All &rarr;
          </a>
        </div>

        <div class="tool-grid">
          {group.tools.map((tool) => (
            <a class="tool-card" href={tool.url} title={tool.name}>
              <span class="icon" aria-hidden="true">
                {tool.icon}
              </span>
              <span class="name">{tool.name}</span>
              <span class="desc">{tool.shortDesc}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section class="about-section">
    <h2>About RepMaths</h2>

    <p>
      RepMaths is a free collection of fitness calculators covering
      strength, training, nutrition and body composition — each built on
      established, cited formulas such as Mifflin-St Jeor for BMR and
      TDEE, the US Navy body-fat method, Epley and Brzycki for one-rep
      max, the Reactive Training Systems RPE scale, and ISSN protein
      guidelines.
    </p>

    <ul class="trust-list">
      <li>✓ Formulas and sources cited on every page</li>
      <li>✓ No sign-up required</li>
      <li>✓ Works in lb and kg</li>
    </ul>

    <p class="about-link">
      Built by a lifter.
      <a href="/about/">Read the RepMaths story →</a>
    </p>
  </section>

  <style>
    /* ===== INTRO ===== */

    .intro {
      padding: 16px 0 8px;
    }

    .intro h1 {
      font-size: clamp(1.4rem, 4.5vw, 2rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin: 0 0 8px;
      font-weight: 700;
    }

    .tagline {
      margin: 0 0 16px;
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    /* ===== SEARCH ===== */

    .search-wrap {
      margin: 0 0 24px;
      max-width: 480px;
    }

    .search-input-wrap {
      position: relative;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input-wrap input {
      width: 100%;
      padding: 11px 14px 11px 40px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .search-input-wrap input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(255, 91, 46, 0.15);
    }

    .search-input-wrap input::placeholder {
      color: var(--text-muted);
    }

    .search-count {
      margin: 8px 0 0;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    /* ===== TOOLS ===== */

    .cluster-section {
      margin: 28px 0;
      content-visibility: auto;
      contain-intrinsic-size: auto 500px;
    }

    .cluster-section:first-of-type {
      margin-top: 0;
    }

    .cluster-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      margin: 0 0 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .cluster-head h2 {
      font-size: 1.15rem;
      margin: 0;
      padding: 0;
      border: none;
    }

    .cluster-link {
      color: var(--text);
      text-decoration: none;
      display: inline-block;
      transition: color 0.15s ease;
    }

    .cluster-link:hover {
      color: var(--accent);
    }

    .cluster-view-all {
      font-size: 0.82rem;
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
      white-space: nowrap;
      transition: color 0.15s ease;
    }

    .cluster-view-all:hover {
      color: var(--accent-hover);
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      display: block;
      line-height: 1.4;
    }

    /* ===== ABOUT ===== */

    .about-section {
      margin: 48px 0 24px;
      padding-top: 32px;
      border-top: 1px solid var(--border);
    }

    .about-section h2 {
      font-size: 1.2rem;
      margin: 0 0 12px;
    }

    .about-section p {
      color: #c7cbd2;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .trust-list {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 20px;
      list-style: none;
      margin: 16px 0;
      padding: 0;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .about-link {
      margin: 0;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .about-link a {
      color: var(--accent);
      text-decoration: none;
    }

    .about-link a:hover {
      color: var(--accent-hover);
    }
  </style>

  <script is:inline>
    (function () {
      var input = document.getElementById("tool-search");
      var count = document.getElementById("search-count");
      var sections = document.querySelectorAll(".cluster-section");

      if (!input) return;

      function filter() {
        var q = input.value.toLowerCase().trim();

        if (!q) {
          sections.forEach(function (s) {
            s.style.display = "";
            s.querySelectorAll(".tool-card").forEach(function (c) {
              c.style.display = "";
            });
          });
          if (count) count.hidden = true;
          return;
        }

        var total = 0;

        sections.forEach(function (s) {
          var visible = 0;

          s.querySelectorAll(".tool-card").forEach(function (c) {
            var match = c.textContent.toLowerCase().indexOf(q) !== -1;
            c.style.display = match ? "" : "none";
            if (match) visible++;
          });

          s.style.display = visible > 0 ? "" : "none";
          total += visible;
        });

        if (count) {
          count.textContent =
            total +
            " calculator" +
            (total === 1 ? "" : "s") +
            " found";
          count.hidden = false;
        }
      }

      input.addEventListener("input", filter);
    })();
  </script>
</Base>
