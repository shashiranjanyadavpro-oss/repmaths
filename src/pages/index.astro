---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';

const clusterLabels: Record<string, string> = {
  strength: "1RM & Strength Calculators",
  training: "Training & Programming",
  equipment: "Plate & Equipment",
  nutrition: "Nutrition & Body Composition",
};

const clusterOrder = ["strength", "training", "equipment", "nutrition"];

const groupedTools = clusterOrder
  .map((id) => ({
    id,
    label: clusterLabels[id],
    tools: toolsData.filter((t) => t.cluster === id),
  }))
  .filter((g) => g.tools.length > 0);
---

<Base
  title="Free Fitness Calculators — 1RM, TDEE, BMI & More | RepMaths"
  description="Free fitness calculators for strength, training, nutrition and body composition — 1RM, bench press, squat, deadlift, TDEE, BMR, macros, body fat, FFMI. Built on Mifflin-St Jeor, the US Navy body-fat method and ISSN formulas. No sign-up required."
>
  <section class="hero-v2">
    <div class="hero-grid">
      <div class="hero-left">
        <span class="hero-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          {toolsData.length} tools and growing
        </span>

        <h1>
          Free Fitness Calculators for Strength, Nutrition &amp; Body Composition
        </h1>

        <p class="hero-sub">
          RepMaths is a free collection of calculators covering strength,
          training, nutrition and body composition — each built on established,
          cited formulas such as Mifflin-St Jeor, the US Navy body-fat method
          and ISSN protein guidelines.
        </p>

        <ul class="hero-trust">
          <li>✓ Formulas and sources cited on every page</li>
          <li>✓ No sign-up required</li>
          <li>✓ Works in lb and kg</li>
        </ul>

        <div class="hero-actions">
          <a href="/tools/" class="btn-hero-primary">
            Browse all calculators →
          </a>
          <a
            href="/tools/strength/strength-standards-calculator/"
            class="btn-hero-secondary"
          >
            Strength Standards →
          </a>
        </div>
      </div>

      <div class="hero-card-wrap">
        <div class="quick-card">
          <div class="quick-card-head">
            <span>Quick 1RM Estimate</span>
            <span class="pulse-dot" aria-hidden="true"></span>
          </div>

          <div class="quick-field">
            <div class="quick-inputs">
              <div class="quick-input">
                <label for="qc-weight">Weight</label>
                <input
                  id="qc-weight"
                  type="number"
                  value="100"
                  min="1"
                  step="any"
                  inputmode="decimal"
                />
                <span class="quick-unit">kg</span>
              </div>

              <div class="quick-input">
                <label for="qc-reps">Reps</label>
                <input
                  id="qc-reps"
                  type="number"
                  value="5"
                  min="1"
                  max="30"
                  step="1"
                  inputmode="numeric"
                />
                <span class="quick-unit">reps</span>
              </div>
            </div>
          </div>

          <div class="quick-result" aria-live="polite">
            <span class="quick-label">Estimated 1RM (Epley)</span>
            <strong><span id="qc-result">116.7</span> kg</strong>
            <div class="quick-bar">
              <div id="qc-bar" style="width:58%"></div>
            </div>
          </div>

          <p class="quick-note">
            <a href="/tools/strength/1rm-calculator/">
              Full 1RM calculator →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    groupedTools.map((group) => (
      <section class="cluster-section">
        <h2>
          <a class="cluster-link" href={`/tools/${group.id}/`}>
            {group.label}
          </a>
        </h2>

        <div class="tool-grid">
          {group.tools.map((tool) => (
            <a class="tool-card" href={tool.url} title={tool.name}>
              <span class="icon" aria-hidden="true">
                {tool.icon}
              </span>
              <span class="name">{tool.name}</span>
              <span class="desc">{tool.shortDesc}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <style>
    .hero-v2 {
      padding: 40px 0 8px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 32px;
      align-items: center;
    }

    @media (max-width: 720px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 999px;
      padding: 6px 14px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: 0.4;
      }
    }

    .hero-left h1 {
      font-size: clamp(2rem, 5vw, 2.8rem);
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin: 16px 0 12px;
    }

    .hero-sub {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 0 16px;
      line-height: 1.6;
    }

    .hero-trust {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      list-style: none;
      margin: 0 0 20px;
      padding: 0;
      color: var(--text-muted);
      font-size: 0.83rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn-hero-primary {
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
    }

    .btn-hero-primary:hover {
      background: var(--accent-hover);
      color: #fff;
    }

    .btn-hero-secondary {
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      font-weight: 600;
      text-decoration: none;
    }

    .btn-hero-secondary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .quick-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }

    .quick-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .quick-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .quick-inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }

    .quick-input {
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
    }

    .quick-input label {
      display: block;
      font-size: 0.68rem;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .quick-input input {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 1.1rem;
      font-weight: 700;
      padding: 0;
      outline: none;
      font-family: inherit;
    }

    .quick-input input:focus {
      color: var(--accent);
    }

    .quick-unit {
      font-size: 0.68rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .quick-result {
      background: var(--surface-2);
      border-radius: 12px;
      padding: 14px 16px;
    }

    .quick-result strong {
      font-size: 1.6rem;
      color: var(--text);
      display: block;
    }

    .quick-bar {
      margin-top: 10px;
      height: 5px;
      border-radius: 999px;
      background: var(--border);
      overflow: hidden;
    }

    .quick-bar div {
      height: 100%;
      background: var(--accent);
      transition: width 0.15s ease;
    }

    .quick-note {
      margin: 12px 0 0;
      font-size: 0.82rem;
      text-align: center;
    }

    .cluster-section {
      margin: 32px 0 40px;
    }

    .cluster-section h2 {
      font-size: 1.25rem;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .cluster-link {
      color: var(--text);
      text-decoration: none;
      display: inline-block;
      transition: color 0.15s ease;
    }

    .cluster-link:hover {
      color: var(--accent);
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      display: block;
    }
  </style>

  <script is:inline>
    (function () {
      var w = document.getElementById("qc-weight");
      var r = document.getElementById("qc-reps");
      var o = document.getElementById("qc-result");
      var b = document.getElementById("qc-bar");

      if (!w || !r || !o) return;

      function calculate() {
        var wt = parseFloat(w.value) || 0;
        var re = parseInt(r.value, 10) || 0;

        if (wt <= 0 || re <= 0) {
          o.textContent = "—";
          if (b) b.style.width = "0%";
          return;
        }

        var rm = re === 1 ? wt : wt * (1 + re / 30);

        o.textContent = rm.toFixed(1);

        if (b) {
          b.style.width = Math.min(100, (re / 12) * 100) + "%";
        }
      }

      w.addEventListener("input", calculate);
      r.addEventListener("input", calculate);

      calculate();
    })();
  </script>
</Base>
