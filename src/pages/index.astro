---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';

const clusterLabels: Record<string, string> = {
  strength: "1RM & Strength Calculators",
  training: "Training & Programming",
  equipment: "Plate & Equipment",
  nutrition: "Nutrition & Body Composition",
};

const clusterOrder = ["strength", "training", "equipment", "nutrition"];

const groupedTools = clusterOrder
  .map((id) => ({
    id,
    label: clusterLabels[id],
    tools: toolsData.filter((t) => t.cluster === id),
  }))
  .filter((g) => g.tools.length > 0);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "RepMaths Fitness Calculators",
  description: `Free fitness calculators — ${toolsData.length} tools for strength, training, nutrition and body composition.`,
  numberOfItems: toolsData.length,
  itemListElement: toolsData.map((tool, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: tool.name,
    url: `https://repmaths.com${tool.url}`,
  })),
};
---

<Base
  title="Free Fitness Calculators — 1RM, TDEE, BMI & More | RepMaths"
  description="Free fitness calculators for strength, nutrition & body composition. Calculate 1RM, TDEE, BMI, macros, body fat & protein Intake instantly."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="hero-v2">
    <div class="hero-left">
      <span class="hero-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        {toolsData.length} tools and growing
      </span>

      <h1>
        Free Fitness Calculators for Strength, Nutrition &amp; Body Composition
      </h1>

      <p class="hero-sub">
        RepMaths is a free collection of calculators covering strength,
        training, nutrition and body composition — each built on established,
        cited formulas such as Mifflin-St Jeor, the US Navy body-fat method
        and ISSN protein guidelines.
      </p>

      <ul class="hero-trust">
        <li>✓ Formulas and sources cited on every page</li>
        <li>✓ No sign-up required</li>
        <li>✓ Works in lb and kg</li>
      </ul>

      <p class="hero-about">
        Built by a lifter. <a href="/about/">Read the RepMaths story →</a>
      </p>

      <div class="hero-actions">
        <a href="/tools/" class="btn-hero-primary">
          Browse all calculators →
        </a>
        <a
          href="/tools/strength/strength-standards-calculator/"
          class="btn-hero-secondary"
        >
          Strength Standards →
        </a>
      </div>

      <div class="search-wrap">
        <div class="search-input-wrap">
          <svg
            class="search-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>

          <input
            type="search"
            id="tool-search"
            placeholder="Search calculators — 1RM, TDEE, BMI…"
            aria-label="Search calculators"
            autocomplete="off"
          />
        </div>

        <p
          id="search-count"
          class="search-count"
          aria-live="polite"
          hidden
        ></p>
      </div>
    </div>
  </section>

  {
    groupedTools.map((group) => (
      <section class="cluster-section">
        <h2>
          <a class="cluster-link" href={`/tools/${group.id}/`}>
            {group.label}
          </a>
        </h2>

        <div class="tool-grid">
          {group.tools.map((tool) => (
            <a class="tool-card" href={tool.url} title={tool.name}>
              <span class="icon" aria-hidden="true">
                {tool.icon}
              </span>
              <span class="name">{tool.name}</span>
              <span class="desc">{tool.shortDesc}</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <style>
    .hero-v2 {
      padding: 32px 0 8px;
    }

    .hero-left {
      max-width: 720px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 999px;
      padding: 6px 14px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      50% {
        opacity: 0.4;
      }
    }

    .hero-left h1 {
      font-size: clamp(1.75rem, 4.5vw, 2.4rem);
      line-height: 1.12;
      letter-spacing: -0.02em;
      margin: 16px 0 12px;
    }

    .hero-sub {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 36rem;
      margin: 0 0 16px;
      line-height: 1.6;
    }

    .hero-trust {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      list-style: none;
      margin: 0 0 12px;
      padding: 0;
      color: var(--text-muted);
      font-size: 0.83rem;
    }

    .hero-about {
      margin: 0 0 20px;
      font-size: 0.83rem;
      color: var(--text-muted);
    }

    .hero-about a {
      color: var(--accent);
      text-decoration: none;
    }

    .hero-about a:hover {
      color: var(--accent-hover);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn-hero-primary {
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }

    .btn-hero-primary:hover {
      background: var(--accent-hover);
      color: #fff;
    }

    .btn-hero-secondary {
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      font-weight: 600;
      text-decoration: none;
      transition: border-color 0.15s ease, color 0.15s ease;
    }

    .btn-hero-secondary:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .search-wrap {
      margin: 20px 0 0;
      max-width: 480px;
    }

    .search-input-wrap {
      position: relative;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input-wrap input {
      width: 100%;
      padding: 12px 14px 12px 40px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      transition: border-color 0.15s ease;
    }

    .search-input-wrap input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .search-input-wrap input::placeholder {
      color: var(--text-muted);
    }

    .search-count {
      margin: 8px 0 0;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .cluster-section {
      margin: 32px 0 40px;
      content-visibility: auto;
      contain-intrinsic-size: auto 500px;
    }

    .cluster-section h2 {
      font-size: 1.25rem;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .cluster-link {
      color: var(--text);
      text-decoration: none;
      display: inline-block;
      transition: color 0.15s ease;
    }

    .cluster-link:hover {
      color: var(--accent);
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
      display: block;
    }
  </style>

  <script is:inline>
    (function () {
      var input = document.getElementById("tool-search");
      var count = document.getElementById("search-count");
      var sections = document.querySelectorAll(".cluster-section");

      if (!input) return;

      function filter() {
        var q = input.value.toLowerCase().trim();

        if (!q) {
          sections.forEach(function (s) {
            s.style.display = "";
            s.querySelectorAll(".tool-card").forEach(function (c) {
              c.style.display = "";
            });
          });
          if (count) count.hidden = true;
          return;
        }

        var total = 0;

        sections.forEach(function (s) {
          var visible = 0;

          s.querySelectorAll(".tool-card").forEach(function (c) {
            var match = c.textContent.toLowerCase().indexOf(q) !== -1;
            c.style.display = match ? "" : "none";
            if (match) visible++;
          });

          s.style.display = visible > 0 ? "" : "none";
          total += visible;
        });

        if (count) {
          count.textContent =
            total +
            " calculator" +
            (total === 1 ? "" : "s") +
            " found";
          count.hidden = false;
        }
      }

      input.addEventListener("input", filter);
    })();
  </script>
</Base>
