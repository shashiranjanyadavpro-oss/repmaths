---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';
---
<Base
  title="Free Fitness & Strength Calculators — 1RM, Macros, Body Fat & More | RepMaths"
  description="Free, fast fitness calculators built on established formulas — 1RM, training percentages, body composition, and nutrition. No sign-up required."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "RepMaths",
    "url": "https://repmaths.com",
    "description": "Free fitness and strength-training calculators built on established, published formulas."
  })} />

  <section class="hero">
    <h1>Free Fitness &amp; Strength Calculators</h1>
    <p>Instant, accurate tools for lifters — built on established formulas, no sign-up required.</p>
  </section>

  <section class="ad-slot">Ad Slot (Top)</section>

  <section class="tool-grid">
    {toolsData.map((tool) => (
      <a class="tool-card" href={tool.url}>
        <span class="icon">{tool.icon}</span>
        <span class="name">{tool.name}</span>
        <span class="desc">{tool.shortDesc}</span>
      </a>
    ))}
  </section>

  <section class="ad-slot">Ad Slot (Bottom)</section>

  <style>
    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 12px;
      padding: 24px 0 48px;
    }
    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .tool-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .tool-card .icon { font-size: 1.8rem; display: block; margin-bottom: 8px; }
    .tool-card .name { color: var(--text); font-weight: 600; font-size: 0.92rem; display: block; margin-bottom: 4px; }
    .tool-card .desc { color: var(--text-muted); font-size: 0.78rem; }
  </style>
</Base>
