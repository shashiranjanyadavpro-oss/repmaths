---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Deadlift Max Calculator — Estimate Your 1RM Safely"
  description="Free deadlift one rep max calculator. Estimate your true deadlift 1RM using Epley, Brzycki, Lander, and Lombardi formulas without testing a risky true max."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Deadlift Max Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online deadlift calculator that estimates a lifter's true one-rep max (1RM) from a submaximal weight to support safer programming."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate my deadlift max safely?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pull a challenging weight for 3 to 6 reps with solid form, then enter that weight and rep count into a deadlift calculator. This avoids the high spinal load and injury risk of grinding out a true single-rep max."
        }
      },
      {
        "@type": "Question",
        "name": "Which formula is most accurate for the deadlift?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epley is a commonly used formula for compound lifts like the deadlift in the 1-10 rep range. Because grip and lower back fatigue can affect deadlift sets more than other lifts, some lifters cross-check with Brzycki for a second estimate. Treat any result as an estimate rather than a guaranteed maximum."
        }
      },
      {
        "@type": "Question",
        "name": "Why does my deadlift 1RM estimate feel too high?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Grip strength and lower back fatigue often become the limiting factor in deadlift sets before the target muscles are fully worked, especially past 6-8 reps. If your estimate feels inflated, try recalculating using a lower-rep set (3-5 reps) with fresh grip and using straps if grip was the failure point."
        }
      },
      {
        "@type": "Question",
        "name": "Does this formula work the same for men and women?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, these are general-population formulas used for both men and women. Some research suggests minor accuracy differences at higher rep ranges by sex and training experience, but the formulas remain a reliable estimate for most lifters."
        }
      },
      {
        "@type": "Question",
        "name": "How do I know if grip or muscle failure limited my deadlift set?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your hands opened up or the bar started slipping before your back or legs felt maxed out, grip was the limiting factor, not muscular strength. In that case, recalculate using lifting straps or a hook grip to get a more accurate estimate of your true pulling strength."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Deadlift Max Calculator</h1>
    <p>Estimate your heavy deadlift one-rep max safely without grinding out a risky true max pull.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active" aria-pressed="true">Epley</button>
        <button type="button" id="formula-brzycki" aria-pressed="false">Brzycki</button>
        <button type="button" id="formula-lander" aria-pressed="false">Lander</button>
        <button type="button" id="formula-lombardi" aria-pressed="false">Lombardi</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input type="number" id="weight" placeholder="e.g. 405" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed (max 36)</label>
      <input type="number" id="reps" placeholder="e.g. 5" inputmode="numeric" step="1" max="36" />
    </div>
    <button class="btn-primary" id="calc-btn">Calculate Deadlift Max</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated Deadlift Max</div>
      <table class="result-table" id="result-table">
        <thead>
          <tr><th>% of 1RM</th><th>Weight</th></tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>Why Estimate Your Deadlift Max?</h2>
    <p>
      The deadlift places enormous demand on your posterior chain — hamstrings,
      glutes, and spinal erectors — while also taxing your grip and central
      nervous system more than almost any other lift. Testing a true 100%
      one-rep max deadlift carries a real risk to your lower back, especially
      without a coach watching your form on the final grinding rep.
    </p>
    <p>
      A deadlift max calculator lets you pull a safer 3-rep to 6-rep set and
      estimate your true strength ceiling from established formulas, so you
      can program your next pulling session without needing to test failure
      directly off the floor.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the heaviest weight you deadlifted for a clean set with good
      form, along with the number of reps completed. Choose a formula and
      unit, then calculate. For the safest and most accurate estimate, use
      a set of 3 to 6 reps — grip and lower back fatigue can distort results
      at higher rep counts.
    </p>
  </article>

  <article class="article-section">
    <h2>Deadlift Percentage Chart &amp; Training Zones</h2>
    <p>
      Once you have your estimated deadlift 1RM, applying the right
      percentage keeps your pulling volume aligned with your goals:
    </p>
    <ul>
      <li><strong>90%–100% (1–3 reps):</strong> <em>Peaking &amp; power.</em> Used for meet prep and testing near-max singles. Requires long rest and low volume to protect the spine.</li>
      <li><strong>80%–85% (4–6 reps):</strong> <em>Strength &amp; density.</em> Builds raw pulling strength and grip endurance in the most common deadlift programming zone.</li>
      <li><strong>70%–75% (8–12 reps):</strong> <em>Hypertrophy.</em> Good for building the hamstrings, glutes, and back, though grip often becomes the limiting factor before the target muscles fatigue.</li>
      <li><strong>60%–65% (12–15+ reps):</strong> <em>Conditioning &amp; endurance.</em> High-rep deadlifts (often with straps) used for conditioning work or deload weeks.</li>
    </ul>
  </article>

  <article class="article-section">
    <h2>Deadlift Math: How the Formulas Differ</h2>
    <p>
      The deadlift fatigues differently than the squat or bench press
      because grip strength and lower back endurance often fail before the
      prime movers do. Here is how each formula applies to the deadlift:
    </p>

    <h3>1. Epley Formula</h3>
    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A reliable default for compound posterior-chain lifts.
      <strong>Best for:</strong> deadlift sets in the 1–10 rep range with
      fresh grip.
    </p>

    <h3>2. Brzycki Formula</h3>
    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      More conservative than Epley, useful as a cross-check if grip fatigue
      may have limited your set before your true strength did.
      <strong>Best for:</strong> heavy low-rep sets (1–6 reps).
    </p>

    <h3>3. Lander Formula</h3>
    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      A stable middle-ground estimate. <strong>Best for:</strong> moderate
      rep ranges (6–10 reps) when grip was solid throughout the set.
    </p>

    <h3>4. Lombardi Formula</h3>
    <p>
      <code>1RM = Weight × Reps^0.10</code><br />
      <strong>Best for:</strong> high-rep deadlift sets (10+ reps),
      typically performed with straps to remove grip as the limiting
      factor.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do I calculate my deadlift max safely?</h3>
      <p>Pull a weight for 3 to 6 reps with solid form and enter it here — this avoids the spinal load risk of a true max attempt.</p>
    </div>
    <div class="faq-item">
      <h3>Which formula is most accurate for the deadlift?</h3>
      <p>Epley is commonly used for the deadlift's 1-10 rep range; cross-checking with Brzycki can help if grip fatigue may have limited your set early. Results are still estimates.</p>
    </div>
    <div class="faq-item">
      <h3>Why does my deadlift 1RM estimate feel too high?</h3>
      <p>Grip and lower back fatigue often limit deadlift sets before the target muscles are fully worked. Try a lower-rep set (3-5) with fresh grip, or use straps if grip was the failure point.</p>
    </div>
    <div class="faq-item">
      <h3>Does this formula work the same for men and women?</h3>
      <p>Yes, these are general-population formulas used for both men and women, though minor accuracy differences can appear at higher rep ranges.</p>
    </div>
<div class="faq-item">
      <h3>How do I know if grip or muscle failure limited my set?</h3>
      <p>If your hands opened up before your back or legs felt maxed out, grip was the limiting factor. Recalculate using straps or a hook grip for a more accurate estimate.</p>
    </div>
  </article>

  <RelatedTools currentToolId="deadlift-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");
    const weightInput = document.getElementById("weight") as HTMLInputElement | null;
    const repsInput = document.getElementById("reps") as HTMLInputElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) unitLb.addEventListener("click", () => setUnit("lb"));
    if (unitKg) unitKg.addEventListener("click", () => setUnit("kg"));
    if (formEpley) formEpley.addEventListener("click", () => setFormula("epley"));
    if (formBrzycki) formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    if (formLander) formLander.addEventListener("click", () => setFormula("lander"));
    if (formLombardi) formLombardi.addEventListener("click", () => setFormula("lombardi"));

    if (repsInput) {
      repsInput.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        if (parseInt(target.value) >= 37) {
          target.value = "36";
        }
      });
    }

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;
      if (weightInput) {
        const currentVal = parseFloat(weightInput.value);
        if (currentVal) {
          weightInput.value = newUnit === "kg"
            ? (currentVal / 2.20462).toFixed(1)
            : (currentVal * 2.20462).toFixed(1);
        }
      }
      unit = newUnit;
      if (unitLb) { unitLb.classList.toggle("active", unit === "lb"); unitLb.setAttribute("aria-pressed", String(unit === "lb")); }
      if (unitKg) { unitKg.classList.toggle("active", unit === "kg"); unitKg.setAttribute("aria-pressed", String(unit === "kg")); }
    }

    function setFormula(f: string) {
      formula = f;
      const map: Record<string, HTMLElement | null> = { epley: formEpley, brzycki: formBrzycki, lander: formLander, lombardi: formLombardi };
      for (const key in map) {
        const el = map[key];
        if (el) { el.classList.toggle("active", f === key); el.setAttribute("aria-pressed", String(f === key)); }
      }
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = parseFloat(weightInput.value);
        let reps = parseInt(repsInput.value, 10);

        if (!weight || !reps || weight <= 0 || reps <= 0) {
          alert("Please enter a valid weight and rep count.");
          return;
        }

        if (reps >= 37) {
          reps = 36;
          repsInput.value = "36";
        }

        let oneRM = 0;
        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM = weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM = weight * 36 / (37 - reps);
        } else if (formula === "lander") {
          oneRM = (100 * weight) / (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM = weight * Math.pow(reps, 0.10);
        }

        const rounded = Math.round(oneRM * 10) / 10;
        if (result1rm) result1rm.textContent = `${rounded} ${unit}`;
        if (resultLabel) resultLabel.textContent = `Estimated Deadlift Max (${formulaLabel(formula)} formula)`;

        const percentages = [95, 90, 85, 80, 75, 70, 65, 60];
        const rows = percentages.map(p => {
          const val = Math.round(rounded * (p / 100) * 10) / 10;
          return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
        }).join("");

        if (resultTableBody) resultTableBody.innerHTML = rows;
        if (resultBox) resultBox.classList.add("show");
      });
    }
  </script>
</Base>
