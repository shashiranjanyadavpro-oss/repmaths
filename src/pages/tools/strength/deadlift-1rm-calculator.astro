---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Deadlift Max Calculator — Estimate Your 1RM Safely"
  description="Free deadlift one rep max calculator. Estimate your true deadlift 1RM using Epley, Brzycki, Lander, and Lombardi formulas without testing a risky true max."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Deadlift Max Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online deadlift calculator that estimates a lifter's one-rep max (1RM) from a submaximal weight to support strength programming."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate my deadlift max safely?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Use a manageable submaximal deadlift set with controlled technique, then enter the weight and completed reps into a deadlift calculator. This estimates your 1RM without requiring a true maximum attempt."
        }
      },
      {
        "@type": "Question",
        "name": "Which formula is most accurate for the deadlift?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epley is a commonly used formula for compound lifts such as the deadlift, particularly at lower rep counts. Different formulas can produce different estimates, so treat the result as an estimate rather than a guaranteed maximum."
        }
      },
      {
        "@type": "Question",
        "name": "Why does my deadlift 1RM estimate feel too high?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Grip strength, technique, fatigue, and lower back endurance can affect deadlift performance, especially as rep counts increase. If an estimate seems high, compare it with a lower-rep set performed under similar conditions."
        }
      },
      {
        "@type": "Question",
        "name": "Does this formula work the same for men and women?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "These general 1RM prediction formulas can be used for both men and women. Individual accuracy can vary with rep range, training experience, technique, fatigue, and other factors."
        }
      },
      {
        "@type": "Question",
        "name": "How do I know if grip or muscle fatigue limited my deadlift set?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your grip gives out or the bar starts slipping before your legs and back reach the same level of effort, grip may have limited the set. In that situation, consider comparing an estimate from another suitable set performed with consistent equipment and technique."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Deadlift Max Calculator</h1>
    <p>Estimate your heavy deadlift one-rep max from a submaximal set without needing to attempt a true maximum.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>

    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active" aria-pressed="true">Epley</button>
        <button type="button" id="formula-brzycki" aria-pressed="false">Brzycki</button>
        <button type="button" id="formula-lander" aria-pressed="false">Lander</button>
        <button type="button" id="formula-lombardi" aria-pressed="false">Lombardi</button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 405"
        inputmode="decimal"
        min="0"
        step="any"
      />
    </div>

    <div class="field">
      <label for="reps">Reps Completed</label>
      <input
        type="number"
        id="reps"
        placeholder="e.g. 5"
        inputmode="numeric"
        min="1"
        step="1"
      />
    </div>

    <button class="btn-primary" id="calc-btn">Calculate Deadlift Max</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated Deadlift Max</div>

      <table class="result-table" id="result-table">
        <thead>
          <tr><th>% of 1RM</th><th>Weight</th></tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>Why Estimate Your Deadlift Max?</h2>

    <p>
      The deadlift is a major posterior-chain strength exercise involving
      the hamstrings, glutes, spinal erectors, and grip. Heavy deadlift
      testing also requires appropriate technique, setup, recovery, and
      safety precautions. A true one-rep max is not necessary for every
      training program.
    </p>

    <p>
      A deadlift max calculator lets you estimate your 1RM from a
      submaximal set instead. This gives you a useful reference for
      programming and comparing training loads without requiring a true
      maximum attempt.
    </p>

    <p>
      For a general estimate, use the
      <a href="/tools/strength/1rm-calculator">1RM Calculator</a>.
      If you want to convert your deadlift performance to another rep
      target, use the
      <a href="/tools/strength/rep-max-calculator">Rep Max Calculator</a>.
      You can also use the
      <a href="/tools/strength/1rm-percentage-calculator">1RM Percentage Calculator</a>
      to turn your estimated 1RM into percentage-based training loads, or
      compare another major lower-body lift with the
      <a href="/tools/strength/squat-1rm-calculator">Squat Max Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>

    <p>
      Enter the heaviest weight you deadlifted for a clean set with
      consistent technique, along with the number of reps completed.
      Choose a formula and unit, then calculate.
    </p>

    <p>
      Lower-rep sets are generally more appropriate when using a 1RM
      prediction equation because fatigue, grip limitations, technique
      changes, and pacing can have a larger effect as repetitions increase.
      Use similar lifting conditions when comparing estimates over time.
    </p>
  </article>

  <article class="article-section">
    <h2>Deadlift Percentage Chart &amp; Training Zones</h2>

    <p>
      Once you have your estimated deadlift 1RM, applying percentages can
      help organize training loads around different goals. The relationship
      between percentage of 1RM and achievable reps varies between lifters,
      exercises, and training days, so these ranges are useful as planning
      guides rather than fixed rules.
    </p>

    <ul>
      <li>
        <strong>90%–100% (1–3 reps):</strong>
        <em>Peaking &amp; power.</em>
        Often used for heavier strength work or preparation for a strength
        test. This zone is demanding, so technique, setup, recovery, and
        appropriate safety measures matter.
      </li>

      <li>
        <strong>80%–85% (4–6 reps):</strong>
        <em>Strength &amp; density.</em>
        A commonly used heavier loading zone for strength-focused training.
      </li>

      <li>
        <strong>70%–75% (8–12 reps):</strong>
        <em>Hypertrophy.</em>
        Can be used for moderate-load resistance training, although grip
        and general fatigue may become important limiting factors.
      </li>

      <li>
        <strong>60%–65% (12–15+ reps):</strong>
        <em>Conditioning &amp; endurance.</em>
        Lighter, higher-repetition deadlift work may be appropriate in some
        programs, but exercise selection, technique, fatigue, and recovery
        should be considered.
      </li>
    </ul>
  </article>

  <article class="article-section">
    <h2>Deadlift Math: How the Formulas Differ</h2>

    <p>
      Deadlift performance can be affected by grip strength, technique,
      lower back endurance, fatigue, and rep count. Here is how each
      formula estimates your deadlift max:
    </p>

    <h3>1. Epley Formula</h3>

    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A widely used 1RM prediction equation that models the relationship
      between weight and reps in a simple linear form.
      <strong>Best for:</strong> comparing deadlift sets in the lower-rep
      range.
    </p>

    <h3>2. Brzycki Formula</h3>

    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      A commonly used 1RM prediction equation that becomes undefined at
      37 reps because its denominator reaches zero. It is mathematically
      defined for integer rep counts from 1 through 36.
      <strong>Best for:</strong> heavier low-rep sets.
    </p>

    <h3>3. Lander Formula</h3>

    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      Another commonly used 1RM prediction equation. It is mathematically
      defined for integer rep counts from 1 through 37; prediction
      reliability can vary as rep count increases.
      <strong>Best for:</strong> comparing estimates from moderate-rep sets.
    </p>

    <h3>4. Lombardi Formula</h3>

    <p>
      <code>1RM = Weight × Reps^0.10</code><br />
      A non-linear 1RM prediction model without the same denominator limit
      as Brzycki or Lander. Like other prediction equations, its estimate
      may become less representative of a true 1RM as rep count increases.
      <strong>Best for:</strong> comparing estimates from higher-rep sets.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>How do I calculate my deadlift max safely?</h3>
      <p>
        Use a manageable submaximal set and enter the weight and completed
        reps here to estimate your 1RM rather than attempting a true
        maximum. Appropriate technique, setup, and safety precautions still
        matter when lifting heavy loads.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which formula is most accurate for the deadlift?</h3>
      <p>
        Epley is commonly used for compound lifts such as the deadlift,
        particularly at lower rep counts. Different formulas can produce
        different estimates, so treat the calculated value as an estimate
        rather than a guaranteed maximum.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why does my deadlift 1RM estimate feel too high?</h3>
      <p>
        Grip strength, fatigue, technique, and rep count can affect a
        deadlift estimate. Try comparing the result with a lower-rep set
        performed under similar conditions.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does this formula work the same for men and women?</h3>
      <p>
        These general-population formulas can be used for both men and
        women, though individual accuracy can vary with rep range, training
        experience, technique, fatigue, and other factors.
      </p>
    </div>

    <div class="faq-item">
      <h3>How do I know if grip or muscle fatigue limited my set?</h3>
      <p>
        If your grip gives out or the bar starts slipping before your legs
        and back reach the same level of effort, grip may have limited the
        set. For a more consistent comparison, repeat the estimate under
        similar equipment and lifting conditions.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="deadlift-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const repsInput =
      document.getElementById("reps") as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    if (formEpley) {
      formEpley.addEventListener("click", () => setFormula("epley"));
    }

    if (formBrzycki) {
      formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    }

    if (formLander) {
      formLander.addEventListener("click", () => setFormula("lander"));
    }

    if (formLombardi) {
      formLombardi.addEventListener("click", () => setFormula("lombardi"));
    }

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (weightInput) {
        const currentVal = Number(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          weightInput.value =
            newUnit === "kg"
              ? (currentVal / 2.20462).toFixed(1)
              : (currentVal * 2.20462).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute(
          "aria-pressed",
          String(unit === "lb")
        );
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute(
          "aria-pressed",
          String(unit === "kg")
        );
      }
    }

    function setFormula(f: string) {
      const validFormulas = [
        "epley",
        "brzycki",
        "lander",
        "lombardi"
      ];

      if (!validFormulas.includes(f)) return;

      formula = f;

      const map: Record<string, HTMLElement | null> = {
        epley: formEpley,
        brzycki: formBrzycki,
        lander: formLander,
        lombardi: formLombardi
      };

      for (const key in map) {
        const el = map[key];

        if (el) {
          el.classList.toggle("active", f === key);
          el.setAttribute(
            "aria-pressed",
            String(f === key)
          );
        }
      }
    }

    function formulaSupportsReps(reps: number): boolean {
      if (!Number.isInteger(reps) || reps < 1) return false;

      if (formula === "brzycki") {
        return 37 - reps > 0;
      }

      if (formula === "lander") {
        return 101.3 - 2.67123 * reps > 0;
      }

      return true;
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    function showError(message: string) {
      if (resultBox) {
        resultBox.classList.add("show");
      }

      if (result1rm) {
        result1rm.textContent = "—";
      }

      if (resultLabel) {
        resultLabel.textContent = message;
      }

      if (resultTableBody) {
        resultTableBody.innerHTML = "";
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = Number(weightInput.value);
        const reps = Number(repsInput.value);

        if (
          !Number.isFinite(weight) ||
          weight <= 0 ||
          !Number.isInteger(reps) ||
          reps < 1
        ) {
          showError(
            "Please enter a valid weight and whole-number rep count."
          );
          return;
        }

        if (!formulaSupportsReps(reps)) {
          if (formula === "brzycki") {
            showError(
              "The Brzycki formula is only defined for 1–36 reps. Try Epley or Lombardi for this rep count."
            );
          } else if (formula === "lander") {
            showError(
              "The Lander formula is only defined for 1–37 reps. Try Epley or Lombardi for this rep count."
            );
          } else {
            showError(
              "Please enter a valid rep count for the selected formula."
            );
          }

          return;
        }

        let oneRM = 0;

        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM = weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM = weight * 36 / (37 - reps);
        } else if (formula === "lander") {
          oneRM =
            (100 * weight) /
            (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM =
            weight * Math.pow(reps, 0.10);
        }

        if (!Number.isFinite(oneRM) || oneRM <= 0) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        const rounded =
          Math.round(oneRM * 10) / 10;

        if (
          !Number.isFinite(rounded) ||
          rounded <= 0
        ) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        if (result1rm) {
          result1rm.textContent =
            `${rounded} ${unit}`;
        }

        if (resultLabel) {
          resultLabel.textContent =
            `Estimated Deadlift Max (${formulaLabel(formula)} formula)`;
        }

        const percentages = [
          95,
          90,
          85,
          80,
          75,
          70,
          65,
          60
        ];

        const rows = percentages
          .map((p) => {
            const val =
              Math.round(
                rounded * (p / 100) * 10
              ) / 10;

            return `
              <tr>
                <td>${p}%</td>
                <td>${val} ${unit}</td>
              </tr>
            `;
          })
          .join("");

        if (resultTableBody) {
          resultTableBody.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
