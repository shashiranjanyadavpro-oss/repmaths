---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Squat 1RM Calculator — Max Squat Estimator"
  description="Free squat 1RM calculator using the Epley and Brzycki formulas. Enter your weight and reps to estimate your max squat."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Squat 1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that estimates a lifter's one-rep max squat from a submaximal weight and rep count."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is this squat 1RM calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It is typically accurate within 5-10% for sets of 1 to 10 reps. Because the squat allows more technical variation than the bench press, results can vary slightly more depending on depth and bar position."
        }
      },
      {
        "@type": "Question",
        "name": "Does squat depth affect the 1RM estimate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The formula assumes consistent depth across your working set and your estimated max. If your depth varies rep to rep, the estimate becomes less reliable."
        }
      },
      {
        "@type": "Question",
        "name": "Should I test my actual squat max instead of estimating it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Only with a spotter or safety bars and a proper warm-up. An estimated 1RM is safer for regular training and usually accurate enough to plan working percentages."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Squat 1RM Calculator</h1>
    <p>Enter the weight and reps you squatted to estimate your max squat.</p>
  </section>

  <section class="ad-slot">Ad Slot (Top)</section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active">lb</button>
        <button type="button" id="unit-kg">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active">Epley</button>
        <button type="button" id="formula-brzycki">Brzycki</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Squatted</label>
      <input type="number" id="weight" placeholder="e.g. 225" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed</label>
      <input type="number" id="reps" placeholder="e.g. 5" inputmode="numeric" />
    </div>
    <button class="btn-primary" id="calc-btn">Calculate Max Squat</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated Max Squat</div>
      <table class="result-table" id="result-table"></table>
    </div>
  </section>

  <section class="ad-slot">Ad Slot (Bottom)</section>

  <article class="article-section">
    <h2>How This Calculator Works</h2>
    <p>
      This tool estimates your one-rep max squat using two established
      formulas: <strong>Epley</strong> (1RM = weight × (1 + reps ÷ 30)) and
      <strong>Brzycki</strong> (1RM = weight × 36 ÷ (37 − reps)). These work
      best for sets of 1 to 10 reps performed to or near failure with
      consistent depth and good form.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the heaviest weight you squatted for a clean set at consistent
      depth, along with the number of reps completed. The result table shows
      common training percentages so you can plan your next squat session's
      working weights directly.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How accurate is this squat 1RM calculator?</h3>
      <p>Typically accurate within 5-10% for sets of 1-10 reps, though depth consistency affects reliability.</p>
    </div>
    <div class="faq-item">
      <h3>Does squat depth affect the estimate?</h3>
      <p>Yes — the formula assumes consistent depth. Varying depth rep to rep makes the estimate less reliable.</p>
    </div>
    <div class="faq-item">
      <h3>Should I test my actual max instead?</h3>
      <p>Only with a spotter or safety bars and proper warm-up. An estimate is safer and usually accurate enough.</p>
    </div>
  </article>

  <RelatedTools currentToolId="squat-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    document.getElementById("unit-lb")!.addEventListener("click", () => setUnit("lb"));
    document.getElementById("unit-kg")!.addEventListener("click", () => setUnit("kg"));
    document.getElementById("formula-epley")!.addEventListener("click", () => setFormula("epley"));
    document.getElementById("formula-brzycki")!.addEventListener("click", () => setFormula("brzycki"));

    function setUnit(u: string) {
      unit = u;
      document.getElementById("unit-lb")!.classList.toggle("active", u === "lb");
      document.getElementById("unit-kg")!.classList.toggle("active", u === "kg");
    }
    function setFormula(f: string) {
      formula = f;
      document.getElementById("formula-epley")!.classList.toggle("active", f === "epley");
      document.getElementById("formula-brzycki")!.classList.toggle("active", f === "brzycki");
    }

    document.getElementById("calc-btn")!.addEventListener("click", () => {
      const weight = parseFloat((document.getElementById("weight") as HTMLInputElement).value);
      const reps = parseInt((document.getElementById("reps") as HTMLInputElement).value, 10);
      if (!weight || !reps || weight <= 0 || reps <= 0) {
        alert("Please enter a valid weight and rep count.");
        return;
      }

      let oneRM: number;
      if (reps === 1) {
        oneRM = weight;
      } else if (formula === "epley") {
        oneRM = weight * (1 + reps / 30);
      } else {
        oneRM = weight * 36 / (37 - reps);
      }

      const rounded = Math.round(oneRM * 10) / 10;
      const formulaName = formula === "epley" ? "Epley" : "Brzycki";
      document.getElementById("result-1rm")!.textContent = `${rounded} ${unit}`;
      document.getElementById("result-label")!.textContent = `Estimated Max Squat (${formulaName} formula)`;

      const percentages = [95, 90, 85, 80, 75, 70, 65, 60];
      const rows = percentages.map(p => {
        const val = Math.round(rounded * (p / 100) * 10) / 10;
        return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
      }).join("");
      document.getElementById("result-table")!.innerHTML = rows;
      document.getElementById("result-box")!.classList.add("show");
    });
  </script>
</Base>
