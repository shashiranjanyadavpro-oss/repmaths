---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Bench Press Max Calculator — Estimate Your 1RM Safely"
  description="Free bench press one rep max calculator. Estimate your max bench safely using the Brzycki, Epley, Lander, or Lombardi formula without needing a spotter."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Bench Press Max Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online bench press calculator that estimates a lifter's one-rep max (1RM) from a submaximal weight to support strength training and load planning."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate my bench press max without a spotter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To estimate your bench press max without attempting a true maximum, use a manageable submaximal weight for a controlled set and enter the weight and completed reps into a calculator using a formula such as Brzycki or Epley. A spotter or appropriate safety equipment is still recommended when benching heavy loads."
        }
      },
      {
        "@type": "Question",
        "name": "Which formula is most accurate for the bench press?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Brzycki is commonly used for pressing movements such as the bench press, particularly at lower rep counts, and can produce a somewhat more conservative estimate than Epley. No single formula is universally most accurate, so treat the result as an estimate."
        }
      },
      {
        "@type": "Question",
        "name": "Why is my estimated bench max higher than what I can actually lift?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Prediction formulas can become less consistent as rep counts increase, and individual performance varies with technique, fatigue, training experience, and exercise-specific strength. An estimate from a lower-rep set may sometimes provide a closer reference to a true 1RM."
        }
      },
      {
        "@type": "Question",
        "name": "Does the bench press formula work the same for men and women?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "These general-population formulas can be used for both men and women. Individual accuracy can vary with rep range, training experience, fatigue, and other factors."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Bench Press Max Calculator</h1>
    <p>Estimate your bench press one-rep max from a submaximal set without needing to attempt a true maximum.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>

    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active" aria-pressed="true">Epley</button>
        <button type="button" id="formula-brzycki" aria-pressed="false">Brzycki</button>
        <button type="button" id="formula-lander" aria-pressed="false">Lander</button>
        <button type="button" id="formula-lombardi" aria-pressed="false">Lombardi</button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 135"
        inputmode="decimal"
        min="0"
        step="any"
      />
    </div>

    <div class="field">
      <label for="reps">Reps Completed</label>
      <input
        type="number"
        id="reps"
        placeholder="e.g. 8"
        inputmode="numeric"
        step="1"
        min="1"
      />
    </div>

    <button class="btn-primary" id="calc-btn">Calculate Max Bench</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated Max Bench Press</div>

      <table class="result-table" id="result-table">
        <thead>
          <tr>
            <th>% of 1RM</th>
            <th>Weight</th>
          </tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>Why Estimate Your Bench Press Max?</h2>

    <p>
      The bench press is a common test of upper-body pushing strength,
      engaging the pectorals, anterior deltoids, and triceps. Attempting
      a true 100% one-rep max requires appropriate setup, technique, and
      safety precautions. A missed heavy rep can create a meaningful
      safety concern, particularly when no spotter or safety arms are available.
    </p>

    <p>
      Using a bench press max calculator lets you estimate your 1RM from
      a submaximal set instead. Plugging the weight and completed reps
      into an established formula can provide a useful reference for
      programming and percentage-based training without requiring a true
      maximum attempt.
    </p>

    <p>
      For broader strength planning, you can also compare this estimate
      with the
      <a href="/tools/strength/1rm-calculator">1RM Calculator</a>,
      convert it into training loads with the
      <a href="/tools/strength/1rm-percentage-calculator">1RM Percentage Calculator</a>,
      or review rep-based estimates with the
      <a href="/tools/strength/rep-max-calculator">Rep Max Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>

    <p>
      Enter the heaviest weight you benched for a clean set, along with
      the number of reps completed. Choose a formula and unit, then
      calculate. For a more consistent estimate, use a set of around 3 to
      8 reps rather than a very high-rep set.
    </p>

    <p>
      Keep the technique and range of motion reasonably consistent when
      comparing estimates over time. Fatigue and day-to-day performance
      can affect how many reps you can complete at a given load, so an
      estimated 1RM should be treated as a planning reference rather than
      a guaranteed maximum.
    </p>
  </article>

  <article class="article-section">
    <h2>Bench Press Percentage Chart &amp; Training Zones</h2>

    <p>
      Once you have your estimated bench press 1RM, applying an
      appropriate percentage to your training can help guide your goals.
      Percentage ranges are useful planning tools, but the number of reps
      possible at a given percentage can vary between lifters, exercises,
      and training days.
    </p>

    <ul>
      <li>
        <strong>90%–100% (1–3 reps):</strong>
        <em>Peaking &amp; power.</em>
        Often used when practicing heavier bench press work or preparing
        for a strength test. This zone is demanding, so appropriate
        technique, setup, and recovery matter.
      </li>

      <li>
        <strong>80%–85% (4–6 reps):</strong>
        <em>Strength &amp; density.</em>
        A commonly used heavier loading zone for strength-focused training.
      </li>

      <li>
        <strong>70%–75% (8–12 reps):</strong>
        <em>Hypertrophy.</em>
        Frequently used for moderate-load resistance training and
        accumulating training volume.
      </li>

      <li>
        <strong>60%–65% (12–15+ reps):</strong>
        <em>Speed &amp; technique.</em>
        Can be useful for lighter technique-focused work or higher-repetition
        training, depending on the program.
      </li>
    </ul>
  </article>

  <article class="article-section">
    <h2>The 4 Bench Press Formulas Explained</h2>

    <p>
      Pressing performance can vary with technique, fatigue, training
      experience, and rep range. Here is how each formula estimates your max:
    </p>

    <h3>1. Brzycki Formula (Commonly Used for Bench Press)</h3>

    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      A commonly used formula for pressing movements that generally gives
      a more conservative estimate as reps increase. It is mathematically
      defined for integer rep counts from 1 through 36.
      <strong>Best for:</strong> lower-rep sets, particularly around the
      1–8 rep range.
    </p>

    <h3>2. Epley Formula</h3>

    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A widely used baseline formula that models the relationship between
      weight and reps in a simple linear form. It can produce a different
      estimate from Brzycki as rep count increases.
      <strong>Best for:</strong> general 1RM estimates from lower-rep sets.
    </p>

    <h3>3. Lander Formula</h3>

    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      Another commonly used 1RM prediction equation. It is mathematically
      defined for integer rep counts from 1 through 37; prediction
      reliability can vary as the rep count increases.
      <strong>Best for:</strong> comparing estimates from moderate-rep sets.
    </p>

    <h3>4. Lombardi Formula</h3>

    <p>
      <code>1RM = Weight × Reps^0.10</code><br />
      A non-linear model without the same mathematical denominator limit as
      Brzycki or Lander. Like other prediction equations, its estimate may
      become less representative of a true 1RM as rep count increases.
      <strong>Best for:</strong> comparing estimates from higher-rep sets.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>How do I calculate my bench press max without a spotter?</h3>
      <p>
        Use a manageable submaximal set and enter the weight and completed
        reps here to estimate your 1RM rather than attempting a true maximum.
        A spotter or appropriate safety equipment is still recommended for
        heavy bench pressing.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which formula is most accurate for the bench press?</h3>
      <p>
        Brzycki is commonly used and can be more conservative for pressing
        movements, though no formula is universally most accurate. Treat
        the calculated value as an estimate.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why is my estimated bench max higher than what I can actually lift?</h3>
      <p>
        Higher-rep sets can make prediction formulas less consistent, and
        technique, fatigue, training experience, and individual strength
        characteristics can all affect the result. Try comparing estimates
        from a lower-rep set.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does this work the same for men and women?</h3>
      <p>
        These general-population formulas can be used for both men and women,
        though individual accuracy can vary with rep range, training
        experience, fatigue, and other factors.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="bench-press-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const repsInput =
      document.getElementById("reps") as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    if (formEpley) {
      formEpley.addEventListener("click", () => setFormula("epley"));
    }

    if (formBrzycki) {
      formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    }

    if (formLander) {
      formLander.addEventListener("click", () => setFormula("lander"));
    }

    if (formLombardi) {
      formLombardi.addEventListener("click", () => setFormula("lombardi"));
    }

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (weightInput) {
        const currentVal = Number(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          weightInput.value =
            newUnit === "kg"
              ? (currentVal / 2.20462).toFixed(1)
              : (currentVal * 2.20462).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute(
          "aria-pressed",
          String(unit === "lb")
        );
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute(
          "aria-pressed",
          String(unit === "kg")
        );
      }
    }

    function setFormula(f: string) {
      const validFormulas = [
        "epley",
        "brzycki",
        "lander",
        "lombardi"
      ];

      if (!validFormulas.includes(f)) return;

      formula = f;

      const map: Record<string, HTMLElement | null> = {
        epley: formEpley,
        brzycki: formBrzycki,
        lander: formLander,
        lombardi: formLombardi
      };

      for (const key in map) {
        const el = map[key];

        if (el) {
          el.classList.toggle("active", f === key);
          el.setAttribute(
            "aria-pressed",
            String(f === key)
          );
        }
      }
    }

    function formulaSupportsReps(reps: number): boolean {
      if (!Number.isInteger(reps) || reps < 1) return false;

      if (formula === "brzycki") {
        return 37 - reps > 0;
      }

      if (formula === "lander") {
        return 101.3 - 2.67123 * reps > 0;
      }

      return true;
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    function showError(message: string) {
      if (resultBox) {
        resultBox.classList.add("show");
      }

      if (result1rm) {
        result1rm.textContent = "—";
      }

      if (resultLabel) {
        resultLabel.textContent = message;
      }

      if (resultTableBody) {
        resultTableBody.innerHTML = "";
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = Number(weightInput.value);
        const reps = Number(repsInput.value);

        if (
          !Number.isFinite(weight) ||
          weight <= 0 ||
          !Number.isInteger(reps) ||
          reps < 1
        ) {
          showError(
            "Please enter a valid weight and whole-number rep count."
          );
          return;
        }

        if (!formulaSupportsReps(reps)) {
          if (formula === "brzycki") {
            showError(
              "The Brzycki formula is only defined for 1–36 reps. Try Epley or Lombardi for this rep count."
            );
          } else if (formula === "lander") {
            showError(
              "The Lander formula is only defined for 1–37 reps. Try Epley or Lombardi for this rep count."
            );
          } else {
            showError(
              "Please enter a valid rep count for the selected formula."
            );
          }

          return;
        }

        let oneRM = 0;

        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM = weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM = weight * 36 / (37 - reps);
        } else if (formula === "lander") {
          oneRM =
            (100 * weight) /
            (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM =
            weight * Math.pow(reps, 0.10);
        }

        if (!Number.isFinite(oneRM) || oneRM <= 0) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        const rounded =
          Math.round(oneRM * 10) / 10;

        if (
          !Number.isFinite(rounded) ||
          rounded <= 0
        ) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        if (result1rm) {
          result1rm.textContent =
            `${rounded} ${unit}`;
        }

        if (resultLabel) {
          resultLabel.textContent =
            `Estimated Max Bench (${formulaLabel(formula)} formula)`;
        }

        const percentages = [
          95,
          90,
          85,
          80,
          75,
          70,
          65,
          60
        ];

        const rows = percentages
          .map((p) => {
            const val =
              Math.round(
                rounded * (p / 100) * 10
              ) / 10;

            return `
              <tr>
                <td>${p}%</td>
                <td>${val} ${unit}</td>
              </tr>
            `;
          })
          .join("");

        if (resultTableBody) {
          resultTableBody.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
