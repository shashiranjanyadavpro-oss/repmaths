---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="1RM Percentage Calculator — Lifting Percentage Chart"
  description="Free 1RM percentage calculator. Find the exact weight for any percentage of your one-rep max, or calculate your 1RM from a known working weight."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "1RM Percentage Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that converts between one-rep max, training percentage, and working weight for percentage-based strength programs."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What percentage of my 1RM should I use for muscle growth?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many hypertrophy-focused programs use moderate loads, often around 65% to 75% of 1RM for sets in the 8 to 12 rep range. The appropriate load can vary with the exercise, training experience, proximity to failure, and individual response."
        }
      },
      {
        "@type": "Question",
        "name": "What percentage of my 1RM is best for building strength?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Strength-focused training often uses heavier loads, commonly around 85% to 95% of 1RM for lower-rep work. The appropriate percentage depends on the exercise, program, experience, and desired training volume."
        }
      },
      {
        "@type": "Question",
        "name": "Should I use my true 1RM or a training max for percentage-based programs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some percentage-based programs use a training max below the true 1RM. A common example is 90% of the actual 1RM, although the exact approach depends on the program and athlete."
        }
      },
      {
        "@type": "Question",
        "name": "How often should I recalculate my 1RM percentages?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can update your 1RM estimate after a meaningful change in performance or at the end of a training cycle. The appropriate timing depends on the program and how frequently your strength changes."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>1RM Percentage Calculator</h1>
    <p>Find the exact weight for any percentage of your max, or work out your 1RM from a lift you already made.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>

    <div class="field">
      <label>Mode</label>
      <div class="unit-toggle">
        <button type="button" id="mode-forward" class="active" aria-pressed="true">1RM → Weight</button>
        <button type="button" id="mode-reverse" aria-pressed="false">Weight → 1RM</button>
      </div>
    </div>

    <div id="forward-fields">
      <div class="field">
        <label for="onerm">Your 1RM</label>
        <input type="number" id="onerm" placeholder="e.g. 225" inputmode="decimal" min="0" />
      </div>
    </div>

    <div id="reverse-fields" style="display:none;">
      <div class="field">
        <label for="known-weight">Weight You Lifted</label>
        <input type="number" id="known-weight" placeholder="e.g. 180" inputmode="decimal" min="0" />
      </div>

      <div class="field">
        <label for="known-percent">That Weight Was What % of Your Max?</label>
        <input type="number" id="known-percent" placeholder="e.g. 80" inputmode="numeric" min="1" max="100" step="1" />
      </div>
    </div>

    <button class="btn-primary" id="calc-btn">Calculate</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-main">–</div>
      <div class="label" id="result-label">Result</div>
      <table class="result-table" id="result-table">
        <thead>
          <tr><th>% of 1RM</th><th>Weight</th></tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is a 1RM Percentage Calculator?</h2>
    <p>
      Percentage-based training programs — from basic strength blocks to
      structured systems like Wendler 5/3/1 — prescribe your working weight
      as a percentage of your one-rep max rather than a fixed number. This
      calculator works both ways: enter your 1RM to get a full lifting
      percentage chart, or enter a weight you already lifted along with the
      percentage it represented to back-calculate your 1RM.
    </p>
    <p>
      If you need to estimate your one-rep max from a completed set instead,
      use the <a href="/tools/strength/1rm-calculator">1RM Calculator</a>.
      You can also use the <a href="/tools/strength/rep-max-calculator">Rep Max Calculator</a>
      to convert a known weight and rep count into a different target rep range.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      If you already know your 1RM, switch to "1RM → Weight" mode and enter
      it — the table below will show your working weight at every common
      training percentage. If you only know a weight you lifted and roughly
      what percentage it was (from a program), switch to "Weight → 1RM" mode
      to calculate your max instead.
    </p>
  </article>

  <article class="article-section">
    <h2>1RM Percentages by Training Goal</h2>
    <ul>
      <li><strong>85%–95%:</strong> <em>Strength &amp; power.</em> Heavy, low-rep work commonly used for strength-focused training. Higher percentages generally allow fewer repetitions and require appropriate fatigue and technique management.</li>
      <li><strong>65%–75%:</strong> <em>Hypertrophy.</em> A commonly used range for moderate-rep sets. It can provide substantial mechanical tension, although muscle growth can occur across a broader range of loads when sets are sufficiently challenging.</li>
      <li><strong>50%–65%:</strong> <em>Endurance &amp; technique work.</em> Lighter loads that can be useful for higher-rep work, warm-ups, technique practice, or deload periods depending on the program.</li>
    </ul>
    <p>
      If your program uses a percentage below your true 1RM as its working
      reference, the <a href="/tools/training/training-max-calculator">Training Max Calculator</a>
      can help convert your 1RM into a training max.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What percentage of my 1RM should I use for muscle growth?</h3>
      <p>Many hypertrophy-focused programs use around 65-75% of 1RM for moderate-rep sets such as 8-12 reps. The appropriate load can vary by exercise, training experience, proximity to failure, and individual response.</p>
    </div>

    <div class="faq-item">
      <h3>What percentage of my 1RM is best for building strength?</h3>
      <p>Strength-focused training often uses heavier loads, commonly around 85-95% of 1RM for lower-rep work. The appropriate percentage depends on the exercise, program, experience, and training volume.</p>
    </div>

    <div class="faq-item">
      <h3>Should I use my true 1RM or a training max?</h3>
      <p>Some percentage-based programs use a training max below your true 1RM. Around 90% of true 1RM is a common example, but the appropriate training max depends on the program and athlete.</p>
    </div>

    <div class="faq-item">
      <h3>How often should I recalculate my percentages?</h3>
      <p>You can update your 1RM estimate after a meaningful change in performance or at the end of a training cycle. The appropriate timing depends on your program and how frequently your strength changes.</p>
    </div>
  </article>

  <RelatedTools currentToolId="1rm-percentage-calculator" />

  <script>
    let unit = "lb";
    let mode = "forward";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const modeForward = document.getElementById("mode-forward");
    const modeReverse = document.getElementById("mode-reverse");
    const forwardFields = document.getElementById("forward-fields");
    const reverseFields = document.getElementById("reverse-fields");
    const oneRMInput = document.getElementById("onerm") as HTMLInputElement | null;
    const knownWeightInput = document.getElementById("known-weight") as HTMLInputElement | null;
    const knownPercentInput = document.getElementById("known-percent") as HTMLInputElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const resultMain = document.getElementById("result-main");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) unitLb.addEventListener("click", () => setUnit("lb"));
    if (unitKg) unitKg.addEventListener("click", () => setUnit("kg"));
    if (modeForward) modeForward.addEventListener("click", () => setMode("forward"));
    if (modeReverse) modeReverse.addEventListener("click", () => setMode("reverse"));

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;

      const conversionFactor = 2.20462;

      const convertInput = (input: HTMLInputElement | null) => {
        if (!input) return;

        const currentValue = Number(input.value);

        if (!Number.isFinite(currentValue) || currentValue <= 0) return;

        input.value = newUnit === "kg"
          ? (currentValue / conversionFactor).toFixed(1)
          : (currentValue * conversionFactor).toFixed(1);
      };

      convertInput(oneRMInput);
      convertInput(knownWeightInput);

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }

      if (resultBox) {
        resultBox.classList.remove("show");
      }
    }

    function setMode(newMode: string) {
      mode = newMode;

      if (modeForward) {
        modeForward.classList.toggle("active", mode === "forward");
        modeForward.setAttribute("aria-pressed", String(mode === "forward"));
      }

      if (modeReverse) {
        modeReverse.classList.toggle("active", mode === "reverse");
        modeReverse.setAttribute("aria-pressed", String(mode === "reverse"));
      }

      if (forwardFields) {
        forwardFields.style.display = mode === "forward" ? "block" : "none";
      }

      if (reverseFields) {
        reverseFields.style.display = mode === "reverse" ? "block" : "none";
      }

      if (resultBox) {
        resultBox.classList.remove("show");
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        const percentages = [95, 90, 85, 80, 75, 70, 65, 60, 55, 50];

        if (mode === "forward") {
          if (!oneRMInput) return;

          const oneRM = Number(oneRMInput.value);

          if (!Number.isFinite(oneRM) || oneRM <= 0) {
            alert("Please enter a valid 1RM greater than 0.");
            return;
          }

          if (resultMain) {
            resultMain.textContent = `${oneRM} ${unit}`;
          }

          if (resultLabel) {
            resultLabel.textContent = "Your 1RM";
          }

          const rows = percentages.map(p => {
            const w = Math.round(oneRM * (p / 100) * 10) / 10;
            return `<tr><td>${p}%</td><td>${w} ${unit}</td></tr>`;
          }).join("");

          if (resultTableBody) {
            resultTableBody.innerHTML = rows;
          }
        } else {
          if (!knownWeightInput || !knownPercentInput) return;

          const weight = Number(knownWeightInput.value);
          const percent = Number(knownPercentInput.value);

          if (
            !Number.isFinite(weight) ||
            !Number.isFinite(percent) ||
            weight <= 0 ||
            percent < 1 ||
            percent > 100
          ) {
            alert("Please enter a valid weight and a percentage between 1 and 100.");
            return;
          }

          const oneRM = weight / (percent / 100);

          if (!Number.isFinite(oneRM) || oneRM <= 0) {
            alert("The entered values could not produce a valid 1RM estimate.");
            return;
          }

          const rounded = Math.round(oneRM * 10) / 10;

          if (resultMain) {
            resultMain.textContent = `${rounded} ${unit}`;
          }

          if (resultLabel) {
            resultLabel.textContent = "Estimated 1RM";
          }

          const rows = percentages.map(p => {
            const w = Math.round(rounded * (p / 100) * 10) / 10;
            return `<tr><td>${p}%</td><td>${w} ${unit}</td></tr>`;
          }).join("");

          if (resultTableBody) {
            resultTableBody.innerHTML = rows;
          }
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
