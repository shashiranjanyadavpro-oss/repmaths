---
import Base from "../../../layouts/Base.astro";
import RelatedTools from "../../../components/RelatedTools.astro";

const pageUrl = "https://repmaths.com/tools/strength/strength-standards-calculator/";

const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "1RM & Strength", href: "/tools/strength/" },
  { name: "Strength Standards Calculator" },
];

const referenceStandards = {
  male: {
    bench: [
      { label: "Beginner", ratio: 0.50 },
      { label: "Novice", ratio: 0.75 },
      { label: "Intermediate", ratio: 1.00 },
      { label: "Advanced", ratio: 1.25 },
      { label: "Elite", ratio: 1.50 },
    ],
    squat: [
      { label: "Beginner", ratio: 0.75 },
      { label: "Novice", ratio: 1.00 },
      { label: "Intermediate", ratio: 1.25 },
      { label: "Advanced", ratio: 1.50 },
      { label: "Elite", ratio: 1.75 },
    ],
    deadlift: [
      { label: "Beginner", ratio: 1.00 },
      { label: "Novice", ratio: 1.25 },
      { label: "Intermediate", ratio: 1.50 },
      { label: "Advanced", ratio: 1.75 },
      { label: "Elite", ratio: 2.00 },
    ],
    ohp: [
      { label: "Beginner", ratio: 0.30 },
      { label: "Novice", ratio: 0.50 },
      { label: "Intermediate", ratio: 0.65 },
      { label: "Advanced", ratio: 0.80 },
      { label: "Elite", ratio: 1.00 },
    ],
  },
  female: {
    bench: [
      { label: "Beginner", ratio: 0.30 },
      { label: "Novice", ratio: 0.50 },
      { label: "Intermediate", ratio: 0.75 },
      { label: "Advanced", ratio: 1.00 },
      { label: "Elite", ratio: 1.25 },
    ],
    squat: [
      { label: "Beginner", ratio: 0.50 },
      { label: "Novice", ratio: 0.75 },
      { label: "Intermediate", ratio: 1.00 },
      { label: "Advanced", ratio: 1.25 },
      { label: "Elite", ratio: 1.50 },
    ],
    deadlift: [
      { label: "Beginner", ratio: 0.75 },
      { label: "Novice", ratio: 1.00 },
      { label: "Intermediate", ratio: 1.25 },
      { label: "Advanced", ratio: 1.50 },
      { label: "Elite", ratio: 1.75 },
    ],
    ohp: [
      { label: "Beginner", ratio: 0.20 },
      { label: "Novice", ratio: 0.30 },
      { label: "Intermediate", ratio: 0.45 },
      { label: "Advanced", ratio: 0.60 },
      { label: "Elite", ratio: 0.75 },
    ],
  },
};

const faqItems = [
  {
    question: "What is considered a 'good' strength standard for natural lifters?",
    answer: "An 'Intermediate' level—typically a 1.25x bodyweight bench, 1.5x squat, and 2.0x deadlift for men—represents a dedicated natural trainee with 1 to 2 years of consistent progressive overload. Hitting these marks indicates a solid foundation of general strength."
  },
  {
    question: "Does body weight affect relative strength standards?",
    answer: "Yes. Due to allometric scaling (the square-cube law), lighter lifters naturally tend to have higher strength-to-bodyweight ratios than heavier lifters. This is why a 150 lb lifter might achieve a 1.5x bodyweight bench press more easily than a 250 lb lifter."
  },
  {
    question: "What are the five main strength standard classifications?",
    answer: "The five common categories are Beginner (just starting to learn the movement), Novice (under 1 year of consistent training), Intermediate (1-2 years of structured lifting), Advanced (multiple years of dedicated programming), and Elite (competitive level strength)."
  },
  {
    question: "Should strength standards be based on bodyweight?",
    answer: "Bodyweight is highly useful for contextualizing strength because the same absolute weight on the bar represents a vastly different relative load for people of different sizes. However, bodyweight ratios do not capture every mechanical factor like height or limb length."
  },
  {
    question: "Can I use an estimated 1RM instead of a tested 1RM?",
    answer: "Yes. An estimated 1RM calculated from a recent submaximal set (e.g., a heavy set of 3 or 5 reps) is perfectly fine to use. While it introduces slight mathematical uncertainty, it is often safer and more practical than testing a true 1-rep max."
  },
  {
    question: "Are strength standards the same as powerlifting standards?",
    answer: "Not necessarily. Competition standards include specific rules for technique, commands, depth, pauses, and equipment (like suits or wraps). A general bodyweight-ratio calculator serves as a personal training benchmark, not a replacement for federation-specific rules."
  }
];

const applicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#app`,
  name: "Strength Standards Calculator",
  url: pageUrl,
  applicationCategory: "HealthApplication",
  applicationSubCategory: "Fitness Calculator",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description:
    "Free strength standards calculator for comparing bench press, squat, deadlift, and overhead press 1RM with bodyweight-based reference benchmarks for male and female lifters.",
};

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Strength Standards Calculator — Bench, Squat, Deadlift & OHP",
  description:
    "Free strength standards calculator for bench press, squat, deadlift, and overhead press. Compare your 1RM with bodyweight-based reference standards in lb or kg.",
  inLanguage: "en",
  isPartOf: {
    "@id": "https://repmaths.com/#website",
  },
  about: {
    "@type": "Thing",
    name: "Strength standards",
  },
  mainEntity: {
    "@id": `${pageUrl}#app`,
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Base
  title="Strength Standards Calculator — Bench, Squat, Deadlift & OHP"
  description="Free strength standards calculator for bench press, squat, deadlift, and overhead press. Compare your 1RM with bodyweight-based reference standards for male and female lifters in lb or kg."
  breadcrumbs={breadcrumbItems}
>
  <script type="application/ld+json" set:html={JSON.stringify(applicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <h1>Strength Standards Calculator</h1>
    <p>
      Compare your <strong>bench press, squat, deadlift, or overhead press 1RM</strong>
      with bodyweight-based strength standards. Enter your bodyweight and lift,
      choose your sex and unit, and discover your current reference level in pounds (lb) or kilograms (kg).
    </p>
  </section>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="sr-only">Calculate Your Strength Level</h2>

    <div class="field" role="group" aria-labelledby="sex-label">
      <label id="sex-label">Sex</label>
      <div class="unit-toggle" role="group" aria-label="Sex">
        <button type="button" class="unit-btn active" data-sex="male" aria-pressed="true">
          Male
        </button>
        <button type="button" class="unit-btn" data-sex="female" aria-pressed="false">
          Female
        </button>
      </div>
    </div>

    <div class="field" role="group" aria-labelledby="unit-label">
      <label id="unit-label">Weight Unit</label>
      <div class="unit-toggle" role="group" aria-label="Weight unit">
        <button type="button" class="unit-btn active" data-unit="lb" aria-pressed="true">
          lb
        </button>
        <button type="button" class="unit-btn" data-unit="kg" aria-pressed="false">
          kg
        </button>
      </div>
    </div>

    <div class="field">
      <label for="bodyweight">Body Weight</label>
      <input
        id="bodyweight"
        name="bodyweight"
        type="number"
        inputmode="decimal"
        min="66"
        max="660"
        step="0.1"
        placeholder="e.g. 180"
        autocomplete="off"
      />
    </div>

    <div class="field">
      <label for="exercise">Exercise</label>
      <select id="exercise" name="exercise">
        <option value="bench">Bench Press</option>
        <option value="squat">Back Squat</option>
        <option value="deadlift">Deadlift</option>
        <option value="ohp">Overhead Press</option>
      </select>
    </div>

    <div class="field">
      <label for="one-rm">1RM (One Rep Max)</label>
      <input
        id="one-rm"
        name="one-rm"
        type="number"
        inputmode="decimal"
        min="1"
        step="0.1"
        placeholder="e.g. 225"
        autocomplete="off"
      />
    </div>

    <div id="calc-error" class="calc-error" role="alert" aria-live="assertive" aria-atomic="true" hidden></div>

    <button type="button" id="calculate" class="btn-primary">
      Calculate Strength Standard
    </button>

    <div id="result" class="result-box" hidden aria-live="polite" aria-atomic="true">
      <div class="big-number" id="result-level">–</div>
      <div class="label">Reference Strength Level</div>

      <p id="result-summary" style="margin-top: 14px; font-size: 1.05rem; font-weight: 600;"></p>
      
      <div id="result-table-wrap" style="margin-top: 18px;"></div>
      
      <div id="next-level" class="lifter-note" style="margin-top: 20px;"></div>

      <div class="result-actions" style="margin-top: 24px;">
        <a href="/tools/strength/1rm-percentage-calculator" class="btn-primary">
          Calculate 1RM Percentages
        </a>
        <a href="/tools/equipment/plate-calculator" class="btn-primary">
          Load the Bar
        </a>
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>Understanding Bodyweight Reference Benchmarks</h2>
    <p>
      Strength standards are reference points used to compare a lifter's performance with bodyweight-adjusted benchmarks. Instead of looking purely at the absolute weight on the barbell, these standards evaluate performance based on your biological sex, specific exercise, and mass.
    </p>
    <p>
      RepMaths uses separate reference models for male and female lifters across five descriptive levels: <strong>Beginner, Novice, Intermediate, Advanced, and Elite</strong>. These levels serve as highly practical training targets and reality checks, rather than universal population percentiles or strict medical assessments.
    </p>
  </article>

  <article class="article-section">
    <h2>The Science of Relative Strength</h2>
    <p>
      Bodyweight matters immensely in strength sports because the same absolute lift represents a vastly different relative effort for people of varying sizes. For example, a 100 kg (225 lb) bench press represents a significantly higher relative strength ratio for someone weighing 65 kg than for someone weighing 110 kg.
    </p>
    <p>The calculator evaluates your capability using this foundational formula:</p>
    <p>
      <code>Relative Strength = 1RM ÷ Bodyweight</code>
    </p>
    <p>
      Your calculated ratio is then mapped against our exercise-specific reference thresholds to determine your current training bracket.
    </p>
  </article>

  <article class="article-section">
    <h2>Using the Reference Ratios (By Lift)</h2>
    
    <h3>Bench Press & Overhead Press</h3>
    <p>
      Upper body pressing standards are highly sensitive to bodyweight and sex. Because upper body musculature differs significantly between males and females, the reference thresholds for the bench press and strict overhead press scale differently than lower body movements. Treat these as baseline performance metrics for upper-body pushing power.
    </p>

    <h3>Back Squat & Deadlift</h3>
    <p>
      Squat and deadlift standards evaluate lower body and posterior chain strength. Differences in squat depth (parallel vs. full depth), bar position (high-bar vs. low-bar), and deadlift stance (conventional vs. sumo) can heavily influence how your lift compares with a standardized reference value. For the most accurate long-term tracking, ensure your technique remains consistent.
    </p>
  </article>

  <article class="article-section">
    <h2>Strength Standards Chart (1RM ÷ Bodyweight)</h2>
    <p>
      Below are the exact bodyweight-ratio thresholds used by the RepMaths engine. Multiply your bodyweight by the ratio shown to find the required 1RM for each level.
    </p>

    <h3>Male Strength Standards</h3>
    <div class="reference-table-wrap">
      <table class="result-table standards-chart">
        <caption class="sr-only">Male strength standards by exercise and level</caption>
        <thead>
          <tr>
            <th scope="col">Level</th>
            <th scope="col">Bench Press</th>
            <th scope="col">Squat</th>
            <th scope="col">Deadlift</th>
            <th scope="col">OHP</th>
          </tr>
        </thead>
        <tbody>
          {referenceStandards.male.bench.map((row, i) => (
            <tr>
              <td>{row.label}</td>
              <td>{row.ratio.toFixed(2)}×</td>
              <td>{referenceStandards.male.squat[i].ratio.toFixed(2)}×</td>
              <td>{referenceStandards.male.deadlift[i].ratio.toFixed(2)}×</td>
              <td>{referenceStandards.male.ohp[i].ratio.toFixed(2)}×</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>Female Strength Standards</h3>
    <div class="reference-table-wrap">
      <table class="result-table standards-chart">
        <caption class="sr-only">Female strength standards by exercise and level</caption>
        <thead>
          <tr>
            <th scope="col">Level</th>
            <th scope="col">Bench Press</th>
            <th scope="col">Squat</th>
            <th scope="col">Deadlift</th>
            <th scope="col">OHP</th>
          </tr>
        </thead>
        <tbody>
          {referenceStandards.female.bench.map((row, i) => (
            <tr>
              <td>{row.label}</td>
              <td>{row.ratio.toFixed(2)}×</td>
              <td>{referenceStandards.female.squat[i].ratio.toFixed(2)}×</td>
              <td>{referenceStandards.female.deadlift[i].ratio.toFixed(2)}×</td>
              <td>{referenceStandards.female.ohp[i].ratio.toFixed(2)}×</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>

  <article class="article-section">
    <h2>Datasets and Coaching Observations</h2>
    <p>
      It is normal for strength standards to differ slightly depending on where you look. This variation exists because different systems utilize different foundational datasets. Some frameworks are built entirely on crowdsourced community logs (which can sometimes be inflated), while others are built on decades of strict clinical coaching observations and athletic testing.
    </p>
    <p>
      Your individual placement on these charts can also be affected by genetic limb proportions, training experience, equipment (like belts and knee sleeves), and whether the 1RM was measured in a commercial gym or under strict competition judging criteria.
    </p>
  </article>

  <article class="article-section">
    <h2>Applying Your Results to Your Training</h2>
    <p>
      Use your resulting level as a baseline metric to inform your programming, rather than a final rigid destination. Tracking your own progressive overload over time is universally more beneficial than comparing yourself exclusively to others.
    </p>
    <p>
      Once you know your current level, you can utilize the 
      <a href="/tools/strength/1rm-percentage-calculator/">1RM Percentage Calculator</a> 
      to structure your next training block, or use the 
      <a href="/tools/training/training-max-calculator/">Training Max Calculator</a> 
      to establish a safe, submaximal starting point for programs like 5/3/1.
    </p>
  </article>

  <article class="article-section">
    <h2>Sources &amp; Academic Reference</h2>
    <ul>
      <li>
        Rippetoe, M., & Kilgore, L. (2006). <em>Practical Programming for Strength Training</em>. (Foundational definitions of Novice to Elite lifter classifications).
      </li>
      <li>
        <a href="https://strengthlevel.com/strength-standards" target="_blank" rel="noopener noreferrer">
          Strength Level — Crowdsourced Community Strength Standards
        </a>
      </li>
      <li>
        <a href="https://www.powerlifting.sport/rules/codes/info" target="_blank" rel="noopener noreferrer">
          International Powerlifting Federation (IPF) Technical Rules
        </a>
      </li>
    </ul>
    <p style="color:var(--text-muted); font-size:0.85rem; margin-top:12px;">
      External systems are provided for comparison of methodology. RepMaths utilizes its own streamlined relative ratio reference model to ensure highly consistent, bodyweight-scaled goal setting.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentToolId="strength-standards-calculator" />

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .calc-error {
      margin: 1rem 0;
      padding: 0.85rem 1rem;
      border: 1px solid #d33;
      border-radius: 8px;
      background: rgba(255, 91, 46, 0.08);
      color: #ff9b82;
    }

    .reference-table-wrap {
      width: 100%;
      overflow-x: auto;
      margin-top: 1rem;
    }

    .standards-chart {
      margin-bottom: 1.5rem;
    }
    
    .current-level {
      font-weight: 700;
      background-color: rgba(255, 91, 46, 0.08);
      color: var(--accent);
    }
    
    .lifter-note {
      padding: 14px;
      border-left: 3px solid var(--accent);
      background: var(--surface-2);
      border-radius: 8px;
      line-height: 1.55;
      font-size: 0.95rem;
    }
  </style>

  <script define:vars={{ referenceStandards }}>
    const standards = referenceStandards;

    const exerciseNames = {
      bench: "Bench Press",
      squat: "Back Squat",
      deadlift: "Deadlift",
      ohp: "Overhead Press",
    };

    let sex = "male";
    let unit = "lb";
    const LB_PER_KG = 2.2046226218;

    const sexButtons = document.querySelectorAll("[data-sex]");
    const unitButtons = document.querySelectorAll("[data-unit]");

    const bodyweightInput = document.querySelector("#bodyweight");
    const oneRmInput = document.querySelector("#one-rm");
    const exerciseInput = document.querySelector("#exercise");
    const calculateButton = document.querySelector("#calculate");

    const resultBox = document.querySelector("#result");
    const resultLevel = document.querySelector("#result-level");
    const resultSummary = document.querySelector("#result-summary");
    const resultTableWrap = document.querySelector("#result-table-wrap");
    const nextLevel = document.querySelector("#next-level");
    const errorBox = document.querySelector("#calc-error");

    function showError(message) {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.hidden = false;
    }

    function clearError() {
      if (!errorBox) return;
      errorBox.textContent = "";
      errorBox.hidden = true;
    }

    function invalidateResult() {
      if (!resultBox) return;
      resultBox.classList.remove("show");
      setTimeout(() => { resultBox.hidden = true; }, 300);
    }

    function updateToggleButtons(buttons, activeValue, attribute) {
      buttons.forEach((button) => {
        const isActive = button.getAttribute(attribute) === activeValue;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
    }

    function updateWeightPlaceholder() {
      if (!bodyweightInput || !oneRmInput) return;
      if (unit === "kg") {
        bodyweightInput.placeholder = "e.g. 82.5";
        oneRmInput.placeholder = "e.g. 100";
      } else {
        bodyweightInput.placeholder = "e.g. 180";
        oneRmInput.placeholder = "e.g. 225";
      }
    }

    function toKg(weight) {
      return unit === "kg" ? weight : weight / LB_PER_KG;
    }

    function formatNumber(value) {
      return Number(value).toFixed(2).replace(/\.00$/, "");
    }

    function formatWeight(value) {
      let rounded;
      if (unit === "lb") {
        rounded = Math.round(value / 2.5) * 2.5;
      } else {
        rounded = Math.round(value * 2) / 2;
      }
      return `${Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1)} ${unit}`;
    }

    function getStrengthLevel(ratio, exerciseStandards) {
      let current = exerciseStandards[0];
      for (let i = 0; i < exerciseStandards.length; i += 1) {
        if (ratio >= exerciseStandards[i].ratio) {
          current = exerciseStandards[i];
        } else {
          break;
        }
      }
      return current;
    }

    function getNextLevel(currentLevel, exerciseStandards) {
      const currentIndex = exerciseStandards.findIndex(
        (item) => item.label === currentLevel.label
      );
      if (currentIndex === -1 || currentIndex >= exerciseStandards.length - 1) {
        return null;
      }
      return exerciseStandards[currentIndex + 1];
    }

    function calculateStrength() {
      clearError();

      const bodyweight = Number(bodyweightInput?.value);
      const oneRm = Number(oneRmInput?.value);
      const exercise = exerciseInput?.value;

      if (!Number.isFinite(bodyweight) || bodyweight <= 0) {
        invalidateResult();
        showError("Please enter a valid body weight.");
        return;
      }

      const bodyweightKg = toKg(bodyweight);
      if (bodyweightKg < 30 || bodyweightKg > 350) {
        invalidateResult();
        showError("Please enter a body weight between 30 and 350 kg (66-770 lbs).");
        return;
      }

      if (!Number.isFinite(oneRm) || oneRm <= 0) {
        invalidateResult();
        showError("Please enter a valid 1RM.");
        return;
      }

      if (!exercise || !standards[sex] || !standards[sex][exercise]) {
        invalidateResult();
        showError("Please select a valid exercise.");
        return;
      }

      const ratio = oneRm / bodyweight;
      const exerciseStandards = standards[sex][exercise];
      const currentLevel = getStrengthLevel(ratio, exerciseStandards);
      const next = getNextLevel(currentLevel, exerciseStandards);
      const exerciseName = exerciseNames[exercise];

      const isBelowBeginner = ratio < exerciseStandards[0].ratio;
      const levelDisplay = isBelowBeginner ? "Below Beginner" : currentLevel.label;

      if (resultLevel) {
        resultLevel.textContent = levelDisplay;
      }

      resultSummary.textContent =
        `Your relative strength is ${formatNumber(ratio)}× bodyweight. ` +
        `Your ${exerciseName} 1RM of ${formatWeight(oneRm)} falls within the ${levelDisplay} reference band.`;

      let tableHtml = `
        <table class="result-table">
          <thead>
            <tr>
              <th>Level</th>
              <th>Ratio</th>
              <th>Target ${unit.toUpperCase()}</th>
            </tr>
          </thead>
          <tbody>
      `;

      exerciseStandards.forEach((standard) => {
        const targetWeight = bodyweight * standard.ratio;
        const isCurrent = !isBelowBeginner && standard.label === currentLevel.label;
        
        tableHtml += `
          <tr class="${isCurrent ? "current-level" : ""}">
            <td>${standard.label}${isCurrent ? " (Current)" : ""}</td>
            <td>${standard.ratio.toFixed(2)}×</td>
            <td>${formatWeight(targetWeight)}</td>
          </tr>
        `;
      });
      tableHtml += `</tbody></table>`;
      resultTableWrap.innerHTML = tableHtml;

      if (isBelowBeginner) {
        const beginnerTarget = bodyweight * exerciseStandards[0].ratio;
        const diff = beginnerTarget - oneRm;
        nextLevel.innerHTML = `<strong>Next Target (Beginner):</strong> ${formatWeight(beginnerTarget)} <br/><span style="color:var(--text-muted); font-size:0.9rem;">You need approximately ${formatWeight(diff)} more to reach the Beginner benchmark.</span>`;
      } else if (next) {
        const targetWeight = bodyweight * next.ratio;
        const additionalWeight = targetWeight - oneRm;
        nextLevel.innerHTML = `<strong>Next Target (${next.label}):</strong> ${formatWeight(targetWeight)} <br/><span style="color:var(--text-muted); font-size:0.9rem;">You need approximately ${formatWeight(additionalWeight)} more to reach the next benchmark.</span>`;
      } else {
        nextLevel.innerHTML = `<strong>Elite Status Achieved.</strong><br/><span style="color:var(--text-muted); font-size:0.9rem;">You are at or above the highest reference band in this model. Outstanding work.</span>`;
      }

      resultBox.hidden = false;
      setTimeout(() => { resultBox.classList.add("show"); }, 10);
    }

    sexButtons.forEach((button) => {
      button.addEventListener("click", () => {
        sex = button.getAttribute("data-sex") || "male";
        updateToggleButtons(sexButtons, sex, "data-sex");
        invalidateResult();
        clearError();
      });
    });

    unitButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextUnit = button.getAttribute("data-unit");
        if (nextUnit !== "lb" && nextUnit !== "kg") return;

        if (bodyweightInput?.value) {
          const currentValue = Number(bodyweightInput.value);
          if (Number.isFinite(currentValue) && currentValue > 0) {
            if (unit === "lb" && nextUnit === "kg") {
              bodyweightInput.value = (currentValue / LB_PER_KG).toFixed(1);
            } else if (unit === "kg" && nextUnit === "lb") {
              bodyweightInput.value = (currentValue * LB_PER_KG).toFixed(1);
            }
          }
        }

        if (oneRmInput?.value) {
          const currentOneRm = Number(oneRmInput.value);
          if (Number.isFinite(currentOneRm) && currentOneRm > 0) {
            if (unit === "lb" && nextUnit === "kg") {
              oneRmInput.value = (currentOneRm / LB_PER_KG).toFixed(1);
            } else if (unit === "kg" && nextUnit === "lb") {
              oneRmInput.value = (currentOneRm * LB_PER_KG).toFixed(1);
            }
          }
        }

        unit = nextUnit;
        updateToggleButtons(unitButtons, unit, "data-unit");
        updateWeightPlaceholder();
        invalidateResult();
        clearError();
      });
    });

    [bodyweightInput, oneRmInput, exerciseInput].forEach(el => {
      el?.addEventListener("input", () => {
        invalidateResult();
        clearError();
      });
    });

    calculateButton?.addEventListener("click", calculateStrength);
    updateWeightPlaceholder();
  </script>
</Base>
