---
import Base from "../../../layouts/Base.astro";
import RelatedTools from "../../../components/RelatedTools.astro";

const pageUrl = "https://repmaths.com/tools/strength/strength-standards-calculator";

const breadcrumbItems = [
  { name: "Home", href: "/" },
  { name: "Strength Calculators", href: "/tools/strength" },
  { name: "Strength Standards Calculator" },
];

const referenceStandards = {
  male: {
    bench: [
      { label: "Beginner", ratio: 0.50 },
      { label: "Novice", ratio: 0.75 },
      { label: "Intermediate", ratio: 1.00 },
      { label: "Advanced", ratio: 1.25 },
      { label: "Elite", ratio: 1.50 },
    ],
    squat: [
      { label: "Beginner", ratio: 0.75 },
      { label: "Novice", ratio: 1.00 },
      { label: "Intermediate", ratio: 1.25 },
      { label: "Advanced", ratio: 1.50 },
      { label: "Elite", ratio: 1.75 },
    ],
    deadlift: [
      { label: "Beginner", ratio: 1.00 },
      { label: "Novice", ratio: 1.25 },
      { label: "Intermediate", ratio: 1.50 },
      { label: "Advanced", ratio: 1.75 },
      { label: "Elite", ratio: 2.00 },
    ],
    ohp: [
      { label: "Beginner", ratio: 0.30 },
      { label: "Novice", ratio: 0.50 },
      { label: "Intermediate", ratio: 0.65 },
      { label: "Advanced", ratio: 0.80 },
      { label: "Elite", ratio: 1.00 },
    ],
  },
  female: {
    bench: [
      { label: "Beginner", ratio: 0.30 },
      { label: "Novice", ratio: 0.50 },
      { label: "Intermediate", ratio: 0.75 },
      { label: "Advanced", ratio: 1.00 },
      { label: "Elite", ratio: 1.25 },
    ],
    squat: [
      { label: "Beginner", ratio: 0.50 },
      { label: "Novice", ratio: 0.75 },
      { label: "Intermediate", ratio: 1.00 },
      { label: "Advanced", ratio: 1.25 },
      { label: "Elite", ratio: 1.50 },
    ],
    deadlift: [
      { label: "Beginner", ratio: 0.75 },
      { label: "Novice", ratio: 1.00 },
      { label: "Intermediate", ratio: 1.25 },
      { label: "Advanced", ratio: 1.50 },
      { label: "Elite", ratio: 1.75 },
    ],
    ohp: [
      { label: "Beginner", ratio: 0.20 },
      { label: "Novice", ratio: 0.30 },
      { label: "Intermediate", ratio: 0.45 },
      { label: "Advanced", ratio: 0.60 },
      { label: "Elite", ratio: 0.75 },
    ],
  },
};

const applicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#app`,
  name: "Strength Standards Calculator",
  url: pageUrl,
  applicationCategory: "HealthApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description:
    "Free strength standards calculator for comparing bench press, squat, deadlift, and overhead press performance with bodyweight-based reference benchmarks.",
};

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Strength Standards Calculator — Bench, Squat, Deadlift & OHP",
  description:
    "Free strength standards calculator for bench press, squat, deadlift, and overhead press. Compare your 1RM with bodyweight-based reference standards in lb or kg.",
  isPartOf: {
    "@id": "https://repmaths.com/#website",
  },
  about: {
    "@type": "Thing",
    name: "Strength standards",
  },
  mainEntity: {
    "@id": `${pageUrl}#app`,
  },
};
---

<Base
  title="Strength Standards Calculator — Bench, Squat, Deadlift & OHP"
  description="Free strength standards calculator for bench press, squat, deadlift, and overhead press. Compare your 1RM with bodyweight-based reference standards in lb or kg."
  canonical={pageUrl}
  breadcrumbs={breadcrumbItems}
  schema={[applicationSchema, webpageSchema]}
>
  <section class="article-section">
    <h1>Strength Standards Calculator</h1>

    <p>
      Compare your <strong>bench press, squat, deadlift, or overhead press 1RM</strong>
      with bodyweight-based strength standards. Enter your bodyweight and lift,
      choose your sex and unit, and see your current reference level.
    </p>

    <div class="calc-card">
      <div
        class="field"
        role="group"
        aria-labelledby="sex-label"
      >
        <span id="sex-label" class="field-label">Sex</span>

        <div class="unit-toggle" role="group" aria-label="Sex">
          <button
            type="button"
            class="unit-btn active"
            data-sex="male"
            aria-pressed="true"
          >
            Male
          </button>

          <button
            type="button"
            class="unit-btn"
            data-sex="female"
            aria-pressed="false"
          >
            Female
          </button>
        </div>
      </div>

      <div
        class="field"
        role="group"
        aria-labelledby="unit-label"
      >
        <span id="unit-label" class="field-label">Weight Unit</span>

        <div class="unit-toggle" role="group" aria-label="Weight unit">
          <button
            type="button"
            class="unit-btn active"
            data-unit="lb"
            aria-pressed="true"
          >
            lb
          </button>

          <button
            type="button"
            class="unit-btn"
            data-unit="kg"
            aria-pressed="false"
          >
            kg
          </button>
        </div>
      </div>

      <div class="field">
        <label for="bodyweight">Body Weight</label>

        <input
          id="bodyweight"
          name="bodyweight"
          type="number"
          inputmode="decimal"
          min="66"
          max="660"
          step="0.1"
          placeholder="e.g. 180"
          aria-describedby="bodyweight-help"
        />

        <small id="bodyweight-help">
          Enter your current bodyweight.
        </small>
      </div>

      <div class="field">
        <label for="exercise">Exercise</label>

        <select id="exercise" name="exercise">
          <option value="bench">Bench Press</option>
          <option value="squat">Back Squat</option>
          <option value="deadlift">Deadlift</option>
          <option value="ohp">Overhead Press</option>
        </select>
      </div>

      <div class="field">
        <label for="one-rm">1RM</label>

        <input
          id="one-rm"
          name="one-rm"
          type="number"
          inputmode="decimal"
          min="1"
          step="0.1"
          placeholder="e.g. 225"
          aria-describedby="one-rm-help"
        />

        <small id="one-rm-help">
          Enter your actual or estimated one-rep max in the selected unit.
        </small>
      </div>

      <div
        id="calc-error"
        class="calc-error"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
        hidden
      ></div>

      <button
        type="button"
        id="calculate"
        class="btn-primary"
      >
        Calculate Strength Standard
      </button>

      <div
        id="result"
        class="result-box"
        hidden
        aria-live="polite"
        aria-atomic="true"
      >
        <h2>Your Strength Standard</h2>

        <p id="result-summary"></p>

        <div id="result-table-wrap"></div>

        <p id="next-level"></p>
      </div>
    </div>
  </section>

  <section class="article-section">
    <h2>What Are Strength Standards?</h2>

    <p>
      Strength standards are reference points used to compare a person's
      lifting performance with bodyweight-based benchmarks. They are commonly
      expressed as a ratio between a lift's 1RM and bodyweight.
    </p>

    <p>
      RepMaths uses separate reference models for male and female lifters and
      five descriptive levels: Beginner, Novice, Intermediate, Advanced, and
      Elite. These levels are intended as practical reference points, not
      universal rankings or population percentiles.
    </p>
  </section>

  <section class="article-section">
    <h2>Strength Standards by Bodyweight</h2>

    <p>
      Bodyweight matters because the same absolute lift represents a different
      relative strength level for people of different sizes. For example, a
      100 kg bench press represents a different bodyweight ratio for someone
      weighing 60 kg than for someone weighing 100 kg.
    </p>

    <p>
      The calculator therefore uses the formula:
    </p>

    <p>
      <strong>Relative Strength = 1RM ÷ Bodyweight</strong>
    </p>

    <p>
      Your calculated ratio is then compared with the selected exercise and
      sex-specific reference thresholds.
    </p>
  </section>

  <section class="article-section">
    <h2>Bench Press Strength Standards</h2>

    <p>
      Bench press standards describe relative pressing strength based on your
      bench press 1RM compared with bodyweight. The reference thresholds used
      by this calculator increase progressively from Beginner through Elite.
    </p>

    <p>
      Because bench press technique, equipment, range of motion, training age,
      and individual body proportions vary, the result should be treated as a
      reference point rather than a definitive assessment of strength.
    </p>
  </section>

  <section class="article-section">
    <h2>Squat Strength Standards</h2>

    <p>
      Squat standards use your back squat 1RM relative to bodyweight.
      Differences in squat depth, bar position, technique, equipment, and
      training history can affect how a lift compares with a reference value.
    </p>

    <p>
      For consistent tracking, use the same exercise variation and comparable
      technique when checking your strength over time.
    </p>
  </section>

  <section class="article-section">
    <h2>Deadlift Strength Standards</h2>

    <p>
      Deadlift standards compare your deadlift 1RM with bodyweight. Deadlift
      performance can vary considerably depending on conventional or sumo
      technique, range of motion, equipment, and individual proportions.
    </p>

    <p>
      Use the calculator primarily as a consistent reference for your own
      training rather than as a universal measurement of athletic ability.
    </p>
  </section>

  <section class="article-section">
    <h2>Overhead Press Strength Standards</h2>

    <p>
      Overhead press standards compare your strict overhead press 1RM with
      bodyweight. The lift is generally much lighter than the squat or
      deadlift, so the bodyweight ratios used for this exercise are different.
    </p>

    <p>
      Keep your exercise technique consistent when using the calculator to
      monitor progress.
    </p>
  </section>

  <section class="article-section">
    <h2>How This Strength Standards Calculator Works</h2>

    <ol>
      <li>Choose your sex.</li>
      <li>Choose pounds or kilograms.</li>
      <li>Enter your bodyweight.</li>
      <li>Select the exercise.</li>
      <li>Enter your 1RM or estimated 1RM.</li>
      <li>Calculate your bodyweight-relative strength ratio.</li>
      <li>Compare that ratio with the selected reference thresholds.</li>
    </ol>

    <p>
      The calculation itself is simple, but the reference values are
      exercise-specific. A ratio that corresponds to one level for the bench
      press does not automatically correspond to the same level for the squat,
      deadlift, or overhead press.
    </p>
  </section>

  <section class="article-section">
    <h2>Why Strength Standards Vary</h2>

    <p>
      Strength standards can differ between sources because different datasets,
      populations, definitions, exercise standards, and classification methods
      may be used.
    </p>

    <p>
      Your individual performance can also be affected by body size, limb
      proportions, technique, training experience, exercise selection,
      equipment, and how the 1RM was measured.
    </p>

    <p>
      RepMaths presents its own bodyweight-ratio reference thresholds so that
      users can make consistent comparisons within this calculator.
    </p>
  </section>

  <section class="article-section">
    <h2>1RM vs Estimated 1RM</h2>

    <p>
      A 1RM is the maximum load you can successfully lift for one repetition
      with the intended technique. An estimated 1RM can be calculated from a
      submaximal set using a rep-max formula.
    </p>

    <p>
      If your 1RM is estimated rather than directly tested, the resulting
      strength-standard level is also an estimate. Different 1RM formulas can
      produce slightly different results.
    </p>

    <p>
      For training purposes, estimated 1RM can be useful because repeatedly
      testing a true maximum is not necessary for tracking progress.
    </p>
  </section>

  <section class="article-section">
    <h2>How to Use Your Strength Standard</h2>

    <p>
      Your result is most useful when viewed alongside your training history.
      Rather than focusing only on a single classification, track your
      bodyweight, 1RM, technique, and progress over time.
    </p>

    <p>
      You can also use your result with other RepMaths tools to plan training
      loads and understand your estimated percentages.
    </p>
  </section>

  <section class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is a good strength standard?</h3>
      <p>
        There is no single universal definition of a good strength standard.
        Standards depend on the exercise, bodyweight, sex, training history,
        technique, and the reference system being used.
      </p>
    </div>

    <div class="faq-item">
      <h3>How is relative strength calculated?</h3>
      <p>
        Relative strength is calculated by dividing your 1RM by your
        bodyweight. For example, a 100 kg 1RM at a 75 kg bodyweight produces a
        ratio of 1.33.
      </p>
    </div>

    <div class="faq-item">
      <h3>Are these strength standards universal?</h3>
      <p>
        No. The RepMaths thresholds are reference values used by this
        calculator. Different strength-standard systems may use different
        thresholds or populations.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does age affect the calculation?</h3>
      <p>
        This calculator does not apply an age adjustment. It compares your
        selected 1RM and bodyweight against the exercise-specific reference
        thresholds.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can I use an estimated 1RM?</h3>
      <p>
        Yes. You can enter an estimated 1RM. Keep in mind that the accuracy of
        your strength-standard result depends on the accuracy of that estimate.
      </p>
    </div>

    <div class="faq-item">
      <h3>What exercises does the calculator support?</h3>
      <p>
        It currently supports bench press, back squat, deadlift, and overhead
        press.
      </p>
    </div>

    <div class="faq-item">
      <h3>Should I compare myself with other lifters?</h3>
      <p>
        Standards are best used as reference points. Differences in technique,
        body proportions, equipment, training history, and measurement methods
        can make direct comparisons less meaningful.
      </p>
    </div>

    <div class="faq-item">
      <h3>Are strength standards the same as powerlifting standards?</h3>
      <p>
        Not necessarily. Competition standards can include specific rules for
        technique, commands, depth, pauses, and equipment. A general
        bodyweight-ratio calculator does not replace competition rules or
        federation-specific standards.
      </p>
    </div>
  </section>

  <section class="article-section">
    <h2>Sources and Further Reading</h2>

    <p>
      Strength standards can vary between reference systems. For additional
      context, users may compare published strength-standard methodologies from
      established lifting databases such as Strength Level.
    </p>

    <p>
      RepMaths uses its own bodyweight-ratio thresholds in this calculator and
      does not claim that these thresholds represent universal population
      percentiles.
    </p>
  </section>

  <section class="article-section">
    <p>
      <strong>Disclaimer:</strong> This calculator provides general fitness
      information and reference estimates. It is not medical advice and does
      not diagnose, treat, or prevent any health condition.
    </p>
  </section>

  <RelatedTools
    currentToolId="strength-standards-calculator"
    maxItems={6}
  />
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .calc-error {
    margin: 1rem 0;
    padding: 0.85rem 1rem;
    border: 1px solid #d33;
    border-radius: 8px;
    background: #fff4f4;
    color: #8a1f1f;
  }

  .reference-table-wrap {
    width: 100%;
    overflow-x: auto;
    margin-top: 1rem;
  }

  .reference-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 420px;
  }

  .reference-table th,
  .reference-table td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid #ddd;
    text-align: left;
  }

  .reference-table th {
    font-weight: 700;
  }

  .reference-table .current-level {
    font-weight: 700;
  }
</style>

<script define:vars={{ referenceStandards }}>
  const standards = referenceStandards;

  const exerciseNames = {
    bench: "Bench Press",
    squat: "Back Squat",
    deadlift: "Deadlift",
    ohp: "Overhead Press",
  };

  let sex = "male";
  let unit = "lb";

  const LB_PER_KG = 2.20462;

  const sexButtons = document.querySelectorAll("[data-sex]");
  const unitButtons = document.querySelectorAll("[data-unit]");

  const bodyweightInput = document.querySelector("#bodyweight");
  const oneRmInput = document.querySelector("#one-rm");
  const exerciseInput = document.querySelector("#exercise");
  const calculateButton = document.querySelector("#calculate");

  const resultBox = document.querySelector("#result");
  const resultSummary = document.querySelector("#result-summary");
  const resultTableWrap = document.querySelector("#result-table-wrap");
  const nextLevel = document.querySelector("#next-level");
  const errorBox = document.querySelector("#calc-error");

  function showError(message) {
    if (!errorBox) return;

    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function clearError() {
    if (!errorBox) return;

    errorBox.textContent = "";
    errorBox.hidden = true;
  }

  function invalidateResult() {
    if (!resultBox) return;

    resultBox.hidden = true;

    if (resultSummary) {
      resultSummary.textContent = "";
    }

    if (resultTableWrap) {
      resultTableWrap.innerHTML = "";
    }

    if (nextLevel) {
      nextLevel.textContent = "";
    }
  }

  function updateToggleButtons(buttons, activeValue, attribute) {
    buttons.forEach((button) => {
      const isActive = button.getAttribute(attribute) === activeValue;

      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
  }

  function updateWeightLimits() {
    if (!bodyweightInput) return;

    if (unit === "kg") {
      bodyweightInput.min = "30";
      bodyweightInput.max = "300";
      bodyweightInput.step = "0.1";
      bodyweightInput.placeholder = "e.g. 82.5";
    } else {
      bodyweightInput.min = "66";
      bodyweightInput.max = "660";
      bodyweightInput.step = "0.1";
      bodyweightInput.placeholder = "e.g. 180";
    }
  }

  function toKg(weight) {
    return unit === "kg" ? weight : weight / LB_PER_KG;
  }

  function formatNumber(value) {
    return Number(value).toFixed(2).replace(/\.00$/, "");
  }

  function formatWeight(value) {
    if (unit === "kg") {
      return `${formatNumber(value)} kg`;
    }

    return `${formatNumber(value)} lb`;
  }

  function getStrengthLevel(ratio, exerciseStandards) {
    let current = exerciseStandards[0];

    for (let i = 0; i < exerciseStandards.length; i += 1) {
      if (ratio >= exerciseStandards[i].ratio) {
        current = exerciseStandards[i];
      } else {
        break;
      }
    }

    return current;
  }

  function getNextLevel(currentLevel, exerciseStandards) {
    const currentIndex = exerciseStandards.findIndex(
      (item) => item.label === currentLevel.label
    );

    if (currentIndex === -1 || currentIndex >= exerciseStandards.length - 1) {
      return null;
    }

    return exerciseStandards[currentIndex + 1];
  }

  function calculateStrength() {
    clearError();

    const bodyweight = Number(bodyweightInput?.value);
    const oneRm = Number(oneRmInput?.value);
    const exercise = exerciseInput?.value;

    if (!Number.isFinite(bodyweight) || bodyweight <= 0) {
      invalidateResult();
      showError("Please enter a valid bodyweight.");
      bodyweightInput?.focus();
      return;
    }

    const bodyweightKg = toKg(bodyweight);

    if (bodyweightKg < 30 || bodyweightKg > 300) {
      invalidateResult();
      showError("Please enter a bodyweight between 30 and 300 kg.");
      bodyweightInput?.focus();
      return;
    }

    if (!Number.isFinite(oneRm) || oneRm <= 0) {
      invalidateResult();
      showError("Please enter a valid 1RM.");
      oneRmInput?.focus();
      return;
    }

    if (!exercise || !standards[sex] || !standards[sex][exercise]) {
      invalidateResult();
      showError("Please select a valid exercise.");
      exerciseInput?.focus();
      return;
    }

    const ratio = oneRm / bodyweight;
    const exerciseStandards = standards[sex][exercise];

    const currentLevel = getStrengthLevel(
      ratio,
      exerciseStandards
    );

    const next = getNextLevel(
      currentLevel,
      exerciseStandards
    );

    const exerciseName = exerciseNames[exercise];

    resultSummary.textContent =
      `Your ${exerciseName} 1RM is ${formatWeight(oneRm)}, ` +
      `which is ${formatNumber(ratio)}× your bodyweight. ` +
      `Your current RepMaths reference level is ${currentLevel.label}.`;

    let tableHtml = `
      <div class="reference-table-wrap">
        <table class="reference-table">
          <caption class="sr-only">
            ${exerciseName} strength standards
          </caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Bodyweight Ratio</th>
              <th scope="col">Target ${unit.toUpperCase()}</th>
            </tr>
          </thead>
          <tbody>
    `;

    exerciseStandards.forEach((standard) => {
      const targetWeight = bodyweight * standard.ratio;
      const isCurrent = standard.label === currentLevel.label;

      tableHtml += `
        <tr class="${isCurrent ? "current-level" : ""}">
          <td>${standard.label}${isCurrent ? " — Current" : ""}</td>
          <td>${standard.ratio.toFixed(2)}×</td>
          <td>${formatWeight(targetWeight)}</td>
        </tr>
      `;
    });

    tableHtml += `
          </tbody>
        </table>
      </div>
    `;

    resultTableWrap.innerHTML = tableHtml;

    if (next) {
      const targetWeight = bodyweight * next.ratio;
      const additionalWeight = targetWeight - oneRm;

      if (additionalWeight > 0) {
        nextLevel.textContent =
          `The next reference level is ${next.label} at ` +
          `${next.ratio.toFixed(2)}× bodyweight, or approximately ` +
          `${formatWeight(targetWeight)}. ` +
          `That is about ${formatWeight(additionalWeight)} above your current 1RM.`;
      } else {
        nextLevel.textContent =
          `The next reference level is ${next.label} at ` +
          `${next.ratio.toFixed(2)}× bodyweight.`;
      }
    } else {
      nextLevel.textContent =
        "Your result reaches the highest reference level used by this calculator.";
    }

    resultBox.hidden = false;
    resultBox.classList.add("show");
  }

  sexButtons.forEach((button) => {
    button.addEventListener("click", () => {
      sex = button.getAttribute("data-sex") || "male";

      updateToggleButtons(
        sexButtons,
        sex,
        "data-sex"
      );

      invalidateResult();
      clearError();
    });
  });

  unitButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const nextUnit = button.getAttribute("data-unit");

      if (nextUnit !== "lb" && nextUnit !== "kg") {
        return;
      }

      if (bodyweightInput?.value) {
        const currentValue = Number(bodyweightInput.value);

        if (Number.isFinite(currentValue) && currentValue > 0) {
          if (unit === "lb" && nextUnit === "kg") {
            bodyweightInput.value = (
              currentValue / LB_PER_KG
            ).toFixed(1);
          } else if (unit === "kg" && nextUnit === "lb") {
            bodyweightInput.value = (
              currentValue * LB_PER_KG
            ).toFixed(1);
          }
        }
      }

      if (oneRmInput?.value) {
        const currentOneRm = Number(oneRmInput.value);

        if (Number.isFinite(currentOneRm) && currentOneRm > 0) {
          if (unit === "lb" && nextUnit === "kg") {
            oneRmInput.value = (
              currentOneRm / LB_PER_KG
            ).toFixed(1);
          } else if (unit === "kg" && nextUnit === "lb") {
            oneRmInput.value = (
              currentOneRm * LB_PER_KG
            ).toFixed(1);
          }
        }
      }

      unit = nextUnit;

      updateToggleButtons(
        unitButtons,
        unit,
        "data-unit"
      );

      updateWeightLimits();
      invalidateResult();
      clearError();
    });
  });

  bodyweightInput?.addEventListener("input", () => {
    invalidateResult();
    clearError();
  });

  oneRmInput?.addEventListener("input", () => {
    invalidateResult();
    clearError();
  });

  exerciseInput?.addEventListener("change", () => {
    invalidateResult();
    clearError();
  });

  calculateButton?.addEventListener("click", calculateStrength);

  updateWeightLimits();
</script>
