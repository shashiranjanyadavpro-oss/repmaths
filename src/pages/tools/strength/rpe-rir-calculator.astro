---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="RPE & RIR Calculator — Estimate Your Daily e1RM"
  description="Free RPE and RIR calculator. Convert a completed set into an estimated one-rep max using the validated RTS RPE chart, and see your weight at any target RPE."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "RPE & RIR Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that converts a completed set's weight, reps, and RPE into an estimated one-rep max using the RTS RPE-to-percentage chart."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between RPE and RIR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "RPE (Rate of Perceived Exertion) rates effort on a scale of roughly 6 to 10, while RIR (Reps in Reserve) counts how many more reps you could have done before failure. They're directly linked: RPE 8 means 2 reps in reserve, RPE 9 means 1 rep in reserve, and RPE 10 means 0 reps in reserve, or absolute failure."
        }
      },
      {
        "@type": "Question",
        "name": "Why use RPE instead of traditional percentage-based training?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Percentage-based training uses a fixed 1RM that doesn't account for daily fluctuations in fatigue, stress, nutrition, or sleep. RPE auto-regulates your training by matching the weight to what you're actually capable of on that specific day, reducing injury risk while still providing the intended training stimulus."
        }
      },
      {
        "@type": "Question",
        "name": "How do you calculate estimated 1RM (e1RM) from an RPE set?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This calculator matches your completed reps and RPE to the validated RTS (Reactive Training Systems) percentage chart. For example, 5 reps at RPE 8 corresponds to roughly 81% of your 1RM. Dividing the weight you lifted by that percentage gives your estimated one-rep max for the day."
        }
      },
      {
        "@type": "Question",
        "name": "Are RPE and RIR accurate for high-rep sets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "RPE and RIR are most accurate for heavy, low-to-moderate rep ranges of roughly 1 to 8 reps. Above 10 reps, RPE becomes harder to gauge accurately because lactic acid buildup and cardiovascular fatigue cloud a lifter's perception of true muscular failure."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>RPE &amp; RIR Calculator</h1>
    <p>Turn a completed set's weight, reps, and RPE into your estimated one-rep max for today.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input type="number" id="weight" placeholder="e.g. 225" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed (1-10)</label>
      <input type="number" id="reps" placeholder="e.g. 5" inputmode="numeric" min="1" max="10" />
    </div>
    <div class="field">
      <label for="rpe">RPE of That Set</label>
      <select id="rpe">
        <option value="10">RPE 10 (0 RIR — failure)</option>
        <option value="9.5">RPE 9.5 (0-1 RIR)</option>
        <option value="9" selected>RPE 9 (1 RIR)</option>
        <option value="8.5">RPE 8.5 (1-2 RIR)</option>
        <option value="8">RPE 8 (2 RIR)</option>
        <option value="7.5">RPE 7.5 (2-3 RIR)</option>
        <option value="7">RPE 7 (3 RIR)</option>
        <option value="6.5">RPE 6.5 (3-4 RIR)</option>
        <option value="6">RPE 6 (4 RIR)</option>
      </select>
    </div>
    <button class="btn-primary" id="calc-btn">Calculate e1RM</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-e1rm">–</div>
      <div class="label">Estimated 1RM (e1RM) for Today</div>
      <table class="result-table" id="result-table">
        <thead>
          <tr><th>Target RPE</th><th>Weight (5 reps)</th></tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is RPE and RIR?</h2>
    <p>
      RPE (Rate of Perceived Exertion) rates how hard a set felt on a scale
      of roughly 6 to 10. RIR (Reps in Reserve) is the same concept from the
      other direction — how many more reps you could have done. The two are
      directly linked: RPE 8 means 2 reps in reserve, RPE 9 means 1 rep in
      reserve, and RPE 10 means 0 reps in reserve, or absolute muscular
      failure.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Use RPE Instead of Fixed Percentages?</h2>
    <p>
      Traditional percentage-based training locks your working weight to a
      fixed 1RM that doesn't account for daily fluctuations in fatigue,
      stress, nutrition, or sleep. RPE auto-regulates your training instead
      — matching the weight to what you're actually capable of that day.
      This reduces injury risk on bad days and can push slightly harder on
      good days, all while targeting the same intended training stimulus.
    </p>
  </article>

  <article class="article-section">
    <h2>How This Calculator Works</h2>
    <p>
      This tool uses the validated RTS (Reactive Training Systems) RPE
      chart — the same chart popularized by Mike Tuchscherer and widely used
      in powerlifting — rather than a generic formula. Your reps and RPE are
      matched to the chart's corresponding percentage of 1RM, then your
      lifted weight is divided by that percentage to estimate your e1RM for
      today. Because it's chart-based, this is more precise than linear
      formulas like Epley for the RPE 6-10 range, especially at low reps.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is the difference between RPE and RIR?</h3>
      <p>RPE rates effort (6-10 scale); RIR counts reps left in the tank. RPE 8 = 2 RIR, RPE 9 = 1 RIR, RPE 10 = 0 RIR.</p>
    </div>
    <div class="faq-item">
      <h3>Why use RPE instead of fixed percentages?</h3>
      <p>RPE auto-regulates for daily fatigue, sleep, and stress, unlike a fixed 1RM percentage that ignores how you actually feel that day.</p>
    </div>
    <div class="faq-item">
      <h3>How do you calculate e1RM from an RPE set?</h3>
      <p>Match your reps and RPE to the RTS chart's percentage, then divide your lifted weight by that percentage.</p>
    </div>
    <div class="faq-item">
      <h3>Are RPE and RIR accurate for high-rep sets?</h3>
      <p>They're most accurate for 1-8 reps. Above 10 reps, fatigue and burning sensations make true failure harder to judge.</p>
    </div>
  </article>

  <RelatedTools currentToolId="rpe-rir-calculator" />

  <script>
    let unit = "lb";

    // RTS/Tuchscherer chart: percentage of 1RM by [RPE][reps 1-10]
    const rpeChart: Record<string, number[]> = {
      "10":  [100, 95.5, 92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9],
      "9.5": [97.8, 93.9, 90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8],
      "9":   [95.5, 92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7],
      "8.5": [93.9, 90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7],
      "8":   [92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4],
      "7.5": [90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7, 68.5],
      "7":   [89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4, 67.4],
      "6.5": [87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7, 68.5, 66.4],
      "6":   [86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4, 67.4, 65.3],
    };

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const weightInput = document.getElementById("weight") as HTMLInputElement | null;
    const repsInput = document.getElementById("reps") as HTMLInputElement | null;
    const rpeSelect = document.getElementById("rpe") as HTMLSelectElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const resultE1RM = document.getElementById("result-e1rm");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) unitLb.addEventListener("click", () => setUnit("lb"));
    if (unitKg) unitKg.addEventListener("click", () => setUnit("kg"));

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;
      if (weightInput) {
        const currentVal = parseFloat(weightInput.value);
        if (currentVal) {
          weightInput.value = newUnit === "kg"
            ? (currentVal / 2.20462).toFixed(1)
            : (currentVal * 2.20462).toFixed(1);
        }
      }
      unit = newUnit;
      if (unitLb) { unitLb.classList.toggle("active", unit === "lb"); unitLb.setAttribute("aria-pressed", String(unit === "lb")); }
      if (unitKg) { unitKg.classList.toggle("active", unit === "kg"); unitKg.setAttribute("aria-pressed", String(unit === "kg")); }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput || !rpeSelect) return;

        const weight = parseFloat(weightInput.value);
        let reps = parseInt(repsInput.value, 10);
        const rpe = rpeSelect.value;

        if (!weight || !reps || weight <= 0 || reps <= 0) {
          alert("Please enter a valid weight and rep count.");
          return;
        }
        if (reps > 10) { reps = 10; repsInput.value = "10"; }

        const pct = rpeChart[rpe][reps - 1] / 100;
        const e1rm = weight / pct;
        const rounded = Math.round(e1rm * 10) / 10;

        if (resultE1RM) resultE1RM.textContent = `${rounded} ${unit}`;

        const targetRPEs = ["10", "9", "8", "7", "6"];
        const rows = targetRPEs.map(r => {
          const p = rpeChart[r][4] / 100; // 5-rep column
          const w = Math.round(rounded * p * 10) / 10;
          return `<tr><td>RPE ${r}</td><td>${w} ${unit}</td></tr>`;
        }).join("");

        if (resultTableBody) resultTableBody.innerHTML = rows;
        if (resultBox) resultBox.classList.add("show");
      });
    }
  </script>
</Base>
