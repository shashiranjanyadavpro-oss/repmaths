---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Overhead Press 1RM Calculator — Estimate Your Pressing Strength"
  description="Free overhead press 1RM calculator. Estimate your strict press one-rep max using Epley, Brzycki, Lander, or Lombardi formulas from a submaximal set."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Overhead Press 1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free online overhead press calculator that estimates a lifter's one-rep max (1RM) from a submaximal set to support strength programming."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate my overhead press 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Enter a manageable overhead press weight and the number of completed reps into the calculator. The selected 1RM formula estimates the weight you may be able to lift for one repetition."
        }
      },
      {
        "@type": "Question",
        "name": "Which formula is best for overhead press 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epley, Brzycki, Lander, and Lombardi are commonly used 1RM prediction equations. Different formulas can produce different estimates, so the result should be treated as an estimate rather than a guaranteed maximum."
        }
      },
      {
        "@type": "Question",
        "name": "Is overhead press 1RM different from bench press 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The overhead press and bench press use different movement patterns and muscle contributions, so their 1RM values should be calculated and tracked separately."
        }
      },
      {
        "@type": "Question",
        "name": "Does technique affect my overhead press 1RM estimate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Range of motion, body position, repetition technique, fatigue, and equipment can affect performance. Using consistent technique and conditions makes comparisons over time more useful."
        }
      },
      {
        "@type": "Question",
        "name": "Does this calculator work for both men and women?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "These general 1RM prediction formulas can be used for both men and women. Individual accuracy can vary with rep range, training experience, technique, fatigue, and other factors."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Overhead Press 1RM Calculator</h1>
    <p>Estimate your strict overhead press one-rep max from a submaximal set without needing to attempt a true maximum.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="unit-lb"
          class="active"
          aria-pressed="true"
        >
          lb
        </button>

        <button
          type="button"
          id="unit-kg"
          aria-pressed="false"
        >
          kg
        </button>
      </div>
    </div>

    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="formula-epley"
          class="active"
          aria-pressed="true"
        >
          Epley
        </button>

        <button
          type="button"
          id="formula-brzycki"
          aria-pressed="false"
        >
          Brzycki
        </button>

        <button
          type="button"
          id="formula-lander"
          aria-pressed="false"
        >
          Lander
        </button>

        <button
          type="button"
          id="formula-lombardi"
          aria-pressed="false"
        >
          Lombardi
        </button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 135"
        inputmode="decimal"
        min="0"
        step="any"
      />
    </div>

    <div class="field">
      <label for="reps">Reps Completed</label>
      <input
        type="number"
        id="reps"
        placeholder="e.g. 5"
        inputmode="numeric"
        min="1"
        step="1"
      />
    </div>

    <button
      class="btn-primary"
      id="calc-btn"
      type="button"
    >
      Calculate Overhead Press 1RM
    </button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>

      <div class="label" id="result-label">
        Estimated Overhead Press 1RM
      </div>

      <table class="result-table" id="result-table">
        <thead>
          <tr>
            <th>% of 1RM</th>
            <th>Weight</th>
          </tr>
        </thead>

        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>Why Estimate Your Overhead Press 1RM?</h2>

    <p>
      The barbell overhead press is a fundamental upper-body strength
      exercise involving the shoulders, triceps, upper chest, and trunk
      muscles. Testing a true one-rep max can be demanding and is not
      necessary for every training program.
    </p>

    <p>
      An overhead press 1RM calculator lets you estimate your maximum
      strength from a submaximal set instead. This gives you a useful
      reference for programming and comparing training loads without
      requiring a true maximum attempt.
    </p>

    <p>
      For a broader estimate, use the
      <a href="/tools/strength/1rm-calculator">1RM Calculator</a>.
      To convert your performance to another target rep range, use the
      <a href="/tools/strength/rep-max-calculator">Rep Max Calculator</a>.
      You can also convert your estimated 1RM into percentage-based
      training loads with the
      <a href="/tools/strength/1rm-percentage-calculator">1RM Percentage Calculator</a>.
      For another upper-body compound lift, compare your result with the
      <a href="/tools/strength/bench-press-1rm-calculator">Bench Press 1RM Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>

    <p>
      Enter the weight you lifted for a clean, controlled overhead press
      set and the number of completed repetitions. Choose your preferred
      formula and unit, then calculate your estimated 1RM.
    </p>

    <p>
      For more consistent estimates, use a set performed with the same
      general technique, range of motion, equipment, and lifting conditions
      when comparing results over time. Lower-rep sets can also reduce the
      influence of fatigue on the estimate.
    </p>
  </article>

  <article class="article-section">
    <h2>Overhead Press Percentage Chart &amp; Training Zones</h2>

    <p>
      Once you have an estimated overhead press 1RM, percentages can help
      organize training loads around different goals. The relationship
      between percentage of 1RM and achievable reps varies between lifters
      and training days, so these ranges should be treated as planning
      guides rather than fixed rules.
    </p>

    <ul>
      <li>
        <strong>90%–100% (1–3 reps):</strong>
        <em>Heavy strength work.</em>
        Often used for heavier pressing practice or preparation for a
        strength test. Technique, setup, and appropriate safety measures
        remain important.
      </li>

      <li>
        <strong>80%–85% (4–6 reps):</strong>
        <em>Strength development.</em>
        A commonly used moderate-to-heavy loading zone for strength-focused
        overhead press training.
      </li>

      <li>
        <strong>70%–75% (8–12 reps):</strong>
        <em>Moderate-load training.</em>
        Can be useful for accumulating pressing volume when appropriate for
        the lifter and program.
      </li>

      <li>
        <strong>60%–65% (12–20 reps):</strong>
        <em>Higher-repetition work.</em>
        Lighter loads can be used for higher-repetition pressing when
        technique and recovery remain consistent.
      </li>
    </ul>
  </article>

  <article class="article-section">
    <h2>Overhead Press 1RM Math: How the Formulas Differ</h2>

    <p>
      Overhead press performance can vary with technique, range of motion,
      fatigue, training experience, and rep count. Here is how each formula
      estimates your overhead press 1RM:
    </p>

    <h3>1. Epley Formula</h3>

    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A widely used 1RM prediction equation that models the relationship
      between weight and repetitions in a simple linear form.
      <strong>Best for:</strong> comparing lower-rep overhead press sets.
    </p>

    <h3>2. Brzycki Formula</h3>

    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      A commonly used 1RM prediction equation. It is mathematically defined
      for integer rep counts from 1 through 36 and becomes undefined at
      37 reps.
      <strong>Best for:</strong> heavier low-rep sets.
    </p>

    <h3>3. Lander Formula</h3>

    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      Another commonly used 1RM prediction equation. It is mathematically
      defined for integer rep counts from 1 through 37, while prediction
      reliability can vary as rep count increases.
      <strong>Best for:</strong> comparing estimates from moderate-rep sets.
    </p>

    <h3>4. Lombardi Formula</h3>

    <p>
      <code>1RM = Weight × Reps^0.10</code><br />
      A non-linear prediction model without the same denominator limit as
      Brzycki or Lander. Like other prediction equations, the estimate can
      become less representative of a true 1RM as rep count increases.
      <strong>Best for:</strong> comparing estimates from higher-rep sets.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>How do I calculate my overhead press 1RM?</h3>

      <p>
        Enter a manageable overhead press weight and the number of completed
        reps. The selected formula estimates the weight you may be able to
        lift for one repetition.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which formula is best for overhead press 1RM?</h3>

      <p>
        Epley, Brzycki, Lander, and Lombardi can all be used to estimate
        1RM. Different equations may produce different results, so compare
        estimates consistently rather than treating one result as a
        guaranteed maximum.
      </p>
    </div>

    <div class="faq-item">
      <h3>Is overhead press 1RM different from bench press 1RM?</h3>

      <p>
        Yes. The overhead press and bench press use different movement
        patterns and muscle contributions, so their 1RM values should be
        calculated and tracked separately.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does technique affect my overhead press 1RM estimate?</h3>

      <p>
        Yes. Range of motion, body position, repetition technique, fatigue,
        and equipment can affect performance. Using consistent technique
        and conditions makes comparisons over time more useful.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does this calculator work for both men and women?</h3>

      <p>
        These general 1RM prediction formulas can be used for both men and
        women, although individual accuracy can vary with rep range,
        training experience, technique, fatigue, and other factors.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="overhead-press-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const repsInput =
      document.getElementById("reps") as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody =
      document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    if (formEpley) {
      formEpley.addEventListener("click", () => setFormula("epley"));
    }

    if (formBrzycki) {
      formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    }

    if (formLander) {
      formLander.addEventListener("click", () => setFormula("lander"));
    }

    if (formLombardi) {
      formLombardi.addEventListener("click", () => setFormula("lombardi"));
    }

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (weightInput) {
        const currentVal = Number(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          weightInput.value =
            newUnit === "kg"
              ? (currentVal / 2.20462).toFixed(1)
              : (currentVal * 2.20462).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute(
          "aria-pressed",
          String(unit === "lb")
        );
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute(
          "aria-pressed",
          String(unit === "kg")
        );
      }
    }

    function setFormula(f: string) {
      const validFormulas = [
        "epley",
        "brzycki",
        "lander",
        "lombardi"
      ];

      if (!validFormulas.includes(f)) return;

      formula = f;

      const map: Record<string, HTMLElement | null> = {
        epley: formEpley,
        brzycki: formBrzycki,
        lander: formLander,
        lombardi: formLombardi
      };

      for (const key in map) {
        const el = map[key];

        if (el) {
          el.classList.toggle("active", f === key);
          el.setAttribute(
            "aria-pressed",
            String(f === key)
          );
        }
      }
    }

    function formulaSupportsReps(reps: number): boolean {
      if (!Number.isInteger(reps) || reps < 1) {
        return false;
      }

      if (formula === "brzycki") {
        return 37 - reps > 0;
      }

      if (formula === "lander") {
        return 101.3 - 2.67123 * reps > 0;
      }

      return true;
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    function showError(message: string) {
      if (resultBox) {
        resultBox.classList.add("show");
      }

      if (result1rm) {
        result1rm.textContent = "—";
      }

      if (resultLabel) {
        resultLabel.textContent = message;
      }

      if (resultTableBody) {
        resultTableBody.innerHTML = "";
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = Number(weightInput.value);
        const reps = Number(repsInput.value);

        if (
          !Number.isFinite(weight) ||
          weight <= 0 ||
          !Number.isInteger(reps) ||
          reps < 1
        ) {
          showError(
            "Please enter a valid weight and whole-number rep count."
          );
          return;
        }

        if (!formulaSupportsReps(reps)) {
          if (formula === "brzycki") {
            showError(
              "The Brzycki formula is only defined for 1–36 reps. Try Epley or Lombardi for this rep count."
            );
          } else if (formula === "lander") {
            showError(
              "The Lander formula is only defined for 1–37 reps. Try Epley or Lombardi for this rep count."
            );
          } else {
            showError(
              "Please enter a valid rep count for the selected formula."
            );
          }

          return;
        }

        let oneRM = 0;

        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM =
            weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM =
            weight * 36 / (37 - reps);
        } else if (formula === "lander") {
          oneRM =
            (100 * weight) /
            (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM =
            weight * Math.pow(reps, 0.10);
        }

        if (!Number.isFinite(oneRM) || oneRM <= 0) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        const rounded =
          Math.round(oneRM * 10) / 10;

        if (
          !Number.isFinite(rounded) ||
          rounded <= 0
        ) {
          showError(
            "Unable to calculate a valid estimate from these inputs."
          );
          return;
        }

        if (result1rm) {
          result1rm.textContent =
            `${rounded} ${unit}`;
        }

        if (resultLabel) {
          resultLabel.textContent =
            `Estimated Overhead Press 1RM (${formulaLabel(formula)} formula)`;
        }

        const percentages = [
          95,
          90,
          85,
          80,
          75,
          70,
          65,
          60
        ];

        const rows = percentages
          .map((p) => {
            const val =
              Math.round(
                rounded * (p / 100) * 10
              ) / 10;

            return `
              <tr>
                <td>${p}%</td>
                <td>${val} ${unit}</td>
              </tr>
            `;
          })
          .join("");

        if (resultTableBody) {
          resultTableBody.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
