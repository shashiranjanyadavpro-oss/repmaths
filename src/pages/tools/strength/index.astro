---
import Base from '../../layouts/Base.astro';
import toolsData from '../../data/tools.json';
const tools = toolsData.filter((t) => t.cluster === "strength");
---

<Base
  title="Strength & 1RM Calculators | RepMaths"
  description="Free strength calculators: 1RM estimators for bench, squat, deadlift, overhead press, rep max, 1RM percentages, and strength standards."
  breadcrumbs={[{ "name": "Home", "href": "/" }, { "name": "Tools", "href": "/tools/" }, { "name": "Strength & 1RM Calculators" }]}
>
  <section class="hero">
    <h1>Strength & 1RM Calculators</h1>
    <p>Estimate maxes and plan percentage-based training.</p>
  </section>

  <div class="tool-grid">
    {tools.map((tool) => (
      <a class="tool-card" href={tool.url}>
        <span class="icon" aria-hidden="true">{tool.icon}</span>
        <span class="name">{tool.name}</span>
        <span class="desc">{tool.shortDesc}</span>
      </a>
    ))}
  </div>

  <style>
    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin: 24px 0 40px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
    }
  </style>
</Base>
