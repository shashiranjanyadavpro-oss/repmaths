---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Bench Press 1RM Calculator — Max Bench Press Estimator"
  description="Free bench press 1RM calculator using the Epley and Brzycki formulas. Enter your weight and reps to estimate your max bench press."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Bench Press 1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that estimates a lifter's one-rep max bench press from a submaximal weight and rep count."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is this bench press 1RM calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It is typically accurate within 5-10% for sets of 1 to 10 reps. Bar speed, fatigue, and technique can all affect the real number, so treat the result as a strong estimate rather than an exact figure."
        }
      },
      {
        "@type": "Question",
        "name": "What is a good bench press 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This depends heavily on bodyweight, sex, and training experience. Rather than comparing to general standards, most lifters get more value from tracking their own estimated 1RM over time."
        }
      },
      {
        "@type": "Question",
        "name": "Should I test my actual bench press max instead of estimating it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Only with a spotter, a proper warm-up, and good technique. Most lifters get more practical value from an estimated 1RM, which is safer and still accurate enough to plan training percentages."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Bench Press 1RM Calculator</h1>
    <p>Enter the weight and reps you benched to estimate your max bench press.</p>
  </section>

  <section class="ad-slot">Ad Slot (Top)</section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active">lb</button>
        <button type="button" id="unit-kg">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active">Epley</button>
        <button type="button" id="formula-brzycki">Brzycki</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Benched</label>
      <input type="number" id="weight" placeholder="e.g. 135" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed</label>
      <input type="number" id="reps" placeholder="e.g. 8" inputmode="numeric" />
    </div>
    <button class="btn-primary" id="calc-btn">Calculate Max Bench</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated Max Bench Press</div>
      <table class="result-table" id="result-table"></table>
    </div>
  </section>

  <section class="ad-slot">Ad Slot (Bottom)</section>

  <article class="article-section">
    <h2>How This Calculator Works</h2>
    <p>
      This tool estimates your one-rep max bench press using two established
      formulas: <strong>Epley</strong> (1RM = weight × (1 + reps ÷ 30)) and
      <strong>Brzycki</strong> (1RM = weight × 36 ÷ (37 − reps)). Both work
      best for sets of 1 to 10 reps performed close to failure with good
      form. The bench press responds particularly well to these formulas
      since bar speed stays fairly consistent across reps compared to lifts
      like the deadlift.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the heaviest weight you benched for a clean set, along with the
      number of reps completed. Choose your preferred formula and unit, then
      calculate. The result table shows common training percentages so you
      can plan your next bench session's working weights directly.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How accurate is this bench press 1RM calculator?</h3>
      <p>Typically accurate within 5-10% for sets of 1-10 reps. Bar speed and fatigue can affect the real number.</p>
    </div>
    <div class="faq-item">
      <h3>What is a good bench press 1RM?</h3>
      <p>It depends on bodyweight, sex, and experience — tracking your own progress matters more than comparing to others.</p>
    </div>
    <div class="faq-item">
      <h3>Should I test my actual max instead?</h3>
      <p>Only with a spotter and proper warm-up. An estimate is safer and usually accurate enough for training purposes.</p>
    </div>
  </article>

  <RelatedTools currentToolId="bench-press-1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    document.getElementById("unit-lb")!.addEventListener("click", () => setUnit("lb"));
    document.getElementById("unit-kg")!.addEventListener("click", () => setUnit("kg"));
    document.getElementById("formula-epley")!.addEventListener("click", () => setFormula("epley"));
    document.getElementById("formula-brzycki")!.addEventListener("click", () => setFormula("brzycki"));

    function setUnit(u: string) {
      unit = u;
      document.getElementById("unit-lb")!.classList.toggle("active", u === "lb");
      document.getElementById("unit-kg")!.classList.toggle("active", u === "kg");
    }
    function setFormula(f: string) {
      formula = f;
      document.getElementById("formula-epley")!.classList.toggle("active", f === "epley");
      document.getElementById("formula-brzycki")!.classList.toggle("active", f === "brzycki");
    }

    document.getElementById("calc-btn")!.addEventListener("click", () => {
      const weight = parseFloat((document.getElementById("weight") as HTMLInputElement).value);
      const reps = parseInt((document.getElementById("reps") as HTMLInputElement).value, 10);
      if (!weight || !reps || weight <= 0 || reps <= 0) {
        alert("Please enter a valid weight and rep count.");
        return;
      }

      let oneRM: number;
      if (reps === 1) {
        oneRM = weight;
      } else if (formula === "epley") {
        oneRM = weight * (1 + reps / 30);
      } else {
        oneRM = weight * 36 / (37 - reps);
      }

      const rounded = Math.round(oneRM * 10) / 10;
      const formulaName = formula === "epley" ? "Epley" : "Brzycki";
      document.getElementById("result-1rm")!.textContent = `${rounded} ${unit}`;
      document.getElementById("result-label")!.textContent = `Estimated Max Bench Press (${formulaName} formula)`;

      const percentages = [95, 90, 85, 80, 75, 70, 65, 60];
      const rows = percentages.map(p => {
        const val = Math.round(rounded * (p / 100) * 10) / 10;
        return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
      }).join("");
      document.getElementById("result-table")!.innerHTML = rows;
      document.getElementById("result-box")!.classList.add("show");
    });
  </script>
</Base>
