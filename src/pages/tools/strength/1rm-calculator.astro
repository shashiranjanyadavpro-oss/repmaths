---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="1RM Calculator — Calculate Your One Rep Max Instantly"
  description="Free 1RM calculator using the Epley and Brzycki formulas. Enter your weight and reps to estimate your one-rep max for squat, bench, or deadlift."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that estimates a lifter's one-rep max (1RM) from a submaximal weight and rep count."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a 1RM calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A 1RM calculator estimates the maximum weight you could lift for a single repetition, based on a lighter weight you lifted for multiple reps. It uses formulas like Epley or Brzycki to predict this number without requiring you to actually test a true max."
        }
      },
      {
        "@type": "Question",
        "name": "How accurate is a 1RM calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "1RM calculators are typically accurate within 5-10% for sets of 1 to 10 reps. Accuracy decreases for higher rep ranges because rep-max formulas are calibrated on lower rep counts."
        }
      },
      {
        "@type": "Question",
        "name": "Which 1RM formula is most accurate: Epley or Brzycki?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epley tends to estimate slightly higher for sets above 5 reps, while Brzycki is often considered more precise for sets under 10 reps. Most lifters use Epley as a simple, reliable default."
        }
      },
      {
        "@type": "Question",
        "name": "Should I test my true 1RM instead of estimating it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Testing a true 1RM carries injury risk, especially without a spotter or coach. Most lifters only need an estimated 1RM to calculate training percentages, making a calculator the safer choice for regular programming."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>1RM Calculator</h1>
    <p>Enter the weight and reps you just lifted to estimate your one-rep max.</p>
  </section>

  <section class="ad-slot">Ad Slot (Top)</section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active">lb</button>
        <button type="button" id="unit-kg">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active">Epley</button>
        <button type="button" id="formula-brzycki">Brzycki</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input type="number" id="weight" placeholder="e.g. 185" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed</label>
      <input type="number" id="reps" placeholder="e.g. 5" inputmode="numeric" />
    </div>
    <button class="btn-primary" id="calc-btn">Calculate 1RM</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated One-Rep Max</div>
      <table class="result-table" id="result-table"></table>
    </div>
  </section>

  <section class="ad-slot">Ad Slot (Bottom)</section>

  <article class="article-section">
    <h2>What Is a 1RM Calculator?</h2>
    <p>
      Your one-rep max (1RM) is the heaviest weight you can lift for a single
      full repetition of an exercise with correct form. Testing it directly is
      risky and fatiguing, so most lifters and coaches estimate it instead using
      a rep-max formula. This calculator supports two of the most widely used
      formulas:
    </p>
    <p>
      <strong>Epley formula:</strong> 1RM = weight × (1 + reps ÷ 30)<br />
      <strong>Brzycki formula:</strong> 1RM = weight × 36 ÷ (37 − reps)
    </p>
    <p>
      Both formulas assume a fairly direct relationship between the weight you
      move and how many clean reps you can complete with it. They work best for
      sets of 1 to 10 reps on compound barbell lifts such as the squat, bench
      press, and deadlift.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the heaviest weight you lifted for a clean set, along with how many
      reps you completed before reaching failure. For the most reliable
      estimate, use a set of 10 reps or fewer — accuracy drops for higher-rep
      sets. The calculator also shows common training percentages (70%, 85%,
      and more) so you can plan your next session's working weights directly
      from the result.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is a 1RM calculator?</h3>
      <p>It estimates the maximum weight you could lift once, based on a lighter weight lifted for multiple reps.</p>
    </div>
    <div class="faq-item">
      <h3>How accurate is a 1RM calculator?</h3>
      <p>Typically accurate within 5-10% for sets of 1-10 reps. Accuracy drops for higher rep counts.</p>
    </div>
    <div class="faq-item">
      <h3>Which formula is most accurate: Epley or Brzycki?</h3>
      <p>Epley runs slightly higher above 5 reps; Brzycki is often more precise under 10 reps.</p>
    </div>
    <div class="faq-item">
      <h3>Should I test my true 1RM instead?</h3>
      <p>Only with a spotter and proper warm-up — most lifters get more value from an estimate for planning training percentages.</p>
    </div>
  </article>

  <RelatedTools currentToolId="1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    document.getElementById("unit-lb")!.addEventListener("click", () => setUnit("lb"));
    document.getElementById("unit-kg")!.addEventListener("click", () => setUnit("kg"));
    document.getElementById("formula-epley")!.addEventListener("click", () => setFormula("epley"));
    document.getElementById("formula-brzycki")!.addEventListener("click", () => setFormula("brzycki"));

    function setUnit(u: string) {
      unit = u;
      document.getElementById("unit-lb")!.classList.toggle("active", u === "lb");
      document.getElementById("unit-kg")!.classList.toggle("active", u === "kg");
    }
    function setFormula(f: string) {
      formula = f;
      document.getElementById("formula-epley")!.classList.toggle("active", f === "epley");
      document.getElementById("formula-brzycki")!.classList.toggle("active", f === "brzycki");
    }

    document.getElementById("calc-btn")!.addEventListener("click", () => {
      const weight = parseFloat((document.getElementById("weight") as HTMLInputElement).value);
      const reps = parseInt((document.getElementById("reps") as HTMLInputElement).value, 10);
      if (!weight || !reps || weight <= 0 || reps <= 0) {
        alert("Please enter a valid weight and rep count.");
        return;
      }

      let oneRM: number;
      if (reps === 1) {
        oneRM = weight;
      } else if (formula === "epley") {
        oneRM = weight * (1 + reps / 30);
      } else {
        oneRM = weight * 36 / (37 - reps);
      }

      const rounded = Math.round(oneRM * 10) / 10;
      const formulaName = formula === "epley" ? "Epley" : "Brzycki";
      document.getElementById("result-1rm")!.textContent = `${rounded} ${unit}`;
      document.getElementById("result-label")!.textContent = `Estimated One-Rep Max (${formulaName} formula)`;

      const percentages = [95, 90, 85, 80, 75, 70, 65, 60];
      const rows = percentages.map(p => {
        const val = Math.round(rounded * (p / 100) * 10) / 10;
        return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
      }).join("");
      document.getElementById("result-table")!.innerHTML = rows;
      document.getElementById("result-box")!.classList.add("show");
    });
  </script>
</Base>
