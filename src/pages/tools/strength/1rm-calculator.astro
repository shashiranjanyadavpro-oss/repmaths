---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---

<Base
  title="1RM Calculator — Calculate Your One Rep Max"
  description="Calculate your estimated one-rep max (1RM) from weight and reps using Epley, Brzycki, Lander, and Lombardi formulas. Includes a 1RM percentage chart for strength training."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free online 1RM calculator that estimates one-rep max from weight and repetitions using four established prediction formulas."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your one-rep max (1RM) is the heaviest weight you can lift for one complete repetition with proper technique. An estimated 1RM uses a submaximal weight and repetitions to predict that value."
        }
      },
      {
        "@type": "Question",
        "name": "Which 1RM formula should I use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epley and Brzycki are commonly used for lower-repetition sets. Research on bench press prediction has found Brzycki particularly accurate when the set contains 10 or fewer repetitions. Prediction accuracy can become less consistent with higher-repetition sets."
        }
      },
      {
        "@type": "Question",
        "name": "Can I calculate 1RM from more than 10 reps?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, but treat the result as a rough estimate. Research on bench press 1RM prediction shows that prediction error can increase when more than 10 repetitions are used. For the most useful estimate, a set of about 3 to 10 reps is generally preferable."
        }
      },
      {
        "@type": "Question",
        "name": "Is an estimated 1RM safer than testing a true 1RM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An estimated 1RM lets you estimate maximal strength from a submaximal set instead of attempting a true maximum lift. A true 1RM should only be tested with appropriate technique, equipment, and safety measures."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>1RM Calculator</h1>
    <p>Enter the weight and reps you just lifted to estimate your one-rep max.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active">lb</button>
        <button type="button" id="unit-kg">kg</button>
      </div>
    </div>

    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active">Epley</button>
        <button type="button" id="formula-brzycki">Brzycki</button>
        <button type="button" id="formula-lander">Lander</button>
        <button type="button" id="formula-lombardi">Lombardi</button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 185"
        inputmode="decimal"
        min="0.01"
        step="0.1"
      />
    </div>

    <div class="field">
      <label for="reps">Reps Completed (Max 36)</label>
      <input
        type="number"
        id="reps"
        placeholder="e.g. 5"
        inputmode="numeric"
        min="1"
        max="36"
        step="1"
      />
    </div>

    <button class="btn-primary" id="calc-btn">Calculate 1RM</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated One-Rep Max</div>
      <table class="result-table" id="result-table"></table>
    </div>
  </section>

  <article class="article-section">
    <h2>1RM Percentage Chart &amp; Training Zones</h2>

    <p>
      Your estimated one-rep max (1RM) gives you a reference point for
      selecting training loads. You can use percentages of your estimated
      1RM to plan working weights for different strength and hypertrophy
      goals.
    </p>

    <ul>
      <li>
        <strong>90%–100%:</strong> Very heavy strength work and 1–3 rep sets.
      </li>
      <li>
        <strong>80%–85%:</strong> Common range for strength-focused sets.
      </li>
      <li>
        <strong>70%–75%:</strong> Common range for moderate-load training
        and hypertrophy work.
      </li>
      <li>
        <strong>60%–65%:</strong> Lighter training, technique work and
        higher-repetition sets.
      </li>
    </ul>

    <p>
      These ranges are guidelines rather than fixed rules. The number of reps
      you can perform at a given percentage varies between lifters, exercises,
      and training backgrounds.
    </p>
  </article>

  <article class="article-section">
    <h2>The 4 1RM Formulas Explained</h2>

    <p>
      This calculator provides four commonly used mathematical approaches for
      estimating one-rep max from a submaximal set. Different formulas can
      produce different results from the same weight and rep count.
    </p>

    <h3>1. Epley Formula</h3>
    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A commonly used linear equation for estimating 1RM from repetitions.
      It is particularly useful as a general-purpose estimate from
      lower-repetition sets.
    </p>

    <h3>2. Brzycki Formula</h3>
    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      A commonly used repetition-to-1RM equation. Research examining bench
      press prediction found the Brzycki equation particularly accurate when
      lifters completed 10 or fewer repetitions. 1
    </p>

    <h3>3. Lander Formula</h3>
    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      Another equation used to estimate maximal strength from a submaximal
      repetition set.
    </p>

    <h3>4. Lombardi Formula</h3>
    <p>
      <code>1RM = Weight × Reps<sup>0.10</sup></code><br />
      A non-linear equation that produces a different estimate from the
      linear models as repetition count increases.
    </p>

    <p>
      <strong>Important:</strong> No prediction formula can guarantee your
      actual 1RM. Individual differences in training history, exercise
      technique, fatigue and strength-endurance can affect the result.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is a 1RM?</h3>
      <p>
        Your one-rep max is the heaviest weight you can lift for one complete
        repetition with proper technique. An estimated 1RM predicts that
        number from a lighter weight and a set of repetitions.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which 1RM formula should I use?</h3>
      <p>
        Epley and Brzycki are useful choices for lower-repetition sets.
        Research on bench press prediction found Brzycki particularly accurate
        when the set contained 10 or fewer repetitions.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can I calculate 1RM from more than 10 reps?</h3>
      <p>
        Yes, but the result should be treated as a rough estimate. Prediction
        accuracy can become less consistent as repetition count increases.
        For a practical 1RM estimate, a set of about 3 to 10 reps is generally
        more useful.
      </p>
    </div>

    <div class="faq-item">
      <h3>Is an estimated 1RM safer than testing a true 1RM?</h3>
      <p>
        Estimating your 1RM lets you use a submaximal set instead of attempting
        a true maximum lift. If you test a true 1RM, use appropriate technique,
        equipment and safety measures.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const repsInput =
      document.getElementById("reps") as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTable = document.getElementById("result-table");
    const resultBox = document.getElementById("result-box");

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;

      if (weightInput) {
        const currentVal = parseFloat(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          weightInput.value =
            newUnit === "kg"
              ? (currentVal / 2.20462).toFixed(1)
              : (currentVal * 2.20462).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
      }
    }

    function setFormula(f: string) {
      if (!["epley", "brzycki", "lander", "lombardi"].includes(f)) return;

      formula = f;

      if (formEpley) {
        formEpley.classList.toggle("active", f === "epley");
      }

      if (formBrzycki) {
        formBrzycki.classList.toggle("active", f === "brzycki");
      }

      if (formLander) {
        formLander.classList.toggle("active", f === "lander");
      }

      if (formLombardi) {
        formLombardi.classList.toggle("active", f === "lombardi");
      }
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    function showError(message: string) {
      alert(message);
    }

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    if (formEpley) {
      formEpley.addEventListener("click", () => setFormula("epley"));
    }

    if (formBrzycki) {
      formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    }

    if (formLander) {
      formLander.addEventListener("click", () => setFormula("lander"));
    }

    if (formLombardi) {
      formLombardi.addEventListener("click", () => setFormula("lombardi"));
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = parseFloat(weightInput.value);
        const reps = parseInt(repsInput.value, 10);

        if (!Number.isFinite(weight) || weight <= 0) {
          showError("Please enter a valid weight.");
          return;
        }

        if (!Number.isInteger(reps) || reps < 1 || reps > 36) {
          showError("Please enter a whole number of reps between 1 and 36.");
          return;
        }

        /*
         * Practical formula ranges:
         * Epley    - useful as a general estimate, but higher reps increase uncertainty.
         * Brzycki  - becomes mathematically unstable near 37 reps.
         * Lander   - becomes mathematically unstable at higher reps.
         * Lombardi - remains mathematically defined for higher reps but should
         *            still be treated as an estimate.
         */

        if (formula === "brzycki" && reps >= 11) {
          showError(
            "Brzycki is best used with lower-repetition sets. For 11+ reps, choose Epley, Lander, or Lombardi."
          );
          return;
        }

        if (formula === "lander" && reps >= 36) {
          showError(
            "The Lander formula becomes unstable at very high repetitions. Please use Epley or Lombardi for this rep range."
          );
          return;
        }

        let oneRM = 0;

        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM = weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM = (weight * 36) / (37 - reps);
        } else if (formula === "lander") {
          oneRM = (100 * weight) / (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM = weight * Math.pow(reps, 0.10);
        }

        if (!Number.isFinite(oneRM) || oneRM <= 0) {
          showError(
            "This combination of reps and formula cannot produce a valid 1RM estimate. Please choose another formula."
          );
          return;
        }

        const rounded = Math.round(oneRM * 10) / 10;

        if (result1rm) {
          result1rm.textContent = `${rounded} ${unit}`;
        }

        if (resultLabel) {
          resultLabel.textContent =
            `Estimated One-Rep Max (${formulaLabel(formula)} formula)`;
        }

        const percentages = [95, 90, 85, 80, 75, 70, 65, 60];

        const rows = percentages
          .map((p) => {
            const val =
              Math.round(rounded * (p / 100) * 10) / 10;

            return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
          })
          .join("");

        if (resultTable) {
          resultTable.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
