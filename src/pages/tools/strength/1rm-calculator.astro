---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="1RM Calculator — Calculate Your One Rep Max (4 Formulas)"
  description="Free 1RM calculator using Epley, Brzycki, Lander, and Lombardi formulas. Estimate your one-rep max for squat, bench, or deadlift without testing a true max."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "1RM Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that estimates a lifter's one-rep max (1RM) from a submaximal weight and rep count using the Epley, Brzycki, Lander, or Lombardi formula."
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a 1RM calculator?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A 1RM calculator estimates the maximum weight you could lift for a single repetition, based on a lighter weight you lifted for multiple reps. It uses established formulas like Epley, Brzycki, Lander, or Lombardi to predict this number without requiring you to actually test a true max."
        }
      },
      {
        "@type": "Question",
        "name": "Which 1RM formula is the most accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Different 1RM formulas can produce different estimates, especially as rep count increases. Epley, Brzycki, Lander, and Lombardi use different mathematical models, so the result can vary depending on the exercise, rep count, and individual lifter. Treat any result as an estimate rather than a guaranteed maximum."
        }
      },
      {
        "@type": "Question",
        "name": "Can I calculate my 1RM using high repetitions (above 10 reps)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. A 1RM can be estimated from higher-repetition sets, but estimates may become less reliable as rep count increases. Different formulas can produce increasingly different results at higher rep counts, so high-rep calculations should be treated as estimates rather than exact maximums."
        }
      },
      {
        "@type": "Question",
        "name": "Is estimating a 1RM better than testing a true 1-rep max?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For many gym-goers and athletes, estimating a 1RM from a submaximal set can be a practical alternative to testing a true maximum. A true 1RM test involves a maximal load and should be approached with appropriate technique, preparation, and safety considerations."
        }
      },
      {
        "@type": "Question",
        "name": "Does this formula work the same for men and women?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "These formulas are general-population formulas commonly used for both men and women. Accuracy can vary with rep range, exercise, training experience, and individual characteristics, so the result should be treated as an estimate."
        }
      }
    ]
  })} />
  <section class="hero">
    <h1>1RM Calculator</h1>
    <p>Enter the weight and reps you just lifted to estimate your one-rep max.</p>
  </section>
  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button type="button" id="formula-epley" class="active" aria-pressed="true">Epley</button>
        <button type="button" id="formula-brzycki" aria-pressed="false">Brzycki</button>
        <button type="button" id="formula-lander" aria-pressed="false">Lander</button>
        <button type="button" id="formula-lombardi" aria-pressed="false">Lombardi</button>
      </div>
    </div>
    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input type="number" id="weight" placeholder="e.g. 185" inputmode="decimal" min="0" step="any" />
    </div>
    <div class="field">
      <label for="reps">Reps Completed</label>
      <input type="number" id="reps" placeholder="e.g. 5" inputmode="numeric" step="1" min="1" />
    </div>
    <button class="btn-primary" id="calc-btn">Calculate 1RM</button>
    <div class="result-box" id="result-box">
      <div class="big-number" id="result-1rm">–</div>
      <div class="label" id="result-label">Estimated One-Rep Max</div>
      <table class="result-table" id="result-table">
        <thead>
          <tr><th>% of 1RM</th><th>Weight</th></tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>
  <article class="article-section">
    <h2>What Is a 1RM Calculator?</h2>
    <p>
      Your one-rep max (1RM) is the heaviest weight you can lift for a single
      full repetition of an exercise with correct form. Testing it directly
      can be demanding and fatiguing, so many lifters and coaches estimate it
      instead using a rep-max formula — this is how to calculate your one
      rep max without testing it against a true single-rep attempt. This
      calculator supports four established formulas: Epley, Brzycki, Lander,
      and Lombardi.
    </p>
  </article>
  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the heaviest weight you lifted for a clean set, along with how
      many reps you completed before reaching failure. Choose a formula and
      unit, then calculate. For a more consistent estimate, use a lower-rep
      set when possible — estimates can vary more between formulas as rep
      count increases. The result table below shows common training
      percentages so you can plan your next session's working weights directly.
    </p>
  </article>
  <article class="article-section">
    <h2>1RM Percentage Chart &amp; Training Zones</h2>
    <p>
      Knowing your estimated one-rep max is just the baseline. To build an
      effective strength and hypertrophy program, you need to apply an
      appropriate percentage of your max to your working sets. Here are
      common ways lifters use 1RM percentages for different training goals:
    </p>
    <ul>
      <li><strong>90%–100% (1–3 reps):</strong> <em>Very heavy strength work.</em> Commonly used for low-rep strength training and peaking. Requires high effort and adequate rest.</li>
      <li><strong>80%–85% (4–6 reps):</strong> <em>Strength &amp; hypertrophy.</em> Commonly used for building strength and muscle with moderate-to-heavy loads.</li>
      <li><strong>70%–75% (8–12 reps):</strong> <em>Hypertrophy (muscle growth).</em> A commonly used range for moderate-load resistance training and higher training volume.</li>
      <li><strong>60%–65% (12–15+ reps):</strong> <em>Endurance &amp; speed.</em> Can be used for dynamic effort (speed work), warm-ups, or muscular endurance depending on the program.</li>
    </ul>
  </article>
  <article class="article-section">
    <h2>The 4 Core 1RM Formulas Explained</h2>
    <p>
      Not all one-rep max calculators are created equal. Because human
      biomechanics and fatigue rates vary, sports scientists have developed
      different mathematical models to estimate maximal strength. Here is a
      look at the four formulas used in this calculator:
    </p>
    <h3>1. Epley Formula (1985)</h3>
    <p>
      <code>1RM = Weight × (1 + Reps / 30)</code><br />
      A widely used baseline in strength training. It assumes a
      linear relationship between weight lifted and reps completed.
      <strong>Best for:</strong> general strength estimates and heavy
      compound movements (squat, deadlift) in the 1–10 rep range.
    </p>
    <h3>2. Brzycki Formula (1993)</h3>
    <p>
      <code>1RM = Weight × 36 / (37 − Reps)</code><br />
      Developed by Matt Brzycki, this hyperbolic equation provides a
      conservative estimate as reps increase. Because the denominator
      becomes zero at 37 reps, this formula cannot produce a valid result
      at 37 reps or above. <strong>Best for:</strong> heavy pressing
      movements (bench press, overhead press) in the 1–8 rep range.
    </p>
    <h3>3. Lander Formula (1985)</h3>
    <p>
      <code>1RM = (100 × Weight) / (101.3 − 2.67123 × Reps)</code><br />
      A linear model that provides an estimate between more aggressive and
      more conservative results. Because its denominator approaches zero
      as repetitions increase, it cannot produce a valid positive estimate
      beyond its mathematical range. <strong>Best for:</strong> moderate
      rep ranges (5–12 reps) and lifters wanting a practical working max
      estimate.
    </p>
    <h3>4. Lombardi Formula (1989)</h3>
    <p>
      <code>1RM = Weight × Reps^0.10</code><br />
      A non-linear power function that increases the estimated 1RM by
      smaller increments as reps go up. <strong>Best for:</strong> athletes
      with high muscular endurance calculating a max from higher-volume
      sets (10+ reps).
    </p>
  </article>
  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is a 1RM calculator?</h3>
      <p>It estimates the maximum weight you could lift once, based on a lighter weight lifted for multiple reps.</p>
    </div>
    <div class="faq-item">
      <h3>Which 1RM formula is the most accurate?</h3>
      <p>Different formulas can produce different estimates, especially at higher rep counts. Epley, Brzycki, Lander, and Lombardi use different mathematical models, so no single formula should be treated as universally accurate. Treat any result as an estimate, not a guaranteed maximum.</p>
    </div>
    <div class="faq-item">
      <h3>Can I calculate my 1RM using high repetitions (above 10 reps)?</h3>
      <p>Yes, but estimates can become less consistent as reps increase. Lombardi or Lander can provide alternative estimates in that range, while Epley and Brzycki may produce different results.</p>
    </div>
    <div class="faq-item">
      <h3>Does this formula work the same for men and women?</h3>
      <p>These are general-population formulas used for both men and women, though accuracy can vary with rep range, exercise, training experience, and individual characteristics.</p>
    </div>
    <div class="faq-item">
      <h3>Is estimating a 1RM better than testing a true 1-rep max?</h3>
      <p>For many lifters, estimating from a submaximal set is a practical alternative to testing a true max. A true 1RM test involves a maximal load and should be approached with appropriate technique, preparation, and safety considerations.</p>
    </div>
  </article>
  <RelatedTools currentToolId="1rm-calculator" />

  <script>
    let unit = "lb";
    let formula = "epley";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const formEpley = document.getElementById("formula-epley");
    const formBrzycki = document.getElementById("formula-brzycki");
    const formLander = document.getElementById("formula-lander");
    const formLombardi = document.getElementById("formula-lombardi");
    const weightInput = document.getElementById("weight") as HTMLInputElement | null;
    const repsInput = document.getElementById("reps") as HTMLInputElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const result1rm = document.getElementById("result-1rm");
    const resultLabel = document.getElementById("result-label");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) unitLb.addEventListener("click", () => setUnit("lb"));
    if (unitKg) unitKg.addEventListener("click", () => setUnit("kg"));
    if (formEpley) formEpley.addEventListener("click", () => setFormula("epley"));
    if (formBrzycki) formBrzycki.addEventListener("click", () => setFormula("brzycki"));
    if (formLander) formLander.addEventListener("click", () => setFormula("lander"));
    if (formLombardi) formLombardi.addEventListener("click", () => setFormula("lombardi"));

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;

      if (weightInput) {
        const currentVal = parseFloat(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          weightInput.value = newUnit === "kg"
            ? (currentVal / 2.20462).toFixed(1)
            : (currentVal * 2.20462).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }
    }

    function setFormula(f: string) {
      formula = f;

      const map: Record<string, HTMLElement | null> = {
        epley: formEpley,
        brzycki: formBrzycki,
        lander: formLander,
        lombardi: formLombardi
      };

      for (const key in map) {
        const el = map[key];

        if (el) {
          el.classList.toggle("active", f === key);
          el.setAttribute("aria-pressed", String(f === key));
        }
      }
    }

    function formulaLabel(f: string) {
      if (f === "epley") return "Epley";
      if (f === "brzycki") return "Brzycki";
      if (f === "lander") return "Lander";
      return "Lombardi";
    }

    function showError(message: string) {
      if (resultBox) {
        resultBox.classList.add("show");
      }

      if (result1rm) {
        result1rm.textContent = "—";
      }

      if (resultLabel) {
        resultLabel.textContent = message;
      }

      if (resultTableBody) {
        resultTableBody.innerHTML = "";
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput) return;

        const weight = parseFloat(weightInput.value);
        const reps = parseInt(repsInput.value, 10);

        if (
          !Number.isFinite(weight) ||
          !Number.isFinite(reps) ||
          weight <= 0 ||
          reps <= 0
        ) {
          showError("Please enter a valid weight and positive whole-number rep count.");
          return;
        }

        if (formula === "brzycki" && reps >= 37) {
          showError("The Brzycki formula is not defined for 37 or more reps. Try Epley or Lombardi for this rep count.");
          return;
        }

        if (formula === "lander") {
          const denominator = 101.3 - (2.67123 * reps);

          if (denominator <= 0) {
            showError("The Lander formula is not valid at this rep count. Try Epley or Lombardi for this rep count.");
            return;
          }
        }

        let oneRM = 0;

        if (reps === 1) {
          oneRM = weight;
        } else if (formula === "epley") {
          oneRM = weight * (1 + reps / 30);
        } else if (formula === "brzycki") {
          oneRM = weight * 36 / (37 - reps);
        } else if (formula === "lander") {
          oneRM = (100 * weight) / (101.3 - 2.67123 * reps);
        } else if (formula === "lombardi") {
          oneRM = weight * Math.pow(reps, 0.10);
        }

        if (!Number.isFinite(oneRM) || oneRM <= 0) {
          showError("Unable to calculate a valid 1RM from these inputs.");
          return;
        }

        const rounded = Math.round(oneRM * 10) / 10;

        if (result1rm) {
          result1rm.textContent = `${rounded} ${unit}`;
        }

        if (resultLabel) {
          resultLabel.textContent =
            `Estimated One-Rep Max (${formulaLabel(formula)} formula)`;
        }

        const percentages = [95, 90, 85, 80, 75, 70, 65, 60];

        const rows = percentages.map(p => {
          const val = Math.round(rounded * (p / 100) * 10) / 10;
          return `<tr><td>${p}%</td><td>${val} ${unit}</td></tr>`;
        }).join("");

        if (resultTableBody) {
          resultTableBody.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
