      .calculator-card { padding: 17px; }
      .form-grid { grid-template-columns: 1fr 1fr; }
      .field.full { grid-column: 1 / -1; }
    }

    @media (max-width: 460px) {
      .form-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .result-primary { padding: 19px 12px; }
      .height-inputs { gap: 8px; }
      .height-inputs input { min-width: 0; }
    }
  </style>

  <script>
    type UnitSystem = "imperial" | "metric";
    type FormulaType = "mifflin" | "katch";
    type Sex = "male" | "female";

    let unitSystem: UnitSystem = "imperial";
    let formula: FormulaType = "mifflin";
    let sex: Sex = "male";

    let preservedWeightKg: number | null = null;
    let preservedHeightCm: number | null = null;

    let showErrors = false;
    let calculateTimeout: number | null = null;
    const DEBOUNCE_MS = 300;

    const IN_TO_CM = 2.54;
    const LB_TO_KG = 0.45359237;
    const HEIGHT_MIN_CM = 121.92;
    const HEIGHT_MAX_CM = 243.84;

    const round0 = (v: number) => Math.round(v);
    const hasScientificNotation = (input: HTMLInputElement) =>
      input.value.trim().toLowerCase().includes("e");

    // --- DOM Elements ---
    const weightEl = document.querySelector("#weight") as HTMLInputElement;
    const heightFtEl = document.querySelector("#height-ft") as HTMLInputElement;
    const heightInEl = document.querySelector("#height-in") as HTMLInputElement;
    const heightCmEl = document.querySelector("#height-cm") as HTMLInputElement;
    const ageEl = document.querySelector("#age") as HTMLInputElement;
    const bodyFatEl = document.querySelector("#body-fat") as HTMLInputElement;
    const activityEl = document.querySelector("#activity") as HTMLSelectElement;

    const sexField = document.querySelector("#sex-field") as HTMLElement;
    const ageField = document.querySelector("#age-field") as HTMLElement;
    const weightLabel = document.querySelector("#weight-label")!;
    const heightImperialField = document.querySelector("#height-imperial-field") as HTMLElement;
    const heightMetricField = document.querySelector("#height-metric-field") as HTMLElement;
    const bodyFatField = document.querySelector("#body-fat-field") as HTMLElement;

    const resultsEl = document.querySelector("#results") as HTMLElement;
    const errorEl = document.querySelector("#error")!;
    const resultTdeeEl = document.querySelector("#result-tdee")!;
    const resultBmrLineEl = document.querySelector("#result-bmr-line")!;
    const resultFormulaEl = document.querySelector("#result-formula")!;
    const targetTableBody = document.querySelector("#result-table-body")!;
    const macroTeaser = document.querySelector("#macro-teaser") as HTMLElement;
    const macroTargetEl = document.querySelector("#macro-target")!;
    const macroProteinEl = document.querySelector("#macro-protein")!;
    const macroCarbsEl = document.querySelector("#macro-carbs")!;
    const macroFatEl = document.querySelector("#macro-fat")!;
    const warningEl = document.querySelector("#warning")!;
    const resultAnnouncement = document.querySelector("#result-announcement")!;

    // --- Helpers ---
    function hideResults() {
      resultsEl.hidden = true;
      errorEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function setError(msg: string) {
      errorEl.textContent = msg;
      errorEl.removeAttribute("hidden");
      resultsEl.hidden = true;
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function silentFail() {
      resultsEl.hidden = true;
      errorEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function fail(msg: string) {
      if (showErrors) setError(msg);
      else silentFail();
    }

    function resetResult() {
      resultsEl.hidden = true;
      errorEl.setAttribute("hidden", "");
    }

    function areRequiredFieldsFilled(): boolean {
      if (formula === "katch") {
        return weightEl.value.trim() !== "" && bodyFatEl.value.trim() !== "";
      }
      if (weightEl.value.trim() === "") return false;
      if (ageEl.value.trim() === "") return false;
      if (unitSystem === "metric") {
        return heightCmEl.value.trim() !== "";
      }
      return heightFtEl.value.trim() !== "";
    }

    // --- Debounce ---
    function cancelScheduledCalculate() {
      if (calculateTimeout !== null) {
        clearTimeout(calculateTimeout);
        calculateTimeout = null;
      }
    }

    function scheduleCalculate() {
      cancelScheduledCalculate();
      calculateTimeout = window.setTimeout(() => {
        calculateTimeout = null;
        calculate();
      }, DEBOUNCE_MS);
    }

    function immediateCalculate() {
      cancelScheduledCalculate();
      calculate();
    }

    // --- Preserved Sync ---
    function syncPreservedWeight() {
      const raw = weightEl.value.trim();
      if (raw === "" || raw.toLowerCase().includes("e")) {
        preservedWeightKg = null;
        return;
      }
      const v = Number(raw);
      if (!Number.isFinite(v) || v <= 0) {
        preservedWeightKg = null;
        return;
      }
      preservedWeightKg = unitSystem === "metric" ? v : v / LB_TO_KG;
    }

    function syncPreservedHeight() {
      if (unitSystem === "metric") {
        const raw = heightCmEl.value.trim();
        if (raw === "" || raw.toLowerCase().includes("e")) {
          preservedHeightCm = null;
          return;
        }
        const v = Number(raw);
        if (!Number.isFinite(v) || v <= 0) {
          preservedHeightCm = null;
          return;
        }
        preservedHeightCm = v;
      } else {
        const ftRaw = heightFtEl.value.trim();
        const inRaw = heightInEl.value.trim();
        
        if (ftRaw === "" && inRaw === "") {
          preservedHeightCm = null;
          return;
        }
        
        const ft = ftRaw === "" ? 0 : Number(ftRaw);
        const inches = inRaw === "" ? 0 : Number(inRaw);
        
        if (ftRaw.includes("e") || inRaw.includes("e")) {
          preservedHeightCm = null;
          return;
        }

        if (!Number.isInteger(ft) || !Number.isInteger(inches) || ft < 0 || inches < 0 || inches >= 12) {
          preservedHeightCm = null;
          return;
        }
        preservedHeightCm = (ft * 12 + inches) * IN_TO_CM;
      }
    }

    // --- Unit Toggle ---
    function setUnitSystem(next: UnitSystem) {
      if (next === unitSystem) return;
      // We deliberately do NOT re-sync preserved values here.
      // The preserved value reflects the user's last real input, not the
      // converted display value. Re-syncing would overwrite original
      // precision (e.g., 178 cm → 5 ft 10 in → 177.8 cm).

      if (preservedWeightKg !== null && preservedWeightKg > 0) {
        weightEl.value = next === "metric" 
          ? preservedWeightKg.toFixed(1) 
          : (preservedWeightKg / LB_TO_KG).toFixed(1);
      } else {
        weightEl.value = "";
      }

      if (preservedHeightCm !== null && preservedHeightCm > 0) {
        if (next === "metric") {
          heightCmEl.value = preservedHeightCm.toFixed(1);
        } else {
          const totalIn = Math.round(preservedHeightCm / IN_TO_CM);
          heightFtEl.value = String(Math.floor(totalIn / 12));
          heightInEl.value = String(totalIn % 12);
        }
      } else {
        heightFtEl.value = "";
        heightInEl.value = "";
        heightCmEl.value = "";
      }

      unitSystem = next;

      document.querySelectorAll("[data-unit]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.unit === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      weightLabel.textContent = `Body weight (${next === "metric" ? "kg" : "lb"})`;
      weightEl.placeholder = next === "metric" ? "e.g. 82" : "e.g. 180";

      if (formula === "mifflin") {
        heightImperialField.hidden = next === "metric";
        heightMetricField.hidden = next === "imperial";
      } else {
        heightImperialField.hidden = true;
        heightMetricField.hidden = true;
      }

      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // --- Formula Toggle ---
    function setFormula(next: FormulaType) {
      if (next === formula) return;
      formula = next;
      document.querySelectorAll("[data-formula]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.formula === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });
      
      const isKatch = next === "katch";
      bodyFatField.hidden = !isKatch;
      sexField.hidden = isKatch;
      ageField.hidden = isKatch;
      
      if (!isKatch) {
        heightImperialField.hidden = unitSystem === "metric";
        heightMetricField.hidden = unitSystem === "imperial";
      } else {
        heightImperialField.hidden = true;
        heightMetricField.hidden = true;
      }
      
      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // --- Sex Toggle ---
    function setSex(next: Sex) {
      if (next === sex) return;
      sex = next;
      document.querySelectorAll("[data-sex]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.sex === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });
      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // --- Calculate ---
    function calculate() {
      errorEl.setAttribute("hidden", "");

      // Determine required inputs based on formula
      const requiredInputs: HTMLInputElement[] = [weightEl];
      if (formula === "mifflin") {
        requiredInputs.push(ageEl);
        if (unitSystem === "metric") requiredInputs.push(heightCmEl);
        else { requiredInputs.push(heightFtEl, heightInEl); }
      } else {
        requiredInputs.push(bodyFatEl);
      }

      if (requiredInputs.some(hasScientificNotation)) {
        fail("Please enter numbers without scientific notation (e.g., 100, not 1e2).");
        return;
      }

      if (formula === "mifflin" && ageEl.value.trim() === "") {
        fail("Please enter your age.");
        return;
      }

      if (weightEl.value.trim() === "") {
        fail("Please enter your body weight.");
        return;
      }

      // NOTE: Preserved values are synced on every `input` event (see wiring below),
      // so we read them here directly. Do NOT re-sync from the DOM here — after a
      // unit toggle, the DOM holds rounded display values which would corrupt the
      // user's original-precision input (e.g., 178 cm → 5ft10in → 177.8 cm).
      if (preservedWeightKg === null) {
        fail("Please enter a valid body weight.");
        return;
      }
      const weightKg = preservedWeightKg;
      if (weightKg < 20 || weightKg > 300) {
        fail("Enter a realistic weight between 20 and 300 kg (44–660 lb).");
        return;
      }

      let heightCm = 0;
      if (formula === "mifflin") {
        if (preservedHeightCm === null) {
          fail("Please enter your height.");
          return;
        }
        heightCm = preservedHeightCm;
        if (heightCm < HEIGHT_MIN_CM - 0.05 || heightCm > HEIGHT_MAX_CM + 0.05) {
          fail("Enter a height between 4 ft 0 in and 8 ft 0 in (about 122–244 cm).");
          return;
        }
      }

      let bmr: number;

      if (formula === "mifflin") {
        const age = Number(ageEl.value);
        if (!Number.isInteger(age) || age < 18 || age > 90) {
          fail("Enter a whole-number age between 18 and 90.");
          return;
        }
        bmr = sex === "male"
          ? (10 * weightKg) + (6.25 * heightCm) - (5 * age) + 5
          : (10 * weightKg) + (6.25 * heightCm) - (5 * age) - 161;
      } else {
        if (bodyFatEl.value.trim() === "") {
          fail("Please enter your body fat percentage for the Katch-McArdle formula.");
          return;
        }
        const bf = Number(bodyFatEl.value);
        if (!Number.isFinite(bf) || bf < 3 || bf > 60) {
          fail("Enter a valid body fat percentage between 3% and 60%.");
          return;
        }
        const leanMassKg = weightKg * (1 - bf / 100);
        bmr = 370 + (21.6 * leanMassKg);
      }

      const activity = Number(activityEl.value);
      const tdee = bmr * activity;

      if (!Number.isFinite(bmr) || !Number.isFinite(tdee) || bmr <= 0 || tdee <= 0) {
        fail("Unable to calculate a valid result. Please review your inputs.");
        return;
      }

      const roundedBmr = round0(bmr);
      const roundedTdee = round0(roundedBmr * activity);

      // Unit ("kcal per day") is already shown in the adjacent <span.result-unit>,
      // so we only set the number here.
      resultTdeeEl.textContent = roundedTdee.toLocaleString();
      resultBmrLineEl.textContent = `Estimated resting energy (REE/RMR): ${roundedBmr.toLocaleString()} kcal/day`;
      resultFormulaEl.textContent = `${roundedBmr.toLocaleString()} × ${activity} ≈ ${roundedTdee.toLocaleString()} kcal/day`;

      // Safety Thresholds & Targets
      let hasLowTarget = false;
      const illustrativeGoals = [
        { label: 'Cut (−500 kcal)', adjustment: -500 },
        { label: 'Cut (−300 kcal)', adjustment: -300 },
        { label: 'Maintenance', adjustment: 0 },
        { label: 'Gain (+250 kcal)', adjustment: 250 },
        { label: 'Gain (+400 kcal)', adjustment: 400 },
      ];

      targetTableBody.replaceChildren();

      for (const goal of illustrativeGoals) {
        const value = roundedTdee + goal.adjustment;
        const row = document.createElement('tr');
        const goalCell = document.createElement('td');
        const valueCell = document.createElement('td');
        
        goalCell.textContent = goal.label;
        
        if (goal.adjustment < 0 && value < 1200) {
          valueCell.textContent = 'Not displayed*';
          hasLowTarget = true;
        } else {
          valueCell.textContent = `${value.toLocaleString()} kcal`;
        }
        
        row.append(goalCell, valueCell);
        targetTableBody.appendChild(row);
      }

      if (hasLowTarget) {
        warningEl.textContent = "*One or more illustrative cutting targets fall below 1,200 kcal/day and have been withheld. This threshold is a product-level safety policy, not a personalized medical recommendation; consult a qualified professional for individualized guidance.";
        warningEl.removeAttribute("hidden");
      } else {
        warningEl.setAttribute("hidden", "");
      }

      // Macro Teaser
      const pCals = roundedTdee * 0.40;
      const cCals = roundedTdee * 0.30;
      const fCals = roundedTdee * 0.30;

      macroTargetEl.textContent = roundedTdee.toLocaleString();
      macroProteinEl.textContent = round0(pCals / 4).toLocaleString();
      macroCarbsEl.textContent = round0(cCals / 4).toLocaleString();
      macroFatEl.textContent = round0(fCals / 9).toLocaleString();
      macroTeaser.hidden = false;

      resultsEl.hidden = false;

      if (resultAnnouncement) {
        resultAnnouncement.textContent =
          `Estimated maintenance calories: ${roundedTdee.toLocaleString()} kilocalories per day. Estimated resting energy: ${roundedBmr.toLocaleString()} kilocalories per day.`;
      }
    }

    // --- Event Wiring ---
    document.querySelectorAll<HTMLButtonElement>("[data-unit]").forEach((btn) => {
      btn.addEventListener("click", () => setUnitSystem(btn.dataset.unit as UnitSystem));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-formula]").forEach((btn) => {
      btn.addEventListener("click", () => setFormula(btn.dataset.formula as FormulaType));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-sex]").forEach((btn) => {
      btn.addEventListener("click", () => setSex(btn.dataset.sex as Sex));
    });

    [weightEl, heightFtEl, heightInEl, heightCmEl, ageEl, bodyFatEl].forEach((el) => {
      el.addEventListener("input", () => {
        if (el === weightEl) syncPreservedWeight();
        if (el === heightFtEl || el === heightInEl || el === heightCmEl) syncPreservedHeight();
        showErrors = false;
        resetResult();
        scheduleCalculate();
      });
      el.addEventListener("blur", () => {
        // Only trigger full validation if required fields are filled.
        // Avoids showing premature errors while user is filling the form.
        if (areRequiredFieldsFilled()) {
          showErrors = true;
          immediateCalculate();
        }
      });
    });

    activityEl.addEventListener("change", () => {
      showErrors = false;
      resetResult();
      immediateCalculate();
    });

    // Scope Enter-key handling to the calculator card only — do not hijack
    // Enter on unrelated page-level inputs (site search, newsletter, etc.).
    document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      "#calculator input, #calculator select"
    ).forEach((el) => {
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          showErrors = true;
          // Preserved values are already current via the `input` listener;
          // no need to re-sync here.
          immediateCalculate();
        }
      });
    });

    // Init
    syncPreservedWeight();
    syncPreservedHeight();
  </script>
</Base>
