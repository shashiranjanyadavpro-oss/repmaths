---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'TDEE Calculator' },
];

const faqs = [
  {
    question: 'What is TDEE?',
    answer:
      'TDEE stands for Total Daily Energy Expenditure. It estimates the calories you burn in an average day, including resting energy expenditure, physical activity, exercise, and digestion.',
  },
  {
    question: 'How do I calculate my maintenance calories?',
    answer:
      'Enter your age, sex, weight, height, and overall activity level. This calculator estimates resting energy expenditure using the Mifflin-St Jeor equation, then multiplies the result by your selected activity factor to estimate maintenance calories.',
  },
  {
    question: 'What is the difference between BMR and TDEE?',
    answer:
      'BMR estimates energy requirements under resting conditions. TDEE includes estimated daily activity and is generally more useful as a starting point for planning everyday calorie intake.',
  },
  {
    question: 'How accurate is the Mifflin-St Jeor equation?',
    answer:
      'Mifflin-St Jeor is a widely used predictive equation for resting energy expenditure. It performs reasonably well across many adult populations, but individual estimates can differ from measured expenditure.',
  },
  {
    question: 'Which TDEE activity multiplier should I choose?',
    answer:
      'Choose the level that reflects your total weekly movement, not just gym sessions. Consider walking, work, commuting, structured exercise, and time spent sitting.',
  },
  {
    question: 'How many calories below TDEE should I eat to lose weight?',
    answer:
      'A calorie deficit can support weight loss, but the appropriate amount varies by individual. This calculator illustrates 300- and 500-calorie adjustments, not personalized prescriptions. Monitor your weight trend and seek professional guidance when appropriate.',
  },
  {
    question: 'How many calories above TDEE should I eat to gain muscle?',
    answer:
      'A modest calorie surplus is commonly used during muscle-gain phases. This calculator illustrates 250- and 400-calorie additions. Adjust your intake according to body-weight changes, training progress, and individual needs.',
  },
  {
    question: 'Is my TDEE the same every day?',
    answer:
      'No. Actual daily expenditure varies with movement, exercise, food intake, and other factors. The calculator estimates an average daily requirement rather than measuring your exact expenditure.',
  },
  {
    question: 'How can I find my actual maintenance calories?',
    answer:
      'Use your calculated TDEE as a starting point. Track calorie intake consistently and compare average body-weight trends over several weeks. Adjust the estimate gradually based on your results.',
  },
  {
    question: 'What should I calculate after TDEE?',
    answer:
      'Use our <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> to estimate carbohydrate, fat, and protein targets, or our <a href="/tools/nutrition/protein-calculator/">Protein Calculator</a> to focus on daily protein requirements. For a focused weight-loss starting point, see the <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a>.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id':
    'https://repmaths.com/tools/nutrition/tdee-calculator/#calculator',
  name: 'RepMaths TDEE Calculator',
  url: 'https://repmaths.com/tools/nutrition/tdee-calculator/',
  description:
    'Free calculator for estimating total daily energy expenditure, maintenance calories, and resting energy expenditure using the Mifflin-St Jeor equation.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="TDEE Calculator — Maintenance Calories & BMR"
  description="Free TDEE calculator using the Mifflin-St Jeor formula. Estimate maintenance calories, BMR, cutting and bulking targets with lb/kg and activity levels."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <section class="hero">
    <h1>TDEE Calculator</h1>
    <p>
      Calculate your estimated maintenance calories and BMR using the
      Mifflin-St Jeor equation. Explore starting calorie targets for
      cutting, maintaining, or gaining weight.
    </p>
  </section>

  <aside class="quick-answer" aria-label="TDEE quick answer">
    <p>
      <strong>How do you calculate TDEE?</strong>
      First estimate resting calorie needs using the Mifflin-St Jeor
      equation. Then multiply that estimate by an activity factor.
      Your result is an estimated average daily calorie requirement,
      also called your <strong>maintenance calories</strong>.
    </p>
  </aside>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="calculator-heading">
      Calculate Your Daily Calorie Needs
    </h2>

    <div class="field">
      <span class="field-label" id="unit-label">Measurement units</span>

      <div class="unit-toggle" role="group" aria-labelledby="unit-label">
        <button
          type="button"
          id="unit-imperial"
          class="active"
          aria-pressed="true"
        >
          lb / ft-in
        </button>

        <button type="button" id="unit-metric" aria-pressed="false">
          kg / cm
        </button>
      </div>
    </div>

    <div class="field">
      <span class="field-label" id="sex-label">Equation category</span>

      <div class="unit-toggle" role="group" aria-labelledby="sex-label">
        <button
          type="button"
          id="sex-male"
          class="active"
          aria-pressed="true"
        >
          Male
        </button>

        <button type="button" id="sex-female" aria-pressed="false">
          Female
        </button>
      </div>

      <p class="field-help">
        Select the male or female equation constant used in the original
        Mifflin-St Jeor formula. Individual energy needs can differ from
        either prediction.
      </p>
    </div>

    <div class="field">
      <label for="age">Age (years)</label>

      <input
        type="number"
        id="age"
        placeholder="e.g. 28"
        inputmode="numeric"
        min="18"
        max="90"
        step="1"
        required
        aria-describedby="age-help calc-error"
      />

      <p id="age-help" class="field-help">
        Designed for adults aged 18–90.
      </p>
    </div>

    <div class="field">
      <label for="weight" id="weight-label">Body weight (lb)</label>

      <input
        type="number"
        id="weight"
        placeholder="e.g. 180"
        inputmode="decimal"
        min="1"
        step="any"
        required
        aria-describedby="calc-error"
      />
    </div>

    <div id="imperial-height" class="field">
      <span class="field-label" id="height-imperial-label">
        Height (feet and inches)
      </span>

      <div
        class="height-inputs"
        role="group"
        aria-labelledby="height-imperial-label"
      >
        <div>
          <label for="height-ft">Feet</label>

          <input
            type="number"
            id="height-ft"
            placeholder="e.g. 5"
            inputmode="numeric"
            min="0"
            max="8"
            step="1"
            aria-describedby="calc-error"
          />
        </div>

        <div>
          <label for="height-in">Inches</label>

          <input
            type="number"
            id="height-in"
            placeholder="e.g. 10"
            inputmode="numeric"
            min="0"
            max="11"
            step="1"
            aria-describedby="calc-error"
          />
        </div>
      </div>
    </div>

    <div id="metric-height" class="field" hidden>
      <label for="height-cm">Height (cm)</label>

      <input
        type="number"
        id="height-cm"
        placeholder="e.g. 178"
        inputmode="decimal"
        min="122"
        max="244"
        step="any"
        aria-describedby="calc-error"
      />
    </div>

    <div class="field">
      <label for="activity">Activity level</label>

      <select id="activity">
        <option value="1.2">Sedentary — little exercise (×1.2)</option>

        <option value="1.375" selected>
          Lightly active — 1–3 days/week (×1.375)
        </option>

        <option value="1.55">
          Moderately active — 3–5 days/week (×1.55)
        </option>

        <option value="1.725">
          Very active — 6–7 days/week (×1.725)
        </option>

        <option value="1.9">
          Extra active — intense training / physical job (×1.9)
        </option>
      </select>

      <p class="field-help">
        Include everyday movement and work activity, not only workouts.
      </p>
    </div>

    <p id="calc-error" class="calc-error" role="alert" hidden></p>

    <button type="button" class="btn-primary" id="calc-btn">
      Calculate TDEE
    </button>

    <div class="result-box" id="result-box" aria-labelledby="result-heading">
      <div
        id="result-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <h3 id="result-heading" class="result-heading">
        Your Estimated Maintenance Calories
      </h3>

      <div class="big-number" id="result-tdee">–</div>

      <div class="label">kcal per day (estimated TDEE)</div>

      <p id="result-bmr-line" class="result-detail"></p>
      <p id="result-formula" class="result-detail"></p>

      <p class="calc-note">
        This is an estimated average daily requirement, not an exact
        measurement of calories burned.
      </p>

      <table class="result-table">
        <caption>Illustrative daily calorie targets</caption>

        <thead>
          <tr>
            <th scope="col">Goal</th>
            <th scope="col">Daily calories</th>
          </tr>
        </thead>

        <tbody id="result-table-body"></tbody>
      </table>

      <p id="result-warning" class="result-warning" hidden></p>

      <p class="calc-note">
        Cutting and gaining adjustments are examples, not individualized
        recommendations. Monitor your progress and adjust gradually.
      </p>

      <div class="result-actions">
        <a href="/tools/nutrition/macro-calculator/" class="btn-primary">
          Calculate Macros
        </a>

        <a href="/tools/nutrition/protein-calculator/" class="btn-primary">
          Calculate Protein
        </a>

        <a
          href="/tools/nutrition/calorie-deficit-calculator/"
          class="btn-primary"
        >
          Calorie Deficit
        </a>
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is TDEE?</h2>

    <p>
      <strong>TDEE (Total Daily Energy Expenditure)</strong> is the
      estimated total number of calories your body uses in an average day.
      It includes resting energy expenditure, exercise, everyday movement,
      and the energy required to digest food.
    </p>

    <p>
      Your TDEE is commonly used as an estimate of your
      <strong>maintenance calories</strong>: the daily energy intake that
      may maintain your current body weight when averaged over time.
    </p>

    <p>
      Because daily movement and other factors change, your actual energy
      expenditure is not identical every day.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Calculate TDEE: Formula and Method</h2>

    <p>
      RepMaths first estimates resting energy expenditure using the
      <strong>Mifflin-St Jeor equation</strong>, then applies your selected
      activity multiplier.
    </p>

    <h3>Male equation</h3>

    <p class="formula">
      BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) + 5
    </p>

    <h3>Female equation</h3>

    <p class="formula">
      BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) − 161
    </p>

    <h3>TDEE formula</h3>

    <p class="formula">TDEE = Estimated BMR × Activity Multiplier</p>

    <p>
      The calculator labels the equation result as BMR for familiarity.
      More precisely, Mifflin-St Jeor predicts resting energy expenditure;
      this is not a direct laboratory measurement of basal metabolic rate.
    </p>

    <p>
      You can also use the dedicated
      <a href="/tools/nutrition/bmr-calculator/">BMR Calculator</a>
      to explore resting calorie needs separately.
    </p>
  </article>

  <article class="article-section">
    <h2>TDEE Calculation Example</h2>

    <p>
      Consider a 30-year-old man weighing 80 kg and measuring 180 cm, with
      a moderately active lifestyle.
    </p>

    <table class="result-table">
      <caption>Worked Mifflin-St Jeor example</caption>

      <tbody>
        <tr>
          <td>Weight</td>
          <td>80 kg</td>
        </tr>

        <tr>
          <td>Height</td>
          <td>180 cm</td>
        </tr>

        <tr>
          <td>Age</td>
          <td>30 years</td>
        </tr>

        <tr>
          <td>Estimated BMR</td>
          <td>1,780 kcal/day</td>
        </tr>

        <tr>
          <td>Activity factor</td>
          <td>1.55</td>
        </tr>

        <tr>
          <td>Estimated TDEE</td>
          <td>2,759 kcal/day</td>
        </tr>
      </tbody>
    </table>

    <p>
      The calculation is 1,780 × 1.55 = 2,759 kcal/day. This is an initial
      maintenance estimate, not a guarantee that eating exactly 2,759
      calories will maintain weight.
    </p>
  </article>

  <article class="article-section">
    <h2>TDEE Activity Level Multipliers Explained</h2>

    <table class="result-table">
      <caption>Common activity factors used by this calculator</caption>

      <thead>
        <tr>
          <th scope="col">Activity level</th>
          <th scope="col">Multiplier</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Sedentary</td>
          <td>1.2</td>
        </tr>

        <tr>
          <td>Lightly active</td>
          <td>1.375</td>
        </tr>

        <tr>
          <td>Moderately active</td>
          <td>1.55</td>
        </tr>

        <tr>
          <td>Very active</td>
          <td>1.725</td>
        </tr>

        <tr>
          <td>Extra active</td>
          <td>1.9</td>
        </tr>
      </tbody>
    </table>

    <p>
      These multipliers are broad planning estimates rather than precise
      measurements. A person who lifts weights four days per week but
      otherwise sits for most of the day may have a lower overall activity
      level than expected.
    </p>

    <p>
      When unsure, select a conservative activity level and refine your
      maintenance estimate using your actual weight trend.
    </p>
  </article>

  <article class="article-section">
    <h2>How Many Calories Do I Need to Maintain My Weight?</h2>

    <p>
      Your estimated maintenance calories are the central result of this
      TDEE calculator. They represent an initial estimate of how much
      energy you may need each day to maintain your current weight.
    </p>

    <p>
      To improve accuracy, compare your average calorie intake with your
      average body-weight trend over several weeks. Daily fluctuations
      caused by water, sodium, digestion, and glycogen can obscure
      shorter-term changes.
    </p>
  </article>

  <article class="article-section">
    <h2>Using TDEE for Weight Loss and Cutting</h2>

    <p>
      A calorie deficit occurs when average calorie intake is lower than
      energy expenditure. This calculator displays illustrative targets
      300 and 500 calories below estimated maintenance.
    </p>

    <p>
      These adjustments are not suitable for everyone. Appropriate energy
      intake depends on individual health, body size, activity, training
      demands, and other circumstances.
    </p>

    <p>
      For a more focused starting estimate, visit the
      <a href="/tools/nutrition/calorie-deficit-calculator/">
        Calorie Deficit Calculator
      </a>. For nutritional planning during a cut, use the
      <a href="/tools/nutrition/protein-calculator/">Protein Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>Using TDEE for Muscle Gain and Bulking</h2>

    <p>
      When aiming to gain muscle, estimated TDEE can provide a maintenance
      reference. A modest calorie surplus is commonly used alongside
      progressive resistance training and sufficient dietary protein.
    </p>

    <p>
      The calculator displays illustrative additions of 250 and 400
      calories per day. The appropriate surplus depends on your training
      experience, goals, and observed progress.
    </p>

    <p>
      Use our
      <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>
      to explore daily protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>How Accurate Is a TDEE Calculator?</h2>

    <p>
      TDEE calculators provide predictions, not direct measurements. Two
      important sources of uncertainty are the resting-energy equation and
      the selected activity multiplier.
    </p>

    <p>
      The Mifflin-St Jeor equation is widely used, but even a
      well-performing population-level equation can overestimate or
      underestimate an individual's actual energy needs.
    </p>

    <h3>How to refine your maintenance estimate</h3>

    <ol>
      <li>Calculate your initial TDEE.</li>
      <li>Track food intake consistently for several weeks.</li>
      <li>Compare average body weight across those weeks.</li>
      <li>Review changes in training and daily activity.</li>
      <li>Adjust your calorie estimate gradually if needed.</li>
    </ol>

    <p>
      This feedback-based approach is generally more useful than assuming
      a formula produces a permanently exact calorie target.
    </p>
  </article>

  <article class="article-section">
    <h2>Mifflin-St Jeor vs. Harris-Benedict</h2>

    <p>
      Mifflin-St Jeor and Harris-Benedict are predictive equations used to
      estimate resting energy expenditure. They use variables such as age,
      weight, height, and sex, but their coefficients differ.
    </p>

    <p>
      RepMaths uses Mifflin-St Jeor because it is a well-established option
      for estimating adult resting energy expenditure. No predictive
      equation is universally accurate for every individual or population.
    </p>
  </article>

  <article class="article-section">
    <h2>BMR vs. TDEE: What's the Difference?</h2>

    <p>
      BMR represents estimated energy requirements under basal resting
      conditions. TDEE extends that starting point to account for overall
      daily energy expenditure.
    </p>

    <p>
      If your goal is to estimate everyday maintenance calories, TDEE is
      generally the more relevant planning figure. BMR should not be
      confused with a personalized minimum calorie-intake recommendation.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    {faqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p set:html={faq.answer} />
      </div>
    ))}
  </article>

  <article class="article-section">
    <h2>Sources and Further Reading</h2>

    <p>
      The following references provide background on resting energy
      prediction and weight-management methodology. The activity factors
      and goal adjustments displayed by RepMaths remain estimates rather
      than clinical prescriptions.
    </p>

    <ul>
      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/2305711/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Mifflin et al. (1990) — A New Predictive Equation for Resting
          Energy Expenditure
        </a>
      </li>

      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/15883556/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Frankenfield et al. (2005) — Comparison of Predictive Equations
          for Resting Metabolic Rate
        </a>
      </li>

      <li>
        <a
          href="https://www.niddk.nih.gov/health-information/weight-management"
          target="_blank"
          rel="noopener noreferrer"
        >
          NIDDK — Weight Management Information
        </a>
      </li>
    </ul>
  </article>

  <p class="disclaimer-note">
    <strong>Important:</strong> This calculator is intended for general
    educational use by adults aged 18–90. It is not a medical or dietary
    prescription. Estimates may be unsuitable during pregnancy,
    breastfeeding, illness, recovery from an eating disorder, or when
    individual clinical nutrition requirements apply. Consult a qualified
    healthcare professional when appropriate.
  </p>

  <RelatedTools currentToolId="tdee-calculator" />

  <style>
    .calculator-heading {
      font-size: 1.12rem;
      margin: 0 0 20px;
    }

    .quick-answer {
      background: var(--surface);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 16px 18px;
      margin: 0 0 24px;
    }

    .quick-answer p {
      margin: 0;
      color: #c7cbd2;
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .quick-answer strong {
      color: var(--accent);
    }

    .field-help {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
      margin: 7px 0 0;
    }

    .height-inputs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .height-inputs > div {
      min-width: 0;
    }

    .height-inputs label {
      display: block;
    }

    .calc-error {
      color: #ffb4a8;
      font-size: 0.9rem;
      line-height: 1.5;
      margin: 10px 0;
    }

    .result-heading {
      font-size: 1rem;
      margin: 0 0 12px;
      color: var(--text);
    }

    .result-detail {
      color: var(--text-muted);
      font-size: 0.88rem;
      margin: 8px 0;
    }

    .calc-note {
      color: var(--text-muted);
      font-size: 0.84rem;
      line-height: 1.6;
      margin: 12px 0;
    }

    .result-warning {
      color: #ffcf99;
      font-size: 0.88rem;
      line-height: 1.5;
      margin-top: 12px;
    }

    .result-table caption {
      text-align: left;
      color: var(--text-muted);
      font-size: 0.84rem;
      padding: 0 0 8px;
    }

    .formula {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
      overflow-wrap: anywhere;
      font-weight: 600;
    }

    .disclaimer-note {
      color: var(--text-muted);
      font-size: 0.83rem;
      line-height: 1.6;
      margin-top: 24px;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    [hidden] {
      display: none !important;
    }

    .article-section ol {
      color: #c7cbd2;
      font-size: 0.95rem;
      padding-left: 22px;
    }

    .article-section ol li {
      margin-bottom: 8px;
    }

    @media (max-width: 480px) {
      .height-inputs {
        gap: 8px;
      }

      .height-inputs input {
        min-width: 0;
      }
    }
  </style>

  <script>
    type UnitSystem = 'imperial' | 'metric';
    type EquationSex = 'male' | 'female';

    let unitSystem: UnitSystem = 'imperial';
    let sex: EquationSex = 'male';

    // Canonical metric values — preserved across unit toggles to avoid
    // cumulative rounding loss from repeated conversions.
    let preservedKg: number | null = null;
    let preservedCm: number | null = null;

    const LB_PER_KG = 2.2046226218;
    const CM_PER_INCH = 2.54;

    const unitImperial = document.getElementById('unit-imperial');
    const unitMetric = document.getElementById('unit-metric');

    const sexMale = document.getElementById('sex-male');
    const sexFemale = document.getElementById('sex-female');

    const imperialHeight = document.getElementById('imperial-height');
    const metricHeight = document.getElementById('metric-height');

    const ageInput = document.getElementById(
      'age'
    ) as HTMLInputElement | null;

    const weightInput = document.getElementById(
      'weight'
    ) as HTMLInputElement | null;

    const weightLabel = document.getElementById('weight-label');

    const heightFtInput = document.getElementById(
      'height-ft'
    ) as HTMLInputElement | null;

    const heightInInput = document.getElementById(
      'height-in'
    ) as HTMLInputElement | null;

    const heightCmInput = document.getElementById(
      'height-cm'
    ) as HTMLInputElement | null;

    const activitySelect = document.getElementById(
      'activity'
    ) as HTMLSelectElement | null;

    const calcBtn = document.getElementById('calc-btn');
    const calcError = document.getElementById('calc-error');
    const resultBox = document.getElementById('result-box');
    const resultTdee = document.getElementById('result-tdee');
    const resultBmrLine = document.getElementById('result-bmr-line');
    const resultFormula = document.getElementById('result-formula');

    const resultTableBody = document.getElementById('result-table-body');
    const resultWarning = document.getElementById('result-warning');
    const resultAnnouncement = document.getElementById(
      'result-announcement'
    );

    const formatter = new Intl.NumberFormat('en-US', {
      maximumFractionDigits: 0,
    });

    const validMultipliers = new Set([1.2, 1.375, 1.55, 1.725, 1.9]);

    function hideResult() {
      resultBox?.classList.remove('show');
      if (resultAnnouncement) {
        resultAnnouncement.textContent = '';
      }
    }

    function clearError() {
      if (calcError) {
        calcError.textContent = '';
        calcError.hidden = true;
      }

      [
        ageInput,
        weightInput,
        heightFtInput,
        heightInInput,
        heightCmInput,
        activitySelect,
      ].forEach((element) => {
        element?.removeAttribute('aria-invalid');
      });
    }

    function showError(
      message: string,
      field?: HTMLInputElement | HTMLSelectElement | null
    ) {
      clearError();

      if (calcError) {
        calcError.textContent = message;
        calcError.hidden = false;
      }

      field?.setAttribute('aria-invalid', 'true');
      hideResult();
      field?.focus();
    }

    function setPressed(button: HTMLElement | null, selected: boolean) {
      button?.classList.toggle('active', selected);
      button?.setAttribute('aria-pressed', String(selected));
    }

    // Update preserved metric value from current input (based on active unit).
    function syncPreservedWeight() {
      if (!weightInput) return;

      const raw = weightInput.value.trim();

      if (raw === '') {
        preservedKg = null;
        return;
      }

      const value = Number(raw);

      if (!Number.isFinite(value) || value <= 0) {
        preservedKg = null;
        return;
      }

      preservedKg = unitSystem === 'imperial' ? value / LB_PER_KG : value;
    }

    function syncPreservedHeightFromImperial() {
      if (unitSystem !== 'imperial') return;
      if (!heightFtInput || !heightInInput) return;

      const feetRaw = heightFtInput.value.trim();
      const inchesRaw = heightInInput.value.trim();

      if (feetRaw === '' && inchesRaw === '') {
        preservedCm = null;
        return;
      }

      const feet = feetRaw === '' ? 0 : Number(feetRaw);
      const inches = inchesRaw === '' ? 0 : Number(inchesRaw);

      if (
        !Number.isFinite(feet) ||
        !Number.isFinite(inches) ||
        feet < 0 ||
        inches < 0
      ) {
        preservedCm = null;
        return;
      }

      const totalInches = feet * 12 + inches;

      if (totalInches <= 0) {
        preservedCm = null;
        return;
      }

      preservedCm = totalInches * CM_PER_INCH;
    }

    function syncPreservedHeightFromMetric() {
      if (unitSystem !== 'metric') return;
      if (!heightCmInput) return;

      const raw = heightCmInput.value.trim();

      if (raw === '') {
        preservedCm = null;
        return;
      }

      const value = Number(raw);

      if (!Number.isFinite(value) || value <= 0) {
        preservedCm = null;
        return;
      }

      preservedCm = value;
    }

    function setUnitSystem(next: UnitSystem) {
      if (next === unitSystem) return;

      // Render weight from preserved kg value.
      if (preservedKg !== null && preservedKg > 0 && weightInput) {
        weightInput.value =
          next === 'imperial'
            ? (preservedKg * LB_PER_KG).toFixed(1)
            : preservedKg.toFixed(1);
      }

      // Render height from preserved cm value.
      if (preservedCm !== null && preservedCm > 0) {
        if (next === 'metric' && heightCmInput) {
          heightCmInput.value = preservedCm.toFixed(1);
        }

        if (
          next === 'imperial' &&
          heightFtInput &&
          heightInInput
        ) {
          const totalInches = Math.round(preservedCm / CM_PER_INCH);
          heightFtInput.value = String(Math.floor(totalInches / 12));
          heightInInput.value = String(totalInches % 12);
        }
      }

      unitSystem = next;

      setPressed(unitImperial, next === 'imperial');
      setPressed(unitMetric, next === 'metric');

      if (imperialHeight) {
        imperialHeight.hidden = next !== 'imperial';
      }

      if (metricHeight) {
        metricHeight.hidden = next !== 'metric';
      }

      if (weightLabel) {
        weightLabel.textContent =
          next === 'imperial' ? 'Body weight (lb)' : 'Body weight (kg)';
      }

      if (weightInput) {
        weightInput.placeholder =
          next === 'imperial' ? 'e.g. 180' : 'e.g. 82';
      }

      clearError();
      hideResult();
    }

    function setSex(next: EquationSex) {
      sex = next;

      setPressed(sexMale, next === 'male');
      setPressed(sexFemale, next === 'female');

      clearError();
      hideResult();
    }

    function calculateTdee() {
      if (!ageInput || !weightInput || !activitySelect) {
        return;
      }

      clearError();

      const ageRaw = ageInput.value.trim();
      const age = Number(ageRaw);

      if (ageRaw === '' || !Number.isInteger(age) || age < 18 || age > 90) {
        showError('Enter a whole-number age between 18 and 90.', ageInput);
        return;
      }

      // Re-sync preserved weight from current input before calculating.
      syncPreservedWeight();

      if (preservedKg === null) {
        showError('Enter a valid body weight greater than zero.', weightInput);
        return;
      }

      const weightKg = preservedKg;

      if (weightKg < 20 || weightKg > 500) {
        showError(
          unitSystem === 'imperial'
            ? 'Enter a body weight between approximately 44 and 1,102 lb.'
            : 'Enter a body weight between 20 and 500 kg.',
          weightInput
        );
        return;
      }

      // Re-sync preserved height from current input before calculating.
      if (unitSystem === 'imperial') {
        syncPreservedHeightFromImperial();
      } else {
        syncPreservedHeightFromMetric();
      }

      if (preservedCm === null) {
        showError(
          unitSystem === 'imperial'
            ? 'Enter your height in feet and inches.'
            : 'Enter a height between 122 and 244 cm.',
          unitSystem === 'imperial' ? heightFtInput : heightCmInput
        );
        return;
      }

      const heightCm = preservedCm;

      if (heightCm < 122 || heightCm > 244) {
        showError(
          'Enter a height between approximately 4 ft and 8 ft (122–244 cm).',
          unitSystem === 'imperial' ? heightFtInput : heightCmInput
        );
        return;
      }

      const activityMultiplier = Number(activitySelect.value);

      if (!validMultipliers.has(activityMultiplier)) {
        showError(
          'Please select a valid activity level.',
          activitySelect
        );
        return;
      }

      const bmr =
        10 * weightKg +
        6.25 * heightCm -
        5 * age +
        (sex === 'male' ? 5 : -161);

      const tdee = bmr * activityMultiplier;

      if (
        !Number.isFinite(bmr) ||
        !Number.isFinite(tdee) ||
        bmr <= 0 ||
        tdee <= 0
      ) {
        showError(
          'Unable to calculate a valid result. Please review your inputs.'
        );
        return;
      }

      // Derive TDEE from rounded BMR so displayed formula is internally consistent.
      const roundedBmr = Math.round(bmr);
      const roundedTdee = Math.round(roundedBmr * activityMultiplier);

      if (resultTdee) {
        resultTdee.textContent = `${formatter.format(roundedTdee)} kcal/day`;
      }

      if (resultBmrLine) {
        resultBmrLine.textContent = `Estimated resting calories (BMR): ${formatter.format(roundedBmr)} kcal/day`;
      }

      if (resultFormula) {
        resultFormula.textContent = `${formatter.format(roundedBmr)} × ${activityMultiplier} ≈ ${formatter.format(roundedTdee)} kcal/day`;
      }

      const illustrativeGoals = [
        { label: 'Cut (−500 kcal)', adjustment: -500 },
        { label: 'Cut (−300 kcal)', adjustment: -300 },
        { label: 'Maintenance', adjustment: 0 },
        { label: 'Gain (+250 kcal)', adjustment: 250 },
        { label: 'Gain (+400 kcal)', adjustment: 400 },
      ];

      const cautionThreshold = sex === 'male' ? 1500 : 1200;
      let hasLowTarget = false;

      if (resultTableBody) {
        resultTableBody.replaceChildren();

        for (const goal of illustrativeGoals) {
          const value = roundedTdee + goal.adjustment;

          const row = document.createElement('tr');
          const goalCell = document.createElement('td');
          const valueCell = document.createElement('td');

          goalCell.textContent = goal.label;

          if (goal.adjustment < 0 && value < cautionThreshold) {
            valueCell.textContent = 'Not displayed*';
            hasLowTarget = true;
          } else {
            valueCell.textContent = `${formatter.format(value)} kcal`;
          }

          row.append(goalCell, valueCell);
          resultTableBody.appendChild(row);
        }
      }

      if (resultWarning) {
        resultWarning.hidden = !hasLowTarget;

        resultWarning.textContent = hasLowTarget
          ? "*One or more illustrative cutting targets fall below RepMaths' conservative screening threshold and have been withheld. This threshold is a product-level safety policy, not a personalized medical recommendation; consult a qualified professional for individualized guidance."
          : '';
      }

      resultBox?.classList.add('show');

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Estimated maintenance calories: ${formatter.format(roundedTdee)} kilocalories per day. Estimated resting calories: ${formatter.format(roundedBmr)} kilocalories per day.`;
      }
    }

    unitImperial?.addEventListener('click', () => {
      setUnitSystem('imperial');
    });

    unitMetric?.addEventListener('click', () => {
      setUnitSystem('metric');
    });

    sexMale?.addEventListener('click', () => {
      setSex('male');
    });

    sexFemale?.addEventListener('click', () => {
      setSex('female');
    });

    calcBtn?.addEventListener('click', calculateTdee);

    ageInput?.addEventListener('input', () => {
      clearError();
      hideResult();
    });

    ageInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateTdee();
      }
    });

    weightInput?.addEventListener('input', () => {
      syncPreservedWeight();
      clearError();
      hideResult();
    });

    weightInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateTdee();
      }
    });

    heightFtInput?.addEventListener('input', () => {
      syncPreservedHeightFromImperial();
      clearError();
      hideResult();
    });

    heightFtInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateTdee();
      }
    });

    heightInInput?.addEventListener('input', () => {
      syncPreservedHeightFromImperial();
      clearError();
      hideResult();
    });

    heightInInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateTdee();
      }
    });

    heightCmInput?.addEventListener('input', () => {
      syncPreservedHeightFromMetric();
      clearError();
      hideResult();
    });

    heightCmInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateTdee();
      }
    });

    activitySelect?.addEventListener('change', () => {
      clearError();
      hideResult();
    });
  </script>
</Base>
