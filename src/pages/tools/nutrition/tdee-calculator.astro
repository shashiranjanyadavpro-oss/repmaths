---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'TDEE Calculator' },
];

const faqs = [
  {
    question: 'What is TDEE?',
    answer:
      'TDEE stands for Total Daily Energy Expenditure. It estimates the calories you burn in an average day, including resting energy expenditure, physical activity, exercise, and digestion.',
  },
  {
    question: 'How do I calculate my maintenance calories?',
    answer:
      'For Mifflin-St Jeor, enter your age, sex, weight, height, and activity level. For Katch-McArdle, enter your weight, body-fat percentage, and activity level. The calculator uses these details to estimate your maintenance calories.',
  },
  {
    question: 'What is the difference between BMR and TDEE?',
    answer:
      'BMR estimates the energy your body uses at rest under strict basal conditions. Mifflin-St Jeor predicts resting energy expenditure (REE/RMR), which may differ slightly from BMR because the measurement conditions are different. TDEE estimates total daily energy expenditure, including resting needs, physical activity, everyday movement, and digestion.',
  },
  {
    question: 'How accurate is the Mifflin-St Jeor equation?',
    answer:
      'Mifflin-St Jeor is a widely used predictive equation for resting energy expenditure. It performs reasonably well across many adult populations, but individual estimates can differ from measured expenditure.',
  },
  {
    question: 'Which TDEE activity multiplier should I choose?',
    answer:
      'Choose the level that reflects your total weekly movement, not just gym sessions. Consider walking, work, commuting, structured exercise, and time spent sitting.',
  },
  {
    question: 'How many calories below TDEE should I eat to lose weight?',
    answer:
      'A calorie deficit can support weight loss, but the appropriate amount varies by individual. This calculator illustrates 300- and 500-calorie adjustments, not personalized prescriptions. Monitor your weight trend and seek professional guidance when appropriate.',
  },
  {
    question: 'How many calories above TDEE should I eat to gain muscle?',
    answer:
      'A modest calorie surplus is commonly used during muscle-gain phases. This calculator illustrates 250- and 400-calorie additions. Adjust your intake according to body-weight changes, training progress, and individual needs.',
  },
  {
    question: 'Is my TDEE the same every day?',
    answer:
      'No. Actual daily expenditure varies with movement, exercise, food intake, and other factors. The calculator estimates an average daily requirement rather than measuring your exact expenditure.',
  },
  {
    question: 'How can I find my actual maintenance calories?',
    answer:
      'Use your calculated TDEE as a starting point. Track calorie intake consistently and compare average body-weight trends over several weeks. Adjust the estimate gradually based on your results.',
  },
  {
    question: 'What is the Katch-McArdle formula?',
    answer:
      'The Katch-McArdle formula (primary published source: Cunningham, 1991) estimates resting energy expenditure using lean body mass instead of total body weight. It can be useful when a reasonably accurate body-fat estimate is available. Its accuracy depends on the quality of that estimate.',
  },
  {
    question: 'What should I calculate after TDEE?',
    answer:
      'After estimating TDEE, you can calculate macronutrient targets (protein, carbs, fat) or focus on daily protein requirements. For a focused weight-loss plan, you can also explore an estimated calorie deficit. Related calculators are linked in the section below.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/tdee-calculator/#calculator',
  name: 'RepMaths TDEE Calculator',
  url: 'https://repmaths.com/tools/nutrition/tdee-calculator/',
  description:
    'Free calculator for estimating total daily energy expenditure, maintenance calories, and resting energy expenditure using the Mifflin-St Jeor and lean-body-mass equations.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="TDEE Calculator – Maintenance Calories | RepMaths"
  description="Free TDEE calculator to estimate maintenance calories with Mifflin-St Jeor or Katch-McArdle. See daily calorie needs and example cutting and bulking targets."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <div class="tool-page">
    <header class="tool-header">
      <p class="eyebrow">Nutrition &amp; Body Composition</p>
      <h1>TDEE Calculator: Estimate Your Maintenance Calories</h1>
      <p class="intro">
        Calculate your estimated maintenance calories and resting energy expenditure 
        using the Mifflin-St Jeor or Katch-McArdle equations.
      </p>
    </header>

    <aside class="quick-answer" aria-label="TDEE quick answer">
      <p>
  <strong>How do you calculate TDEE?</strong>
  First estimate your resting energy expenditure (REE) using the selected equation: Mifflin-St Jeor or Katch-McArdle. Then multiply REE by an activity multiplier to estimate your total daily energy expenditure (TDEE), also called maintenance calories.
  <strong>TDEE = Estimated REE × Activity Multiplier.</strong>
</p>
    </aside>

    <section id="calculator" class="calculator-card" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading" class="calculator-heading">
        Calculate Your Daily Calorie Needs
      </h2>
      <p class="field-help calculator-subtitle">Results update automatically as you enter your details.</p>

      <div class="field full">
        <span class="field-label">Formula</span>
        <div class="unit-toggle" role="group" aria-label="Calculation formula">
          <button type="button" class="unit-btn active" data-formula="mifflin" aria-pressed="true">Mifflin-St Jeor</button>
          <button type="button" class="unit-btn" data-formula="katch" aria-pressed="false">Katch-McArdle</button>
        </div>
        <p class="field-help">Katch-McArdle uses lean body mass and can be useful when you have a reasonably accurate body-fat estimate. Mifflin-St Jeor uses total body weight. Not sure? Stick with Mifflin-St Jeor.</p>
      </div>

      <div class="field">
        <span class="field-label" id="unit-label">Measurement units</span>
        <div class="unit-toggle" role="group" aria-labelledby="unit-label">
          <button type="button" class="unit-btn active" data-unit="imperial" aria-pressed="true">lb / ft-in</button>
          <button type="button" class="unit-btn" data-unit="metric" aria-pressed="false">kg / cm</button>
        </div>
      </div>

      <div class="form-grid">
        <div class="field" id="sex-field">
          <span class="field-label" id="sex-label">Sex</span>
          <div class="unit-toggle" role="group" aria-labelledby="sex-label">
            <button type="button" class="unit-btn active" data-sex="male" aria-pressed="true">Male</button>
            <button type="button" class="unit-btn" data-sex="female" aria-pressed="false">Female</button>
          </div>
          <p class="field-help">The Mifflin-St Jeor equation uses biological sex constants based on average body composition differences. If these do not represent your physiology, the estimate may be less applicable.</p>
        </div>

        <div class="field" id="age-field">
          <label for="age">Age (years)</label>
          <input type="number" id="age" placeholder="e.g. 28" inputmode="numeric" min="18" max="90" step="1" required aria-describedby="age-help error" />
          <p id="age-help" class="field-help">Input range: 18–90 years. The original Mifflin-St Jeor study included adults aged 19–78, so estimates outside that age range may be less reliable.</p>
        </div>

        <div class="field">
          <label for="weight" id="weight-label">Body weight (lb)</label>
          <input type="number" id="weight" placeholder="e.g. 180" inputmode="decimal" min="1" step="any" required aria-describedby="error" />
        </div>

        <div class="field" id="height-imperial-field">
          <span class="field-label" id="height-imperial-label">Height (feet and inches)</span>
          <div class="height-inputs" role="group" aria-labelledby="height-imperial-label">
            <div>
              <label for="height-ft">Feet</label>
              <input type="number" id="height-ft" placeholder="e.g. 5" inputmode="numeric" min="4" max="8" step="1" aria-describedby="error" />
            </div>
            <div>
              <label for="height-in">Inches</label>
              <input type="number" id="height-in" placeholder="e.g. 10" inputmode="numeric" min="0" max="11" step="1" aria-describedby="error" />
            </div>
          </div>
        </div>

        <div class="field" id="height-metric-field" hidden>
          <label for="height-cm">Height (cm)</label>
          <input type="number" id="height-cm" placeholder="e.g. 178" inputmode="decimal" min="121.92" max="243.84" step="any" aria-describedby="error" />
        </div>

        <div class="field" id="body-fat-field" hidden>
          <label for="body-fat">Body Fat %</label>
          <input type="number" id="body-fat" placeholder="e.g. 15" inputmode="decimal" min="3" max="60" step="0.1" aria-describedby="error" />
          <p class="field-help">Required for Katch-McArdle. Use our <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a> to estimate.</p>
        </div>

        <div class="field full">
          <label for="activity">Activity level</label>
          <select id="activity" aria-describedby="error">
            <option value="1.2">Sedentary — Mostly sitting, little daily movement</option>
            <option value="1.375" selected>Lightly active — Some walking and light exercise</option>
            <option value="1.55">Moderately active — Regular exercise and/or substantial daily movement</option>
            <option value="1.725">Very active — Hard training most days or an active physical job</option>
            <option value="1.9">Extra active — Very demanding physical work or intense training multiple times daily</option>
          </select>
          <p class="field-help">Include everyday movement and work activity, not only workouts. Multipliers are approximate estimates.</p>
          <div class="lifter-note-static">
            <strong>Note:</strong> A desk job with regular weight training does not automatically mean you are moderately active. Consider your daily steps, work, commuting, and total weekly movement when choosing a level.
          </div>
        </div>
      </div>

      <p id="error" class="message error" role="alert" hidden></p>

      <div id="results" class="results" hidden>
        <div id="result-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

        <div class="result-primary">
          <span class="result-label">Your Estimated Maintenance Calories</span>
          <strong id="result-tdee">—</strong>
          <span class="result-unit">kcal per day (estimated TDEE)</span>
          <p class="calculator-note result-note">
            A sustained average intake below estimated TDEE may support weight loss, while an intake above it may support weight gain. Actual results vary.
          </p>
        </div>

        <p id="result-bmr-line" class="calculator-note result-line-strong"></p>
        <p id="result-formula" class="calculator-note result-line"></p>

        <div class="target-table-wrap">
          <table class="result-table">
            <caption>Illustrative daily calorie targets</caption>
            <thead>
              <tr>
                <th scope="col">Goal</th>
                <th scope="col">Daily calories</th>
              </tr>
            </thead>
            <tbody id="result-table-body">
              <!-- Dynamic rows injected here -->
            </tbody>
          </table>
        </div>

        <p id="warning" class="message warning" hidden></p>

        <p class="calculator-note result-disclaimer">
          Cutting and gaining adjustments are examples, not individualized recommendations.
        </p>

        <div class="macro-teaser" id="macro-teaser" hidden>
          <h3>Example Maintenance Macro Split (40/30/30)</h3>
          <p class="macro-teaser-sub">
            An example split for a <strong id="macro-target">—</strong> kcal target — not a universal recommendation.
          </p>
          <div class="macro-grid">
            <div>
              <strong id="macro-protein">—</strong>
              <span>g protein</span>
            </div>
            <div>
              <strong id="macro-carbs">—</strong>
              <span>g carbs</span>
            </div>
            <div>
              <strong id="macro-fat">—</strong>
              <span>g fat</span>
            </div>
          </div>
          <a href="/tools/nutrition/macro-calculator/" class="macro-cta">
            Customize your macros →
          </a>
        </div>

        <div class="result-actions">
          <a href="/tools/nutrition/calorie-deficit-calculator/" class="btn-primary">
            Plan a Calorie Deficit
          </a>
          <a href="/tools/nutrition/macro-calculator/" class="btn-secondary">
            Calculate Macros
          </a>
          <a href="/tools/nutrition/protein-calculator/" class="btn-secondary">
            Calculate Protein
          </a>
        </div>
      </div>

      <p class="calculator-note">
        This calculator provides estimates for adults and is not medical advice.
      </p>
    </section>

    <section class="content-section">
      <h2>What Is TDEE?</h2>
      <p>
        <strong>TDEE (Total Daily Energy Expenditure)</strong> is the estimated total number of calories your body uses in an average day. It includes resting energy expenditure, exercise, everyday movement, and the energy required to digest food.
      </p>
      <p>
        Your TDEE is commonly used as an estimate of your <strong>maintenance calories</strong>: the daily energy intake that may maintain your current body weight when averaged over time.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Calculate TDEE: Formula and Method</h2>
      <p>
        RepMaths first estimates resting energy expenditure using your selected equation — Mifflin-St Jeor or Katch-McArdle — then applies your selected activity multiplier to estimate TDEE.
      </p>

      <div class="formula-box">
        <strong>Mifflin-St Jeor — Men:</strong><br />
        <code>REE = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) + 5</code>
        <br /><br />
        <strong>Mifflin-St Jeor — Women:</strong><br />
        <code>REE = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) − 161</code>
      </div>

      <div class="formula-box">
        <strong>Lean Body Mass Equation (Cunningham, 1991):</strong><br />
        <code>REE = 370 + (21.6 × Lean Body Mass in kg)</code>
        <br /><br />
        <p class="formula-box-note">This equation is commonly referred to as the Katch-McArdle formula in fitness calculators. Cunningham (1991) is a primary published source for the lean-body-mass-based prediction equation shown here.</p>
      </div>

      <div class="formula-box">
        <strong>TDEE = Estimated REE × Activity Multiplier</strong>
      </div>
      
      <p>
        Although some online calculators label this result as BMR, the Mifflin-St Jeor equation predicts resting energy expenditure (REE/RMR), not a direct laboratory measurement of basal metabolic rate.
      </p>
      
      <p>
        You can also use the dedicated <a href="/tools/nutrition/bmr-calculator/">BMR Calculator</a> to explore resting calorie needs separately.
      </p>
    </section>

    <section class="content-section">
      <h2>TDEE Calculation Examples (Mifflin-St Jeor &amp; Katch-McArdle)</h2>
      
      <h3>Example 1: Mifflin-St Jeor</h3>
      <p>
        Consider a 30-year-old man weighing 80 kg and measuring 180 cm, with a moderately active lifestyle.
      </p>
      <ol>
        <li>
          <strong>Step 1 — Estimated REE:</strong> <code>1,780 kcal/day</code>
        </li>
        <li>
          <strong>Step 2 — Activity factor:</strong> <code>1.55</code>
        </li>
        <li>
          <strong>Step 3 — Estimated TDEE:</strong> <code>1,780 × 1.55 = 2,759 kcal/day</code>
        </li>
      </ol>

      <h3>Example 2: Lean Body Mass Equation</h3>
      <p>
        Consider the same man (80 kg) with an estimated body-fat percentage of 15%.
      </p>
      <ol>
        <li>
          <strong>Step 1 — Lean Body Mass:</strong> <code>80 kg × (1 - 0.15) = 68 kg</code>
        </li>
        <li>
          <strong>Step 2 — Estimated REE:</strong> <code>370 + (21.6 × 68) = 1,839 kcal/day</code>
        </li>
        <li>
          <strong>Step 3 — Estimated TDEE (×1.55):</strong> <code>1,839 × 1.55 = 2,850 kcal/day</code>
        </li>
      </ol>
      <p>
        These are initial maintenance estimates, not a guarantee that eating exactly these calories will maintain weight.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Validate Your TDEE Estimate</h2>
      <p>
        A calculated TDEE is a starting estimate, not a fixed rule. To find your <em>actual</em> maintenance calories, use a feedback-based approach:
      </p>
      <ol>
        <li>Calculate your initial TDEE estimate using this tool.</li>
        <li>Track your daily calorie intake consistently for 2–3 weeks.</li>
        <li>Weigh yourself daily (or most days) and calculate your average weekly body weight.</li>
        <li>Compare your average weight trend to your goal (maintain, lose, or gain).</li>
        <li>Adjust your calorie intake gradually based on real-world results.</li>
      </ol>
      <p>
        Because daily weight fluctuates due to water, sodium, and digestion, weekly averages are more reliable than single-day weigh-ins.
      </p>
    </section>

    <section class="content-section">
      <h2>Why Is My TDEE Different From Another Calculator?</h2>
      <p>
        If you use multiple TDEE calculators, you may get slightly different results. This is normal because:
      </p>
      <ul>
        <li><strong>Formula differences:</strong> Mifflin-St Jeor and Katch-McArdle use different variables (total weight vs lean mass).</li>
        <li><strong>Activity multipliers:</strong> Some sites use 1.4 for "lightly active", while others use 1.375.</li>
        <li><strong>Rounding:</strong> Some calculators round intermediate numbers, leading to a slight drift.</li>
        <li><strong>Body-fat accuracy:</strong> Katch-McArdle depends on an accurate body-fat estimate. Measurement errors in body fat will directly affect your calculated resting energy expenditure.</li>
      </ul>
      <p>
        Rather than chasing a "perfect" calculator, use one formula consistently and adjust your intake based on your weight trend.
      </p>
    </section>

    <section class="content-section">
      <h2>TDEE Activity Level Multipliers Explained</h2>
      <div class="comparison-table-wrap">
        <table>
          <caption>Common activity factors used by this calculator</caption>
          <thead>
            <tr>
              <th scope="col">Activity level</th>
              <th scope="col">Multiplier</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Sedentary</td><td>1.2</td><td>Mostly sitting, little daily movement</td></tr>
            <tr><td>Lightly active</td><td>1.375</td><td>Some walking and light exercise</td></tr>
            <tr><td>Moderately active</td><td>1.55</td><td>Regular exercise and/or substantial daily movement</td></tr>
            <tr><td>Very active</td><td>1.725</td><td>Hard training most days or an active physical job</td></tr>
            <tr><td>Extra active</td><td>1.9</td><td>Very demanding physical work or intense training multiple times daily</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        These multipliers are broad planning estimates rather than precise measurements. When unsure, select a conservative activity level and refine your maintenance estimate using your actual weight trend.
      </p>
    </section>

    <section class="content-section">
      <h2>Using TDEE for Weight Loss and Cutting</h2>
      <p>
        A calorie deficit occurs when average calorie intake is lower than energy expenditure. This calculator displays illustrative targets 300 and 500 calories below estimated maintenance.
      </p>
      <p>
        For a more focused starting estimate, visit the <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a>.
      </p>
    </section>

    <section class="content-section">
      <h2>Using TDEE for Muscle Gain and Bulking</h2>
      <p>
        When aiming to gain muscle, estimated TDEE can provide a maintenance reference. A modest calorie surplus is commonly used alongside progressive resistance training and sufficient dietary protein.
      </p>
    </section>

    <section class="content-section">
      <h2>Related Calculators</h2>
      <ul>
        <li><a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> — Split calories into protein, carbs, and fat.</li>
        <li><a href="/tools/nutrition/protein-calculator/">Protein Calculator</a> — Estimate daily protein targets.</li>
        <li><a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a> — Plan a fat-loss phase.</li>
        <li><a href="/tools/nutrition/bmr-calculator/">BMR Calculator</a> — Explore resting calorie needs separately.</li>
      </ul>
    </section>

    <section class="content-section sources">
      <h2>Sources and Further Reading</h2>
      <ul>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/2305711/" target="_blank" rel="noopener noreferrer">
            Mifflin et al. (1990) — A New Predictive Equation for Resting Energy Expenditure
          </a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/15883556/" target="_blank" rel="noopener noreferrer">
            Frankenfield et al. (2005) — Comparison of Predictive Equations for Resting Metabolic Rate
          </a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/1957828/" target="_blank" rel="noopener noreferrer">
            Cunningham (1991) — Body Composition as a Determinant of Energy Expenditure
          </a>
        </li>
        <li>
          <a href="https://www.niddk.nih.gov/health-information/weight-management" target="_blank" rel="noopener noreferrer">
            NIDDK — Weight Management Information
          </a>
        </li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <RelatedTools currentToolId="tdee-calculator" />
  </div>

  <style>
    .tool-page { max-width: 900px; margin: 0 auto; }
    .tool-header { margin-bottom: 28px; }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .tool-header h1 {
      margin: 0 0 16px;
      font-size: clamp(1.8rem, 4vw, 2.55rem);
      line-height: 1.12;
    }

    .intro {
      max-width: 760px;
      margin: 0;
      color: var(--text-muted);
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .quick-answer {
      background: var(--surface);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 16px 18px;
      margin: 0 0 24px;
    }
    .quick-answer p { margin: 0; color: #c7cbd2; font-size: 0.92rem; line-height: 1.6; }
    .quick-answer strong { color: var(--accent); }

    .calculator-card {
      padding: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.14);
    }
    .calculator-card h2 { margin: 0 0 20px; font-size: 1.3rem; }
    .calculator-subtitle { margin: -12px 0 20px; }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .field { min-width: 0; }
    .field.full { grid-column: 1 / -1; }

    label,
    .field-label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      min-height: 46px;
      padding: 10px 12px;
      color: var(--text);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      font: inherit;
    }

    input:focus,
    select:focus,
    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .height-inputs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .height-inputs > div { min-width: 0; }
    .height-inputs label { display: block; }

    .unit-toggle {
      display: inline-flex;
      margin-bottom: 8px;
      padding: 3px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .unit-btn {
      min-width: 58px;
      padding: 5px 10px;
      border: 0;
      border-radius: 7px;
      color: var(--text-muted);
