  </style>

  <script>
    // ---------- Element refs ----------
    const sexEl = document.querySelector("#sex") as HTMLSelectElement;
    const ageEl = document.querySelector("#age") as HTMLInputElement;
    const weightLbEl = document.querySelector("#weight-lb") as HTMLInputElement;
    const heightFtEl = document.querySelector("#height-ft") as HTMLInputElement;
    const heightInEl = document.querySelector("#height-in") as HTMLInputElement;
    const weightKgEl = document.querySelector("#weight-kg") as HTMLInputElement;
    const heightCmEl = document.querySelector("#height-cm") as HTMLInputElement;

    const weightLbField = document.querySelector("#weight-lb-field") as HTMLElement;
    const heightImperialField = document.querySelector("#height-imperial-field") as HTMLElement;
    const weightKgField = document.querySelector("#weight-kg-field") as HTMLElement;
    const heightCmField = document.querySelector("#height-cm-field") as HTMLElement;

    const errorEl = document.querySelector("#error")!;
    const warningEl = document.querySelector("#warning")!;
    const resultBmrEl = document.querySelector("#result-bmr")!;
    const resultKjEl = document.querySelector("#result-kj")!;
    const resultAnnouncement = document.querySelector("#result-announcement")!;

    const tdeePreview = document.querySelector("#tdee-preview") as HTMLElement;
    const tdeeSedentaryEl = document.querySelector("#tdee-sedentary")!;
    const tdeeLightEl = document.querySelector("#tdee-light")!;
    const tdeeModerateEl = document.querySelector("#tdee-moderate")!;

    // ---------- State ----------
    type UnitSystem = "imperial" | "metric";
    type Formula = "mifflin" | "harris";

    let unitSystem: UnitSystem = "imperial";
    let formula: Formula = "mifflin";

    // Preserved canonical values (always stored in metric — kg / cm)
    let preservedWeightKg: number | null = null;
    let preservedHeightCm: number | null = null;

    // Errors are only shown on explicit triggers (Enter key or blur).
    let showErrors = false;

    // Debounce
    let calculateTimeout: number | null = null;
    const DEBOUNCE_MS = 300;

    const LB_TO_KG = 0.45359237;
    const IN_TO_CM = 2.54;

    // Canonical height range — exact 4 ft 0 in to 8 ft 0 in.
    const HEIGHT_MIN_CM = 4 * 12 * IN_TO_CM;   // 121.92 cm
    const HEIGHT_MAX_CM = 8 * 12 * IN_TO_CM;   // 243.84 cm

    // Standard TDEE activity multipliers
    const ACTIVITY_SEDENTARY = 1.2;
    const ACTIVITY_LIGHT = 1.375;
    const ACTIVITY_MODERATE = 1.55;

    // ---------- Helpers ----------
    const hasScientificNotation = (input: HTMLInputElement) =>
      input.value.trim().toLowerCase().includes("e");

    function hideResults() {
      resultBmrEl.textContent = "—";
      resultKjEl.textContent = "—";
      tdeePreview.hidden = true;
      tdeeSedentaryEl.textContent = "—";
      tdeeLightEl.textContent = "—";
      tdeeModerateEl.textContent = "—";
    }

    function setError(msg: string) {
      errorEl.textContent = msg;
      errorEl.removeAttribute("hidden");
      warningEl.setAttribute("hidden", "");
      hideResults();
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function silentFail() {
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
      hideResults();
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function fail(msg: string) {
      if (showErrors) setError(msg);
      else silentFail();
    }

    function clearMessages() {
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
    }

    function resetResult() {
      hideResults();
      clearMessages();
    }

    // ---------- Debounce helpers ----------
    function cancelScheduledCalculate() {
      if (calculateTimeout !== null) {
        clearTimeout(calculateTimeout);
        calculateTimeout = null;
      }
    }

    function scheduleCalculate() {
      cancelScheduledCalculate();
      calculateTimeout = window.setTimeout(() => {
        calculateTimeout = null;
        if (areRequiredFieldsFilled()) calculate();
      }, DEBOUNCE_MS);
    }

    function immediateCalculate() {
      cancelScheduledCalculate();
      if (areRequiredFieldsFilled()) calculate();
    }

    // Force calculation — used on Enter key and blur so missing-field or
    // invalid-value errors are surfaced to the user.
    function forceCalculate() {
      cancelScheduledCalculate();
      calculate();
    }

    function areRequiredFieldsFilled(): boolean {
      if (ageEl.value.trim() === "") return false;
      if (unitSystem === "imperial") {
        if (
          weightLbEl.value.trim() === "" ||
          heightFtEl.value.trim() === "" ||
          heightInEl.value.trim() === ""
        ) return false;
      } else {
        if (
          weightKgEl.value.trim() === "" ||
          heightCmEl.value.trim() === ""
        ) return false;
      }
      return true;
    }

    // Only the inputs visible in the current unit system participate in
    // scientific-notation validation. Hidden fields must never block
    // calculation for the visible set.
    function getRelevantNumericInputs(): HTMLInputElement[] {
      return unitSystem === "imperial"
        ? [ageEl, weightLbEl, heightFtEl, heightInEl]
        : [ageEl, weightKgEl, heightCmEl];
    }

    // ---------- Preserved-value sync ----------
    // Only called from user input listeners. Rejects scientific notation
    // so that a subsequent unit toggle cannot bypass validation.
    function syncPreservedValues() {
      if (unitSystem === "imperial") {
        const lbRaw = weightLbEl.value.trim();
        if (lbRaw === "" || lbRaw.toLowerCase().includes("e")) {
          preservedWeightKg = null;
        } else {
          const lb = Number(lbRaw);
          preservedWeightKg = Number.isFinite(lb) && lb > 0 ? lb * LB_TO_KG : null;
        }

        const ftRaw = heightFtEl.value.trim();
        const inRaw = heightInEl.value.trim();
        if (
          ftRaw === "" ||
          inRaw === "" ||
          ftRaw.toLowerCase().includes("e") ||
          inRaw.toLowerCase().includes("e")
        ) {
          preservedHeightCm = null;
        } else {
          const ft = Number(ftRaw);
          const inches = Number(inRaw);
          if (
            Number.isFinite(ft) &&
            Number.isFinite(inches) &&
            Number.isInteger(ft) &&
            ft >= 4 &&
            ft <= 8 &&
            inches >= 0 &&
            inches < 12 &&
            !(ft === 8 && inches > 0)
          ) {
            preservedHeightCm = ((ft * 12) + inches) * IN_TO_CM;
          } else {
            preservedHeightCm = null;
          }
        }
      } else {
        const kgRaw = weightKgEl.value.trim();
        if (kgRaw === "" || kgRaw.toLowerCase().includes("e")) {
          preservedWeightKg = null;
        } else {
          const kg = Number(kgRaw);
          preservedWeightKg = Number.isFinite(kg) && kg > 0 ? kg : null;
        }

        const cmRaw = heightCmEl.value.trim();
        if (cmRaw === "" || cmRaw.toLowerCase().includes("e")) {
          preservedHeightCm = null;
        } else {
          const cm = Number(cmRaw);
          preservedHeightCm = Number.isFinite(cm) && cm > 0 ? cm : null;
        }
      }
    }

    // ---------- Unit system toggle ----------
    function setUnitSystem(next: UnitSystem) {
      if (next === unitSystem) return;

      if (next === "metric") {
        if (preservedWeightKg !== null && preservedWeightKg > 0) {
          weightKgEl.value = preservedWeightKg.toFixed(1);
        } else {
          weightKgEl.value = "";
        }

        if (preservedHeightCm !== null && preservedHeightCm > 0) {
          const clampedCm = Math.min(
            Math.max(preservedHeightCm, HEIGHT_MIN_CM),
            HEIGHT_MAX_CM
          );
          heightCmEl.value = clampedCm.toFixed(1);
        } else {
          heightCmEl.value = "";
        }

        weightLbField.hidden = true;
        heightImperialField.hidden = true;
        weightKgField.hidden = false;
        heightCmField.hidden = false;
      } else {
        if (preservedWeightKg !== null && preservedWeightKg > 0) {
          const lb = preservedWeightKg / LB_TO_KG;
          weightLbEl.value = lb.toFixed(1);
        } else {
          weightLbEl.value = "";
        }

        if (preservedHeightCm !== null && preservedHeightCm > 0) {
          const clampedCm = Math.min(
            Math.max(preservedHeightCm, HEIGHT_MIN_CM),
            HEIGHT_MAX_CM
          );
          const totalInches = clampedCm / IN_TO_CM;
          let ft = Math.floor(totalInches / 12);
          let inches = Number((totalInches - ft * 12).toFixed(1));
          // Roll over if rounding pushes inches to 12
          if (inches >= 12) {
            ft += 1;
            inches = 0;
          }
          // Snap near-zero inches to 0 to avoid "8 ft 0.1 in" edge
          if (inches > 0 && inches < 0.15) inches = 0;
          // Clamp to 8 ft 0 in upper boundary
          if (ft > 8 || (ft === 8 && inches > 0)) {
            ft = 8;
            inches = 0;
          }
          heightFtEl.value = String(ft);
          heightInEl.value = inches.toFixed(1);
        } else {
          heightFtEl.value = "";
          heightInEl.value = "";
        }

        weightLbField.hidden = false;
        heightImperialField.hidden = false;
        weightKgField.hidden = true;
        heightCmField.hidden = true;
      }

      unitSystem = next;

      document.querySelectorAll("[data-unit]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.unit === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // ---------- Formula toggle ----------
    function setFormula(next: Formula) {
      if (next === formula) return;
      formula = next;

      document.querySelectorAll("[data-formula]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.formula === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // ---------- BMR calculation ----------
    function calculateBmr(weightKg: number, heightCm: number, age: number): number {
      const isMale = sexEl.value === "male";

      if (formula === "mifflin") {
        return isMale
          ? 10 * weightKg + 6.25 * heightCm - 5 * age + 5
          : 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
      }

      return isMale
        ? 13.397 * weightKg + 4.799 * heightCm - 5.677 * age + 88.362
        : 9.247 * weightKg + 3.098 * heightCm - 4.33 * age + 447.593;
    }

    // ---------- Calculate ----------
    function calculate() {
      clearMessages();

      if (getRelevantNumericInputs().some(hasScientificNotation)) {
        fail("Please enter numbers without scientific notation.");
        return;
      }

      if (ageEl.value.trim() === "") {
        fail("Please enter your age.");
        return;
      }
      if (unitSystem === "imperial") {
        if (
          weightLbEl.value.trim() === "" ||
          heightFtEl.value.trim() === "" ||
          heightInEl.value.trim() === ""
        ) {
          fail("Please fill in your weight and height.");
          return;
        }
      } else {
        if (
          weightKgEl.value.trim() === "" ||
          heightCmEl.value.trim() === ""
        ) {
          fail("Please fill in your weight and height.");
          return;
        }
      }

      const age = Number(ageEl.value);
      if (!Number.isFinite(age) || !Number.isInteger(age) || age < 18 || age > 90) {
        fail("Enter a whole-number age between 18 and 90.");
        return;
      }

      if (preservedWeightKg === null || preservedHeightCm === null) {
        if (unitSystem === "imperial") {
          fail("Enter a valid height between 4 ft 0 in and 8 ft 0 in (about 122–244 cm).");
        } else {
          fail("Enter valid weight and height measurements.");
        }
        return;
      }

      const weightKg = preservedWeightKg;
      const heightCm = preservedHeightCm;

      if (weightKg < 20 || weightKg > 500) {
        fail("Enter a valid weight between 20 and 500 kg (about 44–1,102 lb).");
        return;
      }

      if (heightCm < HEIGHT_MIN_CM - 0.05 || heightCm > HEIGHT_MAX_CM + 0.05) {
        fail("Enter a valid height between 4 ft 0 in and 8 ft 0 in (about 122–244 cm).");
        return;
      }

      const bmr = calculateBmr(weightKg, heightCm, age);

      if (!Number.isFinite(bmr) || bmr <= 0) {
        fail(
          "We could not calculate a valid BMR from those inputs. Please check your values and try again."
        );
        return;
      }

      displayResult(bmr);
    }

    function displayResult(bmr: number) {
      const rounded = Math.round(bmr);
      const kj = Math.round(rounded * 4.184);

      resultBmrEl.textContent = `${rounded.toLocaleString()}`;
      resultKjEl.textContent = `≈ ${kj.toLocaleString()} kJ/day`;

      const tdeeSedentary = Math.round(rounded * ACTIVITY_SEDENTARY);
      const tdeeLight = Math.round(rounded * ACTIVITY_LIGHT);
      const tdeeModerate = Math.round(rounded * ACTIVITY_MODERATE);

      tdeeSedentaryEl.textContent = `${tdeeSedentary.toLocaleString()} kcal`;
      tdeeLightEl.textContent = `${tdeeLight.toLocaleString()} kcal`;
      tdeeModerateEl.textContent = `${tdeeModerate.toLocaleString()} kcal`;
      tdeePreview.hidden = false;

      if (rounded < 1000) {
        warningEl.textContent =
          "Your calculated BMR is quite low. If this doesn't match your body size, double-check your inputs. Persistent very low values are worth discussing with a qualified healthcare professional.";
        warningEl.removeAttribute("hidden");
      }

      // Concise announcement — detailed TDEE values remain visible on page.
      if (resultAnnouncement) {
        resultAnnouncement.textContent =
          `Estimated BMR: ${rounded.toLocaleString()} kilocalories per day.`;
      }
    }

    // ---------- Event wiring ----------
    document.querySelectorAll<HTMLButtonElement>("[data-unit]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setUnitSystem(btn.dataset.unit as UnitSystem)
      );
    });

    document.querySelectorAll<HTMLButtonElement>("[data-formula]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setFormula(btn.dataset.formula as Formula)
      );
    });

    sexEl.addEventListener("change", () => {
      showErrors = false;
      resetResult();
      immediateCalculate();
    });

    const numericFields: HTMLInputElement[] = [
      ageEl,
      weightLbEl,
      heightFtEl,
      heightInEl,
      weightKgEl,
      heightCmEl,
    ];

    numericFields.forEach((el) => {
      el.addEventListener("input", () => {
        syncPreservedValues();
        showErrors = false;
        resetResult();
        scheduleCalculate();
      });
      // Blur — user finished with this field. Force calculation so any
      // missing-field or invalid-value errors are visible.
      el.addEventListener("blur", () => {
        syncPreservedValues();
        showErrors = true;
        forceCalculate();
      });
    });

    // Enter key → force calculation with visible errors
    document.querySelectorAll<HTMLInputElement>("input").forEach((el) => {
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          showErrors = true;
          syncPreservedValues();
          forceCalculate();
        }
      });
    });

    // ---------- Init ----------
    // Blank state on load — no calculate() call.
    syncPreservedValues();
  </script>
</Base>
