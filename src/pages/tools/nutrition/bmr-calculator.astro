---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const pageTitle = "BMR Calculator (Mifflin-St Jeor) — Basal Metabolic Rate";
const pageDescription =
  "Free BMR calculator using the Mifflin-St Jeor and Harris-Benedict equations. Calculate your basal metabolic rate and resting calorie needs using pounds and inches or kilograms and centimeters.";
---

<Base
  title={pageTitle}
  description={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BMR Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": pageDescription
  })} />

  <section class="hero">
    <h1>BMR Calculator (Mifflin-St Jeor)</h1>

    <p>
      Calculate your Basal Metabolic Rate (BMR) using the Mifflin-St Jeor or
      Harris-Benedict equation. Enter your weight in pounds or kilograms and
      height in feet/inches or centimeters.
    </p>
  </section>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="sr-only">
      Calculate Your Basal Metabolic Rate
    </h2>

    <div class="field">
      <label>Unit</label>

      <div class="unit-toggle" role="group" aria-label="Choose measurement unit">
        <button
          type="button"
          id="unit-imperial"
          class="active"
          aria-pressed="true"
        >
          lb / ft-in
        </button>

        <button
          type="button"
          id="unit-metric"
          aria-pressed="false"
        >
          kg / cm
        </button>
      </div>
    </div>

    <div class="field">
      <label for="sex">Sex</label>

      <select id="sex">
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>
    </div>

    <div class="field">
      <label>Formula</label>

      <div
        class="unit-toggle"
        role="group"
        aria-label="Choose BMR formula"
      >
        <button
          type="button"
          id="formula-mifflin"
          class="active"
          aria-pressed="true"
        >
          Mifflin-St Jeor
        </button>

        <button
          type="button"
          id="formula-harris"
          aria-pressed="false"
        >
          Harris-Benedict
        </button>
      </div>
    </div>

    <div class="field">
      <label for="age">Age</label>

      <input
        type="number"
        id="age"
        placeholder="e.g. 30"
        inputmode="numeric"
        min="18"
        max="90"
        step="1"
      />

      <small>Adults 18–90</small>
    </div>

    <div id="imperial-fields">
      <div class="field">
        <label for="weight-lb">Weight (lb)</label>

        <input
          type="number"
          id="weight-lb"
          placeholder="e.g. 175"
          inputmode="decimal"
          min="44"
          max="1102"
          step="0.1"
        />
      </div>

      <div class="field">
        <label>Height</label>

        <div class="height-row">
          <div>
            <label for="height-ft" class="sr-only">Feet</label>

            <input
              type="number"
              id="height-ft"
              placeholder="ft"
              inputmode="numeric"
              min="4"
              max="8"
              step="1"
            />
          </div>

          <div>
            <label for="height-in" class="sr-only">Inches</label>

            <input
              type="number"
              id="height-in"
              placeholder="in"
              inputmode="decimal"
              min="0"
              max="11.99"
              step="0.1"
            />
          </div>
        </div>
      </div>
    </div>

    <div id="metric-fields" hidden>
      <div class="field">
        <label for="weight-kg">Weight (kg)</label>

        <input
          type="number"
          id="weight-kg"
          placeholder="e.g. 79.4"
          inputmode="decimal"
          min="20"
          max="500"
          step="0.1"
        />
      </div>

      <div class="field">
        <label for="height-cm">Height (cm)</label>

        <input
          type="number"
          id="height-cm"
          placeholder="e.g. 178"
          inputmode="decimal"
          min="122"
          max="244"
          step="0.1"
        />
      </div>
    </div>

    <div
      id="input-error"
      class="input-error"
      role="alert"
      aria-live="assertive"
      hidden
    ></div>

    <button class="btn-primary" id="calc-btn">
      Calculate BMR
    </button>

    <div
      class="result-box"
      id="result-box"
      aria-live="polite"
      hidden
    >
      <div class="big-number" id="result-bmr">–</div>

      <div class="label">
        Estimated BMR
      </div>

      <p
        id="result-kj"
        style="margin:6px 0 0; font-size:0.85rem; opacity:0.75;"
      >
        Approx. 0 kJ/day
      </p>

      <p class="result-note">
        BMR is an estimate of the energy your body uses at rest to support
        essential physiological functions. It is not your total daily calorie
        requirement.
      </p>

      <a
        href="/tools/nutrition/tdee-calculator"
        class="btn-secondary"
      >
        Calculate Your TDEE →
      </a>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is Basal Metabolic Rate (BMR)?</h2>

    <p>
      Basal Metabolic Rate, or BMR, is an estimate of how much energy your
      body needs at rest to support essential functions such as breathing,
      circulation, and maintaining normal body processes.
    </p>

    <p>
      Your BMR is only one part of your overall energy needs. Daily movement,
      exercise, digestion, and other activities require additional energy.
      That is why BMR should not be treated as your maintenance calorie
      intake.
    </p>

    <p>
      This calculator is designed for adults ages 18–90 and provides
      estimates using two commonly used predictive equations.
    </p>
  </article>

  <article class="article-section">
    <h2>From BMR to TDEE: Understanding Your Daily Calorie Needs</h2>

    <p>
      BMR estimates resting energy expenditure, while
      <a href="/tools/nutrition/tdee-calculator">TDEE</a>
      estimates total daily energy expenditure after accounting for your
      activity level.
    </p>

    <p>
      In practical calorie planning, TDEE is usually more useful than BMR
      because it is intended to represent your total daily energy needs.
      Your actual energy requirements can still differ from any calculator
      estimate.
    </p>

    <p>
      If your goal is weight loss, you can use your estimated TDEE as a
      starting point and then use real-world changes in body weight,
      activity, nutrition, and performance to adjust your intake.
    </p>

    <p>
      For a more detailed estimate, use our
      <a href="/tools/nutrition/tdee-calculator">
        TDEE Calculator
      </a>.
    </p>
  </article>

  <article class="article-section">
    <h2>Comparing BMR Formulas: Mifflin-St Jeor and Harris-Benedict</h2>

    <p>
      This calculator provides two commonly used predictive equations for
      estimating resting energy expenditure.
    </p>

    <h3>Mifflin-St Jeor Equation</h3>

    <p>
      The Mifflin-St Jeor equation was developed from measured resting
      energy expenditure in healthy adults and is widely used as a
      predictive equation.
    </p>

    <p>
      For men:
      <code>BMR = 10 × weight(kg) + 6.25 × height(cm) − 5 × age + 5</code>
    </p>

    <p>
      For women:
      <code>BMR = 10 × weight(kg) + 6.25 × height(cm) − 5 × age − 161</code>
    </p>

    <h3>Revised Harris-Benedict Equation</h3>

    <p>
      The revised Harris-Benedict equation is an older predictive approach
      that is also widely referenced for estimating resting energy
      requirements.
    </p>

    <p>
      For men:
      <code>
        BMR = 13.397 × weight(kg) + 4.799 × height(cm) − 5.677 × age + 88.362
      </code>
    </p>

    <p>
      For women:
      <code>
        BMR = 9.247 × weight(kg) + 3.098 × height(cm) − 4.330 × age + 447.593
      </code>
    </p>

    <p>
      Predictive accuracy can vary between populations and individuals.
      Neither equation should be treated as an exact measurement of your
      personal resting energy expenditure.
    </p>
  </article>

  <article class="article-section">
    <h2>Factors That Affect Your BMR</h2>

    <p>
      BMR varies between individuals because resting energy needs depend on
      multiple characteristics rather than body weight alone.
    </p>

    <ul>
      <li><strong>Body size:</strong> Larger bodies generally require more energy at rest.</li>
      <li><strong>Height:</strong> Height contributes to the predictive equations used by this calculator.</li>
      <li><strong>Age:</strong> Estimated resting energy needs generally change as people age.</li>
      <li><strong>Sex:</strong> The equations use different constants for men and women.</li>
      <li><strong>Body composition:</strong> Lean tissue is metabolically active and contributes to resting energy expenditure.</li>
      <li><strong>Individual variation:</strong> Predictive equations cannot capture every factor affecting an individual's measured energy expenditure.</li>
    </ul>

    <p>
      Because of this variation, two people with the same height and weight
      can have different actual resting energy requirements.
    </p >
  </article>

  <article class="article-section">
    <h2>Using BMR as a Starting Point for Weight Loss</h2>

    <p>
      BMR should not be used by itself to determine a weight-loss calorie
      target. Your total daily energy expenditure is higher than your BMR
      because it also reflects movement, exercise, and other daily energy
      costs.
    </p>

    <p>
      A practical approach is to estimate your
      <a href="/tools/nutrition/tdee-calculator">TDEE</a>
      first, then choose a calorie intake that fits your goals and
      circumstances.
    </p>

    <p>
      If your goal is specifically fat loss, our
      <a href="/tools/nutrition/calorie-deficit-calculator">
        Calorie Deficit Calculator
      </a>
      can estimate a daily calorie target and projected weight-loss
      timeline.
    </p>

    <p>
      Calculator results are starting estimates. Your actual weight trend
      over several weeks can provide useful feedback when deciding whether
      your calorie intake needs adjustment.
    </p>
  </article>

  <article class="article-section">
    <h2>BMR vs. RMR: Are They the Same?</h2>

    <p>
      BMR and RMR are related concepts, but they are not identical
      measurements. Both describe resting energy expenditure, while the
      testing conditions used to measure basal and resting metabolic rates
      can differ.
    </p>

    <p>
      Online calculators such as this one provide predictive estimates rather
      than laboratory measurements. If you need a measured value, resting
      energy expenditure can be assessed using indirect calorimetry under
      controlled conditions.
    </p>
  </article>

  <article class="article-section">
    <h2>Sources & References</h2>

    <p>
      The equations used on this page are based on published research on
      predictive resting-energy equations. Calculator results are estimates
      and can differ from measured resting energy expenditure.
    </p>

    <ul>
      <li>
        Mifflin MD, St Jeor ST, Hill LA, Scott BJ, Daugherty SA, Koh YO.
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/2305711/"
          target="_blank"
          rel="noopener noreferrer"
        >
          A new predictive equation for resting energy expenditure in healthy individuals
        </a>.
        <em>American Journal of Clinical Nutrition</em>. 1990.
      </li>

      <li>
        Roza AM, Shizgal HM.
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/6741850/"
          target="_blank"
          rel="noopener noreferrer"
        >
          The Harris Benedict equation reevaluated: resting energy requirements and the body cell mass
        </a>.
        <em>American Journal of Clinical Nutrition</em>. 1984.
      </li>
    </ul>

    <p>
      Predictive equations should be interpreted as estimates rather than
      direct measurements. Individual accuracy can vary across populations
      and circumstances.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is a good BMR?</h3>

      <p>
        There is no single BMR value that is considered good or bad for
        everyone. BMR varies with factors such as body size, height, weight,
        age, sex, and body composition. A calculator estimate should be
        interpreted in the context of the individual rather than as a health
        score.
      </p>
    </div>

    <div class="faq-item">
      <h3>Should I eat my BMR or my TDEE to lose weight?</h3>

      <p>
        BMR estimates resting energy expenditure, while TDEE estimates total
        daily energy expenditure. For calorie planning, TDEE is generally the
        more useful starting point because it accounts for daily activity and
        exercise. Your appropriate calorie intake depends on your goals,
        circumstances, and real-world progress.
      </p>
    </div>

    <div class="faq-item">
      <h3>Is a BMR of 1500 good or bad?</h3>

      <p>
        A BMR of 1500 kcal/day is not inherently good or bad. Resting energy
        needs vary substantially between people, so a single BMR number
        cannot be used as a general health rating.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which BMR formula should I use?</h3>

      <p>
        There is no formula that is guaranteed to be the most accurate for
        every person. This calculator provides both Mifflin-St Jeor and
        revised Harris-Benedict estimates so you can compare commonly used
        predictive approaches.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can I use BMR to calculate calories for weight loss?</h3>

      <p>
        BMR alone does not represent your total daily calorie needs. A more
        useful approach is to estimate your
        <a href="/tools/nutrition/tdee-calculator">TDEE</a>
        and use that estimate as a starting point for calorie planning.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why can my BMR change when I lose weight?</h3>

      <p>
        Your estimated resting energy needs can change as your body weight
        and body composition change. A smaller body generally requires less
        energy to maintain at rest, although the amount of change varies
        between individuals.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does building muscle increase BMR?</h3>

      <p>
        Changes in body composition can affect resting energy expenditure
        because different tissues have different metabolic demands. However,
        the effect of gaining muscle on total daily calorie needs varies by
        person and should not be treated as a precise calorie multiplier.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can BMR be measured instead of calculated?</h3>

      <p>
        Yes. Resting energy expenditure can be measured using methods such as
        indirect calorimetry under controlled conditions. Online BMR
        calculators instead provide predictive estimates from variables such
        as age, sex, height, and weight.
      </p>
    </div>

    <div class="faq-item">
      <h3>What should I calculate after BMR?</h3>

      <p>
        The next practical step is usually estimating your
        <a href="/tools/nutrition/tdee-calculator">TDEE</a>,
        because TDEE accounts for daily activity and exercise. From there,
        you can explore calorie targets, macros, and protein based on your
        goal.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="bmr-calculator" />

  <script>
    let unitSystem = "imperial";
    let sex = "male";
    let formula = "mifflin";

    const unitImperial = document.getElementById("unit-imperial");
    const unitMetric = document.getElementById("unit-metric");

    const formulaMifflin = document.getElementById("formula-mifflin");
    const formulaHarris = document.getElementById("formula-harris");

    const sexInput =
      document.getElementById("sex") as HTMLSelectElement | null;

    const ageInput =
      document.getElementById("age") as HTMLInputElement | null;

    const weightLbInput =
      document.getElementById("weight-lb") as HTMLInputElement | null;

    const heightFtInput =
      document.getElementById("height-ft") as HTMLInputElement | null;

    const heightInInput =
      document.getElementById("height-in") as HTMLInputElement | null;

    const weightKgInput =
      document.getElementById("weight-kg") as HTMLInputElement | null;

    const heightCmInput =
      document.getElementById("height-cm") as HTMLInputElement | null;

    const imperialFields =
      document.getElementById("imperial-fields");

    const metricFields =
      document.getElementById("metric-fields");

    const calcBtn =
      document.getElementById("calc-btn");

    const resultBox =
      document.getElementById("result-box");

    const resultBmr =
      document.getElementById("result-bmr");

    const resultKj =
      document.getElementById("result-kj");

    const inputError =
      document.getElementById("input-error");


    if (unitImperial) {
      unitImperial.addEventListener("click", () => {
        setUnitSystem("imperial");
      });
    }

    if (unitMetric) {
      unitMetric.addEventListener("click", () => {
        setUnitSystem("metric");
      });
    }

    if (formulaMifflin) {
      formulaMifflin.addEventListener("click", () => {
        setFormula("mifflin");
      });
    }

    if (formulaHarris) {
      formulaHarris.addEventListener("click", () => {
        setFormula("harris");
      });
    }

    if (sexInput) {
      sexInput.addEventListener("change", () => {
        sex = sexInput.value;
      });
    }


    function setUnitSystem(newSystem: string) {
      if (newSystem === unitSystem) return;

      if (newSystem === "metric") {
        const currentLb = parseFloat(weightLbInput?.value || "");

        if (Number.isFinite(currentLb) && currentLb > 0 && weightKgInput) {
          weightKgInput.value =
            (currentLb / 2.20462).toFixed(1);
        }

        const ft = parseFloat(heightFtInput?.value || "");
        const inches = parseFloat(heightInInput?.value || "");

        if (
          Number.isFinite(ft) &&
          Number.isFinite(inches) &&
          heightCmInput
        ) {
          const totalInches = (ft * 12) + inches;

          heightCmInput.value =
            (totalInches * 2.54).toFixed(1);
        }
      } else {
        const currentKg = parseFloat(weightKgInput?.value || "");

        if (Number.isFinite(currentKg) && currentKg > 0 && weightLbInput) {
          weightLbInput.value =
            (currentKg * 2.20462).toFixed(1);
        }

        const cm = parseFloat(heightCmInput?.value || "");

        if (Number.isFinite(cm) && cm > 0) {
          const totalInches = cm / 2.54;
          const ft = Math.floor(totalInches / 12);
          const inches = totalInches - (ft * 12);

          if (heightFtInput) {
            heightFtInput.value = String(ft);
          }

          if (heightInInput) {
            heightInInput.value = inches.toFixed(1);
          }
        }
      }

      unitSystem = newSystem;

      updateUnitUI();
      clearError();
    }


    function updateUnitUI() {
      const isImperial = unitSystem === "imperial";

      if (unitImperial) {
        unitImperial.classList.toggle("active", isImperial);
        unitImperial.setAttribute(
          "aria-pressed",
          String(isImperial)
        );
      }

      if (unitMetric) {
        unitMetric.classList.toggle("active", !isImperial);
        unitMetric.setAttribute(
          "aria-pressed",
          String(!isImperial)
        );
      }

      if (imperialFields) {
        imperialFields.hidden = !isImperial;
      }

      if (metricFields) {
        metricFields.hidden = isImperial;
      }
    }


    function setFormula(newFormula: string) {
      formula = newFormula;

      const isMifflin = formula === "mifflin";

      if (formulaMifflin) {
        formulaMifflin.classList.toggle("active", isMifflin);
        formulaMifflin.setAttribute(
          "aria-pressed",
          String(isMifflin)
        );
      }

      if (formulaHarris) {
        formulaHarris.classList.toggle("active", !isMifflin);
        formulaHarris.setAttribute(
          "aria-pressed",
          String(!isMifflin)
        );
      }
    }


    function showError(message: string) {
      if (!inputError) return;

      inputError.textContent = message;
      inputError.hidden = false;

      if (resultBox) {
        resultBox.hidden = true;
      }
    }


    function clearError() {
      if (!inputError) return;

      inputError.textContent = "";
      inputError.hidden = true;
    }


    function getWeightKg(): number {
      if (unitSystem === "metric") {
        return parseFloat(weightKgInput?.value || "");
      }

      const weightLb = parseFloat(weightLbInput?.value || "");

      return weightLb / 2.20462;
    }


    function getHeightCm(): number {
      if (unitSystem === "metric") {
        return parseFloat(heightCmInput?.value || "");
      }

      const feet = parseFloat(heightFtInput?.value || "");
      const inches = parseFloat(heightInInput?.value || "");

      return ((feet * 12) + inches) * 2.54;
    }


    function calculateBmr(
      weightKg: number,
      heightCm: number,
      age: number
    ): number {
      if (formula === "mifflin") {
        if (sex === "male") {
          return (
            (10 * weightKg) +
            (6.25 * heightCm) -
            (5 * age) +
            5
          );
        }

        return (
          (10 * weightKg) +
          (6.25 * heightCm) -
          (5 * age) -
          161
        );
      }

      if (sex === "male") {
        return (
          (13.397 * weightKg) +
          (4.799 * heightCm) -
          (5.677 * age) +
          88.362
        );
      }

      return (
        (9.247 * weightKg) +
        (3.098 * heightCm) -
        (4.330 * age) +
        447.593
      );
    }


    function validateInputs(
      age: number,
      weightKg: number,
      heightCm: number
    ): boolean {
      if (
        !Number.isFinite(age) ||
        !Number.isInteger(age) ||
        age < 18 ||
        age > 90
      ) {
        showError(
          "Please enter an age from 18 to 90."
        );
        return false;
      }

      if (
        !Number.isFinite(weightKg) ||
        weightKg < 20 ||
        weightKg > 500
      ) {
        showError(
          "Please enter a valid body weight between 20 and 500 kg (about 44–1,102 lb)."
        );
        return false;
      }

      if (
        !Number.isFinite(heightCm) ||
        heightCm < 122 ||
        heightCm > 244
      ) {
        showError(
          "Please enter a valid height between 122 and 244 cm (about 4 ft and 8 ft)."
        );
        return false;
      }

      if (unitSystem === "imperial") {
        const feet = parseFloat(heightFtInput?.value || "");
        const inches = parseFloat(heightInInput?.value || "");

        if (
          !Number.isFinite(feet) ||
          !Number.isFinite(inches) ||
          feet < 4 ||
          feet > 8 ||
          inches < 0 ||
          inches >= 12
        ) {
          showError(
            "Please enter a valid height using feet and inches."
          );
          return false;
        }
      }

      return true;
    }


    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        clearError();

        const age = parseFloat(ageInput?.value || "");
        const weightKg = getWeightKg();
        const heightCm = getHeightCm();

        if (!validateInputs(age, weightKg, heightCm)) {
          return;
        }

        const bmr = calculateBmr(
          weightKg,
          heightCm,
          age
        );

        if (!Number.isFinite(bmr) || bmr <= 0) {
          showError(
            "We could not calculate a valid BMR from those inputs. Please check your values and try again."
          );
          return;
        }

        const rounded = Math.round(bmr);

        if (resultBmr) {
          resultBmr.textContent =
            `${rounded.toLocaleString()} kcal/day`;
        }

        if (resultKj) {
          resultKj.textContent =
            `Approx. ${Math.round(
              rounded * 4.184
            ).toLocaleString()} kJ/day`;
        }

        if (resultBox) {
          resultBox.hidden = false;
        }
      });
    }
  </script>
</Base>
