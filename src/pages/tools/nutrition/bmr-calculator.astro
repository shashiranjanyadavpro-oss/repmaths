---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="BMR Calculator (Mifflin-St Jeor) — Basal Metabolic Rate"
  description="Free BMR calculator using the Mifflin-St Jeor and Harris-Benedict equations. Estimate your basal metabolic rate and resting calorie needs from your age, sex, height, and weight."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BMR Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free online BMR calculator that estimates basal metabolic rate using the Mifflin-St Jeor or revised Harris-Benedict equation."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a good BMR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There is no single good BMR. Your estimated BMR depends mainly on body size, height, weight, age, and sex. A larger body generally requires more energy at rest, but individual values vary substantially."
        }
      },
      {
        "@type": "Question",
        "name": "How is BMR different from TDEE?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMR is an estimate of the energy your body requires for basic physiological functions under resting conditions. TDEE is your estimated total daily energy expenditure after accounting for activity, exercise, and the thermic effect of food."
        }
      },
      {
        "@type": "Question",
        "name": "Which BMR formula should I use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mifflin-St Jeor is a widely used predictive equation for resting energy expenditure and performs well in many adult populations. Harris-Benedict is an older alternative. Neither equation is exact for every individual, so results should be treated as estimates."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use BMR to calculate calories for weight loss?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMR is a resting estimate, not a complete daily calorie requirement. For weight-loss or maintenance planning, estimate TDEE first and then consider an appropriate calorie target based on your goals and individual circumstances."
        }
      },
      {
        "@type": "Question",
        "name": "Does building muscle increase BMR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Increasing lean mass can increase resting energy expenditure, although the size of the change varies between individuals. Muscle mass is one factor that contributes to resting calorie needs."
        }
      },
      {
        "@type": "Question",
        "name": "Can BMR be measured instead of calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Resting energy expenditure can be measured with indirect calorimetry under controlled conditions. Calculator formulas estimate resting energy needs from characteristics such as age, sex, height, and weight."
        }
      },
      {
        "@type": "Question",
        "name": "Does BMR decrease when you lose weight?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMR can decrease as body weight and lean mass change because a smaller body generally requires less energy to maintain at rest. The amount of change varies between individuals."
        }
      },
      {
        "@type": "Question",
        "name": "What should I calculate after BMR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your goal is calorie planning, calculate your TDEE next. You can then use a macro calculator to estimate macronutrient targets and a protein calculator to focus specifically on daily protein intake."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>BMR Calculator</h1>
    <p>
      Estimate your Basal Metabolic Rate — the energy your body uses to
      support essential functions at rest.
    </p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Units</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="unit-imperial"
          class="active"
          aria-pressed="true"
        >
          lb / ft-in
        </button>
        <button
          type="button"
          id="unit-metric"
          aria-pressed="false"
        >
          kg / cm
        </button>
      </div>
    </div>

    <div class="field">
      <label>Sex</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="sex-male"
          class="active"
          aria-pressed="true"
        >
          Male
        </button>
        <button
          type="button"
          id="sex-female"
          aria-pressed="false"
        >
          Female
        </button>
      </div>
    </div>

    <div class="field">
      <label>Formula</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="formula-mifflin"
          class="active"
          aria-pressed="true"
        >
          Mifflin-St Jeor
        </button>
        <button
          type="button"
          id="formula-harris"
          aria-pressed="false"
        >
          Harris-Benedict
        </button>
      </div>
    </div>

    <div class="field">
      <label for="age">Age (18-90)</label>
      <input
        type="number"
        id="age"
        placeholder="e.g. 28"
        inputmode="numeric"
        min="18"
        max="90"
      />
    </div>

    <div class="field">
      <label for="weight">Weight</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 180"
        inputmode="decimal"
        min="1"
      />
    </div>

    <div id="imperial-height" class="field">
      <label>Height</label>
      <div style="display:flex; gap:8px;">
        <input
          type="number"
          id="height-ft"
          placeholder="ft"
          inputmode="numeric"
          min="0"
          max="8"
          style="flex:1;"
        />
        <input
          type="number"
          id="height-in"
          placeholder="in (0-11)"
          inputmode="numeric"
          min="0"
          max="11"
          style="flex:1;"
        />
      </div>
    </div>

    <div
      id="metric-height"
      class="field"
      style="display:none;"
    >
      <label for="height-cm">Height (cm)</label>
      <input
        type="number"
        id="height-cm"
        placeholder="e.g. 178"
        inputmode="decimal"
        min="1"
      />
    </div>

    <button class="btn-primary" id="calc-btn">
      Calculate BMR
    </button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-bmr">–</div>

      <div class="label" id="result-label">
        Estimated Basal Metabolic Rate
      </div>

      <p
        id="result-note"
        style="margin:10px 0 0; font-size:0.9rem; opacity:0.85;"
      >
        This is an estimate of resting energy needs, not a personalized
        daily calorie target.
      </p>

      <a
        href="/tools/nutrition/tdee-calculator"
        class="btn-primary"
        style="display:block; text-decoration:none; margin-top:14px;"
      >
        Calculate Your Full TDEE →
      </a>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is Basal Metabolic Rate (BMR)?</h2>

    <p>
      Basal Metabolic Rate (BMR) is an estimate of the energy your body
      requires to support essential physiological functions at rest, such
      as breathing, circulation, and maintaining normal cellular activity.
      It does not represent the calories you burn from exercise, walking,
      daily movement, or digestion.
    </p>

    <p>
      Online BMR calculators use predictive equations rather than directly
      measuring your metabolism. Your result is therefore an estimate based
      on factors such as age, sex, height, and body weight.
    </p>
  </article>

  <article class="article-section">
    <h2>BMR vs. TDEE</h2>

    <ul>
      <li>
        <strong>BMR:</strong> Estimated energy required for essential
        functions under resting conditions.
      </li>
      <li>
        <strong>TDEE:</strong> Estimated total daily energy expenditure,
        including activity, exercise, and the thermic effect of food.
      </li>
    </ul>

    <p>
      BMR is only one part of your overall daily energy expenditure.
      If you're trying to estimate calories for maintenance, fat loss,
      or muscle gain, your
      <a href="/tools/nutrition/tdee-calculator">TDEE Calculator</a>
      is more useful because it accounts for your activity level.
    </p>

    <p>
      You can then use your estimated TDEE together with your individual
      goal, food intake, training, and progress over time rather than
      treating your BMR as a daily calorie target.
    </p>
  </article>

  <article class="article-section">
    <h2>Mifflin-St Jeor vs. Harris-Benedict</h2>

    <p>
      This calculator provides two commonly used predictive equations for
      estimating resting energy expenditure. Mifflin-St Jeor is widely
      used in modern nutrition practice and performed well compared with
      several other commonly used equations in a systematic review.
      However, predictive accuracy varies by population and no equation
      gives an exact result for every individual.
    </p>

    <table class="result-table">
      <thead>
        <tr>
          <th>Equation</th>
          <th>Notes</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Mifflin-St Jeor (1990)</td>
          <td>
            Widely used predictive equation for adult resting energy
            expenditure.
          </td>
        </tr>

        <tr>
          <td>Harris-Benedict (revised 1984)</td>
          <td>
            Older predictive equation that remains widely referenced
            and used as an alternative estimate.
          </td>
        </tr>
      </tbody>
    </table>

    <h3>Mifflin-St Jeor Formula</h3>

    <p>
      <strong>Men:</strong><br />
      10 × weight(kg) + 6.25 × height(cm) − 5 × age + 5
    </p>

    <p>
      <strong>Women:</strong><br />
      10 × weight(kg) + 6.25 × height(cm) − 5 × age − 161
    </p>

    <h3>Revised Harris-Benedict Formula</h3>

    <p>
      <strong>Men:</strong><br />
      13.397 × weight(kg) + 4.799 × height(cm) − 5.677 × age + 88.362
    </p>

    <p>
      <strong>Women:</strong><br />
      9.247 × weight(kg) + 3.098 × height(cm) − 4.330 × age + 447.593
    </p>
  </article>

  <article class="article-section">
    <h2>Factors That Affect Your BMR</h2>

    <ul>
      <li>
        <strong>Body size:</strong> Larger bodies generally require more
        energy to maintain basic physiological functions.
      </li>

      <li>
        <strong>Lean mass:</strong> Muscle and other metabolically active
        tissues contribute to resting energy expenditure.
      </li>

      <li>
        <strong>Age:</strong> Resting energy needs often change with age,
        partly because body composition and lean mass can change.
      </li>

      <li>
        <strong>Sex:</strong> Sex is included as a variable in commonly
        used BMR equations because average body composition and energy
        requirements differ between populations.
      </li>

      <li>
        <strong>Body composition:</strong> Two people with the same
        body weight can have different resting energy needs because
        their lean and fat mass can differ.
      </li>
    </ul>
  </article>

  <article class="article-section">
    <h2>BMR Calculator for Weight Loss</h2>

    <p>
      Your BMR can be useful as a starting point for understanding your
      resting calorie needs, but it should not be treated as your complete
      daily calorie requirement.
    </p>

    <p>
  A common approach is to estimate your
  <a href="/tools/nutrition/tdee-calculator">TDEE</a>
  first, then use your goals and real-world progress to determine an
  appropriate calorie intake. Your actual energy needs can differ from
  a calculator estimate, so changes in body weight and performance over
  time provide useful feedback.
</p>

<p>
  If your goal is fat loss, you can then use our
  <a href="/tools/nutrition/calorie-deficit-calculator">
    Calorie Deficit Calculator
  </a>
  to estimate a daily calorie target and projected weight-loss timeline.
</p>

    <p>
      For a broader nutrition plan, you can also use the
      <a href="/tools/nutrition/macro-calculator">Macro Calculator</a>
      to estimate protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>BMR vs. RMR: Are They the Same?</h2>

    <p>
      BMR and Resting Metabolic Rate (RMR) are closely related concepts,
      but they are not technically identical. BMR refers to energy
      expenditure measured under strict basal conditions, while RMR is
      generally measured under somewhat less restrictive resting
      conditions.
    </p>

    <p>
      Many online calculators use the terms interchangeably because both
      describe resting energy expenditure. For practical calorie-planning
      purposes, remember that a calculator result is an estimate rather
      than a direct measurement of your metabolism.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is a good BMR?</h3>
      <p>
        There is no single "good" BMR. Your estimated resting calorie
        needs depend on factors such as body size, height, weight, age,
        sex, and body composition. Two people of the same age can have
        very different BMR values.
      </p>
    </div>

    <div class="faq-item">
      <h3>How is BMR different from TDEE?</h3>
      <p>
        BMR estimates energy required for essential functions at rest.
        TDEE estimates your total daily energy expenditure after adding
        activity, exercise, and the thermic effect of food.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which BMR formula should I use?</h3>
      <p>
        Mifflin-St Jeor is a widely used predictive equation and has
        performed well in many adult populations. Harris-Benedict is an
        older alternative. Neither formula is exact for every individual.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can I use BMR to calculate calories for weight loss?</h3>
      <p>
        BMR alone does not account for your daily movement and exercise.
        Estimate your TDEE first, then use your goals and real-world
        progress to guide your calorie intake.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does building muscle increase BMR?</h3>
      <p>
        Increasing lean mass can increase resting energy expenditure,
        although the size of the change varies between individuals.
        Muscle mass is one of several factors affecting resting calorie
        needs.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can BMR be measured instead of calculated?</h3>
      <p>
        Yes. Resting energy expenditure can be measured with indirect
        calorimetry under controlled conditions. A calculator instead
        estimates energy needs from characteristics such as age, sex,
        height, and weight.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does BMR decrease when you lose weight?</h3>
      <p>
        BMR can decrease as body weight and lean mass change because a
        smaller body generally requires less energy to maintain at rest.
        The amount of change varies between individuals.
      </p>
    </div>

    <div class="faq-item">
      <h3>What should I calculate after BMR?</h3>
      <p>
        If your goal is calorie planning, calculate your
        <a href="/tools/nutrition/tdee-calculator">TDEE</a>
        next. You can then use the
        <a href="/tools/nutrition/macro-calculator">Macro Calculator</a>
        to estimate macronutrient targets and the
        <a href="/tools/nutrition/protein-calculator">Protein Calculator</a>
        to focus specifically on daily protein intake.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="bmr-calculator" />

  <script>
    let unitSystem = "imperial";
    let sex = "male";
    let formula = "mifflin";

    const unitImperial = document.getElementById("unit-imperial");
    const unitMetric = document.getElementById("unit-metric");

    const sexMale = document.getElementById("sex-male");
    const sexFemale = document.getElementById("sex-female");

    const formulaMifflin = document.getElementById("formula-mifflin");
    const formulaHarris = document.getElementById("formula-harris");

    const imperialHeight = document.getElementById("imperial-height");
    const metricHeight = document.getElementById("metric-height");

    const ageInput =
      document.getElementById("age") as HTMLInputElement | null;

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const heightFtInput =
      document.getElementById("height-ft") as HTMLInputElement | null;

    const heightInInput =
      document.getElementById("height-in") as HTMLInputElement | null;

    const heightCmInput =
      document.getElementById("height-cm") as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");

    const resultBmr =
      document.getElementById("result-bmr");

    const resultBox =
      document.getElementById("result-box");

    const resultNote =
      document.getElementById("result-note");

    if (unitImperial) {
      unitImperial.addEventListener("click", () => {
        setUnitSystem("imperial");
      });
    }

    if (unitMetric) {
      unitMetric.addEventListener("click", () => {
        setUnitSystem("metric");
      });
    }

    if (sexMale) {
      sexMale.addEventListener("click", () => {
        setSex("male");
      });
    }

    if (sexFemale) {
      sexFemale.addEventListener("click", () => {
        setSex("female");
      });
    }

    if (formulaMifflin) {
      formulaMifflin.addEventListener("click", () => {
        setFormula("mifflin");
      });
    }

    if (formulaHarris) {
      formulaHarris.addEventListener("click", () => {
        setFormula("harris");
      });
    }

    function setUnitSystem(sys: string) {
      unitSystem = sys;

      if (unitImperial) {
        unitImperial.classList.toggle(
          "active",
          sys === "imperial"
        );

        unitImperial.setAttribute(
          "aria-pressed",
          String(sys === "imperial")
        );
      }

      if (unitMetric) {
        unitMetric.classList.toggle(
          "active",
          sys === "metric"
        );

        unitMetric.setAttribute(
          "aria-pressed",
          String(sys === "metric")
        );
      }

      if (imperialHeight) {
        (imperialHeight as HTMLElement).style.display =
          sys === "imperial" ? "block" : "none";
      }

      if (metricHeight) {
        (metricHeight as HTMLElement).style.display =
          sys === "metric" ? "block" : "none";
      }
    }

    function setSex(s: string) {
      sex = s;

      if (sexMale) {
        sexMale.classList.toggle(
          "active",
          s === "male"
        );

        sexMale.setAttribute(
          "aria-pressed",
          String(s === "male")
        );
      }

      if (sexFemale) {
        sexFemale.classList.toggle(
          "active",
          s === "female"
        );

        sexFemale.setAttribute(
          "aria-pressed",
          String(s === "female")
        );
      }
    }

    function setFormula(f: string) {
      formula = f;

      if (formulaMifflin) {
        formulaMifflin.classList.toggle(
          "active",
          f === "mifflin"
        );

        formulaMifflin.setAttribute(
          "aria-pressed",
          String(f === "mifflin")
        );
      }

      if (formulaHarris) {
        formulaHarris.classList.toggle(
          "active",
          f === "harris"
        );

        formulaHarris.setAttribute(
          "aria-pressed",
          String(f === "harris")
        );
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!ageInput || !weightInput) return;

        const age = parseFloat(ageInput.value);
        const weightRaw = parseFloat(weightInput.value);

        if (!Number.isFinite(age) || age < 18 || age > 90) {
          alert("Please enter a valid adult age between 18 and 90.");
          return;
        }

        if (
          !Number.isFinite(weightRaw) ||
          weightRaw <= 0
        ) {
          alert("Please enter a valid weight.");
          return;
        }

        let weightKg: number;
        let heightCm: number;

        if (unitSystem === "imperial") {
          const ft = parseFloat(
            heightFtInput?.value || "0"
          );

          const inch = parseFloat(
            heightInInput?.value || "0"
          );

          if (
            !Number.isFinite(ft) ||
            !Number.isFinite(inch) ||
            (ft <= 0 && inch <= 0)
          ) {
            alert("Please enter a valid height.");
            return;
          }

          if (ft < 0 || ft > 8) {
            alert("Feet must be between 0 and 8.");
            return;
          }

          if (inch < 0 || inch > 11) {
            alert("Inches must be between 0 and 11.");
            return;
          }

          const totalInches =
            ft * 12 + inch;

          if (
            totalInches < 48 ||
            totalInches > 96
          ) {
            alert("Please enter a realistic height between 4 ft and 8 ft.");
            return;
          }

          weightKg =
            weightRaw / 2.20462;

          heightCm =
            totalInches * 2.54;

          if (
            weightKg < 20 ||
            weightKg > 500
          ) {
            alert("Please enter a realistic body weight.");
            return;
          }
        } else {
          const cm = parseFloat(
            heightCmInput?.value || "0"
          );

          if (
            !Number.isFinite(cm) ||
            cm <= 0
          ) {
            alert("Please enter a valid height.");
            return;
          }

          if (cm < 122 || cm > 244) {
            alert("Please enter a realistic height between 122 and 244 cm.");
            return;
          }

          weightKg = weightRaw;
          heightCm = cm;

          if (
            weightKg < 20 ||
            weightKg > 500
          ) {
            alert("Please enter a realistic body weight.");
            return;
          }
        }

        let bmr: number;

        if (formula === "mifflin") {
          bmr =
            sex === "male"
              ? (
                  10 * weightKg +
                  6.25 * heightCm -
                  5 * age +
                  5
                )
              : (
                  10 * weightKg +
                  6.25 * heightCm -
                  5 * age -
                  161
                );
        } else {
          bmr =
            sex === "male"
              ? (
                  13.397 * weightKg +
                  4.799 * heightCm -
                  5.677 * age +
                  88.362
                )
              : (
                  9.247 * weightKg +
                  3.098 * heightCm -
                  4.330 * age +
                  447.593
                );
        }

        const rounded = Math.round(bmr);

        if (resultBmr) {
          resultBmr.textContent =
            `${rounded} kcal/day`;
        }

        if (resultNote) {
          resultNote.textContent =
            `${formula === "mifflin" ? "Mifflin-St Jeor" : "Revised Harris-Benedict"} estimate. This is a resting-energy estimate, not a personalized daily calorie target.`;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
