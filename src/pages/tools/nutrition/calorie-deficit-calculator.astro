---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'Calorie Deficit Calculator' },
];

const faqs = [
  {
    question: 'What is a calorie deficit?',
    answer:
      'A calorie deficit occurs when you consume fewer calories than your body uses. Your estimated TDEE represents the calories needed to maintain your current weight, so eating below that level creates an estimated energy deficit.',
  },
  {
    question: 'How do you calculate a calorie deficit?',
    answer:
      'First estimate your BMR, then estimate TDEE by applying an activity factor. Your estimated calorie deficit is the difference between TDEE and your planned daily calorie intake.',
  },
  {
    question: 'Is a 500 calorie deficit good for weight loss?',
    answer:
      'A <strong>500-calorie daily deficit</strong> is a commonly used planning benchmark and corresponds to about 3,500 calories per week. Using the simple 3,500-calorie rule gives an initial estimate of about <strong>1 pound of weight loss per week</strong>, but real-world weight change varies as energy expenditure and body weight change.',
  },
  {
    question: 'How long will it take to lose weight with a calorie deficit?',
    answer:
      'A simple planning estimate divides the calories associated with the weight you want to lose by your planned weekly calorie deficit. The result is only an estimate because real-world weight loss is not perfectly linear.',
  },
  {
    question: 'How many calories should I eat to lose weight?',
    answer:
      'A useful starting point is to estimate your TDEE and choose a moderate calorie reduction rather than using the same calorie target for everyone. Your age, body size, sex, activity level, health status, and goal all affect your calorie needs.',
  },
  {
    question: 'Is a large calorie deficit safe?',
    answer:
      'Larger calorie deficits can increase the risk of inadequate nutrition, fatigue, hunger, and loss of lean tissue. A more moderate approach is generally easier to sustain, and people with medical conditions or special nutritional needs should discuss calorie restriction with a qualified healthcare professional.',
  },
  {
    question: 'Is a 1,000-calorie deficit safe?',
    answer:
      'A <strong>1,000-calorie daily deficit</strong> may be appropriate for some people with higher baseline maintenance calories, but it is not recommended as a default approach. It corresponds to roughly 2 lb (0.9 kg) of weight loss per week and increases the risk of muscle loss and inadequate nutrition if protein intake and training are not optimized. Medical supervision is often advisable.',
  },
  {
    question: 'Do you always lose a pound a week with a 500-calorie deficit?',
    answer:
      '<strong>On paper, yes</strong> — 500 kcal × 7 days = 3,500 kcal, which is the traditional estimate for 1 lb of fat. <strong>In practice, no.</strong> Weight loss tends to slow as your body becomes lighter, because a smaller body burns fewer calories. This is called adaptive thermogenesis, and it is one of the main reasons real-world weight loss rarely follows a straight line.',
  },
  {
    question: 'Should I eat back the calories I burn from exercise?',
    answer:
      '<strong>Usually, no.</strong> The activity level you select in this calculator is intended to already include your typical weekly exercise. If you also add back the calories your smartwatch reports, you may double-count the same energy and erase much of your planned deficit.',
  },
  {
    question: 'Why does weight loss slow down over time?',
    answer:
      'As you lose weight, your BMR and TDEE both decrease because moving a lighter body requires less energy. The same calorie target that produced a 500-calorie deficit at your starting weight produces a smaller deficit as you get lighter. Recalculating every 10 lb (4.5 kg) helps keep your target aligned with your current body weight.',
  },
  {
    question: 'Can I use this calculator for a 1 pound per week weight-loss goal?',
    answer:
      'Yes. Select the <strong>1 lb per week</strong> option. The calculator uses the traditional 3,500-calorie-per-pound planning heuristic to estimate the required daily deficit and an approximate timeline.',
  },
  {
    question: 'Can I use this calculator for a 2 pound per week goal?',
    answer:
      'Yes, but a 2 lb per week goal requires a substantially larger estimated calorie deficit. The calculator flags when the resulting intake becomes very low, and aggressive calorie restriction should not be treated as appropriate for everyone.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/calorie-deficit-calculator/#calculator',
  name: 'Calorie Deficit Calculator',
  alternateName: 'Weight Loss Calorie Calculator',
  url: 'https://repmaths.com/tools/nutrition/calorie-deficit-calculator/',
  description:
    'Free calorie deficit calculator for weight loss. Estimate BMR, TDEE, daily calorie target, weekly loss rate, and time to reach your goal weight.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="Calorie Deficit Calculator — Weight Loss & Timeline"
  description="Free calorie deficit calculator for weight loss. Estimate BMR, TDEE, daily calorie target, weekly loss rate, and time to reach your goal weight."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <div class="tool-page">
    <header class="tool-header">
      <p class="eyebrow">Weight Loss &amp; Nutrition</p>
      <h1>Calorie Deficit Calculator</h1>

      <p class="intro">
        A calorie deficit occurs when you consume fewer calories than your body
        uses. Use this calculator to estimate your BMR, TDEE, daily calorie
        target, calorie deficit, weekly weight-loss rate, and approximate
        timeline for reaching your goal weight.
      </p>
    </header>

    <aside class="quick-answer" aria-label="Calorie deficit quick answer">
      <p>
        <strong>What is a calorie deficit?</strong> A calorie deficit is the
        gap between the calories your body uses (TDEE) and the calories you
        eat. A daily deficit of <strong>500 kcal</strong> is often used as a
        planning target for roughly <strong>1 lb (0.45 kg) per week</strong> of
        weight loss. Formula: <code>Calorie Deficit = TDEE − Daily Calorie Target</code>.
      </p>
    </aside>

    <section class="calculator-card" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading">Calculate Your Calorie Deficit</h2>

      <div class="form-grid">
        <div class="field">
          <label for="sex">Sex</label>
          <select id="sex">
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
        </div>

        <div class="field">
          <label for="age">Age</label>
          <div class="input-with-unit">
            <input id="age" type="number" min="18" max="90" value="30" step="1" inputmode="numeric" />
            <span>years</span>
          </div>
        </div>

        <div class="field">
          <label>Weight</label>
          <div class="unit-toggle" role="group" aria-label="Weight unit">
            <button type="button" class="unit-btn active" data-weight-unit="lb">lb</button>
            <button type="button" class="unit-btn" data-weight-unit="kg">kg</button>
          </div>
          <div class="input-with-unit">
            <input id="weight" type="number" min="66" max="660" value="180" step="0.1" inputmode="decimal" />
            <span id="weight-unit-label">lb</span>
          </div>
        </div>

        <div class="field">
          <label>Height</label>
          <div class="unit-toggle" role="group" aria-label="Height unit">
            <button type="button" class="unit-btn active" data-height-unit="ft">ft/in</button>
            <button type="button" class="unit-btn" data-height-unit="cm">cm</button>
          </div>

          <div id="imperial-height" class="height-row">
            <div class="input-with-unit">
              <input id="height-ft" type="number" min="4" max="8" value="5" step="1" inputmode="numeric" />
              <span>ft</span>
            </div>
            <div class="input-with-unit">
              <input id="height-in" type="number" min="0" max="11" value="10" step="1" inputmode="numeric" />
              <span>in</span>
            </div>
          </div>

          <div id="metric-height" class="input-with-unit hidden">
            <input id="height-cm" type="number" min="122" max="244" value="178" step="0.1" inputmode="decimal" />
            <span>cm</span>
          </div>
        </div>

        <div class="field full">
          <label for="activity">Activity level</label>
          <select id="activity">
            <option value="1.2">Sedentary — little or no exercise</option>
            <option value="1.375">Lightly active — exercise 1–3 days/week</option>
            <option value="1.55" selected>Moderately active — exercise 3–5 days/week</option>
            <option value="1.725">Very active — hard exercise 6–7 days/week</option>
            <option value="1.9">Extra active — very hard training / physical job</option>
          </select>
        </div>

        <div class="field">
          <label for="goal-weight">Goal weight</label>
          <div class="input-with-unit">
            <input id="goal-weight" type="number" min="66" max="660" value="160" step="0.1" inputmode="decimal" />
            <span id="goal-unit-label">lb</span>
          </div>
        </div>

        <div class="field">
          <label for="loss-rate">Weight-loss rate</label>
          <select id="loss-rate">
            <option value="0.5">0.5 lb / week (0.23 kg)</option>
            <option value="1" selected>1 lb / week (0.45 kg)</option>
            <option value="1.5">1.5 lb / week (0.68 kg)</option>
            <option value="2">2 lb / week (0.91 kg)</option>
          </select>
        </div>
      </div>

      <p id="error" class="message error" role="alert" hidden></p>

      <div id="results" class="results">
        <div
          id="result-announcement"
          class="sr-only"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></div>

        <div class="result-primary">
          <span class="result-label">Estimated daily calorie target</span>
          <strong id="calorie-target">—</strong>
          <span class="result-unit">kcal/day</span>
        </div>

        <div class="result-grid">
          <div class="result-box">
            <span>BMR</span>
            <strong id="bmr">—</strong>
            <small>kcal/day</small>
          </div>
          <div class="result-box">
            <span>TDEE</span>
            <strong id="tdee">—</strong>
            <small>kcal/day</small>
          </div>
          <div class="result-box">
            <span>Daily deficit</span>
            <strong id="daily-deficit">—</strong>
            <small>kcal/day</small>
          </div>
          <div class="result-box">
            <span>Weekly loss estimate</span>
            <strong id="weekly-loss">—</strong>
            <small>lb/week</small>
          </div>
        </div>

        <div class="timeline">
          <div class="timeline-visual" aria-hidden="true">
            <div class="timeline-labels">
              <span>Start: <strong id="timeline-start">—</strong></span>
              <span>Goal: <strong id="timeline-goal">—</strong></span>
            </div>
            <div class="timeline-bar">
              <span class="timeline-start-dot"></span>
              <span class="timeline-goal-dot"></span>
            </div>
          </div>

          <span class="result-label">Estimated time to goal</span>
          <strong id="timeline">—</strong>
          <p id="timeline-detail"></p>
          <p class="timeline-eta">
            Estimated goal date: <strong id="timeline-eta">—</strong>
          </p>
        </div>

        <div class="macro-teaser" id="macro-teaser">
          <h3>Example macro split (40/30/30)</h3>
          <p class="macro-teaser-sub">
            This is <strong>one example split</strong> for a
            <strong id="macro-target">—</strong> kcal target — not a universal
            recommendation. Protein needs depend on body weight, training, and
            individual circumstances. Customize for your goals.
          </p>
          <div class="macro-grid">
            <div>
              <strong id="macro-protein">—</strong>
              <span>g protein</span>
            </div>
            <div>
              <strong id="macro-carbs">—</strong>
              <span>g carbs</span>
            </div>
            <div>
              <strong id="macro-fat">—</strong>
              <span>g fat</span>
            </div>
          </div>
          <a href="/tools/nutrition/macro-calculator/" class="macro-cta">
            Customize your macros →
          </a>
        </div>

        <p id="warning" class="message warning" hidden></p>
        <p id="goal-message" class="message info" hidden></p>
      </div>

      <p class="calculator-note">
        This calculator provides estimates for adults and is not medical advice.
        Actual weight change varies with adherence, activity, body composition,
        metabolism, and changes in energy expenditure over time.
      </p>
    </section>

    <section class="content-section">
      <h2>What Exactly Is a Calorie Deficit?</h2>

      <p>
        A calorie deficit means your energy intake is lower than the energy your
        body uses over time. Your estimated <strong>TDEE</strong> represents
        the calories you may need to maintain your current weight under your
        current activity pattern. Eating below that estimate creates a
        theoretical calorie deficit.
      </p>

      <p>
        The important word is <strong>estimate</strong>. TDEE is not a laboratory
        measurement, and your energy needs can change as your body weight,
        activity, and eating pattern change.
      </p>
    </section>

    <section class="content-section">
      <h2>How Is Your Calorie Deficit Calculated?</h2>

      <p>
        RepMaths uses a four-step calculation so you can see where the result
        comes from.
      </p>

      <ol>
        <li>
          <strong>Calculate BMR.</strong>
          Your basal metabolic rate is estimated with the
          <a href="https://pubmed.ncbi.nlm.nih.gov/2305711/" target="_blank" rel="noopener noreferrer">Mifflin–St Jeor equation</a>.
        </li>
        <li>
          <strong>Estimate TDEE.</strong>
          BMR is multiplied by an activity factor to estimate daily energy
          expenditure.
        </li>
        <li>
          <strong>Apply the selected deficit.</strong>
          A selected weekly weight-loss rate is converted into an estimated
          daily calorie deficit using the traditional 3,500-calorie-per-pound
          planning heuristic.
        </li>
        <li>
          <strong>Estimate the timeline.</strong>
          The amount of weight you want to lose is divided by the selected
          weekly rate to produce an approximate number of weeks.
        </li>
      </ol>

      <p>
        The 3,500-calorie-per-pound figure is useful as a simple planning
        heuristic, but it should not be interpreted as a precise biological
        rule. <a href="https://www.niddk.nih.gov/health-information/weight-management/body-weight-planner" target="_blank" rel="noopener noreferrer">NIDDK</a>
        notes that real-world weight loss slows as the body adapts and energy
        expenditure changes.
      </p>
    </section>

    <section class="content-section">
      <h2>Example Calculation: How to Estimate Your Calorie Deficit</h2>

      <p>
        Consider Mike, a 30-year-old male who weighs 180 lb (81.6 kg), is
        5&prime;10&Prime; (178 cm) tall, and is moderately active (exercises
        3&ndash;5 days per week). The numbers below are rounded for readability.
      </p>

      <ol>
        <li>
          <strong>Step 1 — BMR (Mifflin-St Jeor for men):</strong>
          <code>BMR = (10 × 81.6 kg) + (6.25 × 178 cm) − (5 × 30 years) + 5</code>
          <br />
          <code>BMR ≈ 1,784 kcal/day</code>
        </li>
        <li>
          <strong>Step 2 — TDEE at moderate activity:</strong>
          <code>TDEE ≈ 1,784 × 1.55 = 2,765 kcal/day</code>
        </li>
        <li>
          <strong>Step 3 — Daily deficit for 1 lb (0.45 kg) per week:</strong>
          <code>3,500 ÷ 7 = 500 kcal/day</code>
        </li>
        <li>
          <strong>Step 4 — Calorie target:</strong>
          <code>2,765 − 500 = 2,265 kcal/day</code>
        </li>
        <li>
          <strong>Step 5 — Timeline for a 20 lb (9.1 kg) goal:</strong>
          <code>20 lb ÷ 1 lb/week ≈ 20 weeks (≈ 4.6 months)</code>
        </li>
      </ol>

      <p>
        Because the calculator works with the exact values you enter (not the
        rounded numbers shown here), your live result may differ slightly from
        the numbers above.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Calculate a Calorie Deficit to Lose 1 lb (0.45 kg) a Week</h2>

      <p>
        A traditional planning model treats 1 pound as approximately 3,500
        calories. Dividing that amount across seven days gives an estimated
        <strong>500-calorie daily deficit</strong>.
      </p>

      <div class="formula-box">
        <strong>Example:</strong>
        TDEE 2,400 kcal − 500 kcal = approximately 1,900 kcal/day
      </div>

      <p>
        This is a planning estimate, not a promise that exactly 1 pound of
        body fat will be lost every week. <a href="https://www.nhlbi.nih.gov/files/docs/guidelines/obesity_guidelines_archive.pdf" target="_blank" rel="noopener noreferrer">NHLBI guidance</a>
        describes 500&ndash;1,000 kcal/day deficits as a traditional approach
        associated with roughly 1&ndash;2 lb (0.45&ndash;0.9 kg) per week in
        appropriate weight-management settings.
      </p>
    </section>

    <section class="content-section">
      <h2>500 Calorie Deficit Calculator</h2>

      <p>
        A 500-calorie deficit is one of the most familiar starting points in
        weight-loss planning. If your estimated TDEE is 2,400 calories,
        subtracting 500 gives an initial target of 1,900 calories per day.
      </p>

      <p>
        That does not mean 500 calories is automatically appropriate for every
        person. A calorie target should also make sense for your body size,
        activity, nutrition needs, health status, and ability to sustain it.
      </p>
    </section>

    <section class="content-section">
      <h2>Safe vs. Unhealthy Calorie Deficits: What You Need to Know</h2>

      <p>
        There is no single calorie deficit that is medically appropriate for
        every adult. Larger deficits can make it harder to meet nutrient needs
        and may increase hunger, fatigue, or loss of lean tissue.
      </p>

      <p>
        Older <a href="https://www.nhlbi.nih.gov/files/docs/guidelines/obesity_guidelines_archive.pdf" target="_blank" rel="noopener noreferrer">NIH/NHLBI guidance</a>
        describes approximately 1&ndash;2 pounds per week as a commonly used
        weight-loss range, but individual needs vary.
      </p>

      <p>
        If the calculator produces a very low calorie target, treat that as a
        reason to reconsider the selected rate rather than as a target to
        force. <a href="https://www.niddk.nih.gov/health-information/weight-management/just-enough-food-portions" target="_blank" rel="noopener noreferrer">NIDDK</a>
        also notes that calorie needs vary with factors including age, body
        weight, height, sex, metabolism, and activity.
      </p>

      <div class="callout">
        <strong>Important:</strong> Do not use this calculator to create an
        aggressive calorie restriction plan if you are pregnant or
        breastfeeding, under 18, have an eating disorder, or have a medical
        condition that affects nutrition or weight. Speak with a qualified
        healthcare professional for individualized guidance.
      </div>
    </section>

    <section class="content-section">
      <h2>Extreme vs. Moderate Calorie Deficit</h2>

      <div class="comparison-table-wrap">
        <table>
          <thead>
            <tr>
              <th>Approach</th>
              <th>Planning idea</th>
              <th>What to consider</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Moderate</td>
              <td>Smaller calorie reduction (roughly 300&ndash;500 kcal/day)</td>
              <td>Often easier to sustain and fit into a balanced diet</td>
            </tr>
            <tr>
              <td>Higher</td>
              <td>Larger calorie reduction (roughly 500&ndash;1,000 kcal/day)</td>
              <td>Requires more attention to hunger, nutrition, recovery, and adherence</td>
            </tr>
            <tr>
              <td>Very aggressive</td>
              <td>Large restriction (&gt;1,000 kcal/day or &lt;1,200 kcal total)</td>
              <td>Should not be treated as a routine self-directed approach</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Minimum Daily Calories for Weight Loss</h2>

      <p>
        There is no universal minimum calorie intake that is safe for every
        adult. Calorie needs depend on the individual, and very-low-calorie
        diets may require clinical supervision.
      </p>

      <p>
        For example,
        <a href="https://www.niddk.nih.gov/health-information/diabetes/overview/preventing-type-2-diabetes/game-plan" target="_blank" rel="noopener noreferrer">NIDDK advises</a>
        that eating below 1,200 calories per day is not advised in one of its
        weight-management programs, while older clinical guidance used
        different calorie ranges depending on sex, body size, and treatment
        context.
      </p>

      <p>
        Therefore, RepMaths uses a warning when a calculated target becomes
        unusually low rather than labeling a single number as universally
        &ldquo;safe.&rdquo;
      </p>
    </section>

    <section class="content-section">
      <h2>Should You Eat Back the Calories You Burn From Exercise?</h2>

      <p>
        <strong>Usually, no.</strong> The activity level you select in this
        calculator (sedentary through extra active) is intended to already
        include your typical weekly exercise. If you also add back the
        calories your smartwatch reports, you may double-count the same energy.
      </p>

      <p>
        A common pitfall is selecting &ldquo;Moderately active&rdquo; (which
        assumes 3&ndash;5 workouts per week) and then adding 300&ndash;500 kcal
        back on every training day. That can erase much of your planned
        deficit.
      </p>

      <p>
        If you want to account for exercise more precisely, choose a lower
        activity level (like &ldquo;Sedentary&rdquo; or &ldquo;Lightly
        active&rdquo;) and manually add your estimated exercise calories to
        your daily target. Just be consistent with whichever approach you
        choose.
      </p>
    </section>

    <section class="content-section">
      <h2>Will a Calorie Deficit Cause Muscle Loss?</h2>

      <p>
        A calorie deficit does not automatically cause muscle loss. However, if
        the deficit is aggressive, protein intake is low, or you are not doing
        resistance training, the risk of losing lean tissue increases.
      </p>

      <p>
        Research on weight loss consistently shows that the following factors
        help preserve muscle during a calorie deficit:
      </p>

      <ul>
        <li>
          <strong>Resistance training</strong> — 2 to 4 sessions per week,
          hitting each major muscle group.
        </li>
        <li>
          <strong>Adequate protein intake</strong> — roughly 1.6 to 2.4 g/kg of
          body weight per day (0.7 to 1.1 g/lb) is a commonly cited range
          during an energy deficit.
        </li>
        <li>
          <strong>A moderate deficit</strong> — smaller deficits (roughly
          300–500 kcal/day) tend to preserve lean mass better than aggressive
          deficits.
        </li>
        <li>
          <strong>Sufficient sleep and recovery</strong> — sleep deprivation
          can shift the composition of weight loss toward lean tissue.
        </li>
      </ul>

      <p>
        Use our <a href="/tools/nutrition/protein-calculator/">Protein Calculator</a>
        to estimate a practical daily protein target alongside your calorie
        deficit, and our <a href="/tools/nutrition/calories-burned-calculator/">Calories
        Burned Calculator</a> to estimate exercise-related energy expenditure.
      </p>
    </section>

    <section class="content-section">
      <h2>Why Recalculating Every 10 lb (4.5 kg) Helps</h2>

      <p>
        Calorie needs are not fixed. As you lose weight, your BMR and TDEE both
        decrease because moving a lighter body requires less energy. This means
        the same calorie target that produced a 500 kcal deficit at 200 lb
        produces a smaller deficit at 180 lb.
      </p>

      <p>
  Part of this reduction is expected: a lighter body naturally burns fewer
  calories at rest and during movement. Beyond that, some people also
  experience an additional metabolic adaptation — often called
  <strong>adaptive thermogenesis</strong> — where energy expenditure drops
  slightly more than predicted by changes in body weight alone.
</p>

<p>
  Research on weight-loss programs, including work cited by the
  <a href="https://www.niddk.nih.gov/health-information/weight-management/body-weight-planner" target="_blank" rel="noopener noreferrer">NIDDK Body Weight Planner</a>,
  has shown that real-world weight loss tends to slow over time even when
  calorie intake stays consistent. Recalculating periodically helps keep your
  target aligned with your current body weight.
</p>

      <h3>When recalculating tends to help</h3>
      <ul>
        <li>Every 10 lb (4.5 kg) of weight loss</li>
        <li>When your activity pattern changes significantly</li>
        <li>If the scale stops moving for 3&ndash;4 weeks while adherence is consistent</li>
        <li>Before starting a new training block or program</li>
      </ul>

      <p>
        Recalculating regularly keeps your calorie target aligned with your
        current body weight and prevents a stale plan from becoming a smaller
        deficit than you intended.
      </p>
    </section>

    <section class="content-section">
      <h2>Calorie Deficit Timeline Calculator</h2>

      <p>
        Your timeline depends on how much weight you want to lose and the
        weekly rate selected. For example, a 20 lb (9.1 kg) goal at an estimated
        1 lb/week rate gives a simple planning estimate of about 20 weeks.
      </p>

      <p>
        Real progress rarely follows a perfectly straight line. Water
        retention, changes in activity, appetite, body weight, and metabolic
        adaptation can all affect the rate of weight change. <a href="https://www.niddk.nih.gov/health-information/weight-management/body-weight-planner" target="_blank" rel="noopener noreferrer">NIDDK&rsquo;s Body Weight Planner</a>
        is specifically designed to account for changing energy expenditure
        over time.
      </p>
    </section>

    <section class="content-section">
      <h2>Basal Metabolic Rate and Calorie Deficit</h2>

      <p>
        BMR is the estimated energy your body uses at rest. TDEE goes beyond
        BMR by accounting for your activity level. A calorie deficit is
        calculated from your estimated total daily energy expenditure rather
        than from BMR alone.
      </p>

      <p>
        For a more detailed breakdown of basal metabolic rate, use the
        <a href="/tools/nutrition/bmr-calculator/">BMR Calculator</a>.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Use This Calculator</h2>

      <ol>
        <li>Enter your age and sex.</li>
        <li>Enter your body weight in pounds or kilograms.</li>
        <li>Enter your height.</li>
        <li>Select the activity level that best represents your normal routine.</li>
        <li>Enter your desired goal weight.</li>
        <li>Select a weekly weight-loss rate.</li>
        <li>Review your estimated BMR, TDEE, calorie target, deficit, and timeline.</li>
      </ol>

      <p>
        For another approach to daily calorie needs, compare your result with
        the <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a>.
        You can then use the
        <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>
        to turn a calorie target into protein, carbohydrate, and fat targets.
      </p>
    </section>

    <section class="content-section">
