  <script>
    const sexEl = document.querySelector("#sex") as HTMLSelectElement;
    const ageEl = document.querySelector("#age") as HTMLInputElement;
    const weightEl = document.querySelector("#weight") as HTMLInputElement;
    const goalWeightEl = document.querySelector("#goal-weight") as HTMLInputElement;
    const heightFtEl = document.querySelector("#height-ft") as HTMLInputElement;
    const heightInEl = document.querySelector("#height-in") as HTMLInputElement;
    const heightCmEl = document.querySelector("#height-cm") as HTMLInputElement;
    const activityEl = document.querySelector("#activity") as HTMLSelectElement;
    const lossRateEl = document.querySelector("#loss-rate") as HTMLSelectElement;

    const weightUnitLabel = document.querySelector("#weight-unit-label")!;
    const goalUnitLabel = document.querySelector("#goal-unit-label")!;
    const imperialHeight = document.querySelector("#imperial-height")!;
    const metricHeight = document.querySelector("#metric-height")!;
    const errorEl = document.querySelector("#error")!;
    const warningEl = document.querySelector("#warning")!;
    const goalMessageEl = document.querySelector("#goal-message")!;

    const calorieTargetEl = document.querySelector("#calorie-target")!;
    const bmrEl = document.querySelector("#bmr")!;
    const tdeeEl = document.querySelector("#tdee")!;
    const deficitEl = document.querySelector("#daily-deficit")!;
    const weeklyLossEl = document.querySelector("#weekly-loss")!;
    const timelineEl = document.querySelector("#timeline")!;
    const timelineDetailEl = document.querySelector("#timeline-detail")!;
    const timelineStartEl = document.querySelector("#timeline-start")!;
    const timelineGoalEl = document.querySelector("#timeline-goal")!;
    const timelineEtaEl = document.querySelector("#timeline-eta")!;
    const macroTargetEl = document.querySelector("#macro-target")!;
    const macroProteinEl = document.querySelector("#macro-protein")!;
    const macroCarbsEl = document.querySelector("#macro-carbs")!;
    const macroFatEl = document.querySelector("#macro-fat")!;
    const macroTeaser = document.querySelector("#macro-teaser") as HTMLElement | null;
    const resultAnnouncement = document.querySelector("#result-announcement")!;

    let weightUnit: "lb" | "kg" = "lb";
    let heightUnit: "ft" | "cm" = "ft";

    // Canonical metric values — preserved across unit toggles to avoid
    // cumulative rounding loss from repeated conversions.
    let preservedWeightKg: number | null = null;
    let preservedGoalKg: number | null = null;
    let preservedCm: number | null = null;

    const round = (value: number) => Math.round(value);
    const kgToLb = (kg: number) => kg * 2.2046226218;
    const lbToKg = (lb: number) => lb / 2.2046226218;

    function hideResults() {
      calorieTargetEl.textContent = "—";
      bmrEl.textContent = "—";
      tdeeEl.textContent = "—";
      deficitEl.textContent = "—";
      weeklyLossEl.textContent = "—";
      timelineEl.textContent = "—";
      timelineDetailEl.textContent = "";
      if (timelineStartEl) timelineStartEl.textContent = "—";
      if (timelineGoalEl) timelineGoalEl.textContent = "—";
      if (timelineEtaEl) timelineEtaEl.textContent = "—";
      if (macroTargetEl) macroTargetEl.textContent = "—";
      if (macroProteinEl) macroProteinEl.textContent = "—";
      if (macroCarbsEl) macroCarbsEl.textContent = "—";
      if (macroFatEl) macroFatEl.textContent = "—";
      if (macroTeaser) macroTeaser.setAttribute("hidden", "");
    }

    function setError(message: string) {
      errorEl.textContent = message;
      errorEl.removeAttribute("hidden");
      hideResults();
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function clearMessages() {
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
      goalMessageEl.setAttribute("hidden", "");
    }

    // Reject scientific notation and other non-standard numeric inputs.
    function hasScientificNotation(input: HTMLInputElement): boolean {
      const v = input.value.trim().toLowerCase();
      return v.includes("e");
    }

    function getHeightCm(): number | null {
  if (heightUnit === "cm") {
    if (heightCmEl.value.trim() === "") return null;
    const cm = Number(heightCmEl.value);
    return Number.isFinite(cm) && cm > 0 ? cm : null;
  }

  const ftRaw = heightFtEl.value.trim();
  const inRaw = heightInEl.value.trim();

  // Both fields must be non-empty
  if (ftRaw === "" || inRaw === "") return null;

  const ft = Number(ftRaw);
  const inches = Number(inRaw);

  if (!Number.isFinite(ft) || !Number.isFinite(inches)) return null;

  // Individual validation: feet must be whole number 4-8, inches must be whole number 0-11
  if (!Number.isInteger(ft) || ft < 4 || ft > 8) return null;
  if (!Number.isInteger(inches) || inches < 0 || inches > 11) return null;

  return ((ft * 12) + inches) * 2.54;
}

    function syncPreservedWeight() {
      const rawWeight = Number(weightEl.value);
      if (weightEl.value.trim() !== "" && Number.isFinite(rawWeight) && rawWeight > 0) {
        preservedWeightKg = weightUnit === "kg" ? rawWeight : lbToKg(rawWeight);
      } else {
        preservedWeightKg = null;
      }

      const rawGoal = Number(goalWeightEl.value);
      if (goalWeightEl.value.trim() !== "" && Number.isFinite(rawGoal) && rawGoal > 0) {
        preservedGoalKg = weightUnit === "kg" ? rawGoal : lbToKg(rawGoal);
      } else {
        preservedGoalKg = null;
      }
    }

    function syncPreservedHeight() {
      const cm = getHeightCm();
      if (cm !== null && cm >= 122 && cm <= 244) {
        preservedCm = cm;
      } else {
        preservedCm = null;
      }
    }

    // Initialize preserved values from HTML defaults on page load.
    function initializePreservedValues() {
      syncPreservedWeight();
      syncPreservedHeight();
    }

    function calculate() {
      clearMessages();

      // Reject scientific notation in numeric inputs
      if (
        hasScientificNotation(ageEl) ||
        hasScientificNotation(weightEl) ||
        hasScientificNotation(goalWeightEl) ||
        hasScientificNotation(heightFtEl) ||
        hasScientificNotation(heightInEl) ||
        hasScientificNotation(heightCmEl)
      ) {
        setError("Please enter numbers without scientific notation.");
        return;
      }

      // Explicit blank-input check — Number("") returns 0
      if (
        ageEl.value.trim() === "" ||
        weightEl.value.trim() === "" ||
        goalWeightEl.value.trim() === ""
      ) {
        setError("Please fill in all required fields.");
        return;
      }

      if (heightUnit === "cm") {
        if (heightCmEl.value.trim() === "") {
          setError("Please enter your height.");
          return;
        }
      } else {
        if (heightFtEl.value.trim() === "" && heightInEl.value.trim() === "") {
          setError("Please enter your height.");
          return;
        }
      }

      const age = Number(ageEl.value);
      const rawWeight = Number(weightEl.value);
      const rawGoalWeight = Number(goalWeightEl.value);
      const heightCm = preservedCm !== null ? preservedCm : getHeightCm();
      const activity = Number(activityEl.value);
      const weeklyLossLb = Number(lossRateEl.value);

      if (!Number.isFinite(age) || !Number.isInteger(age) || age < 18 || age > 90) {
  setError("Enter a whole-number age between 18 and 90.");
  return;
}

      if (!Number.isFinite(rawWeight) || rawWeight <= 0) {
        setError("Enter a valid current weight.");
        return;
      }

      if (!Number.isFinite(rawGoalWeight) || rawGoalWeight <= 0) {
        setError("Enter a valid goal weight.");
        return;
      }

      if (heightCm === null || !Number.isFinite(heightCm) || heightCm < 122 || heightCm > 244) {
        setError("Enter a realistic height between 122 and 244 cm (approximately 4 ft – 8 ft).");
        return;
      }

      const weightKg = preservedWeightKg !== null
        ? preservedWeightKg
        : (weightUnit === "kg" ? rawWeight : lbToKg(rawWeight));

      const goalWeightKg = preservedGoalKg !== null
        ? preservedGoalKg
        : (weightUnit === "kg" ? rawGoalWeight : lbToKg(rawGoalWeight));

      if (weightKg < 30 || weightKg > 300) {
        setError("Enter a current weight between 30 and 300 kg.");
        return;
      }

      if (goalWeightKg < 30 || goalWeightKg > 300) {
        setError("Enter a goal weight between 30 and 300 kg.");
        return;
      }

      if (goalWeightKg >= weightKg) {
        setError("Your goal weight must be lower than your current weight for a weight-loss calculation.");
        return;
      }

      const bmr = sexEl.value === "male"
        ? (10 * weightKg) + (6.25 * heightCm) - (5 * age) + 5
        : (10 * weightKg) + (6.25 * heightCm) - (5 * age) - 161;

      const tdee = bmr * activity;
      const dailyDeficit = (weeklyLossLb * 3500) / 7;
      const calorieTarget = tdee - dailyDeficit;

      const weightToLoseLb = kgToLb(weightKg - goalWeightKg);
      const weeks = weightToLoseLb / weeklyLossLb;

      const goalDate = new Date();
      goalDate.setDate(goalDate.getDate() + Math.round(weeks * 7));
      const goalDateStr = goalDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
      });

      // Only display calorie target as a number when it is a usable value (> 0)
if (calorieTarget > 0) {
  calorieTargetEl.textContent = `${round(calorieTarget).toLocaleString()}`;
} else {
  calorieTargetEl.textContent = "—";
}

bmrEl.textContent = `${round(bmr).toLocaleString()}`;
tdeeEl.textContent = `${round(tdee).toLocaleString()}`;
deficitEl.textContent = `${round(dailyDeficit).toLocaleString()}`;
weeklyLossEl.textContent = `${weeklyLossLb.toFixed(1)}`;

if (calorieTarget > 0 && weeks > 0 && Number.isFinite(weeks)) {
  timelineEl.textContent = `${weeks.toFixed(1)} weeks`;
  timelineDetailEl.textContent =
    `About ${Math.ceil(weeks)} weeks to lose approximately ${weightToLoseLb.toFixed(1)} lb (${(weightToLoseLb / 2.2046226218).toFixed(1)} kg) at the selected planning rate.`;

  if (timelineStartEl) {
    timelineStartEl.textContent = `${rawWeight.toFixed(1)} ${weightUnit}`;
  }
  if (timelineGoalEl) {
    timelineGoalEl.textContent = `${rawGoalWeight.toFixed(1)} ${weightUnit}`;
  }
  if (timelineEtaEl) {
    timelineEtaEl.textContent = `~${goalDateStr}`;
  }
} else {
  timelineEl.textContent = "—";
  timelineDetailEl.textContent = "";
  if (timelineStartEl) timelineStartEl.textContent = "—";
  if (timelineGoalEl) timelineGoalEl.textContent = "—";
  if (timelineEtaEl) timelineEtaEl.textContent = "—";
}

      // Macro teaser (example 40/30/30 split) — only when target is positive
      if (calorieTarget > 0 && macroTeaser) {
        const proteinCal = calorieTarget * 0.40;
        const carbsCal = calorieTarget * 0.30;
        const fatCal = calorieTarget * 0.30;

        if (macroTargetEl) {
          macroTargetEl.textContent = `${round(calorieTarget).toLocaleString()}`;
        }
        if (macroProteinEl) {
          macroProteinEl.textContent = `${round(proteinCal / 4).toLocaleString()}`;
        }
        if (macroCarbsEl) {
          macroCarbsEl.textContent = `${round(carbsCal / 4).toLocaleString()}`;
        }
        if (macroFatEl) {
          macroFatEl.textContent = `${round(fatCal / 9).toLocaleString()}`;
        }

        macroTeaser.removeAttribute("hidden");
      } else if (macroTeaser) {
        macroTeaser.setAttribute("hidden", "");
      }

      // Warning priority order (most critical first):
// 1. Zero/negative target — not usable at all
// 2. Very low target (< 1,200 kcal) — clinical guideline threshold
// 3. Sex-specific low target — contextual caution
// 4. Sub-BMR caution — informational, not a universal minimum

if (calorieTarget <= 0) {
  warningEl.textContent =
    "This selected weight-loss rate would require a calorie target at or below zero, which is not a usable plan. Choose a slower rate.";
  warningEl.removeAttribute("hidden");
} else if (calorieTarget < 1200) {
  warningEl.textContent =
    `Your calculated target is below 1,200 kcal/day. This is a very low calorie intake for most adults. Treat this as a warning to reconsider the selected weight-loss rate rather than a recommended intake. Very low calorie targets may not provide enough energy or nutrients without professional supervision.`;
  warningEl.removeAttribute("hidden");
} else if (
  (sexEl.value === "male" && calorieTarget < 1500) ||
  (sexEl.value === "female" && calorieTarget < 1200)
) {
  warningEl.textContent =
    `Your calculated calorie target is relatively low. Consider a slower weight-loss rate and seek professional guidance if you are unsure whether this intake is appropriate for you.`;
  warningEl.removeAttribute("hidden");
} else if (calorieTarget < bmr) {
  warningEl.textContent =
    `Your daily calorie target is below your estimated BMR of ${round(bmr).toLocaleString()} kcal. Sustained intake below BMR is uncommon as a routine approach and is often accompanied by closer professional guidance. Consider a slower weight-loss rate unless you are working with a qualified healthcare professional.`;
  warningEl.removeAttribute("hidden");
}

      if (weeks < 8) {
        goalMessageEl.textContent =
          "Your selected timeline is relatively short. A slower rate may be easier to sustain and may make it easier to meet nutrition needs.";
        goalMessageEl.removeAttribute("hidden");
      }

      if (weeks > 52) {
        goalMessageEl.textContent =
          "Longer timelines are normal for larger weight-loss goals. Real-world progress is rarely perfectly linear.";
        goalMessageEl.removeAttribute("hidden");
      }

      if (resultAnnouncement) {
        resultAnnouncement.textContent =
          `Estimated daily calorie target: ${round(calorieTarget).toLocaleString()} kcal. BMR: ${round(bmr).toLocaleString()} kcal. TDEE: ${round(tdee).toLocaleString()} kcal. Daily deficit: ${round(dailyDeficit).toLocaleString()} kcal. Estimated time to goal: ${weeks.toFixed(1)} weeks.`;
      }
    }

    document.querySelectorAll<HTMLButtonElement>("[data-weight-unit]").forEach((button) => {
      button.addEventListener("click", () => {
        const nextUnit = button.dataset.weightUnit as "lb" | "kg";

        if (nextUnit === weightUnit) return;

        // Ensure preserved values are populated before conversion
        if (preservedWeightKg === null || preservedGoalKg === null) {
          syncPreservedWeight();
        }

        if (preservedWeightKg !== null && preservedWeightKg > 0) {
          weightEl.value = nextUnit === "kg"
            ? preservedWeightKg.toFixed(1)
            : kgToLb(preservedWeightKg).toFixed(1);
        }

        if (preservedGoalKg !== null && preservedGoalKg > 0) {
          goalWeightEl.value = nextUnit === "kg"
            ? preservedGoalKg.toFixed(1)
            : kgToLb(preservedGoalKg).toFixed(1);
        }

        weightUnit = nextUnit;
        weightUnitLabel.textContent = nextUnit;
        goalUnitLabel.textContent = nextUnit;

        document.querySelectorAll("[data-weight-unit]").forEach((item) => {
          item.classList.toggle("active", (item as HTMLElement).dataset.weightUnit === nextUnit);
        });

        calculate();
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-height-unit]").forEach((button) => {
      button.addEventListener("click", () => {
        const nextUnit = button.dataset.heightUnit as "ft" | "cm";

        if (nextUnit === heightUnit) return;

        // Ensure preserved height is populated before conversion
        if (preservedCm === null) {
          syncPreservedHeight();
        }

        const sourceCm = preservedCm !== null ? preservedCm : getHeightCm();

        if (sourceCm === null) return;

        if (nextUnit === "cm") {
          heightCmEl.value = sourceCm.toFixed(1);
          imperialHeight.classList.add("hidden");
          metricHeight.classList.remove("hidden");
        } else {
          const totalInches = sourceCm / 2.54;
          const ft = Math.floor(totalInches / 12);
          const inches = totalInches - (ft * 12);

          heightFtEl.value = String(ft);
          heightInEl.value = inches.toFixed(1);
          metricHeight.classList.add("hidden");
          imperialHeight.classList.remove("hidden");
        }

        heightUnit = nextUnit;

        document.querySelectorAll("[data-height-unit]").forEach((item) => {
          item.classList.toggle("active", (item as HTMLElement).dataset.heightUnit === nextUnit);
        });

        calculate();
      });
    });

    // Input listeners — sync preserved values and recalculate
    weightEl.addEventListener("input", () => { syncPreservedWeight(); calculate(); });
    weightEl.addEventListener("change", () => { syncPreservedWeight(); calculate(); });

    goalWeightEl.addEventListener("input", () => { syncPreservedWeight(); calculate(); });
    goalWeightEl.addEventListener("change", () => { syncPreservedWeight(); calculate(); });

    heightFtEl.addEventListener("input", () => { syncPreservedHeight(); calculate(); });
    heightInEl.addEventListener("input", () => { syncPreservedHeight(); calculate(); });
    heightCmEl.addEventListener("input", () => { syncPreservedHeight(); calculate(); });

    [sexEl, ageEl, activityEl, lossRateEl].forEach((element) => {
      element.addEventListener("input", calculate);
      element.addEventListener("change", calculate);
    });

    // Enter key submits calculation from any input/select
    document.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((el) => {
      el.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          calculate();
        }
      });
    });

    // Initialize preserved values on page load, then calculate
    initializePreservedValues();
    calculate();
  </script>
</Base>
