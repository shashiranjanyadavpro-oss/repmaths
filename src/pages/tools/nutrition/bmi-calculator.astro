---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---

<Base
  title="BMI Calculator — Check Your Body Mass Index & Target Weight"
  description="Calculate your BMI using pounds and inches or kilograms and centimeters. Check your adult BMI category, healthy BMI range, and estimated weight range for adults 20 and older."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BMI Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free adult BMI calculator for adults 20 and older using pounds and inches or kilograms and centimeters, with BMI category and BMI-based weight range estimates."
  })} />

  <section class="hero">
    <h1>BMI Calculator — Check Your Body Mass Index &amp; Target Weight</h1>
    <p>
      Calculate your BMI using pounds and inches or kilograms and centimeters,
      check your adult BMI category, and see the weight range corresponding
      to a BMI of 18.5–24.9.
    </p>
  </section>

  <section class="calc-card" aria-label="BMI calculator">
    <div class="field">
      <label>Unit</label>

      <div
        class="unit-toggle"
        role="group"
        aria-label="Choose measurement units"
      >
        <button
          type="button"
          id="unit-us"
          class="active"
          aria-pressed="true"
        >
          lb / ft + in
        </button>

        <button
          type="button"
          id="unit-metric"
          aria-pressed="false"
        >
          kg / cm
        </button>
      </div>
    </div>

    <div id="us-fields">
      <div class="field">
        <label for="weight-lb">Weight (lb)</label>

        <input
          type="number"
          id="weight-lb"
          placeholder="e.g. 185"
          inputmode="decimal"
          min="55"
          max="1000"
          step="0.1"
          autocomplete="off"
        />
      </div>

      <div class="height-grid">
        <div class="field">
          <label for="height-ft">Height (ft)</label>

          <input
            type="number"
            id="height-ft"
            placeholder="e.g. 5"
            inputmode="numeric"
            min="3"
            max="9"
            step="1"
            autocomplete="off"
          />
        </div>

        <div class="field">
          <label for="height-in">Height (in)</label>

          <input
            type="number"
            id="height-in"
            placeholder="e.g. 10"
            inputmode="decimal"
            min="0"
            max="11.9"
            step="0.1"
            autocomplete="off"
          />
        </div>
      </div>
    </div>

    <div id="metric-fields" hidden>
      <div class="field">
        <label for="weight-kg">Weight (kg)</label>

        <input
          type="number"
          id="weight-kg"
          placeholder="e.g. 84"
          inputmode="decimal"
          min="25"
          max="453.592"
          step="0.1"
          autocomplete="off"
        />
      </div>

      <div class="field">
        <label for="height-cm">Height (cm)</label>

        <input
          type="number"
          id="height-cm"
          placeholder="e.g. 178"
          inputmode="decimal"
          min="91.44"
          max="274.32"
          step="0.1"
          autocomplete="off"
        />
      </div>
    </div>

    <div
      id="input-error"
      class="input-error"
      role="alert"
      aria-live="assertive"
      hidden
    ></div>

    <div class="result-box" id="result-box" aria-live="polite">
      <div class="big-number" id="bmi-value">–</div>

      <div class="label" id="bmi-category">
        Enter your height and weight
      </div>

      <div
        class="bmi-scale"
        role="img"
        aria-label="BMI reference scale showing underweight, healthy weight, overweight, and obesity categories"
      >
        <div class="scale-track">
          <span class="scale-segment underweight"></span>
          <span class="scale-segment healthy"></span>
          <span class="scale-segment overweight"></span>
          <span class="scale-segment obesity"></span>

          <span
            class="scale-marker"
            id="scale-marker"
            aria-hidden="true"
          ></span>
        </div>

        <div class="scale-labels" aria-hidden="true">
          <span>Underweight</span>
          <span>Healthy</span>
          <span>Overweight</span>
          <span>Obesity</span>
        </div>
      </div>

      <div class="bmi-details">
        <div class="metric-card">
          <span>Healthy BMI range</span>
          <strong>18.5–24.9</strong>
        </div>

        <div class="metric-card">
          <span>Weight at BMI 24.9</span>
          <strong id="upper-weight">–</strong>
        </div>
      </div>

      <div class="range-result">
        <strong>Reference weight range for BMI 18.5–24.9</strong>

        <div id="healthy-weight-range">–</div>

        <small>
          This is a BMI-based reference range, not a personalized
          ideal-weight prescription.
        </small>
      </div>

      <div class="lifter-note">
        <strong>Lifter note:</strong>
        BMI does not distinguish muscle from body fat. If you have substantial
        muscularity, consider your BMI alongside other measures such as
        body-fat estimates and waist measurements.
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is BMI?</h2>

    <p>
      Body mass index (BMI) is a calculated measure of weight relative to
      height. For adults, it is commonly used as a screening measure to
      classify weight status into underweight, healthy weight, overweight,
      or obesity. BMI is useful for screening, but it is not a direct
      measurement of body fat or a diagnosis of health.
    </p>

    <p>
      The adult BMI categories used by this calculator are intended for
      adults age 20 and older. Children and teenagers require
      age- and sex-specific BMI-for-age interpretation.
    </p>
  </article>

  <article class="article-section">
    <h2>The Mathematical Formula Behind BMI</h2>

    <p>
      In metric units, BMI is calculated by dividing body weight in kilograms
      by height in meters squared.
    </p>

    <p>
      <code>BMI = weight (kg) ÷ height² (m²)</code>
    </p>

    <p>
      When using pounds and inches, the conversion factor is included in the
      formula:
    </p>

    <p>
      <code>BMI = 703 × weight (lb) ÷ height² (in²)</code>
    </p>

    <p>
      For example, someone who is 5 ft 10 in tall and weighs 175 lb has a BMI
      of about 25.1. The calculator above performs the same calculation
      automatically and handles the conversion between US customary and
      metric units.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is a Healthy BMI?</h2>

    <p>
      The commonly used adult BMI categories are:
    </p>

    <table class="result-table category-table">
      <caption>Adult BMI categories</caption>

      <thead>
        <tr>
          <th scope="col">BMI</th>
          <th scope="col">Category</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Below 18.5</td>
          <td>Underweight</td>
        </tr>

        <tr>
          <td>18.5–24.9</td>
          <td>Healthy weight</td>
        </tr>

        <tr>
          <td>25.0–29.9</td>
          <td>Overweight</td>
        </tr>

        <tr>
          <td>30.0 or higher</td>
          <td>Obesity</td>
        </tr>
      </tbody>
    </table>

    <p>
      These categories are reference ranges for adults. BMI should be
      considered with other information when assessing an individual's health
      rather than treated as a diagnosis on its own.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is a Normal BMI for My Age and Height?</h2>

    <p>
      For adults age 20 and older, the commonly used healthy-weight BMI range
      is 18.5 to 24.9. Height matters because the same BMI corresponds to
      different body weights at different heights.
    </p>

    <p>
      Age does not change the standard adult BMI categories. However, children
      and teenagers are still growing, so their BMI is interpreted using
      age- and sex-specific BMI-for-age percentiles rather than the adult
      categories shown here.
    </p>
  </article>

  <article class="article-section">
    <h2>BMI and Target Weight</h2>

    <p>
      If you want to know what body weight corresponds to a particular BMI,
      the calculation can be reversed. For a given height, the calculator
      finds the weights corresponding to BMI 18.5 and BMI 24.9 and displays
      that as a reference range.
    </p>

    <p>
      This can help answer searches such as “ideal weight for height,” but BMI
      alone cannot determine an individual's ideal or healthiest body weight.
      Muscle mass, fat distribution, medical history, waist size, and other
      factors can provide additional context.
    </p>

    <p>
      If your goal is weight loss, you can use the
      <a href="/tools/nutrition/calorie-deficit-calculator">
        Calorie Deficit Calculator
      </a>
      to estimate a calorie target and projected timeline, then use
      real-world changes in body weight and performance to adjust your plan.
    </p>
  </article>

  <article class="article-section">
    <h2>BMI Limitations for Athletes and Lifters</h2>

    <p>
      BMI is especially important to interpret carefully if you lift weights
      or carry substantial muscle mass. The calculation only uses height and
      weight, so it cannot tell whether that weight comes from muscle, fat,
      bone, or other lean tissue.
    </p>

    <p>
      A muscular athlete can therefore have a BMI in the overweight or
      obesity range without having the same body-fat level as someone with
      less lean mass. That does not make the BMI calculation mathematically
      wrong; it means BMI may provide less information about body composition
      for that individual.
    </p>

    <p>
      If body composition is your main question, use our
      <a href="/tools/nutrition/body-fat-calculator">
        Body Fat Calculator
      </a>
      as another reference rather than relying on BMI alone.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Muscle Mass Make BMI Inaccurate?</h2>

    <p>
      Muscle mass can make BMI less informative because muscle contributes to
      body weight. BMI cannot distinguish fat mass from lean mass, so a highly
      muscular person may receive an overweight or obesity classification
      from BMI even when their body-fat level is relatively low.
    </p>

    <p>
      For gym-goers, it is therefore useful to view BMI as one measurement in
      a broader picture. Waist circumference, body-fat estimates, training
      performance, health history, and other relevant measures can provide
      additional context.
    </p>
  </article>

  <article class="article-section">
    <h2>Are There Different BMI Standards for Men and Women?</h2>

    <p>
      The standard adult BMI calculation is the same for men and women, and
      the commonly used adult category cutoffs are the same. BMI can still
      relate differently to body composition between individuals, so sex alone
      should not be used to turn a BMI number into a complete assessment of
      health.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use BMI With Other Fitness Metrics</h2>

    <p>
      BMI answers a narrow question about weight relative to height. RepMaths
      has other calculators that can answer the next question in a fitness or
      nutrition workflow:
    </p>

    <ul>
      <li>
        <a href="/tools/nutrition/body-fat-calculator">
          Body Fat Calculator
        </a>
        — estimate body-fat percentage using the US Navy tape-measure method.
      </li>

      <li>
        <a href="/tools/nutrition/bmr-calculator">
          BMR Calculator
        </a>
        — estimate basal metabolic rate from age, sex, height, and weight.
      </li>

      <li>
        <a href="/tools/nutrition/tdee-calculator">
          TDEE Calculator
        </a>
        — estimate daily maintenance calories from BMR and activity.
      </li>

      <li>
        <a href="/tools/nutrition/calorie-deficit-calculator">
          Calorie Deficit Calculator
        </a>
        — estimate a calorie target and weight-loss timeline.
      </li>

      <li>
        <a href="/tools/nutrition/macro-calculator">
          Macro Calculator
        </a>
        — convert a calorie target into protein, carbohydrate, and fat
        targets.
      </li>

      <li>
        <a href="/tools/nutrition/protein-calculator">
          Protein Calculator
        </a>
        — estimate a daily protein range based on body weight, activity,
        and goal.
      </li>
    </ul>
  </article>

  <article class="article-section">
    <h2>Sources &amp; Methodology</h2>

    <p>
      RepMaths uses the standard adult BMI calculation and the commonly used
      adult BMI categories of below 18.5, 18.5–24.9, 25.0–29.9, and 30.0 or
      higher. These categories and the BMI formula are consistent with
      guidance from the
      <a
        href="https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html"
        target="_blank"
        rel="noopener noreferrer"
      >
        U.S. Centers for Disease Control and Prevention (CDC)
      </a>
      and
      <a
        href="https://www.nhlbi.nih.gov/calculate-your-bmi"
        target="_blank"
        rel="noopener noreferrer"
      >
        National Heart, Lung, and Blood Institute (NHLBI)
      </a>.
    </p>

    <p>
      The calculator is intended for adults age 20 and older. CDC describes
      BMI as a screening measure that should be considered alongside other
      health information rather than used as a diagnosis or complete measure
      of individual health.
      <a
        href="https://www.cdc.gov/bmi/about/index.html"
        target="_blank"
        rel="noopener noreferrer"
      >
        CDC's BMI methodology and limitations
      </a>
      provide additional background.
    </p>

    <p>
      BMI-based weight ranges shown by this calculator are mathematical
      conversions of the 18.5–24.9 reference range for the entered height.
      They are not personalized medical recommendations.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>Is BMI a good indicator of overall health?</h3>

      <p>
        BMI is useful as a screening measure, but it is not a complete
        assessment of health. It does not directly measure body fat or show
        where fat is distributed. Other information such as medical history,
        physical findings, health behaviors, and laboratory results can add
        important context.
      </p>
    </div>

    <div class="faq-item">
      <h3>Can I have a high BMI and still be healthy?</h3>

      <p>
        A high BMI does not by itself describe a person's complete health
        status. People with substantial muscle mass can have a high BMI
        because BMI cannot distinguish muscle from fat. BMI should therefore
        be considered alongside other relevant health measures.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why can waist circumference add information beyond BMI?</h3>

      <p>
        BMI measures weight relative to height but does not show where body
        fat is stored. Waist circumference can provide additional information
        about body-fat distribution and may help put a BMI result into a
        broader health context.
      </p>
    </div>

    <div class="faq-item">
      <h3>What BMI range is considered healthy for adults?</h3>

      <p>
        For adults age 20 and older, the commonly used healthy-weight BMI
        range is 18.5 to less than 25.0. RepMaths displays this as 18.5–24.9
        in the calculator and reference table.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does BMI work differently for men and women?</h3>

      <p>
        The standard adult BMI calculation and commonly used adult category
        cutoffs are the same for men and women. However, BMI can have
        different relationships with body composition between individuals,
        so BMI should not be interpreted in isolation.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does BMI work for children and teenagers?</h3>

      <p>
        Not in the same way as the adult calculator. Children and teenagers
        are growing, so their BMI is interpreted using age- and sex-specific
        BMI-for-age percentiles. This calculator is intended for adults age
        20 and older.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="bmi-calculator" />

  <script>
    let unit = "us";

    const unitUs = document.getElementById("unit-us");
    const unitMetric = document.getElementById("unit-metric");
    const usFields = document.getElementById("us-fields");
    const metricFields = document.getElementById("metric-fields");

    const weightLb =
      document.getElementById("weight-lb") as HTMLInputElement | null;

    const heightFt =
      document.getElementById("height-ft") as HTMLInputElement | null;

    const heightIn =
      document.getElementById("height-in") as HTMLInputElement | null;

    const weightKg =
      document.getElementById("weight-kg") as HTMLInputElement | null;

    const heightCm =
      document.getElementById("height-cm") as HTMLInputElement | null;

    const resultBox = document.getElementById("result-box");
    const bmiValue = document.getElementById("bmi-value");
    const bmiCategory = document.getElementById("bmi-category");
    const healthyWeightRange =
      document.getElementById("healthy-weight-range");
    const upperWeight = document.getElementById("upper-weight");
    const inputError = document.getElementById("input-error");
    const scaleMarker = document.getElementById("scale-marker");

    function showError(message: string) {
      if (inputError) {
        inputError.textContent = message;
        inputError.hidden = false;
      }

      if (resultBox) {
        resultBox.classList.remove("show");
      }
    }

    function clearError() {
      if (inputError) {
        inputError.textContent = "";
        inputError.hidden = true;
      }
    }

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;

      if (newUnit === "metric" && unit === "us") {
        const lb = parseFloat(weightLb?.value || "");
        const ft = parseFloat(heightFt?.value || "");
        const inches = parseFloat(heightIn?.value || "");

        if (Number.isFinite(lb) && lb > 0 && weightKg) {
          weightKg.value = (lb * 0.45359237).toFixed(1);
        }

        if (
          Number.isFinite(ft) &&
          Number.isFinite(inches) &&
          ft > 0 &&
          inches >= 0 &&
          inches < 12 &&
          heightCm
        ) {
          heightCm.value =
            ((ft * 12 + inches) * 2.54).toFixed(1);
        }
      }

      if (newUnit === "us" && unit === "metric") {
        const kg = parseFloat(weightKg?.value || "");
        const cm = parseFloat(heightCm?.value || "");

        if (Number.isFinite(kg) && kg > 0 && weightLb) {
          weightLb.value = (kg * 2.2046226218).toFixed(1);
        }

        if (
          Number.isFinite(cm) &&
          cm > 0 &&
          heightFt &&
          heightIn
        ) {
          const totalInches = cm / 2.54;
          const feet = Math.floor(totalInches / 12);
          const inches = totalInches - feet * 12;

          heightFt.value = String(feet);
          heightIn.value = inches.toFixed(1);
        }
      }

      unit = newUnit;

      const isUs = unit === "us";

      if (usFields) usFields.hidden = !isUs;
      if (metricFields) metricFields.hidden = isUs;

      if (unitUs) {
        unitUs.classList.toggle("active", isUs);
        unitUs.setAttribute("aria-pressed", String(isUs));
      }

      if (unitMetric) {
        unitMetric.classList.toggle("active", !isUs);
        unitMetric.setAttribute(
          "aria-pressed",
          String(!isUs)
        );
      }

      calculate();
    }

    function getCategory(bmi: number): string {
      if (bmi < 18.5) return "Underweight";
      if (bmi < 25) return "Healthy weight";
      if (bmi < 30) return "Overweight";
      return "Obesity";
    }

    function updateScale(bmi: number) {
      if (!scaleMarker) return;

      /*
       * The visual scale is intentionally illustrative rather than a
       * continuous medical risk chart. Category boundaries are represented
       * by the standard adult BMI cutoffs.
       */
      const min = 15;
      const max = 40;

      let clamped = bmi;

      if (clamped < min) clamped = min;
      if (clamped > max) clamped = max;

      const position =
        ((clamped - min) / (max - min)) * 100;

      scaleMarker.style.left = `${position}%`;
    }

    function calculate() {
      clearError();

      let bmi: number | null = null;
      let heightMeters = 0;

      if (unit === "us") {
        const lb = parseFloat(weightLb?.value || "");
        const ft = parseFloat(heightFt?.value || "");
        const inches = parseFloat(heightIn?.value || "");

        if (
          !Number.isFinite(lb) ||
          lb <= 0 ||
          !Number.isFinite(ft) ||
          ft <= 0 ||
          !Number.isFinite(inches) ||
          inches < 0 ||
          inches >= 12
        ) {
          if (resultBox) resultBox.classList.remove("show");
          return;
        }

        const totalInches = ft * 12 + inches;

        if (totalInches < 36 || totalInches > 108) {
          showError(
            "Please enter a height between 3 ft and 9 ft."
          );
          return;
        }

        if (lb < 55 || lb > 1000) {
          showError(
            "Please enter a weight between 55 lb and 1,000 lb."
          );
          return;
        }

        heightMeters = totalInches * 0.0254;
        bmi =
          (lb * 703) /
          (totalInches * totalInches);
      } else {
        const kg = parseFloat(weightKg?.value || "");
        const cm = parseFloat(heightCm?.value || "");

        if (
          !Number.isFinite(kg) ||
          kg <= 0 ||
          !Number.isFinite(cm) ||
          cm <= 0
        ) {
          if (resultBox) resultBox.classList.remove("show");
          return;
        }

        if (cm < 91.44 || cm > 274.32) {
          showError(
            "Please enter a height between 91.44 cm and 274.32 cm."
          );
          return;
        }

        if (kg < 25 || kg > 453.592) {
          showError(
            "Please enter a weight between 25 kg and 453.592 kg."
          );
          return;
        }

        heightMeters = cm / 100;
        bmi =
          kg /
          (heightMeters * heightMeters);
      }

      if (
        bmi === null ||
        !Number.isFinite(bmi) ||
        bmi <= 0
      ) {
        if (resultBox) resultBox.classList.remove("show");
        return;
      }

      const lowerWeightKg =
        18.5 *
        heightMeters *
        heightMeters;

      const upperWeightKg =
        24.9 *
        heightMeters *
        heightMeters;

      if (bmiValue) {
        bmiValue.textContent = bmi.toFixed(1);
      }

      if (bmiCategory) {
        bmiCategory.textContent = getCategory(bmi);
      }

      updateScale(bmi);

      if (unit === "us") {
        const lowerLb =
          lowerWeightKg *
          2.2046226218;

        const upperLb =
          upperWeightKg *
          2.2046226218;

        if (healthyWeightRange) {
          healthyWeightRange.textContent =
            `${lowerLb.toFixed(1)}–${upperLb.toFixed(1)} lb`;
        }

        if (upperWeight) {
          upperWeight.textContent =
            `${upperLb.toFixed(1)} lb`;
        }
      } else {
        if (healthyWeightRange) {
          healthyWeightRange.textContent =
            `${lowerWeightKg.toFixed(1)}–${upperWeightKg.toFixed(1)} kg`;
        }

        if (upperWeight) {
          upperWeight.textContent =
            `${upperWeightKg.toFixed(1)} kg`;
        }
      }

      if (resultBox) {
        resultBox.classList.add("show");
      }
    }

    unitUs?.addEventListener(
      "click",
      () => setUnit("us")
    );

    unitMetric?.addEventListener(
      "click",
      () => setUnit("metric")
    );

    [
      weightLb,
      heightFt,
      heightIn,
      weightKg,
      heightCm
    ].forEach((input) => {
      input?.addEventListener(
        "input",
        calculate
      );

      input?.addEventListener(
        "change",
        calculate
      );
    });
  </script>

  <style>
    .height-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .result-box {
      text-align: center;
    }

    .result-box .big-number {
      font-size: 3rem;
    }

    .input-error {
      margin-top: 12px;
      padding: 10px 12px;
      border: 1px solid #b83a2b;
      border-radius: 8px;
      background: rgba(184, 58, 43, 0.1);
      color: #e6b3ad;
      text-align: left;
      font-size: 0.85rem;
      line-height: 1.45;
    }

    .bmi-scale {
      margin-top: 20px;
      text-align: left;
    }

    .scale-track {
      position: relative;
      display: grid;
      grid-template-columns: 3.5fr 6.5fr 5fr 10fr;
      height: 12px;
      overflow: visible;
      border-radius: 999px;
      background: var(--surface-2);
    }

    .scale-segment {
      display: block;
      height: 12px;
    }

    .scale-segment:first-child {
      border-radius: 999px 0 0 999px;
    }

    .scale-segment:last-of-type {
