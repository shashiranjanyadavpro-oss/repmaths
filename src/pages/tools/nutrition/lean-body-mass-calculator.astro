    @media (max-width: 640px) {
      .lbm-details {
        grid-template-columns: 1fr;
      }

      .method-toggle button {
        flex: 1 1 calc(50% - 8px);
      }

      .composition-legend {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>

  <script>
    let unit = "lb";
    let method = "bodyfat";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const methodBodyFat = document.getElementById("method-bodyfat");
    const methodBoer = document.getElementById("method-boer");
    const methodJames = document.getElementById("method-james");
    const methodHume = document.getElementById("method-hume");

    const sexInput =
      document.getElementById("sex") as HTMLSelectElement | null;

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const bodyFatInput =
      document.getElementById("bodyfat") as HTMLInputElement | null;

    const heightFtInput =
      document.getElementById("height-ft") as HTMLInputElement | null;

    const heightInInput =
      document.getElementById("height-in") as HTMLInputElement | null;

    const heightCmInput =
      document.getElementById("height-cm") as HTMLInputElement | null;

    const sexField = document.getElementById("sex-field");
    const bodyFatField = document.getElementById("bodyfat-field");
    const heightFields = document.getElementById("height-fields");
    const heightImperial = document.getElementById("height-imperial");
    const heightMetric = document.getElementById("height-metric");

    const calcBtn = document.getElementById("calc-btn");

    const inputError =
      document.getElementById("input-error");

    const resultBox =
      document.getElementById("result-box");

    const resultLbm =
      document.getElementById("result-lbm");

    const resultWeight =
      document.getElementById("result-weight");

    const resultFat =
      document.getElementById("result-fat");

    const resultPercent =
      document.getElementById("result-percent");

    const resultMethod =
      document.getElementById("result-method");

    const compositionLean =
      document.getElementById("composition-lean");

    const compositionFat =
      document.getElementById("composition-fat");

    const visualLeanPercent =
      document.getElementById("visual-lean-percent");

    const visualFatPercent =
      document.getElementById("visual-fat-percent");


    function setUnit(newUnit: string) {
      if (newUnit === unit) return;

      if (weightInput) {
        const currentWeight =
          parseFloat(weightInput.value);

        if (
          Number.isFinite(currentWeight) &&
          currentWeight > 0
        ) {
          weightInput.value =
            newUnit === "kg"
              ? (currentWeight / 2.20462).toFixed(1)
              : (currentWeight * 2.20462).toFixed(1);
        }
      }

      if (newUnit === "kg") {
        const feet =
          parseFloat(heightFtInput?.value || "");

        const inches =
          parseFloat(heightInInput?.value || "");

        if (
          Number.isFinite(feet) &&
          Number.isFinite(inches) &&
          heightCmInput
        ) {
          const totalInches =
            (feet * 12) + inches;

          heightCmInput.value =
            (totalInches * 2.54).toFixed(1);
        }
      } else {
        const cm =
          parseFloat(heightCmInput?.value || "");

        if (
          Number.isFinite(cm) &&
          cm > 0
        ) {
          const totalInches =
            cm / 2.54;

          const feet =
            Math.floor(totalInches / 12);

          const inches =
            totalInches - (feet * 12);

          if (heightFtInput) {
            heightFtInput.value =
              String(feet);
          }

          if (heightInInput) {
            heightInInput.value =
              inches.toFixed(1);
          }
        }
      }

      unit = newUnit;

      updateUnitUI();
      clearError();
    }


    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle(
          "active",
          unit === "lb"
        );

        unitLb.setAttribute(
          "aria-pressed",
          String(unit === "lb")
        );
      }

      if (unitKg) {
        unitKg.classList.toggle(
          "active",
          unit === "kg"
        );

        unitKg.setAttribute(
          "aria-pressed",
          String(unit === "kg")
        );
      }

      updateHeightFields();
    }


    function setMethod(newMethod: string) {
      method = newMethod;

      const buttons = [
        [methodBodyFat, "bodyfat"],
        [methodBoer, "boer"],
        [methodJames, "james"],
        [methodHume, "hume"]
      ] as const;

      for (const [button, value] of buttons) {
        if (button) {
          button.classList.toggle(
            "active",
            method === value
          );

          button.setAttribute(
            "aria-pressed",
            String(method === value)
          );
        }
      }

      const needsHeight =
        method !== "bodyfat";

      if (bodyFatField) {
        bodyFatField.hidden =
          method !== "bodyfat";
      }

      if (heightFields) {
        heightFields.hidden =
          !needsHeight;
      }

      if (sexField) {
        sexField.hidden =
          !needsHeight;
      }

      updateHeightFields();
      clearError();
    }


    function updateHeightFields() {
      if (method === "bodyfat") {
        if (heightFields) {
          heightFields.hidden = true;
        }

        return;
      }

      if (heightFields) {
        heightFields.hidden = false;
      }

      if (unit === "lb") {
        if (heightImperial) {
          heightImperial.hidden = false;
        }

        if (heightMetric) {
          heightMetric.hidden = true;
        }
      } else {
        if (heightImperial) {
          heightImperial.hidden = true;
        }

        if (heightMetric) {
          heightMetric.hidden = false;
        }
      }
    }


    function showError(message: string) {
      if (!inputError) return;

      inputError.textContent =
        message;

      inputError.hidden = false;

      if (resultBox) {
        resultBox.hidden = true;
      }
    }


    function clearError() {
      if (!inputError) return;

      inputError.textContent = "";
      inputError.hidden = true;
    }


    function round(value: number): number {
      return Math.round(value * 10) / 10;
    }


    function getWeightKg(): number {
      const rawWeight =
        parseFloat(weightInput?.value || "");

      if (
        !Number.isFinite(rawWeight) ||
        rawWeight <= 0
      ) {
        return NaN;
      }

      return unit === "kg"
        ? rawWeight
        : rawWeight / 2.20462;
    }


    function getHeightCm(): number {
      if (unit === "kg") {
        return parseFloat(
          heightCmInput?.value || ""
        );
      }

      const feet =
        parseFloat(heightFtInput?.value || "");

      const inches =
        parseFloat(heightInInput?.value || "");

      if (
        !Number.isFinite(feet) ||
        !Number.isFinite(inches)
      ) {
        return NaN;
      }

      return (
        (feet * 12) + inches
      ) * 2.54;
    }


    function getLbmFromBodyFat(
      weightKg: number,
      bodyFatPercent: number
    ): number {
      return (
        weightKg *
        (1 - bodyFatPercent / 100)
      );
    }


    function getBoerLbm(
      weightKg: number,
      heightCm: number,
      sex: string
    ): number {
      if (sex === "female") {
        return (
          0.252 * weightKg +
          0.473 * heightCm -
          48.3
        );
      }

      return (
        0.407 * weightKg +
        0.267 * heightCm -
        19.2
      );
    }


    function getJamesLbm(
      weightKg: number,
      heightCm: number,
      sex: string
    ): number {
      /*
       * James formula uses height in meters.
       * The previous implementation incorrectly used
       * centimeters directly, which materially distorted results.
       */

      const heightM =
        heightCm / 100;

      if (
        !Number.isFinite(heightM) ||
        heightM <= 0
      ) {
        return NaN;
      }

      const ratioSquared =
        Math.pow(
          weightKg / heightM,
          2
        );

      if (sex === "female") {
        return (
          1.07 * weightKg -
          148 * ratioSquared
        );
      }

      return (
        1.10 * weightKg -
        128 * ratioSquared
      );
    }


    function getHumeLbm(
      weightKg: number,
      heightCm: number,
      sex: string
    ): number {
      if (sex === "female") {
        return (
          0.29569 * weightKg +
          0.41813 * heightCm -
          43.2933
        );
      }

      return (
        0.32810 * weightKg +
        0.33929 * heightCm -
        29.5336
      );
    }


    function updateCompositionVisual(
      leanPercent: number,
      fatPercent: number
    ) {
      const safeLean =
        Math.max(
          0,
          Math.min(100, leanPercent)
        );

      const safeFat =
        Math.max(
          0,
          Math.min(100, fatPercent)
        );

      if (compositionLean) {
        compositionLean.style.width =
          `${safeLean}%`;
      }

      if (compositionFat) {
        compositionFat.style.width =
          `${safeFat}%`;
      }

      if (visualLeanPercent) {
        visualLeanPercent.textContent =
          `${round(safeLean)}%`;
      }

      if (visualFatPercent) {
        visualFatPercent.textContent =
          `${round(safeFat)}%`;
      }
    }


    if (unitLb) {
      unitLb.addEventListener(
        "click",
        () => setUnit("lb")
      );
    }

    if (unitKg) {
      unitKg.addEventListener(
        "click",
        () => setUnit("kg")
      );
    }

    if (methodBodyFat) {
      methodBodyFat.addEventListener(
        "click",
        () => setMethod("bodyfat")
      );
    }

    if (methodBoer) {
      methodBoer.addEventListener(
        "click",
        () => setMethod("boer")
      );
    }

    if (methodJames) {
      methodJames.addEventListener(
        "click",
        () => setMethod("james")
      );
    }

    if (methodHume) {
      methodHume.addEventListener(
        "click",
        () => setMethod("hume")
      );
    }


    if (calcBtn) {
      calcBtn.addEventListener(
        "click",
        () => {
          clearError();

          const weightKg =
            getWeightKg();

          if (
            !Number.isFinite(weightKg) ||
            weightKg < 25 ||
            weightKg > 300
          ) {
            showError(
              "Please enter a body weight between 25 and 300 kg."
            );

            return;
          }

          let lbmKg = NaN;
          let methodName = "";

          if (method === "bodyfat") {
            const bodyFat =
              parseFloat(
                bodyFatInput?.value || ""
              );

            if (
              !Number.isFinite(bodyFat) ||
              bodyFat <= 0 ||
              bodyFat >= 70
            ) {
              showError(
                "Please enter a body-fat percentage between 1% and 69.9%."
              );

              return;
            }

            lbmKg =
              getLbmFromBodyFat(
                weightKg,
                bodyFat
              );

            methodName =
              "Body fat percentage";
          } else {
            const heightCm =
              getHeightCm();

            const sex =
              sexInput?.value || "male";

            if (
              !Number.isFinite(heightCm) ||
              heightCm < 120 ||
              heightCm > 250
            ) {
              showError(
                "Please enter a height between 120 and 250 cm."
              );

              return;
            }

            if (
              unit === "lb"
            ) {
              const feet =
                parseFloat(
                  heightFtInput?.value || ""
                );

              const inches =
                parseFloat(
                  heightInInput?.value || ""
                );

              if (
                !Number.isFinite(feet) ||
                !Number.isFinite(inches) ||
                feet < 3 ||
                feet > 8 ||
                inches < 0 ||
                inches >= 12
              ) {
                showError(
                  "Please enter a valid height using feet and inches."
                );

                return;
              }
            }

            if (method === "boer") {
              lbmKg =
                getBoerLbm(
                  weightKg,
                  heightCm,
                  sex
                );

              methodName =
                "Boer formula";
            }

            if (method === "james") {
              lbmKg =
                getJamesLbm(
                  weightKg,
                  heightCm,
                  sex
                );

              methodName =
                "James formula";
            }

            if (method === "hume") {
              lbmKg =
                getHumeLbm(
                  weightKg,
                  heightCm,
                  sex
                );

              methodName =
                "Hume formula";
            }
          }

          if (
            !Number.isFinite(lbmKg) ||
            lbmKg <= 0 ||
            lbmKg >= weightKg
          ) {
            showError(
              "This combination of inputs produced an invalid LBM estimate. Please check your values or try another method."
            );

            return;
          }

          const fatMassKg =
            weightKg - lbmKg;

          const leanPercent =
            (lbmKg / weightKg) * 100;

          const fatPercent =
            (fatMassKg / weightKg) * 100;

          const displayLbm =
            unit === "lb"
              ? lbmKg * 2.20462
              : lbmKg;

          const displayWeight =
            unit === "lb"
              ? weightKg * 2.20462
              : weightKg;

          const displayFat =
            unit === "lb"
              ? fatMassKg * 2.20462
              : fatMassKg;

          if (resultLbm) {
            resultLbm.textContent =
              `${round(displayLbm)} ${unit}`;
          }

          if (resultWeight) {
            resultWeight.textContent =
              `${round(displayWeight)} ${unit}`;
          }

          if (resultFat) {
            resultFat.textContent =
              `${round(displayFat)} ${unit}`;
          }

          if (resultPercent) {
            resultPercent.textContent =
              `${round(leanPercent)}%`;
          }

          if (resultMethod) {
            resultMethod.textContent =
              methodName;
          }

          updateCompositionVisual(
            leanPercent,
            fatPercent
          );

          if (resultBox) {
            resultBox.hidden = false;
            resultBox.classList.add("show");
          }
        }
      );
    }


    setMethod("bodyfat");
    updateUnitUI();
  </script>
</Base>
