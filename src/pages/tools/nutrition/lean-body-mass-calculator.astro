  <script>
    type Unit = 'lb' | 'kg';
    type Method = 'bodyfat' | 'boer' | 'james' | 'hume';

    let unit: Unit = 'lb';
    let method: Method = 'bodyfat';

    let preservedKg: number | null = null;
    let preservedCm: number | null = null;

    const LB_PER_KG = 2.20462;

    const unitLb = document.getElementById('unit-lb');
    const unitKg = document.getElementById('unit-kg');

    const methodBodyFat = document.getElementById('method-bodyfat');
    const methodBoer = document.getElementById('method-boer');
    const methodJames = document.getElementById('method-james');
    const methodHume = document.getElementById('method-hume');

    const sexInput = document.getElementById('sex') as HTMLSelectElement | null;
    const weightInput = document.getElementById('weight') as HTMLInputElement | null;
    const bodyFatInput = document.getElementById('bodyfat') as HTMLInputElement | null;
    const heightFtInput = document.getElementById('height-ft') as HTMLInputElement | null;
    const heightInInput = document.getElementById('height-in') as HTMLInputElement | null;
    const heightCmInput = document.getElementById('height-cm') as HTMLInputElement | null;

    const sexField = document.getElementById('sex-field');
    const bodyFatField = document.getElementById('bodyfat-field');
    const heightFields = document.getElementById('height-fields');
    const heightImperial = document.getElementById('height-imperial');
    const heightMetric = document.getElementById('height-metric');

    const calcBtn = document.getElementById('calc-btn');
    const inputError = document.getElementById('input-error');
    const resultBox = document.getElementById('result-box');
    const resultLbm = document.getElementById('result-lbm');
    const resultWeight = document.getElementById('result-weight');
    const resultFat = document.getElementById('result-fat');
    const resultPercent = document.getElementById('result-percent');
    const resultMethod = document.getElementById('result-method');
    const compositionLean = document.getElementById('composition-lean');
    const compositionFat = document.getElementById('composition-fat');
    const visualLeanPercent = document.getElementById('visual-lean-percent');
    const visualFatPercent = document.getElementById('visual-fat-percent');
    const resultAnnouncement = document.getElementById('result-announcement');
    const weightLabel = document.getElementById('weight-label');

    const round = (value: number) => Math.round(value * 10) / 10;

    function syncPreservedWeight() {
      if (!weightInput) return;
      const raw = weightInput.value.trim();
      if (raw === '') { preservedKg = null; return; }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) { preservedKg = null; return; }
      preservedKg = unit === 'lb' ? value / LB_PER_KG : value;
    }

    function syncPreservedHeightFromImperial() {
      if (!heightFtInput || !heightInInput) return;
      const feetRaw = heightFtInput.value.trim();
      const inchesRaw = heightInInput.value.trim();
      if (feetRaw === '' && inchesRaw === '') { preservedCm = null; return; }
      const feet = feetRaw === '' ? 0 : Number(feetRaw);
      const inches = inchesRaw === '' ? 0 : Number(inchesRaw);
      if (!Number.isFinite(feet) || !Number.isFinite(inches) || feet < 0 || inches < 0) {
        preservedCm = null; return;
      }
      const totalInches = feet * 12 + inches;
      if (totalInches <= 0) { preservedCm = null; return; }
      preservedCm = totalInches * 2.54;
    }

    function syncPreservedHeightFromMetric() {
      if (!heightCmInput) return;
      const raw = heightCmInput.value.trim();
      if (raw === '') { preservedCm = null; return; }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) { preservedCm = null; return; }
      preservedCm = value;
    }

    function setUnit(next: Unit) {
      if (next === unit) return;

      if (preservedKg !== null && preservedKg > 0 && weightInput) {
        weightInput.value = next === 'lb'
          ? (preservedKg * LB_PER_KG).toFixed(1)
          : preservedKg.toFixed(1);
      }

      if (preservedCm !== null && preservedCm > 0) {
        if (next === 'kg' && heightCmInput) {
          heightCmInput.value = preservedCm.toFixed(1);
        }
        if (next === 'lb' && heightFtInput && heightInInput) {
          const totalInches = Math.round(preservedCm / 2.54);
          heightFtInput.value = String(Math.floor(totalInches / 12));
          heightInInput.value = String(totalInches % 12);
        }
      }

      unit = next;
      updateUnitUI();
      clearError();
    }

    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle('active', unit === 'lb');
        unitLb.setAttribute('aria-pressed', String(unit === 'lb'));
      }
      if (unitKg) {
        unitKg.classList.toggle('active', unit === 'kg');
        unitKg.setAttribute('aria-pressed', String(unit === 'kg'));
      }
      if (weightLabel) {
        weightLabel.textContent = unit === 'lb' ? 'Body weight (lb)' : 'Body weight (kg)';
      }
      if (weightInput) {
        weightInput.placeholder = unit === 'lb' ? 'e.g. 180' : 'e.g. 82';
      }
      updateHeightFields();
    }

    function setMethod(next: Method) {
      method = next;

      const buttons: Array<[HTMLElement | null, Method]> = [
        [methodBodyFat, 'bodyfat'],
        [methodBoer, 'boer'],
        [methodJames, 'james'],
        [methodHume, 'hume'],
      ];

      for (const [button, value] of buttons) {
        if (button) {
          button.classList.toggle('active', method === value);
          button.setAttribute('aria-pressed', String(method === value));
        }
      }

      const needsHeight = method !== 'bodyfat';
      if (bodyFatField) bodyFatField.hidden = method !== 'bodyfat';
      if (heightFields) heightFields.hidden = !needsHeight;
      if (sexField) sexField.hidden = !needsHeight;

      updateHeightFields();
      clearError();
    }

    function updateHeightFields() {
      if (method === 'bodyfat') { if (heightFields) heightFields.hidden = true; return; }
      if (heightFields) heightFields.hidden = false;
      if (unit === 'lb') {
        if (heightImperial) heightImperial.hidden = false;
        if (heightMetric) heightMetric.hidden = true;
      } else {
        if (heightImperial) heightImperial.hidden = true;
        if (heightMetric) heightMetric.hidden = false;
      }
    }

    function showError(message: string) {
      if (!inputError) return;
      inputError.textContent = message;
      inputError.hidden = false;
      if (resultBox) { resultBox.hidden = true; resultBox.classList.remove('show'); }
    }

    function clearError() {
      if (!inputError) return;
      inputError.textContent = '';
      inputError.hidden = true;
    }

    function getBoerLbm(weightKg: number, heightCm: number, sex: string) {
      return sex === 'female'
        ? 0.252 * weightKg + 0.473 * heightCm - 48.3
        : 0.407 * weightKg + 0.267 * heightCm - 19.2;
    }

    function getJamesLbm(weightKg: number, heightCm: number, sex: string) {
      const ratioSquared = Math.pow(weightKg / heightCm, 2);
      return sex === 'female'
        ? 1.07 * weightKg - 148 * ratioSquared
        : 1.10 * weightKg - 128 * ratioSquared;
    }

    function getHumeLbm(weightKg: number, heightCm: number, sex: string) {
      return sex === 'female'
        ? 0.29569 * weightKg + 0.41813 * heightCm - 43.2933
        : 0.32810 * weightKg + 0.33929 * heightCm - 29.5336;
    }

    function updateCompositionVisual(leanPercent: number, fatPercent: number) {
      const safeLean = Math.max(0, Math.min(100, leanPercent));
      const safeFat = Math.max(0, Math.min(100, fatPercent));
      if (compositionLean) compositionLean.style.width = `${safeLean}%`;
      if (compositionFat) compositionFat.style.width = `${safeFat}%`;
      if (visualLeanPercent) visualLeanPercent.textContent = `${round(safeLean)}%`;
      if (visualFatPercent) visualFatPercent.textContent = `${round(safeFat)}%`;
    }

    unitLb?.addEventListener('click', () => setUnit('lb'));
    unitKg?.addEventListener('click', () => setUnit('kg'));
    methodBodyFat?.addEventListener('click', () => setMethod('bodyfat'));
    methodBoer?.addEventListener('click', () => setMethod('boer'));
    methodJames?.addEventListener('click', () => setMethod('james'));
    methodHume?.addEventListener('click', () => setMethod('hume'));

    weightInput?.addEventListener('input', () => { syncPreservedWeight(); clearError(); });
    heightFtInput?.addEventListener('input', () => { syncPreservedHeightFromImperial(); clearError(); });
    heightInInput?.addEventListener('input', () => { syncPreservedHeightFromImperial(); clearError(); });
    heightCmInput?.addEventListener('input', () => { syncPreservedHeightFromMetric(); clearError(); });
    bodyFatInput?.addEventListener('input', clearError);

    calcBtn?.addEventListener('click', () => {
      clearError();

      if (preservedKg === null) syncPreservedWeight();

      if (preservedKg === null || preservedKg < 25 || preservedKg > 300) {
        showError('Please enter a body weight between 25 and 300 kg (approximately 55–660 lb).');
        return;
      }

      const weightKg = preservedKg;
      let lbmKg = NaN;
      let methodName = '';

      if (method === 'bodyfat') {
        const bodyFat = Number(bodyFatInput?.value ?? '');
        if (!Number.isFinite(bodyFat) || bodyFat <= 0 || bodyFat >= 70) {
          showError('Please enter a body-fat percentage between 1% and 69.9%.');
          return;
        }
        lbmKg = weightKg * (1 - bodyFat / 100);
        methodName = 'Body fat percentage';
      } else {
        if (unit === 'lb') syncPreservedHeightFromImperial();
        else syncPreservedHeightFromMetric();

        if (preservedCm === null || preservedCm < 120 || preservedCm > 250) {
          showError('Please enter a height between 120 and 250 cm (approximately 4 ft – 8 ft).');
          return;
        }

        const heightCm = preservedCm;
        const sex = sexInput?.value || 'male';

        if (method === 'boer') { lbmKg = getBoerLbm(weightKg, heightCm, sex); methodName = 'Boer formula'; }
        else if (method === 'james') { lbmKg = getJamesLbm(weightKg, heightCm, sex); methodName = 'James formula'; }
        else if (method === 'hume') { lbmKg = getHumeLbm(weightKg, heightCm, sex); methodName = 'Hume formula'; }
      }

      if (!Number.isFinite(lbmKg) || lbmKg <= 0 || lbmKg >= weightKg) {
        showError('This combination of inputs produced an invalid LBM estimate. Please check your values or try another method.');
        return;
      }

      const fatMassKg = weightKg - lbmKg;
      const leanPercent = (lbmKg / weightKg) * 100;
      const fatPercent = (fatMassKg / weightKg) * 100;

      const displayLbm = unit === 'lb' ? lbmKg * LB_PER_KG : lbmKg;
      const displayWeight = unit === 'lb' ? weightKg * LB_PER_KG : weightKg;
      const displayFat = unit === 'lb' ? fatMassKg * LB_PER_KG : fatMassKg;

      if (resultLbm) resultLbm.textContent = `${round(displayLbm)} ${unit}`;
      if (resultWeight) resultWeight.textContent = `${round(displayWeight)} ${unit}`;
      if (resultFat) resultFat.textContent = `${round(displayFat)} ${unit}`;
      if (resultPercent) resultPercent.textContent = `${round(leanPercent)}%`;
      if (resultMethod) resultMethod.textContent = methodName;

      updateCompositionVisual(leanPercent, fatPercent);

      if (resultBox) { resultBox.hidden = false; resultBox.classList.add('show'); }

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Estimated lean body mass: ${round(displayLbm)} ${unit}. Body weight: ${round(displayWeight)} ${unit}. Estimated fat mass: ${round(displayFat)} ${unit}. Lean mass percentage: ${round(leanPercent)}%.`;
      }
    });

    setMethod('bodyfat');
    updateUnitUI();
  </script>
</Base>
