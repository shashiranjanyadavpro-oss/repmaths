      display: block;
      margin-bottom: 5px;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .metric-card strong {
      font-size: 1rem;
    }

    .range-result {
      margin-top: 18px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface-2);
    }

    .lifter-note {
      margin-top: 16px;
      padding: 14px;
      border-left: 3px solid var(--accent);
      background: var(--surface-2);
      border-radius: 8px;
      line-height: 1.55;
    }

