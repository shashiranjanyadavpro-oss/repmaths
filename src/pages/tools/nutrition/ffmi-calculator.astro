const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/ffmi-calculator/#calculator',
  name: 'RepMaths FFMI Calculator',
  alternateName: 'Fat-Free Mass Index Calculator',
  url: 'https://repmaths.com/tools/nutrition/ffmi-calculator/',
  description:
    'Free FFMI calculator — calculate raw and normalized Fat-Free Mass Index from weight, height, and body fat. Supports lb and kg.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
