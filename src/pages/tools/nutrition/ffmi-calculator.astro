  <script>
    type Unit = "lb" | "kg";

    let unit: Unit = "lb";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const heightFtInput =
      document.getElementById("height-ft") as HTMLInputElement | null;

    const heightInInput =
      document.getElementById("height-in") as HTMLInputElement | null;

    const heightCmInput =
      document.getElementById("height-cm") as HTMLInputElement | null;

    const bodyFatInput =
      document.getElementById("bodyfat") as HTMLInputElement | null;

    const sexInput =
      document.getElementById("sex") as HTMLSelectElement | null;

    const heightImperial =
      document.getElementById("height-imperial");

    const heightMetric =
      document.getElementById("height-metric");

    const weightUnit =
      document.getElementById("weight-unit");

    const calcBtn =
      document.getElementById("calc-btn");

    const resultBox =
      document.getElementById("result-box");

    const resultNormalized =
      document.getElementById("result-normalized");

    const resultFfmi =
      document.getElementById("result-ffmi");

    const resultFfm =
      document.getElementById("result-ffm");

    const resultFat =
      document.getElementById("result-fat");

    const resultLeanPercent =
      document.getElementById("result-lean-percent");

    const resultBmi =
      document.getElementById("result-bmi");

    const resultLevel =
      document.getElementById("result-level");

    const resultInterpretation =
      document.getElementById("result-interpretation");

    function round(value: number, decimals = 1): number {
      const factor = Math.pow(10, decimals);
      return Math.round(value * factor) / factor;
    }

    function setUnit(newUnit: Unit) {
      if (newUnit === unit) return;

      /*
       * Weight conversion
       */
      if (weightInput) {
        const currentWeight = parseFloat(weightInput.value);

        if (
          Number.isFinite(currentWeight) &&
          currentWeight > 0
        ) {
          weightInput.value =
            newUnit === "kg"
              ? (currentWeight / 2.2046226218).toFixed(1)
              : (currentWeight * 2.2046226218).toFixed(1);
        }
      }

      /*
       * Height conversion
       *
       * Always convert through total inches.
       * This prevents the lb/ft/in ↔ kg/cm switch
       * from changing the underlying height.
       */
      if (unit === "lb" && newUnit === "kg") {
        if (heightFtInput && heightInInput && heightCmInput) {
          const feet = parseFloat(heightFtInput.value);
          const inches = parseFloat(heightInInput.value);

          if (
            Number.isFinite(feet) &&
            Number.isFinite(inches) &&
            feet >= 0 &&
            inches >= 0 &&
            inches < 12
          ) {
            const totalInches =
              feet * 12 + inches;

            heightCmInput.value =
              (totalInches * 2.54).toFixed(1);
          }
        }
      }

      if (unit === "kg" && newUnit === "lb") {
        if (heightCmInput && heightFtInput && heightInInput) {
          const cm = parseFloat(heightCmInput.value);

          if (
            Number.isFinite(cm) &&
            cm > 0
          ) {
            const totalInches = cm / 2.54;

            const feet =
              Math.floor(totalInches / 12);

            const inches =
              totalInches - feet * 12;

            heightFtInput.value =
              String(feet);

            heightInInput.value =
              inches.toFixed(1);
          }
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle(
          "active",
          unit === "lb"
        );

        unitLb.setAttribute(
          "aria-pressed",
          String(unit === "lb")
        );
      }

      if (unitKg) {
        unitKg.classList.toggle(
          "active",
          unit === "kg"
        );

        unitKg.setAttribute(
          "aria-pressed",
          String(unit === "kg")
        );
      }

      if (weightUnit) {
        weightUnit.textContent =
          unit === "lb" ? "lb" : "kg";
      }

      if (heightImperial) {
        heightImperial.hidden =
          unit !== "lb";
      }

      if (heightMetric) {
        heightMetric.hidden =
          unit !== "kg";
      }
    }

    function getWeightKg(): number {
      const raw =
        parseFloat(weightInput?.value || "");

      if (!Number.isFinite(raw)) {
        return NaN;
      }

      return unit === "lb"
        ? raw / 2.2046226218
        : raw;
    }

    function getHeightCm(): number {
      if (unit === "kg") {
        return parseFloat(
          heightCmInput?.value || ""
        );
      }

      const feet =
        parseFloat(heightFtInput?.value || "");

      const inches =
        parseFloat(heightInInput?.value || "");

      if (
        !Number.isFinite(feet) ||
        !Number.isFinite(inches)
      ) {
        return NaN;
      }

      if (
        feet < 3 ||
        feet > 8 ||
        inches < 0 ||
        inches >= 12
      ) {
        return NaN;
      }

      const totalInches =
        feet * 12 + inches;

      return totalInches * 2.54;
    }

    function getInterpretation(
      normalized: number,
      sex: string
    ) {
      if (sex === "female") {
        if (normalized < 16) {
          return {
            level: "Lower FFMI range",
            text:
              "Your calculated FFMI is in a lower range. Female FFMI values vary across populations and sports, so this number should be interpreted as a body-composition metric rather than a pass/fail standard."
          };
        }

        if (normalized < 18) {
          return {
            level: "Moderate FFMI range",
            text:
              "Your calculated FFMI falls in a moderate range. There is no universal female FFMI cutoff for athletic or natural status."
          };
        }

        if (normalized < 20) {
          return {
            level: "Higher FFMI range",
            text:
              "Your calculated FFMI falls in a higher range. Female athletes can show substantial sport-specific differences in FFMI."
          };
        }

        if (normalized < 23) {
          return {
            level: "Very high FFMI range",
            text:
              "Your calculated FFMI is relatively high. Interpret it alongside your sport, training history, body-fat measurement method, and population."
          };
        }

        return {
          level: "High FFMI value",
          text:
            "Your calculated FFMI is high relative to broad female-athlete reference data. This is not a diagnosis and should not be used to infer drug use."
        };
      }

      if (normalized < 18) {
        return {
          level: "Lower FFMI range",
          text:
            "Your calculated FFMI is in a lower muscularity range. FFMI is descriptive and should be interpreted alongside training history and body-fat measurement quality."
        };
      }

      if (normalized < 20) {
        return {
          level: "Moderate FFMI range",
          text:
            "Your calculated FFMI falls in a moderate muscularity range."
        };
      }

      if (normalized < 22) {
        return {
          level: "Higher FFMI range",
          text:
            "Your calculated FFMI indicates a relatively high amount of fat-free mass for your height."
        };
      }

      if (normalized < 25) {
        return {
          level: "Very high FFMI range",
          text:
            "Your calculated FFMI is in a very high muscularity range. The result remains an estimate because it depends on your body-fat measurement."
        };
      }

      return {
        level: "25+ FFMI reference range",
        text:
          "Your normalized FFMI is at or above the commonly cited 25 reference point from Kouri et al. This does not prove or disprove performance-enhancing drug use."
      };
    }

    if (unitLb) {
      unitLb.addEventListener(
        "click",
        () => setUnit("lb")
      );
    }

    if (unitKg) {
      unitKg.addEventListener(
        "click",
        () => setUnit("kg")
      );
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        const weightKg = getWeightKg();
        const heightCm = getHeightCm();

        const bodyFat =
          parseFloat(bodyFatInput?.value || "");

        const sex =
          sexInput?.value || "male";

        if (
          !Number.isFinite(weightKg) ||
          weightKg < 30 ||
          weightKg > 300
        ) {
          alert(
            "Please enter a body weight between 30 and 300 kg."
          );
          return;
        }

        if (
          !Number.isFinite(heightCm) ||
          heightCm < 120 ||
          heightCm > 250
        ) {
          alert(
            "Please enter a height between 120 and 250 cm."
          );
          return;
        }

        if (
          !Number.isFinite(bodyFat) ||
          bodyFat < 3 ||
          bodyFat > 60
        ) {
          alert(
            "Please enter a body-fat percentage between 3% and 60%."
          );
          return;
        }

        const heightM =
          heightCm / 100;

        const fatMassKg =
          weightKg * (bodyFat / 100);

        const fatFreeMassKg =
          weightKg - fatMassKg;

        const ffmi =
          fatFreeMassKg /
          Math.pow(heightM, 2);

        /*
         * Kouri et al. (1995):
         * Normalized FFMI =
         * FFMI + 6.3 × (1.80 − height in metres)
         */
        const normalizedFfmi =
          ffmi +
          6.3 * (1.8 - heightM);

        const bmi =
          weightKg /
          Math.pow(heightM, 2);

        const leanPercent =
          (fatFreeMassKg / weightKg) * 100;

        const displayFfm =
          unit === "lb"
            ? fatFreeMassKg * 2.2046226218
            : fatFreeMassKg;

        const displayFat =
          unit === "lb"
            ? fatMassKg * 2.2046226218
            : fatMassKg;

        if (resultNormalized) {
          resultNormalized.textContent =
            round(normalizedFfmi).toFixed(1);
        }

        if (resultFfmi) {
          resultFfmi.textContent =
            `${round(ffmi).toFixed(1)} kg/m²`;
        }

        if (resultFfm) {
          resultFfm.textContent =
            `${round(displayFfm).toFixed(1)} ${unit}`;
        }

        if (resultFat) {
          resultFat.textContent =
            `${round(displayFat).toFixed(1)} ${unit}`;
        }

        if (resultLeanPercent) {
          resultLeanPercent.textContent =
            `${round(leanPercent).toFixed(1)}%`;
        }

        if (resultBmi) {
          resultBmi.textContent =
            round(bmi).toFixed(1);
        }

        const interpretation =
          getInterpretation(
            normalizedFfmi,
            sex
          );

        if (resultLevel) {
          resultLevel.textContent =
            interpretation.level;
        }

        if (resultInterpretation) {
          resultInterpretation.textContent =
            interpretation.text;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
