const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="FFMI Calculator — Fat-Free Mass Index & Normalized FFMI"
  description="Free FFMI calculator — calculate raw and normalized Fat-Free Mass Index from weight, height, and body fat. Supports lb and kg."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <section class="hero">
    <h1>FFMI Calculator</h1>
    <p>
      Calculate your <strong>raw FFMI</strong> and
      <strong>normalized FFMI</strong> using pounds and inches or kilograms
      and centimeters. See where your fat-free mass index sits relative to
      common natural-lifter reference ranges.
    </p>
  </section>

  <aside class="quick-answer" aria-label="FFMI quick answer">
    <p>
      <strong>What is FFMI?</strong> FFMI (Fat-Free Mass Index) estimates
      how much lean mass you carry relative to height. Formula:
      <code>fat-free mass (kg) ÷ height² (m)</code>. Normalized FFMI
      adjusts for height, making it possible to compare lifters of
      different statures. A typical natural male lifter falls around
      <strong>20–21.9</strong>; women around <strong>17–17.9</strong>.
    </p>
  </aside>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="calculator-heading">
      Calculate Your FFMI
    </h2>

    <div class="field">
      <span class="field-label" id="unit-label">Unit</span>
      <div class="unit-toggle" role="group" aria-labelledby="unit-label">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">
          lb &amp; inches
        </button>
        <button type="button" id="unit-kg" aria-pressed="false">
          kg &amp; cm
        </button>
      </div>
    </div>

    <div class="field">
      <label for="sex">Sex</label>
      <select id="sex">
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>
    </div>

    <div class="field">
      <label for="weight" id="weight-label">Body weight (lb)</label>
      <div class="input-with-suffix">
        <input
          type="number"
          id="weight"
          placeholder="e.g. 180"
          inputmode="decimal"
          min="66"
          max="660"
          step="any"
        />
        <span id="weight-unit">lb</span>
      </div>
    </div>

    <div id="height-imperial">
      <div class="field">
        <span class="field-label">Height</span>
        <div class="height-grid">
          <div class="input-with-suffix">
            <input
              type="number"
              id="height-ft"
              placeholder="5"
              inputmode="numeric"
              min="3"
              max="8"
              step="1"
              aria-label="Height in feet"
            />
            <span>ft</span>
          </div>
          <div class="input-with-suffix">
            <input
              type="number"
              id="height-in"
              placeholder="11"
              inputmode="decimal"
              min="0"
              max="11.99"
              step="0.1"
              aria-label="Height in inches"
            />
            <span>in</span>
          </div>
        </div>
      </div>
    </div>

    <div id="height-metric" hidden>
      <div class="field">
        <label for="height-cm">Height</label>
        <div class="input-with-suffix">
          <input
            type="number"
            id="height-cm"
            placeholder="e.g. 180"
            inputmode="decimal"
            min="120"
            max="250"
            step="0.1"
          />
          <span>cm</span>
        </div>
      </div>
    </div>

    <div class="field">
      <label for="bodyfat">Body fat percentage</label>
      <div class="input-with-suffix">
        <input
          type="number"
          id="bodyfat"
          placeholder="e.g. 15"
          inputmode="decimal"
          min="3"
          max="60"
          step="0.1"
        />
        <span>%</span>
      </div>
      <p class="field-help">
        Don't know your body-fat percentage?
        <a href="/tools/nutrition/body-fat-calculator/">
          Estimate it with our US Navy Body Fat Calculator
        </a>.
      </p>
    </div>

    <p id="input-error" class="input-error" role="alert" aria-live="assertive" hidden></p>

    <button type="button" class="btn-primary" id="calc-btn">
      Calculate FFMI
    </button>

    <div class="result-box" id="result-box" hidden>
      <div
        id="result-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <div class="result-primary">
        <div class="result-title">Normalized FFMI</div>
        <div class="big-number" id="result-normalized">–</div>
        <div class="result-unit">kg/m²</div>
      </div>

      <div class="ffmi-positioning" id="ffmi-positioning">
        <div class="positioning-bar" aria-hidden="true">
          <span class="position-segment seg-1"></span>
          <span class="position-segment seg-2"></span>
          <span class="position-segment seg-3"></span>
          <span class="position-segment seg-4"></span>
          <span class="position-segment seg-5"></span>
          <span class="position-marker" id="position-marker"></span>
        </div>
        <div class="positioning-labels" aria-hidden="true">
          <span id="pos-label-1">&lt;18</span>
          <span id="pos-label-2">18–20</span>
          <span id="pos-label-3">20–22</span>
          <span id="pos-label-4">22–25</span>
          <span id="pos-label-5">25+</span>
        </div>
        <p class="positioning-note">Illustrative positioning — not to scale</p>
      </div>

      <div class="result-secondary">
        <div class="metric-card">
          <span class="metric-label">Raw FFMI</span>
          <strong id="result-ffmi">–</strong>
        </div>
        <div class="metric-card">
          <span class="metric-label">Fat-free mass</span>
          <strong id="result-ffm">–</strong>
        </div>
        <div class="metric-card">
          <span class="metric-label">Fat mass</span>
          <strong id="result-fat">–</strong>
        </div>
        <div class="metric-card">
          <span class="metric-label">Fat-free mass (%)</span>
          <strong id="result-lean-percent">–</strong>
        </div>
        <div class="metric-card">
          <span class="metric-label">BMI</span>
          <strong id="result-bmi">–</strong>
        </div>
      </div>

      <div class="ffmi-interpretation">
        <strong id="result-level">–</strong>
        <p id="result-interpretation">–</p>
      </div>

      <div class="next-level" id="next-level" hidden>
        <span class="next-level-label">To reach the next reference band:</span>
        <span id="next-level-text">–</span>
      </div>

      <div class="ffmi-scale">
        <h3 id="reference-guide-title">FFMI Reference Guide — Male</h3>
        <table class="result-table" id="reference-table">
          <caption>Broad educational reference bands — not medical classifications</caption>
          <thead>
            <tr>
              <th scope="col">Normalized FFMI</th>
              <th scope="col">General interpretation</th>
            </tr>
          </thead>
          <tbody id="reference-tbody"></tbody>
        </table>
        <p class="scale-note">
          These are broad educational reference bands, not medical
          classifications, and not proof of natural or enhanced status.
        </p>
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is FFMI?</h2>

    <p>
      <strong>FFMI (Fat-Free Mass Index)</strong> is a body-composition
      metric that expresses estimated fat-free mass relative to height. It
      has a similar mathematical structure to BMI, but FFMI uses fat-free
      mass instead of total body weight.
    </p>

    <p>
      This makes FFMI useful for lifters and athletes who want additional
      context about muscularity that BMI alone cannot provide. FFMI does
      not directly measure muscle mass, because fat-free mass includes
      bone, organs, body water, and other non-fat tissues.
    </p>

    <p>
      This calculator reports both <strong>raw FFMI</strong> and
      <strong>normalized FFMI</strong>, so you can see the underlying
      calculation as well as the height-adjusted value.
    </p>
  </article>

  <article class="article-section">
    <h2>Step-by-Step: How to Calculate Your FFMI</h2>

    <p>
      FFMI is calculated in two main steps. First, estimate fat-free mass
      from body weight and body-fat percentage. Then divide fat-free mass
      by height in metres squared.
    </p>

    <h3>Step 1: Calculate fat-free mass</h3>
    <p>
      <code>Fat-Free Mass = Weight × (1 − Body Fat % ÷ 100)</code>
    </p>

    <h3>Step 2: Calculate FFMI</h3>
    <p>
      <code>FFMI = Fat-Free Mass (kg) ÷ Height² (m)</code>
    </p>

    <h3>Worked example</h3>

    <p>
      Consider a 25-year-old male lifter who weighs 180 lb (81.6 kg), is
      5'11" tall (approximately 1.80 m), and has an estimated 15% body fat:
    </p>

    <ol>
      <li>
        Fat-free mass = 81.6 × (1 − 0.15) = <strong>69.4 kg</strong>
      </li>
      <li>
        Height squared = 1.80 × 1.80 = <strong>3.24 m²</strong>
      </li>
      <li>
        Raw FFMI = 69.4 ÷ 3.24 ≈ <strong>21.4 kg/m²</strong>
      </li>
      <li>
        At exactly 1.80 m, raw and normalized FFMI are the same value
      </li>
    </ol>

    <p>
      That puts this lifter solidly in the <strong>higher muscularity
      range</strong> for a natural male lifter — roughly aligned with the
      typical "good" band reported for trained men.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is Normalized FFMI?</h2>

    <p>
      Raw FFMI divides fat-free mass by height squared, but body
      composition does not scale perfectly with height. Normalized FFMI
      applies the height correction proposed by
      <a href="https://pubmed.ncbi.nlm.nih.gov/7496846/" target="_blank" rel="noopener noreferrer">Kouri et al. (1995)</a>
      to improve comparisons across different statures. The correction is
      positive below 1.80 m and negative above 1.80 m.
    </p>

    <p>
      The Kouri et al. approach uses:
    </p>

    <p>
      <code>Normalized FFMI = FFMI + 6.3 × (1.80 − Height in metres)</code>
    </p>

    <p>
      At exactly 1.80 m, raw and normalized FFMI are the same value.
    </p>

    <h3>Worked example (taller individual)</h3>

    <p>
      Consider a lifter weighing 90 kg at 15% body fat and 1.90 m tall:
    </p>

    <ol>
      <li>Fat-free mass = 90 × 0.85 = <strong>76.5 kg</strong></li>
      <li>Height squared = 1.90 × 1.90 = <strong>3.61 m²</strong></li>
      <li>Raw FFMI = 76.5 ÷ 3.61 ≈ <strong>21.2 kg/m²</strong></li>
      <li>Height correction = 6.3 × (1.80 − 1.90) = <strong>−0.63</strong></li>
      <li>Normalized FFMI = 21.2 − 0.63 ≈ <strong>20.6 kg/m²</strong></li>
    </ol>

    <p>
      The height correction used here follows the method reported by
      Kouri et al. and should not be confused with calculators that use
      different normalization methods.
    </p>
  </article>

  <article class="article-section">
    <h2>FFMI Ranges for Men and Women</h2>

    <p>
      FFMI ranges are commonly reported separately for men and women,
      because average muscle mass and hormonal profiles differ. The
      following bands combine published reference ranges from fitness
      research and are consistent with commonly cited interpretation
      guides.
    </p>

    <h3>Men</h3>

    <table class="result-table">
      <caption>Normalized FFMI ranges — men</caption>
      <thead>
        <tr>
          <th scope="col">Normalized FFMI</th>
          <th scope="col">Typical body fat</th>
          <th scope="col">Category</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>17–18</td><td>10–18%</td><td>Lean / untrained</td></tr>
        <tr><td>18–20</td><td>20–27%</td><td>Average</td></tr>
        <tr><td>20–21</td><td>10–18%</td><td>Athlete / intermediate</td></tr>
        <tr><td>22–23</td><td>6–12%</td><td>Advanced natural</td></tr>
        <tr><td>24–25</td><td>8–20%</td><td>Elite natural</td></tr>
        <tr><td>26+</td><td>—</td><td>Above common natural reference</td></tr>
      </tbody>
    </table>

    <h3>Women</h3>

    <table class="result-table">
      <caption>Normalized FFMI ranges — women</caption>
      <thead>
        <tr>
          <th scope="col">Normalized FFMI</th>
          <th scope="col">Typical body fat</th>
          <th scope="col">Category</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>14–15</td><td>20–25%</td><td>Lean / untrained</td></tr>
        <tr><td>14–17</td><td>22–35%</td><td>Average</td></tr>
        <tr><td>16–17</td><td>18–25%</td><td>Athlete / intermediate</td></tr>
        <tr><td>18–20</td><td>15–22%</td><td>Advanced</td></tr>
        <tr><td>19–21</td><td>15–30%</td><td>Bodybuilder / strength athlete</td></tr>
      </tbody>
    </table>

    <p class="calc-note">
      The bands and body-fat percentages shown are
      <strong>illustrative fitness reference ranges</strong>, not
      scientific cutoffs or diagnostic categories. They are provided as
      general context for interpreting FFMI — not as target ranges, not
      as required companions, and not as medical guidance. Individual
      physiques can span these bands with wide variation in body-fat
      level.
    </p>
  </article>

  <article class="article-section">
    <h2>At What FFMI Do You Look Muscular?</h2>

    <p>
      Visual muscularity depends on more than FFMI alone — bone structure,
      muscle insertions, body-fat distribution, and lighting all play a
      role. However, broad ranges are commonly cited:
    </p>

    <ul>
      <li>
        <strong>Normalized FFMI 18–19:</strong> lean, but not obviously
        muscular — often an untrained or lightly-trained physique.
      </li>
      <li>
        <strong>Normalized FFMI 20–21:</strong> visibly athletic. Muscle
        definition begins to show when body fat is under roughly 18%.
      </li>
      <li>
        <strong>Normalized FFMI 21–23 with 10–15% body fat:</strong>
        clearly muscular, lean look — often described as the "aesthetic"
        range.
      </li>
      <li>
        <strong>Normalized FFMI 24–25:</strong> elite natural level —
        dense, highly developed musculature across the body.
      </li>
    </ul>

    <p>
      In practice, a lifter with an FFMI of <strong>21–22 and body fat
      around 12%</strong> often looks more muscular than someone with a
      higher FFMI but higher body fat. Body-fat percentage strongly
      affects how visible muscle definition is.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Increase Your FFMI</h2>

    <p>
      Increasing FFMI means increasing fat-free mass relative to height.
      In practice, that means building muscle. Several evidence-based
      factors matter:
    </p>

    <ol>
      <li>
        <strong>Progressive resistance training.</strong> Consistently
        increasing weight, volume, or intensity over time is the primary
        driver of muscle growth. Aim for 2–4 sessions per week hitting
        each major muscle group.
      </li>
      <li>
        <strong>Adequate protein intake.</strong> Roughly 1.4–2.0 g/kg of
        body weight per day is a commonly cited sports-nutrition range.
        See our <a href="/tools/nutrition/protein-calculator/">Protein Calculator</a>
        for a goal-based estimate.
      </li>
      <li>
        <strong>Sufficient calories.</strong> Building muscle typically
        requires a small calorie surplus — roughly 250–400 kcal above
        maintenance. Use our
        <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a>
        as a starting point.
      </li>
      <li>
        <strong>Sleep and recovery.</strong> Muscle repair happens during
        recovery. Aim for 7–9 hours per night for most adults.
      </li>
      <li>
        <strong>Patience and consistency.</strong> Muscle gain is slow —
        a rate of roughly 0.5–1% of body weight per month is realistic
        for well-trained lifters during a bulk.
      </li>
    </ol>

    <p>
      For nutrition targets alongside your training plan, see our
      <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>
      and
      <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>How Age and Genetics Impact Your FFMI</h2>

    <p>
      Age and genetics both affect how much fat-free mass you can build
      and maintain.
    </p>

    <h3>Age</h3>
    <p>
      Muscle mass tends to peak between the late 20s and mid-30s and
      gradually declines afterward if training stops. Adults who train
      consistently can maintain high FFMI well into their 40s and 50s,
      but natural anabolic potential generally declines with age. For
      older adults, higher protein intakes (roughly 1.0–1.5 g/kg/day) are
      often recommended to help preserve muscle mass.
    </p>

    <h3>Genetics</h3>
    <p>
      Bone structure, frame size, limb lengths, and muscle-fiber
      composition all influence how much fat-free mass a person can carry.
      A lifter with a broader frame and naturally higher baseline muscle
      may reach FFMI values that another lifter with a smaller frame
      cannot match — even with identical training.
    </p>

    <p>
      Because of this variability, the 25 FFMI number should be treated
      as a reference point, not a hard biological limit for every
      individual.
    </p>
  </article>

  <article class="article-section">
    <h2>FFMI Natural Limit: What Does 25 Mean?</h2>

    <p>
      The number <strong>25</strong> is one of the most frequently
      discussed FFMI benchmarks in bodybuilding.
    </p>

    <p>
      In a 1995 study, Kouri and colleagues calculated FFMI in 157 male
      athletes, including 83 anabolic-androgenic steroid users and 74
      non-users. The normalized FFMI values among the non-users extended
      up to a well-defined value of 25.0.
    </p>

    <p>
      This is the historical basis for the commonly cited
      <strong>maximum natural FFMI</strong> idea. However, the original
      study described its findings as preliminary and the sample was
      limited to male athletes.
    </p>

    <p>
      Later research has reported FFMI values above 25 in drug-free
      athletic populations. In one collegiate American football study,
      26.4% of participants had height-adjusted FFMI values above 25 and
      the 97.5th percentile was 28.1. Research on drug-free sumo wrestlers
      has also documented values well above 25.
    </p>

    <p>
      Therefore, FFMI should be treated as a body-composition metric, not
      as a definitive test for performance-enhancing drug use.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Creatine Increase FFMI?</h2>

    <p>
      <strong>Yes, temporarily — for some people.</strong> Creatine
      supplementation increases intracellular water retention in muscle
      tissue, which increases total fat-free mass. This can boost FFMI in
      some individuals, though the size of any change depends on
      individual response, training status, starting muscle creatine
      levels, and the body-composition method used to estimate fat-free
      mass.
    </p>

    <p>
      Critically, this increase mostly reflects water retained inside the
      muscle cell — not newly built muscle tissue. Creatine-induced
      muscle growth only occurs when supplementation is combined with
      resistance training, which is why creatine is often described as a
      "training amplifier" rather than an independent driver of muscle
      gain.
    </p>

    <p>
      If your FFMI increases noticeably in the first few weeks of taking
      creatine, that increase is expected and mostly reflects cellular
      hydration. It is not automatically a sign of new muscle.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Your Body-Fat Measurement Method Affect FFMI?</h2>

    <p>
      <strong>Yes, substantially.</strong> FFMI depends directly on
      estimated fat-free mass, which depends on body-fat percentage. Two
      different measurement methods can produce different body-fat
      estimates for the same person, and those differences carry through
      to FFMI.
    </p>

    <table class="result-table">
      <caption>Typical reliability of common body-fat methods</caption>
      <thead>
        <tr>
          <th scope="col">Method</th>
          <th scope="col">Typical accuracy notes</th>
          <th scope="col">Practical notes</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>DEXA scan</td>
          <td>Widely used research reference</td>
          <td>Requires a clinic; not error-free</td>
        </tr>
        <tr>
          <td>Skinfold calipers</td>
          <td>Varies with tester skill</td>
          <td>Accuracy depends heavily on technique</td>
        </tr>
        <tr>
          <td>US Navy tape method</td>
          <td>General population estimate</td>
          <td>Uses neck, waist, hip measurements</td>
        </tr>
        <tr>
          <td>Bioelectrical impedance (BIA)</td>
          <td>Strongly affected by hydration state</td>
          <td>Sensitive to timing and conditions</td>
        </tr>
      </tbody>
    </table>

    <p class="calc-note">
      DEXA is widely used as a research reference, but it is not an
      error-free gold standard. All body-composition methods have
      limitations, and accuracy depends on measurement conditions,
      population, and equipment. For tracking change over time, using the
      same method under similar conditions is generally more useful than
      comparing isolated results from different methods.
    </p>
  </article>

  <article class="article-section">
    <h2>FFMI vs. BMI: What's the Difference?</h2>

    <p>
      BMI and FFMI have a similar mathematical structure, but they answer
      different questions.
    </p>

    <table class="result-table">
      <caption>BMI vs FFMI comparison</caption>
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col">Uses</th>
          <th scope="col">Main purpose</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>BMI</td>
          <td>Total body weight + height</td>
          <td>General weight-to-height screening metric</td>
        </tr>
        <tr>
          <td>FFMI</td>
          <td>Fat-free mass + height</td>
          <td>Describes fat-free mass relative to height</td>
        </tr>
      </tbody>
    </table>

    <p>
      If you want to calculate your general body-mass index, use our
      <a href="/tools/nutrition/bmi-calculator/">BMI Calculator</a>.
    </p>
  </article>

