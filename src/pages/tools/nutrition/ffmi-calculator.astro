  <script>
    type Unit = 'lb' | 'kg';
    type Sex = 'male' | 'female';

    let unit: Unit = 'lb';
    let sex: Sex = 'male';

    let preservedKg: number | null = null;
    let preservedCm: number | null = null;

    const LB_PER_KG = 2.2046226218;

    const unitLb = document.getElementById('unit-lb');
    const unitKg = document.getElementById('unit-kg');

    const sexInput = document.getElementById('sex') as HTMLSelectElement | null;

    const weightInput = document.getElementById('weight') as HTMLInputElement | null;
    const weightLabel = document.getElementById('weight-label');
    const weightUnit = document.getElementById('weight-unit');

    const heightFtInput = document.getElementById('height-ft') as HTMLInputElement | null;
    const heightInInput = document.getElementById('height-in') as HTMLInputElement | null;
    const heightCmInput = document.getElementById('height-cm') as HTMLInputElement | null;

    const bodyFatInput = document.getElementById('bodyfat') as HTMLInputElement | null;

    const heightImperial = document.getElementById('height-imperial');
    const heightMetric = document.getElementById('height-metric');

    const calcBtn = document.getElementById('calc-btn');
    const inputError = document.getElementById('input-error');

    const resultBox = document.getElementById('result-box');
    const resultNormalized = document.getElementById('result-normalized');
    const resultFfmi = document.getElementById('result-ffmi');
    const resultFfm = document.getElementById('result-ffm');
    const resultFat = document.getElementById('result-fat');
    const resultLeanPercent = document.getElementById('result-lean-percent');
    const resultBmi = document.getElementById('result-bmi');
    const resultLevel = document.getElementById('result-level');
    const resultInterpretation = document.getElementById('result-interpretation');
    const resultAnnouncement = document.getElementById('result-announcement');
    const positionMarker = document.getElementById('position-marker');
    const nextLevelBox = document.getElementById('next-level');
    const nextLevelText = document.getElementById('next-level-text');

    const referenceTbody = document.getElementById('reference-tbody');
    const referenceGuideTitle = document.getElementById('reference-guide-title');

    const posLabel1 = document.getElementById('pos-label-1');
    const posLabel2 = document.getElementById('pos-label-2');
    const posLabel3 = document.getElementById('pos-label-3');
    const posLabel4 = document.getElementById('pos-label-4');
    const posLabel5 = document.getElementById('pos-label-5');

    const round = (value: number, decimals = 1) => {
      const factor = Math.pow(10, decimals);
      return Math.round(value * factor) / factor;
    };

    const referenceBands: Record<Sex, { label: string; text: string }[]> = {
      male: [
        { label: 'Below 18', text: 'Lower muscularity range' },
        { label: '18–20', text: 'Moderate muscularity range' },
        { label: '20–22', text: 'Higher muscularity range (typical trained male)' },
        { label: '22–25', text: 'Very high muscularity range (advanced natural)' },
        { label: '25+', text: 'Above the commonly cited Kouri reference point' },
      ],
      female: [
        { label: 'Below 14', text: 'Lower muscularity range' },
        { label: '14–16', text: 'Moderate muscularity range' },
        { label: '16–18', text: 'Higher muscularity range (typical trained female)' },
        { label: '18–21', text: 'Very high muscularity range (advanced natural)' },
        { label: '21+', text: 'Above broad female-athlete reference ranges' },
      ],
    };

    // Numerical position scale for the marker.
    // Male bands: <18, 18-20, 20-22, 22-25, 25+ → spans 16-26 (10 units).
    // Female bands: <14, 14-16, 16-18, 18-21, 21+ → spans 12-22 (10 units).
    // Segment flex ratios 2:2:2:3:1 match the actual band widths in both cases.
    const positionScale: Record<Sex, [number, number]> = {
      male: [16, 26],
      female: [12, 22],
    };

    function updatePositionLabels(selectedSex: Sex) {
      const labels = selectedSex === 'female'
        ? ['<14', '14–16', '16–18', '18–21', '21+']
        : ['<18', '18–20', '20–22', '22–25', '25+'];

      const nodes = [posLabel1, posLabel2, posLabel3, posLabel4, posLabel5];
      nodes.forEach((node, i) => { if (node) node.textContent = labels[i]; });
    }

    function renderReferenceTable(selectedSex: Sex) {
      if (!referenceTbody) return;

      if (referenceGuideTitle) {
        referenceGuideTitle.textContent = `FFMI Reference Guide — ${selectedSex === 'female' ? 'Female' : 'Male'}`;
      }

      referenceTbody.replaceChildren();

      for (const band of referenceBands[selectedSex]) {
        const tr = document.createElement('tr');

        const labelCell = document.createElement('td');
        labelCell.textContent = band.label;

        const textCell = document.createElement('td');
        textCell.textContent = band.text;

        tr.append(labelCell, textCell);
        referenceTbody.appendChild(tr);
      }
    }

    function syncPreservedWeight() {
      if (!weightInput) return;
      const raw = weightInput.value.trim();
      if (raw === '') { preservedKg = null; return; }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) { preservedKg = null; return; }
      preservedKg = unit === 'lb' ? value / LB_PER_KG : value;
    }

    function syncPreservedHeightFromImperial() {
      if (!heightFtInput || !heightInInput) return;
      const feetRaw = heightFtInput.value.trim();
      const inchesRaw = heightInInput.value.trim();
      if (feetRaw === '' && inchesRaw === '') { preservedCm = null; return; }
      const feet = feetRaw === '' ? 0 : Number(feetRaw);
      const inches = inchesRaw === '' ? 0 : Number(inchesRaw);
      if (!Number.isFinite(feet) || !Number.isFinite(inches) || feet < 0 || inches < 0 || inches >= 12) {
        preservedCm = null; return;
      }
      const totalInches = feet * 12 + inches;
      if (totalInches <= 0) { preservedCm = null; return; }
      preservedCm = totalInches * 2.54;
    }

    function syncPreservedHeightFromMetric() {
      if (!heightCmInput) return;
      const raw = heightCmInput.value.trim();
      if (raw === '') { preservedCm = null; return; }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) { preservedCm = null; return; }
      preservedCm = value;
    }

    function resetResult() {
      clearError();
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
      if (resultAnnouncement) resultAnnouncement.textContent = '';
    }

    function updateWeightLimits() {
      if (!weightInput) return;

      if (unit === 'lb') {
        weightInput.min = '66';
        weightInput.max = '660';
      } else {
        weightInput.min = '30';
        weightInput.max = '300';
      }
    }

    function setUnit(next: Unit) {
      if (next === unit) return;

      if (preservedKg !== null && preservedKg > 0 && weightInput) {
        weightInput.value = next === 'lb'
          ? (preservedKg * LB_PER_KG).toFixed(1)
          : preservedKg.toFixed(1);
      }

      if (preservedCm !== null && preservedCm > 0) {
        if (next === 'kg' && heightCmInput) {
          heightCmInput.value = preservedCm.toFixed(1);
        }
        if (next === 'lb' && heightFtInput && heightInInput) {
          const totalInches = preservedCm / 2.54;
          const feet = Math.floor(totalInches / 12);
          const inches = totalInches - feet * 12;
          heightFtInput.value = String(feet);
          heightInInput.value = inches.toFixed(1);
        }
      }

      unit = next;
      updateUnitUI();
      resetResult();
    }

    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle('active', unit === 'lb');
        unitLb.setAttribute('aria-pressed', String(unit === 'lb'));
      }
      if (unitKg) {
        unitKg.classList.toggle('active', unit === 'kg');
        unitKg.setAttribute('aria-pressed', String(unit === 'kg'));
      }
      if (weightUnit) weightUnit.textContent = unit === 'lb' ? 'lb' : 'kg';
      if (weightLabel) {
        weightLabel.textContent = unit === 'lb' ? 'Body weight (lb)' : 'Body weight (kg)';
      }
      if (weightInput) {
        weightInput.placeholder = unit === 'lb' ? 'e.g. 180' : 'e.g. 82';
      }
      if (heightImperial) heightImperial.hidden = unit !== 'lb';
      if (heightMetric) heightMetric.hidden = unit !== 'kg';

      updateWeightLimits();
    }

    function showError(message: string) {
      if (!inputError) return;
      inputError.textContent = message;
      inputError.hidden = false;
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
    }

    function clearError() {
      if (!inputError) return;
      inputError.textContent = '';
      inputError.hidden = true;
    }

    function getWeightKg(): number {
      if (preservedKg !== null) return preservedKg;
      const raw = Number(weightInput?.value ?? '');
      if (!Number.isFinite(raw) || raw <= 0) return NaN;
      return unit === 'lb' ? raw / LB_PER_KG : raw;
    }

    function getHeightCm(): number {
      if (preservedCm !== null) return preservedCm;
      if (unit === 'kg') {
        const cm = Number(heightCmInput?.value ?? '');
        return Number.isFinite(cm) && cm > 0 ? cm : NaN;
      }
      const feet = Number(heightFtInput?.value ?? '');
      const inches = Number(heightInInput?.value ?? '');
      if (!Number.isFinite(feet) || !Number.isFinite(inches)) return NaN;
      if (feet < 3 || feet > 8 || inches < 0 || inches >= 12) return NaN;
      return (feet * 12 + inches) * 2.54;
    }

    function getInterpretation(normalized: number, selectedSex: Sex) {
      if (selectedSex === 'female') {
        if (normalized < 14) return { level: 'Lower FFMI range', text: 'Your calculated FFMI is in a lower range. Female FFMI values vary across populations and sports, so this number should be interpreted as a body-composition metric rather than a pass/fail standard.' };
        if (normalized < 16) return { level: 'Moderate FFMI range', text: 'Your calculated FFMI falls in a moderate range. There is no universal female FFMI cutoff for athletic or natural status.' };
        if (normalized < 18) return { level: 'Higher FFMI range', text: 'Your calculated FFMI falls in a higher range. Female athletes can show substantial sport-specific differences in FFMI.' };
        if (normalized < 21) return { level: 'Very high FFMI range', text: 'Your calculated FFMI is relatively high. Interpret it alongside your sport, training history, body-fat measurement method, and population.' };
        return { level: 'High FFMI value', text: 'Your calculated FFMI is high relative to broad female-athlete reference data. This is not a diagnosis and should not be used to infer drug use.' };
      }
      if (normalized < 18) return { level: 'Lower FFMI range', text: 'Your calculated FFMI is in a lower muscularity range. FFMI is descriptive and should be interpreted alongside training history and body-fat measurement quality.' };
      if (normalized < 20) return { level: 'Moderate FFMI range', text: 'Your calculated FFMI falls in a moderate muscularity range.' };
      if (normalized < 22) return { level: 'Higher FFMI range', text: 'Your calculated FFMI indicates a relatively high amount of fat-free mass for your height — typical of a trained male lifter.' };
      if (normalized < 25) return { level: 'Very high FFMI range', text: 'Your calculated FFMI is in a very high muscularity range, aligned with an advanced natural level. The result remains an estimate because it depends on your body-fat measurement.' };
      return { level: '25+ FFMI reference range', text: 'Your normalized FFMI is at or above the commonly cited 25 reference point from Kouri et al. This does not prove or disprove performance-enhancing drug use.' };
    }

    function updatePositionMarker(normalized: number, selectedSex: Sex) {
      if (!positionMarker) return;
      const [min, max] = positionScale[selectedSex];
      const clamped = Math.max(min, Math.min(max, normalized));
      const percent = ((clamped - min) / (max - min)) * 100;
      positionMarker.style.left = `${percent}%`;
    }

    unitLb?.addEventListener('click', () => setUnit('lb'));
    unitKg?.addEventListener('click', () => setUnit('kg'));

    weightInput?.addEventListener('input', () => { syncPreservedWeight(); resetResult(); });
    heightFtInput?.addEventListener('input', () => { syncPreservedHeightFromImperial(); resetResult(); });
    heightInInput?.addEventListener('input', () => { syncPreservedHeightFromImperial(); resetResult(); });
    heightCmInput?.addEventListener('input', () => { syncPreservedHeightFromMetric(); resetResult(); });
    bodyFatInput?.addEventListener('input', resetResult);

    sexInput?.addEventListener('change', () => {
      sex = (sexInput.value as Sex) || 'male';
      updatePositionLabels(sex);
      renderReferenceTable(sex);
      resetResult();
    });

    calcBtn?.addEventListener('click', () => {
      clearError();

      if (preservedKg === null) syncPreservedWeight();
      if (preservedCm === null) {
        if (unit === 'lb') syncPreservedHeightFromImperial();
        else syncPreservedHeightFromMetric();
      }

      const weightKg = getWeightKg();
      const heightCm = getHeightCm();
      const bodyFat = Number(bodyFatInput?.value ?? '');

      if (!Number.isFinite(weightKg) || weightKg < 30 || weightKg > 300) {
        showError('Please enter a body weight between 30 and 300 kg (approximately 66–660 lb).');
        return;
      }
      if (!Number.isFinite(heightCm) || heightCm < 120 || heightCm > 250) {
        showError('Please enter a height between 120 and 250 cm (approximately 4 ft – 8 ft).');
        return;
      }
      if (!Number.isFinite(bodyFat) || bodyFat < 3 || bodyFat > 60) {
        showError('Please enter a body-fat percentage between 3% and 60%.');
        return;
      }

      const heightM = heightCm / 100;
      const fatMassKg = weightKg * (bodyFat / 100);
      const fatFreeMassKg = weightKg - fatMassKg;
      const ffmi = fatFreeMassKg / Math.pow(heightM, 2);
      const normalizedFfmi = ffmi + 6.3 * (1.8 - heightM);
      const bmi = weightKg / Math.pow(heightM, 2);
      const leanPercent = (fatFreeMassKg / weightKg) * 100;

      const displayFfm = unit === 'lb' ? fatFreeMassKg * LB_PER_KG : fatFreeMassKg;
      const displayFat = unit === 'lb' ? fatMassKg * LB_PER_KG : fatMassKg;

      if (resultNormalized) resultNormalized.textContent = round(normalizedFfmi).toFixed(1);
      if (resultFfmi) resultFfmi.textContent = `${round(ffmi).toFixed(1)} kg/m²`;
      if (resultFfm) resultFfm.textContent = `${round(displayFfm).toFixed(1)} ${unit}`;
      if (resultFat) resultFat.textContent = `${round(displayFat).toFixed(1)} ${unit}`;
      if (resultLeanPercent) resultLeanPercent.textContent = `${round(leanPercent).toFixed(1)}%`;
      if (resultBmi) resultBmi.textContent = round(bmi).toFixed(1);

      const interpretation = getInterpretation(normalizedFfmi, sex);
      if (resultLevel) resultLevel.textContent = interpretation.level;
      if (resultInterpretation) resultInterpretation.textContent = interpretation.text;

      updatePositionMarker(normalizedFfmi, sex);

      if (nextLevelBox && nextLevelText) {
        const bands = sex === 'female' ? [14, 16, 18, 21] : [18, 20, 22, 25];
        const nextBand = bands.find((band) => band > normalizedFfmi);

        if (!nextBand) {
          nextLevelBox.hidden = true;
        } else {
          const rawTarget = nextBand - 6.3 * (1.80 - heightM);
          const ffmTargetKg = rawTarget * Math.pow(heightM, 2);
          const ffmGainKg = ffmTargetKg - fatFreeMassKg;
          const ffmGain = unit === 'lb' ? ffmGainKg * LB_PER_KG : ffmGainKg;

          if (ffmGain > 0.1) {
            nextLevelBox.hidden = false;
            nextLevelText.textContent = `Reach a normalized FFMI of ${nextBand.toFixed(1)} — approximately ${round(ffmGain).toFixed(1)} ${unit} of additional fat-free mass at your current height.`;
          } else {
            nextLevelBox.hidden = true;
          }
        }
      }

      if (resultBox) {
        resultBox.hidden = false;
        resultBox.classList.add('show');
      }

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Normalized FFMI: ${round(normalizedFfmi).toFixed(1)} kg per square meter. Raw FFMI: ${round(ffmi).toFixed(1)}. Fat-free mass: ${round(displayFfm).toFixed(1)} ${unit}. ${interpretation.level}.`;
      }
    });

    updateUnitUI();
    updatePositionLabels(sex);
    renderReferenceTable(sex);
  </script>
</Base>
