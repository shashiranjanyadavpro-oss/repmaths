---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---

<Base
  title="Calories Burned Calculator — Track Your Workout & Daily Burn"
  description="Free calories burned calculator using MET values. Estimate calories burned from walking, running, cycling, weightlifting, cardio, and other activities based on your weight and workout duration."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Calories Burned Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free online calculator that estimates calories burned during exercise and physical activity using MET values, body weight, and activity duration."
  })} />

  <section class="hero">
    <h1>Calories Burned Calculator</h1>
    <p>
      Estimate calories burned during walking, running, cycling, weightlifting,
      cardio, and other activities using your body weight, workout duration,
      and a MET-based activity estimate.
    </p>
  </section>

  <section class="calc-card" aria-label="Calories burned calculator">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="unit-lb"
          class="active"
          aria-pressed="true"
        >
          lb
        </button>
        <button
          type="button"
          id="unit-kg"
          aria-pressed="false"
        >
          kg
        </button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Body Weight</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 180"
        inputmode="decimal"
        min="20"
        max="350"
        step="any"
      />
    </div>

    <div class="field">
      <label for="activity">Activity</label>
      <select id="activity">
        <optgroup label="Weight Training & Gym">
          <option value="3.5">
            Resistance training — multiple exercises
          </option>
          <option value="5">
            Resistance training — squats/deadlifts
          </option>
          <option value="5.8">
            Resistance circuit / supersets
          </option>
          <option value="6">
            Vigorous weightlifting / bodybuilding
          </option>
          <option value="7.5">
            Vigorous circuit training
          </option>
          <option value="9.8">
            Kettlebell swings
          </option>
        </optgroup>

        <optgroup label="Walking">
          <option value="2.8">
            Walking — easy pace
          </option>
          <option value="3.5">
            Walking — moderate pace
          </option>
          <option value="4.3">
            Walking — brisk pace
          </option>
          <option value="5">
            Walking — very brisk pace
          </option>
        </optgroup>

        <optgroup label="Running">
          <option value="7">
            Running — easy pace
          </option>
          <option value="8.3">
            Running — moderate pace
          </option>
          <option value="9.8">
            Running — faster pace
          </option>
          <option value="11.5">
            Running — vigorous pace
          </option>
        </optgroup>

        <optgroup label="Cycling">
          <option value="4">
            Cycling — light effort
          </option>
          <option value="6.8">
            Cycling — moderate effort
          </option>
          <option value="8">
            Cycling — vigorous effort
          </option>
          <option value="10">
            Cycling — high-intensity effort
          </option>
        </optgroup>

        <optgroup label="Cardio Machines">
          <option value="5">
            Elliptical — moderate
          </option>
          <option value="9">
            Elliptical — vigorous
          </option>
          <option value="5">
            Rowing — moderate
          </option>
          <option value="7.3">
            Rowing — vigorous
          </option>
          <option value="9.3">
            Stair treadmill / stair machine
          </option>
        </optgroup>

        <optgroup label="Other Activities">
          <option value="3.8">
            Calisthenics — moderate
          </option>
          <option value="7.5">
            Calisthenics — vigorous
          </option>
          <option value="5">
            Boot camp
          </option>
          <option value="11">
            Rope skipping
          </option>
        </optgroup>
      </select>
    </div>

    <div class="field">
      <label for="duration">Duration</label>
      <div class="duration-row">
        <input
          type="number"
          id="duration"
          placeholder="e.g. 45"
          inputmode="decimal"
          min="1"
          max="1440"
          step="any"
        />

        <select id="duration-unit" aria-label="Duration unit">
          <option value="minutes">Minutes</option>
          <option value="hours">Hours</option>
        </select>
      </div>
    </div>

    <button class="btn-primary" id="calc-btn">
      Calculate Calories Burned
    </button>

    <div class="result-box" id="result-box" aria-live="polite">
      <div class="result-grid">
        <div class="result-stat">
          <div class="big-number" id="result-total">–</div>
          <div class="label">Estimated Total Calories</div>
        </div>

        <div class="result-stat">
          <div class="big-number" id="result-active">–</div>
          <div class="label">Estimated Active Calories</div>
        </div>
      </div>

      <div class="result-details">
        <div>
          <strong id="result-kcal-minute">–</strong>
          <span>kcal/min</span>
        </div>

        <div>
          <strong id="result-met">–</strong>
          <span>MET</span>
        </div>
      </div>

      <div class="reality-check">
        <h3>Lifter's Reality Check</h3>
        <p id="reality-text">
          A gym session is not the same as continuous exercise. Rest periods,
          setup time, changing weights, walking between equipment, and
          conversation can reduce the amount of time spent actively exercising.
        </p>
      </div>

      <p class="result-note">
        These are estimates, not direct measurements of your individual energy
        expenditure.
      </p>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is a Calories Burned Calculator?</h2>

    <p>
      A calories burned calculator estimates how much energy you may expend
      during a physical activity based on your body weight, activity intensity,
      and duration. This calculator uses MET values to provide a practical
      estimate for activities such as walking, running, cycling, weightlifting,
      circuit training, and cardio.
    </p>

    <p>
      The result is an estimate rather than a direct measurement. Actual energy
      expenditure can vary with exercise technique, fitness level, movement
      efficiency, workout intensity, rest periods, terrain, equipment, and
      individual physiology.
    </p>
  </article>

  <article class="article-section">
    <h2>How Do You Calculate Calories Burned During Exercise?</h2>

    <p>
      MET-based calorie calculations combine an activity's MET value with body
      weight and exercise duration. The calculator converts your weight to
      kilograms when necessary and estimates calories from the selected
      activity's MET value.
    </p>

    <p>
      In simplified form, the calculation uses:
      <strong>calories per minute = MET × 3.5 × body weight in kg ÷ 200</strong>.
      Multiplying that value by exercise duration gives the estimated total
      calories for the session.
    </p>

    <p>
      For a practical nutrition estimate, the result should be treated as a
      range or planning input rather than an exact measurement of calories
      burned.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is a MET?</h2>

    <p>
      MET stands for metabolic equivalent of task. A MET value describes the
      energy cost of an activity relative to resting metabolic rate. The
      <a
        href="https://pacompendium.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium of Physical Activities
      </a>
      uses MET values to classify the energy cost of many different physical
      activities.
    </p>

    <p>
      The
      <a
        href="https://pacompendium.com/adult-compendium/"
        target="_blank"
        rel="noopener noreferrer"
      >
        2024 Adult Compendium
      </a>
      provides standardized activity classifications and MET values. These
      values are useful for estimating energy expenditure at the population
      level, but they do not measure the exact calorie cost for every
      individual.
    </p>
  </article>

  <article class="article-section">
    <h2>The Science of Calorie Expenditure During Resistance Training</h2>

    <p>
      Resistance training can have very different energy costs depending on
      the exercise, load, number of repetitions, rest intervals, and how
      continuously the workout is performed.
    </p>

    <p>
      The 2024 Adult Compendium includes separate MET classifications for
      resistance training involving multiple exercises, vigorous weightlifting,
      squats and deadlifts, and resistance circuits. This is why there is no
      single calorie-burn number that applies to every weightlifting workout.
    </p>

    <p>
      For lifters, the most important practical distinction is between
      <strong>active exercise time</strong> and the total time spent at the
      gym. A 60-minute gym visit does not necessarily represent 60 minutes of
      continuous resistance exercise.
    </p>
  </article>

  <article class="article-section">
    <h2>How Many Calories Do You Burn Lifting Weights?</h2>

    <p>
      There is no single calorie value for weightlifting. Exercise intensity
      can vary substantially between a traditional strength session, a
      bodybuilding workout, a resistance circuit, and a short high-intensity
      conditioning session.
    </p>

    <p>
      For example, the Adult Compendium lists different MET classifications
      for general resistance training, squats and deadlifts, vigorous
      weightlifting, and resistance circuits. The calculator therefore gives
      you several resistance-training options instead of treating every gym
      session as identical.
    </p>

    <p>
      If you are tracking a lifting session for nutrition purposes, remember
      that calorie expenditure is only one part of the training picture.
      Training volume, recovery, performance, and progressive overload are
      also important.
    </p>
  </article>

  <article class="article-section">
    <h2>Tracking Calories for Weightlifting</h2>

    <p>
      If your main goal is strength or muscle growth, avoid treating estimated
      exercise calories as a precise allowance for extra food. A better
      approach is to use your estimated calorie expenditure alongside your
      overall nutrition target and then monitor body-weight trends, training
      performance, recovery, and hunger.
    </p>

    <p>
      You can use our
      <a href="/tools/nutrition/tdee-calculator">TDEE Calculator</a>
      to estimate your daily energy needs, then use the
      <a href="/tools/nutrition/macro-calculator">Macro Calculator</a>
      to turn a calorie target into protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned Walking</h2>

    <p>
      Walking calorie expenditure depends primarily on body weight, walking
      intensity, duration, terrain, and individual movement efficiency.
      Walking faster generally requires more energy than walking at an easy
      pace.
    </p>

    <p>
      The
      <a
        href="https://pacompendium.com/walking/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium walking section
      </a>
      provides different activity classifications for walking speeds and
      conditions rather than treating all walking as one activity.
    </p>

    <p>
      This makes a MET-based calculator useful for comparing different walking
      durations and intensities, while still keeping the result as an estimate.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned Running</h2>

    <p>
      Running generally has a higher energy cost per minute than easy walking,
      but the exact estimate depends on running speed, body weight, duration,
      terrain, and individual efficiency.
    </p>

    <p>
      The
      <a
        href="https://pacompendium.com/running/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium running classifications
      </a>
      distinguish between different running intensities and speeds.
    </p>

    <p>
      If you want to compare running with walking for the same duration, select
      each activity in the calculator and keep your body weight and duration
      constant.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Body Weight Affect Calories Burned?</h2>

    <p>
      Yes. For the same MET value and exercise duration, the calculation
      produces a higher estimated calorie expenditure for a heavier body
      weight because moving a larger body generally requires more energy.
    </p>

    <p>
      This is one reason calorie estimates should be personalized to body
      weight rather than relying on a single generic calorie number for an
      activity.
    </p>
  </article>

  <article class="article-section">
    <h2>Heart Rate, Exercise Intensity & Energy Expenditure</h2>

    <p>
      Heart rate can provide useful information about exercise intensity, but
      it does not by itself provide a perfect measurement of calories burned.
      The relationship between heart rate and energy expenditure varies by
      activity and individual.
    </p>

    <p>
      A heart-rate-based wearable may therefore produce a different estimate
      from a MET-based calculator. Differences can occur because the two
      approaches use different inputs, assumptions, algorithms, and activity
      classifications.
    </p>

    <p>
      For resistance training in particular, heart rate can fluctuate because
      of set intensity, rest periods, breathing, exercise selection, and
      factors unrelated to total calorie expenditure.
    </p>
  </article>

  <article class="article-section">
    <h2>Understanding Active and Total Exercise Calories</h2>

    <p>
      This calculator reports both estimated total exercise calories and
      estimated active calories. Total exercise calories represent the
      calculated energy expenditure associated with the selected activity.
    </p>

    <p>
      Active calories are estimated here by subtracting the resting
      contribution represented by approximately 1 MET from the selected
      activity's MET value. This is a calculation convention and should not
      be assumed to match the exact definition used by Apple Watch, Garmin,
      Fitbit, or another wearable.
    </p>

    <p>
      If you are comparing this result with a smartwatch, always compare the
      same activity duration and understand whether the device is reporting
      active calories, total calories, or another metric.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Calorie Estimates Can Differ From Real-World Burn</h2>

    <p>
      Formula-based calorie estimates are useful because direct measurement of
      energy expenditure requires specialized testing. However, a standardized
      MET value cannot capture every factor affecting an individual's actual
      energy cost.
    </p>

    <p>
      Differences can come from exercise intensity, movement efficiency,
      technique, fitness level, body composition, environmental conditions,
      rest intervals, and how continuously the activity is performed.
    </p>

    <p>
      The Compendium itself is a classification system rather than a personal
      metabolic measurement. Its
      <a
        href="https://pacompendium.com/corrected-mets/"
        target="_blank"
        rel="noopener noreferrer"
      >
        corrected MET guidance
      </a>
      explains important limitations of standardized MET values when estimating
      individual energy expenditure.
    </p>
  </article>

  <article class="article-section">
    <h2>Smartwatch Calories vs Calculator Estimates</h2>

    <p>
      A smartwatch and a MET-based calculator can legitimately produce
      different calorie estimates for the same workout. Wearables may combine
      heart rate, movement, user characteristics, GPS data, activity type, and
      proprietary algorithms, while this calculator uses body weight,
      duration, and a standardized MET value.
    </p>

    <p>
      Neither number should automatically be treated as an exact measurement
      of your individual calorie expenditure. For ongoing nutrition tracking,
      consistency and changes in your real-world body-weight trend can be more
      useful than treating any single exercise-calorie estimate as exact.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned and Weight Loss</h2>

    <p>
      Exercise contributes to energy expenditure, but weight loss depends on
      overall energy balance over time rather than the calories reported by a
      single workout.
    </p>

    <p>
      If your goal is fat loss, use your estimated daily needs and real-world
      progress together. Our
      <a href="/tools/nutrition/calorie-deficit-calculator">
        Calorie Deficit Calculator
      </a>
      can estimate a daily calorie target and projected weight-loss timeline.
    </p>

    <p>
      Avoid assuming that every calorie shown by an exercise calculator should
      automatically be added back to your food intake. Exercise estimates have
      uncertainty, and your actual calorie needs depend on your complete
      activity pattern and individual response.
    </p>
  </article>

  <article class="article-section">
    <h2>Using Calories Burned With Your Nutrition Plan</h2>

    <p>
      Calories burned estimates work best as one piece of a broader nutrition
      plan. For example, you can combine activity estimates with your
      estimated
      <a href="/tools/nutrition/bmr-calculator">BMR</a>,
      <a href="/tools/nutrition/tdee-calculator">TDEE</a>,
      <a href="/tools/nutrition/macro-calculator">macros</a>, and
      <a href="/tools/nutrition/protein-calculator">protein target</a>.
    </p>

    <p>
      For people who train regularly, it is usually more useful to look at
      trends in body weight, workout performance, recovery, and nutrition
      adherence than to chase an exact calorie number for every individual
      workout.
    </p>
  </article>

  <article class="article-section">
    <h2>Sources & Methodology</h2>

    <p>
      Activity classifications and MET values are based on the
      <a
        href="https://pacompendium.com/adult-compendium/"
        target="_blank"
        rel="noopener noreferrer"
      >
        2024 Adult Compendium of Physical Activities
      </a>
      and related Compendium activity pages.
    </p>

    <p>
      The Compendium provides standardized estimates for physical activities.
      RepMaths uses those values with body weight and duration to create a
      practical calculator result. The output is not a laboratory measurement
      of an individual's oxygen consumption or metabolic rate.
    </p>

    <p>
      MET-based calculations should therefore be interpreted as estimates for
      planning and comparison rather than exact measurements.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>
        Why does my Apple Watch show different calories than this calculator?
      </h3>
      <p>
        A smartwatch and a MET-based calculator may use different inputs and
        algorithms. A wearable may incorporate heart rate, movement, GPS,
        activity type, and personal characteristics, while this calculator
        uses body weight, duration, and a standardized MET estimate.
      </p>
    </div>

    <div class="faq-item">
      <h3>Should I eat back the calories I burn from exercise?</h3>
      <p>
        Not necessarily. Exercise-calorie estimates contain uncertainty, so
        automatically eating back every reported calorie can make your actual
        intake higher than intended. Use your overall calorie target and
        monitor body-weight and performance trends over time.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does weightlifting cause an afterburn effect (EPOC)?</h3>
      <p>
        Resistance exercise can increase oxygen consumption and energy
        expenditure after exercise, commonly referred to as excess post-exercise
        oxygen consumption or EPOC. This calculator does not add a separate
        EPOC adjustment to its displayed result.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does sweating more mean I burned more calories?</h3>
      <p>
        Not necessarily. Sweating is primarily a thermoregulatory response and
        can be affected by temperature, humidity, clothing, hydration, and
        individual differences. Sweat loss should not be used as a direct
        measure of calories burned.
      </p>
    </div>

    <div class="faq-item">
      <h3>How accurate are MET-based calorie estimates?</h3>
      <p>
        MET-based calculations provide standardized estimates rather than
        direct measurements of individual energy expenditure. Accuracy can vary
        with activity intensity, body weight, exercise technique, fitness,
        rest periods, and other individual factors.
      </p>
    </div>

    <div class="faq-item">
      <h3>
        Do heavier people burn more calories during the same activity?
      </h3>
      <p>
        For the same activity classification and duration, the MET calculation
        generally produces a higher estimated calorie expenditure at a higher
        body weight because the calculation scales with body mass.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="calories-burned-calculator" />

  <script>
    let unit = "lb";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const weightInput =
      document.getElementById("weight") as HTMLInputElement | null;

    const activityInput =
      document.getElementById("activity") as HTMLSelectElement | null;

    const durationInput =
      document.getElementById("duration") as HTMLInputElement | null;

    const durationUnitInput =
      document.getElementById("duration-unit") as HTMLSelectElement | null;

    const calcBtn = document.getElementById("calc-btn");

    const resultBox = document.getElementById("result-box");
    const resultTotal = document.getElementById("result-total");
    const resultActive = document.getElementById("result-active");
    const resultKcalMinute = document.getElementById("result-kcal-minute");
    const resultMet = document.getElementById("result-met");
    const realityText = document.getElementById("reality-text");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    function setUnit(newUnit: string) {
      if (newUnit === unit) return;

      if (weightInput) {
        const currentValue = parseFloat(weightInput.value);

        if (Number.isFinite(currentValue) && currentValue > 0) {
          weightInput.value =
            newUnit === "kg"
              ? (currentValue / 2.2046226218).toFixed(1)
              : (currentValue * 2.2046226218).toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }
    }

    function showError(message: string) {
      alert(message);
    }

    function formatNumber(value: number, decimals = 0): string {
      return value.toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (
          !weightInput ||
          !activityInput ||
          !durationInput ||
          !durationUnitInput
        ) {
          return;
        }

        const inputWeight = parseFloat(weightInput.value);
        const met = parseFloat(activityInput.value);
        const durationValue = parseFloat(durationInput.value);
        const durationUnit = durationUnitInput.value;

        if (
          !Number.isFinite(inputWeight) ||
          inputWeight <= 0 ||
          !Number.isFinite(met) ||
          met <= 0 ||
          !Number.isFinite(durationValue) ||
          durationValue <= 0
        ) {
          showError(
            "Please enter a valid body weight, activity, and workout duration."
          );
          return;
        }

        const weightKg =
          unit === "lb"
            ? inputWeight / 2.2046226218
            : inputWeight;

        if (weightKg < 20 || weightKg > 350) {
          showError(
            "Please enter a body weight between 20 and 350 kg (44 and 772 lb)."
          );
          return;
        }

        const durationMinutes =
          durationUnit === "hours"
            ? durationValue * 60
            : durationValue;

        if (
          !Number.isFinite(durationMinutes) ||
          durationMinutes <= 0 ||
          durationMinutes > 1440
        ) {
          showError(
            "Please enter a workout duration between 1 minute and 24 hours."
          );
          return;
        }

        const caloriesPerMinute =
          (met * 3.5 * weightKg) / 200;

        const totalCalories =
          caloriesPerMinute * durationMinutes;

        const activeCaloriesPerMinute =
          (Math.max(met - 1, 0) * 3.5 * weightKg) / 200;

        const totalActiveCalories =
          activeCaloriesPerMinute * durationMinutes;

        if (
          !Number.isFinite(totalCalories) ||
          !Number.isFinite(totalActiveCalories) ||
          totalCalories <= 0
        ) {
          showError(
            "This combination of inputs did not produce a valid estimate. Please try different values."
          );
          return;
        }

        if (resultTotal) {
          resultTotal.textContent =
            `${formatNumber(Math.round(totalCalories))} kcal`;
        }

        if (resultActive) {
          resultActive.textContent =
            `${formatNumber(Math.round(totalActiveCalories))} kcal`;
        }

        if (resultKcalMinute) {
          resultKcalMinute.textContent =
            formatNumber(caloriesPerMinute, 2);
        }

        if (resultMet) {
          resultMet.textContent =
            formatNumber(met, 1);
        }

        if (realityText) {
          const selectedActivity =
            activityInput.options[activityInput.selectedIndex]?.text ||
            "this activity";

          if (met >= 5.8) {
            realityText.textContent =
              `For ${selectedActivity.toLowerCase()}, the selected MET represents a relatively vigorous activity level. If your session contains long rest periods or substantial setup time, your actual average energy expenditure across the full gym visit may be lower than this continuous-activity estimate.`;
          } else {
            realityText.textContent =
              `This estimate assumes the selected activity is performed at approximately the selected intensity for the full duration. During a real gym session, rest periods, setup time, changing weights, walking between equipment, and conversation can reduce continuous exercise time.`;
          }
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>

  <style>
    .duration-row {
      display: grid;
      grid-template-columns: 1fr 150px;
      gap: 10px;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }

    .result-stat {
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
