---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'Calories Burned Calculator' },
];

const faqs = [
  {
    question: 'Why does my Apple Watch show different calories than this calculator?',
    answer:
      'A smartwatch and a MET-based calculator may use different inputs and algorithms. A wearable may incorporate heart rate, movement, GPS, activity type, and personal characteristics, while this calculator uses body weight, duration, and a standardized MET estimate.',
  },
  {
    question: 'Should I eat back the calories I burn from exercise?',
    answer:
      '<strong>Not necessarily.</strong> Exercise-calorie estimates contain uncertainty, so automatically eating back every reported calorie can make your actual intake higher than intended. Use your overall calorie target and monitor body-weight and performance trends over time.',
  },
  {
    question: 'Does weightlifting cause an afterburn effect (EPOC)?',
    answer:
      '<strong>Yes.</strong> Resistance exercise can increase oxygen consumption and energy expenditure after exercise, commonly referred to as excess post-exercise oxygen consumption (EPOC). This calculator does <strong>not</strong> add a separate EPOC adjustment to its displayed result, though the effect is real and varies by session intensity.',
  },
  {
    question: 'Does sweating more mean I burned more calories?',
    answer:
      '<strong>No.</strong> Sweating is primarily a thermoregulatory response and can be affected by temperature, humidity, clothing, hydration, and individual differences. Sweat loss should not be used as a direct measure of calories burned.',
  },
  {
    question: 'How accurate are MET-based calorie estimates?',
    answer:
      'MET-based calculations provide <strong>standardized estimates</strong> rather than direct measurements of individual energy expenditure. Accuracy can vary with activity intensity, body weight, exercise technique, fitness, rest periods, and other individual factors.',
  },
  {
    question: 'Do heavier people burn more calories during the same activity?',
    answer:
      '<strong>Yes.</strong> For the same activity classification and duration, the MET calculation generally produces a higher estimated calorie expenditure at a higher body weight because the calculation scales with body mass.',
  },
  {
    question: 'How many calories does a 30-minute weightlifting session burn?',
    answer:
      'It depends on body weight and training intensity. As a broad reference, a <strong>155 lb (70 kg)</strong> person lifting at moderate effort (5.0 MET) burns roughly <strong>170–180 kcal</strong> in 30 minutes. A 180 lb (82 kg) person at the same intensity would burn roughly <strong>200–210 kcal</strong>.',
  },
  {
    question: 'How many calories do you burn walking 30 minutes?',
    answer:
      'For a moderate walking pace (3.5 MET), a <strong>155 lb (70 kg)</strong> person burns roughly <strong>125 kcal</strong> in 30 minutes, while a <strong>180 lb (82 kg)</strong> person burns roughly <strong>145 kcal</strong>. Brisk walking at higher MET values increases the estimate.',
  },
  {
    question: 'How many calories do you burn running 30 minutes?',
    answer:
      'At a moderate running pace (8.3 MET), a <strong>155 lb (70 kg)</strong> person burns roughly <strong>305 kcal</strong> in 30 minutes, while a <strong>180 lb (82 kg)</strong> person burns roughly <strong>355 kcal</strong>. Faster speeds and higher MET values increase the estimate.',
  },
  {
    question: 'Which exercise burns the most calories?',
    answer:
      'Per minute, the highest-burn activities include <strong>rope skipping</strong> (11.0 MET), <strong>vigorous running</strong> (11.5 MET), and <strong>high-intensity cycling</strong> (10.0 MET). However, the best exercise is the one you can perform consistently — total weekly burn matters more than any single session.',
  },
  {
    question: 'What should I calculate after my calories burned estimate?',
    answer:
      'Use our <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a> to estimate your daily energy needs, our <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> to split calories into protein, carbohydrate, and fat, or our <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a> for a weight-loss target.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/calories-burned-calculator/#calculator',
  name: 'RepMaths Calories Burned Calculator',
  alternateName: 'Calories Burned Calculator',
  url: 'https://repmaths.com/tools/nutrition/calories-burned-calculator/',
  description:
    'Free calories burned calculator using MET values. Estimate calories burned from walking, running, cycling, and weightlifting.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="Calories Burned Calculator — MET-Based Exercise Burn"
  description="Free calories burned calculator using MET values. Estimate calories burned from walking, running, cycling, and weightlifting in lb or kg."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <section class="hero">
    <h1>Calories Burned Calculator</h1>
    <p>
      Estimate calories burned during walking, running, cycling,
      weightlifting, cardio, and other activities using your body weight,
      workout duration, and a MET-based activity estimate.
    </p>
  </section>

  <aside class="quick-answer" aria-label="Calories burned quick answer">
    <p>
      <strong>How do you calculate calories burned?</strong> Most exercise
      calculators use MET values (Metabolic Equivalent of Task) with the
      formula: <code>kcal/min = MET × 3.5 × body weight (kg) ÷ 200</code>.
      For example, a 180 lb (82 kg) person lifting weights at moderate
      effort (5.0 MET) for 45 minutes burns roughly <strong>320 kcal</strong>.
      Results are estimates — actual burn varies with intensity, rest
      periods, and individual factors.
    </p>
  </aside>

  <section class="calc-card" aria-label="Calories burned calculator">
    <div class="field">
      <span class="field-label" id="unit-label">Unit</span>
      <div class="unit-toggle" role="group" aria-labelledby="unit-label">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">
          lb
        </button>
        <button type="button" id="unit-kg" aria-pressed="false">
          kg
        </button>
      </div>
    </div>

    <div class="field">
      <label for="weight" id="weight-label">Body weight (lb)</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 180"
        inputmode="decimal"
        min="44"
        max="772"
        step="any"
        aria-describedby="weight-help calc-error"
      />
      <p id="weight-help" class="field-help">
        Between 44 lb and 772 lb (approximately 20–350 kg).
      </p>
    </div>

    <div class="field">
      <label for="activity">Activity</label>
      <select id="activity">
        <optgroup label="Weight Training &amp; Gym">
          <option value="3.5">Resistance training — multiple exercises (3.5 MET)</option>
          <option value="5.0">Resistance training — squats/deadlifts (5.0 MET)</option>
          <option value="5.8">Resistance circuit / supersets (5.8 MET)</option>
          <option value="6.0">Vigorous weightlifting / bodybuilding (6.0 MET)</option>
          <option value="7.5">Vigorous circuit training (7.5 MET)</option>
          <option value="8.0">CrossFit-style WOD (8.0 MET)</option>
          <option value="9.8">Kettlebell swings (9.8 MET)</option>
        </optgroup>

        <optgroup label="Walking">
          <option value="2.8">Walking — easy pace (2.8 MET)</option>
          <option value="3.5">Walking — moderate pace (3.5 MET)</option>
          <option value="4.3">Walking — brisk pace (4.3 MET)</option>
          <option value="5.0">Walking — very brisk pace (5.0 MET)</option>
        </optgroup>

        <optgroup label="Running">
          <option value="7.0">Running — easy pace (7.0 MET)</option>
          <option value="8.3">Running — moderate pace (8.3 MET)</option>
          <option value="9.8">Running — faster pace (9.8 MET)</option>
          <option value="11.5">Running — vigorous pace (11.5 MET)</option>
        </optgroup>

        <optgroup label="Cycling">
          <option value="4.0">Cycling — light effort (4.0 MET)</option>
          <option value="6.8">Cycling — moderate effort (6.8 MET)</option>
          <option value="8.0">Cycling — vigorous effort (8.0 MET)</option>
          <option value="10.0">Cycling — high-intensity effort (10.0 MET)</option>
        </optgroup>

        <optgroup label="Cardio Machines">
          <option value="5.0">Elliptical — moderate (5.0 MET)</option>
          <option value="9.0">Elliptical — vigorous (9.0 MET)</option>
          <option value="5.0">Rowing — moderate (5.0 MET)</option>
          <option value="7.3">Rowing — vigorous (7.3 MET)</option>
          <option value="9.3">Stair treadmill / stair machine (9.3 MET)</option>
        </optgroup>

        <optgroup label="Other Activities">
          <option value="3.8">Calisthenics — moderate (3.8 MET)</option>
          <option value="7.5">Calisthenics — vigorous (7.5 MET)</option>
          <option value="5.0">Boot camp (5.0 MET)</option>
          <option value="11.0">Rope skipping (11.0 MET)</option>
        </optgroup>
      </select>
    </div>

    <div class="field">
      <label for="duration">Duration</label>
      <div class="duration-row">
        <input
          type="number"
          id="duration"
          placeholder="e.g. 45"
          inputmode="decimal"
          min="1"
          max="1440"
          step="any"
        />
        <select id="duration-unit" aria-label="Duration unit">
          <option value="minutes">Minutes</option>
          <option value="hours">Hours</option>
        </select>
      </div>
    </div>

    <p id="calc-error" class="input-error" role="alert" aria-live="assertive" hidden></p>

    <button type="button" class="btn-primary" id="calc-btn">
      Calculate Calories Burned
    </button>

    <div class="result-box" id="result-box" hidden>
      <div
        id="result-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <div class="result-grid">
        <div class="result-stat">
          <div class="big-number" id="result-total">–</div>
          <div class="label">Estimated Total Calories</div>
        </div>
        <div class="result-stat">
          <div class="big-number" id="result-active">–</div>
          <div class="label">Estimated Active Calories</div>
        </div>
      </div>

      <div class="result-details">
        <div>
          <strong id="result-kcal-minute">–</strong>
          <span>kcal/min</span>
        </div>
        <div>
          <strong id="result-met">–</strong>
          <span>MET</span>
        </div>
      </div>

      <div class="fat-loss-result" id="fat-loss-result">
        <span class="fat-loss-label">Equivalent fat loss:</span>
        <strong id="result-fat-loss">–</strong>
        <p class="fat-loss-note">
  Based on exercise-attributable (active) calories and approximately
  7,700 kcal per kg of body fat (3,500 kcal per lb). This is a mathematical
  comparison, not a claim that a single session directly converts to fat loss.
</p>
      </div>

      <div class="reality-check">
        <h3>Lifter's Reality Check</h3>
        <p id="reality-text">
          A gym session is not the same as continuous exercise. Rest periods,
          setup time, changing weights, walking between equipment, and
          conversation can reduce the amount of time spent actively exercising.
        </p>
      </div>

      <p class="result-note">
        These are estimates, not direct measurements of your individual energy
        expenditure.
      </p>

      <div class="result-actions">
        <a href="/tools/nutrition/tdee-calculator/" class="btn-primary">
          Calculate TDEE
        </a>
        <a href="/tools/nutrition/macro-calculator/" class="btn-primary">
          Calculate Macros
        </a>
        <a href="/tools/nutrition/calorie-deficit-calculator/" class="btn-primary">
          Calorie Deficit
        </a>
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is a Calories Burned Calculator?</h2>

    <p>
      A calories burned calculator estimates how much energy you may expend
      during a physical activity based on your body weight, activity intensity,
      and duration. This calculator uses MET values to provide a practical
      estimate for activities such as walking, running, cycling, weightlifting,
      circuit training, and cardio.
    </p>

    <p>
      The result is an estimate rather than a direct measurement. Actual energy
      expenditure can vary with exercise technique, fitness level, movement
      efficiency, workout intensity, rest periods, terrain, equipment, and
      individual physiology.
    </p>
  </article>

  <article class="article-section">
    <h2>Step-by-Step: How to Calculate Calories Burned</h2>

    <p>
      MET-based calorie calculations combine an activity's MET value with body
      weight and exercise duration. The calculator converts your weight to
      kilograms when necessary and estimates calories from the selected
      activity's MET value.
    </p>

    <h3>Step 1: Convert weight to kilograms</h3>
    <p>
      <code>Weight (kg) = Weight (lb) ÷ 2.2046226218</code>
    </p>

    <h3>Step 2: Calculate calories per minute</h3>
    <p>
      <code>kcal/min = MET × 3.5 × body weight (kg) ÷ 200</code>
    </p>

    <h3>Step 3: Multiply by duration</h3>
    <p>
      <code>Total kcal = kcal/min × exercise duration (minutes)</code>
    </p>

    <h3>Worked example</h3>

    <p>
      Consider a 180 lb (82 kg) person lifting weights at moderate effort
      (5.0 MET) for 45 minutes:
    </p>

    <ol>
      <li>MET value for moderate weightlifting = <strong>5.0</strong></li>
      <li>
        kcal/min = (5.0 × 3.5 × 82) ÷ 200 ≈ <strong>7.2 kcal/min</strong>
      </li>
      <li>
        Total = 7.2 × 45 ≈ <strong>324 kcal</strong>
      </li>
    </ol>

    <p>
      For a practical nutrition estimate, the result should be treated as a
      range or planning input rather than an exact measurement of calories
      burned.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is a MET?</h2>

    <p>
      MET stands for metabolic equivalent of task. A MET value describes the
      energy cost of an activity relative to resting metabolic rate. The
      <a
        href="https://pacompendium.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium of Physical Activities
      </a>
      uses MET values to classify the energy cost of many different physical
      activities.
    </p>

    <p>
      The
      <a
        href="https://pacompendium.com/adult-compendium/"
        target="_blank"
        rel="noopener noreferrer"
      >
        2024 Adult Compendium
      </a>
      provides standardized activity classifications and MET values. These
      values are useful for estimating energy expenditure at the population
      level, but they do not measure the exact calorie cost for every
      individual.
    </p>
  </article>

  <article class="article-section">
    <h2>MET Values by Training Style</h2>

    <p>
      Resistance training covers a wide range of training styles with
      substantially different energy costs. The MET values below are consistent
      with the 2024 Adult Compendium and commonly cited in weightlifting
      calorie research.
    </p>

    <table class="result-table">
      <caption>MET values by training style (2024 Adult Compendium)</caption>
      <thead>
        <tr>
          <th scope="col">Training style</th>
          <th scope="col">MET</th>
          <th scope="col">Typical characteristics</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Light machine work</td>
          <td>3.5</td>
          <td>Guided movements, extended rest, rehab or beginner</td>
        </tr>
        <tr>
          <td>General free-weight training</td>
          <td>5.0</td>
          <td>Moderate loads (60–75% 1RM), balanced work-rest</td>
        </tr>
        <tr>
          <td>Powerlifting</td>
          <td>5.0</td>
          <td>Heavy loads (80–95% 1RM), long rests (3–5 min)</td>
        </tr>
        <tr>
          <td>Bodybuilding / hypertrophy</td>
          <td>5.5</td>
          <td>Higher volume (8–15 reps), shorter rests (60–90s)</td>
        </tr>
        <tr>
          <td>Olympic lifting</td>
          <td>6.5</td>
          <td>Explosive compound lifts — clean, snatch, jerk</td>
        </tr>
        <tr>
          <td>CrossFit-style WOD</td>
          <td>8.0</td>
          <td>Mixed-modality, minimal rest, circuit format</td>
        </tr>
      </tbody>
    </table>
  </article>

  <article class="article-section">
    <h2>What Exercise Burns the Most Calories?</h2>

    <p>
      Per minute of continuous effort, the following activities typically
      produce the highest calorie burn based on 2024 Compendium MET values:
    </p>

    <table class="result-table">
      <caption>Highest-burn exercises by MET value</caption>
      <thead>
        <tr>
          <th scope="col">Exercise</th>
          <th scope="col">MET</th>
          <th scope="col">Approx. burn (155 lb / 70 kg, 30 min)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Running — vigorous pace</td>
          <td>11.5</td>
          <td>~375 kcal</td>
        </tr>
        <tr>
          <td>Rope skipping</td>
          <td>11.0</td>
          <td>~360 kcal</td>
        </tr>
        <tr>
          <td>Cycling — high-intensity</td>
          <td>10.0</td>
          <td>~325 kcal</td>
        </tr>
        <tr>
          <td>Kettlebell swings</td>
          <td>9.8</td>
          <td>~320 kcal</td>
        </tr>
        <tr>
          <td>Running — faster pace</td>
          <td>9.8</td>
          <td>~320 kcal</td>
        </tr>
        <tr>
          <td>Stair treadmill</td>
          <td>9.3</td>
          <td>~305 kcal</td>
        </tr>
      </tbody>
    </table>

    <p class="calc-note">
      High-burn exercises are not automatically the best choice. Total weekly
      energy expenditure, sustainability, recovery, and enjoyment all matter.
      For most people, the best exercise is the one they can perform
      consistently.
    </p>
  </article>

  <article class="article-section">
    <h2>The Science of Calorie Expenditure During Resistance Training</h2>

    <p>
      Resistance training can have very different energy costs depending on
      the exercise, load, number of repetitions, rest intervals, and how
      continuously the workout is performed.
    </p>

    <p>
      The 2024 Adult Compendium includes separate MET classifications for
      resistance training involving multiple exercises, vigorous weightlifting,
      squats and deadlifts, and resistance circuits. This is why there is no
      single calorie-burn number that applies to every weightlifting workout.
    </p>

    <p>
      For lifters, the most important practical distinction is between
      <strong>active exercise time</strong> and the total time spent at the
      gym. A 60-minute gym visit does not necessarily represent 60 minutes of
      continuous resistance exercise.
    </p>
  </article>

  <article class="article-section">
    <h2>How Many Calories Do You Burn Lifting Weights?</h2>

    <p>
      There is no single calorie value for weightlifting. Exercise intensity
      can vary substantially between a traditional strength session, a
      bodybuilding workout, a resistance circuit, and a short high-intensity
      conditioning session.
    </p>

    <h3>Reference ranges by body weight and session length</h3>

    <p>
      The following grid uses <strong>moderate lifting (5.0 MET)</strong> as a
      reference. Actual burn varies with training style and rest periods.
    </p>

    <table class="result-table">
      <caption>Estimated kcal at moderate lifting intensity (5.0 MET)</caption>
      <thead>
        <tr>
          <th scope="col">Body weight</th>
          <th scope="col">30 min</th>
          <th scope="col">45 min</th>
          <th scope="col">60 min</th>
        </tr>
      </thead>
      <tbody>
  <tr>
    <td>130 lb (59 kg)</td>
    <td>~155 kcal</td>
    <td>~232 kcal</td>
    <td>~310 kcal</td>
  </tr>
  <tr>
    <td>155 lb (70 kg)</td>
    <td>~184 kcal</td>
    <td>~276 kcal</td>
    <td>~368 kcal</td>
  </tr>
  <tr>
    <td>180 lb (82 kg)</td>
    <td>~215 kcal</td>
    <td>~323 kcal</td>
    <td>~431 kcal</td>
  </tr>
  <tr>
    <td>205 lb (93 kg)</td>
    <td>~244 kcal</td>
    <td>~366 kcal</td>
    <td>~488 kcal</td>
  </tr>
  <tr>
    <td>230 lb (104 kg)</td>
    <td>~273 kcal</td>
    <td>~410 kcal</td>
    <td>~546 kcal</td>
  </tr>
</tbody>
    </table>

    <p class="calc-note">
      These values are broad reference estimates based on the MET formula.
      Actual burn varies with rest periods, training intensity, exercise
      selection, and individual physiology.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Weightlifting Cause an Afterburn Effect (EPOC)?</h2>

    <p>
      Yes. Resistance exercise can increase oxygen consumption and energy
      expenditure after exercise — commonly called
      <strong>EPOC (Excess Post-exercise Oxygen Consumption)</strong> or the
      "afterburn effect." This extra burn is real, but usually modest.
    </p>

    <p>
  The size and duration of the afterburn effect depend on session intensity,
  training volume, individual fitness, and the measurement window used in
  research. Different studies report different EPOC estimates, so a single
  universal number does not apply to every lifter.
</p>

<p>
  Broadly, higher-intensity sessions with heavier loads, shorter rest
  periods, or a circuit format tend to produce a larger EPOC response than
  low-intensity or long-rest sessions. However, even a well-estimated EPOC
  is usually a modest addition to the calories burned during the workout
  itself.
</p>

<p class="calc-note">
  RepMaths does not add a separate EPOC adjustment to its calculator result.
  The calculator estimate reflects the activity performed, not post-exercise
  energy expenditure. This is a conservative choice: EPOC is real, but it is
  difficult to estimate accurately for an individual session.
</p>
  </article>

  <article class="article-section">
    <h2>Rep Range and Training Goal Reference</h2>

    <p>
      Different training goals use different rep ranges, rest periods, and
      intensities — which affect how many calories a session burns.
    </p>

    <table class="result-table">
      <caption>Rep range and rest period by training goal</caption>
      <thead>
        <tr>
          <th scope="col">Goal</th>
          <th scope="col">Rep range</th>
          <th scope="col">Rest period</th>
          <th scope="col">Relative calorie burn</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Max strength</td>
          <td>1–5 reps</td>
          <td>3–5 min</td>
          <td>Lower per minute</td>
        </tr>
        <tr>
          <td>Hypertrophy</td>
          <td>6–12 reps</td>
          <td>60–90 sec</td>
          <td>Moderate</td>
        </tr>
        <tr>
          <td>Muscular endurance</td>
          <td>12–20 reps</td>
          <td>30–60 sec</td>
          <td>Higher per minute</td>
        </tr>
        <tr>
          <td>Power</td>
          <td>1–5 reps (explosive)</td>
          <td>2–4 min</td>
          <td>Lower per minute</td>
        </tr>
        <tr>
          <td>Circuit / fat loss</td>
          <td>10–20 reps</td>
          <td>15–45 sec</td>
          <td>Highest per minute</td>
        </tr>
      </tbody>
    </table>
  </article>

  <article class="article-section">
    <h2>Tracking Calories for Weightlifting</h2>

    <p>
      If your main goal is strength or muscle growth, avoid treating estimated
      exercise calories as a precise allowance for extra food. A better
      approach is to use your estimated calorie expenditure alongside your
      overall nutrition target and then monitor body-weight trends, training
      performance, recovery, and hunger.
    </p>

    <p>
      You can use our
      <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a>
      to estimate your daily energy needs, then use the
      <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>
      to turn a calorie target into protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned Walking</h2>

    <p>
      Walking calorie expenditure depends primarily on body weight, walking
      intensity, duration, terrain, and individual movement efficiency.
      Walking faster generally requires more energy than walking at an easy
      pace.
    </p>

    <p>For a 30-minute walk, approximate burn by weight:</p>

    <ul>
      <li>
        <strong>130 lb (59 kg):</strong> ~80 kcal (easy) to ~125 kcal (brisk)
      </li>
      <li>
        <strong>155 lb (70 kg):</strong> ~95 kcal (easy) to ~150 kcal (brisk)
      </li>
      <li>
        <strong>180 lb (82 kg):</strong> ~110 kcal (easy) to ~175 kcal (brisk)
      </li>
      <li>
        <strong>205 lb (93 kg):</strong> ~125 kcal (easy) to ~200 kcal (brisk)
      </li>
    </ul>

    <p>
      The
      <a
        href="https://pacompendium.com/walking/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium walking section
      </a>
      provides different activity classifications for walking speeds and
      conditions rather than treating all walking as one activity.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned Running</h2>

    <p>
      Running generally has a higher energy cost per minute than easy walking,
      but the exact estimate depends on running speed, body weight, duration,
      terrain, and individual efficiency.
    </p>

    <p>For a 30-minute run, approximate burn by weight:</p>

    <ul>
      <li>
        <strong>130 lb (59 kg):</strong> ~185 kcal (easy) to ~305 kcal (vigorous)
      </li>
      <li>
        <strong>155 lb (70 kg):</strong> ~220 kcal (easy) to ~360 kcal (vigorous)
      </li>
      <li>
        <strong>180 lb (82 kg):</strong> ~255 kcal (easy) to ~420 kcal (vigorous)
      </li>
      <li>
        <strong>205 lb (93 kg):</strong> ~290 kcal (easy) to ~475 kcal (vigorous)
      </li>
    </ul>

    <p>
      The
      <a
        href="https://pacompendium.com/running/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Compendium running classifications
      </a>
      distinguish between different running intensities and speeds.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Body Weight Affect Calories Burned?</h2>

    <p>
      Yes. For the same MET value and exercise duration, the calculation
      produces a higher estimated calorie expenditure for a heavier body
      weight because moving a larger body generally requires more energy.
    </p>

    <p>
      This is one reason calorie estimates should be personalized to body
      weight rather than relying on a single generic calorie number for an
      activity.
    </p>
  </article>

  <article class="article-section">
    <h2>Heart Rate, Exercise Intensity &amp; Energy Expenditure</h2>

    <p>
      Heart rate can provide useful information about exercise intensity, but
      it does not by itself provide a perfect measurement of calories burned.
      The relationship between heart rate and energy expenditure varies by
      activity and individual.
    </p>

    <p>
      A heart-rate-based wearable may therefore produce a different estimate
      from a MET-based calculator. Differences can occur because the two
      approaches use different inputs, assumptions, algorithms, and activity
      classifications.
    </p>

    <p>
      For resistance training in particular, heart rate can fluctuate because
      of set intensity, rest periods, breathing, exercise selection, and
      factors unrelated to total calorie expenditure.
    </p>
  </article>

  <article class="article-section">
    <h2>Understanding Active and Total Exercise Calories</h2>

    <p>
      This calculator reports both estimated total exercise calories and
      estimated active calories. Total exercise calories represent the
      calculated energy expenditure associated with the selected activity.
    </p>

    <p>
      Active calories are estimated here by subtracting the resting
      contribution represented by approximately 1 MET from the selected
      activity's MET value. This is a calculation convention and should not
      be assumed to match the exact definition used by Apple Watch, Garmin,
      Fitbit, or another wearable.
    </p>

    <p>
      If you are comparing this result with a smartwatch, always compare the
      same activity duration and understand whether the device is reporting
      active calories, total calories, or another metric.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned vs BMR and TDEE</h2>

    <p>
      Exercise calories are only one piece of your total daily energy
      expenditure. Your full daily burn combines several components:
    </p>

    <ul>
      <li>
        <strong>BMR (Basal Metabolic Rate)</strong> — calories burned at
        complete rest to maintain basic functions.
      </li>
      <li>
        <strong>TEF (Thermic Effect of Food)</strong> — calories used to
        digest, absorb, and process food.
      </li>
      <li>
        <strong>NEAT (Non-Exercise Activity Thermogenesis)</strong> — calories
        burned from daily movement like walking, standing, and chores.
      </li>
      <li>
        <strong>EAT (Exercise Activity Thermogenesis)</strong> — calories
        burned from structured exercise, which is what this calculator
        estimates.
      </li>
    </ul>

    <p>
      For a complete picture of your daily energy needs, use our
      <a href="/tools/nutrition/bmr-calculator/">BMR Calculator</a>
      and <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a>
      alongside this exercise calculator.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Calorie Estimates Can Differ From Real-World Burn</h2>

    <p>
      Formula-based calorie estimates are useful because direct measurement of
      energy expenditure requires specialized testing. However, a standardized
      MET value cannot capture every factor affecting an individual's actual
      energy cost.
    </p>

    <p>
      Differences can come from exercise intensity, movement efficiency,
      technique, fitness level, body composition, environmental conditions,
      rest intervals, and how continuously the activity is performed.
    </p>

    <p>
      The Compendium itself is a classification system rather than a personal
      metabolic measurement. Its
      <a
        href="https://pacompendium.com/corrected-mets/"
        target="_blank"
        rel="noopener noreferrer"
      >
        corrected MET guidance
      </a>
      explains important limitations of standardized MET values when estimating
      individual energy expenditure.
    </p>
  </article>

  <article class="article-section">
    <h2>Smartwatch Calories vs Calculator Estimates</h2>

    <p>
      A smartwatch and a MET-based calculator can legitimately produce
      different calorie estimates for the same workout. Wearables may combine
      heart rate, movement, user characteristics, GPS data, activity type, and
      proprietary algorithms, while this calculator uses body weight,
      duration, and a standardized MET value.
    </p>

    <p>
      Neither number should automatically be treated as an exact measurement
      of your individual calorie expenditure. For ongoing nutrition tracking,
      consistency and changes in your real-world body-weight trend can be more
      useful than treating any single exercise-calorie estimate as exact.
    </p>
  </article>

  <article class="article-section">
    <h2>Calories Burned and Weight Loss</h2>

    <p>
      Exercise contributes to energy expenditure, but weight loss depends on
      overall energy balance over time rather than the calories reported by a
      single workout.
    </p>

    <p>
      If your goal is fat loss, use your estimated daily needs and real-world
      progress together. Our
      <a href="/tools/nutrition/calorie-deficit-calculator/">
        Calorie Deficit Calculator
      </a>
      can estimate a daily calorie target and projected weight-loss timeline.
    </p>

    <p>
      Avoid assuming that every calorie shown by an exercise calculator should
      automatically be added back to your food intake. Exercise estimates have
      uncertainty, and your actual calorie needs depend on your complete
      activity pattern and individual response.
    </p>
  </article>

  <article class="article-section">
    <h2>Using Calories Burned With Your Nutrition Plan</h2>

    <p>
      Calories burned estimates work best as one piece of a broader nutrition
      plan. For example, you can combine activity estimates with your
      estimated
      <a href="/tools/nutrition/bmr-calculator/">BMR</a>,
      <a href="/tools/nutrition/tdee-calculator/">TDEE</a>,
      <a href="/tools/nutrition/macro-calculator/">macros</a>, and
      <a href="/tools/nutrition/protein-calculator/">protein target</a>.
    </p>

    <p>
      For people who train regularly, it is usually more useful to look at
      trends in body weight, workout performance, recovery, and nutrition
      adherence than to chase an exact calorie number for every individual
      workout.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    {faqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p set:html={faq.answer} />
      </div>
    ))}
  </article>

  <article class="article-section">
    <h2>Sources &amp; Methodology</h2>

    <p>
      Activity classifications and MET values are based on the
      <a
        href="https://pacompendium.com/adult-compendium/"
        target="_blank"
        rel="noopener noreferrer"
      >
        2024 Adult Compendium of Physical Activities
      </a>
      and related Compendium activity pages.
    </p>

    <p>
      The Compendium provides standardized estimates for physical activities.
      RepMaths uses those values with body weight and duration to create a
      practical calculator result. The output is not a laboratory measurement
      of an individual's oxygen consumption or metabolic rate.
    </p>

    <p>
      MET-based calculations should therefore be interpreted as estimates for
      planning and comparison rather than exact measurements.
    </p>
  </article>

