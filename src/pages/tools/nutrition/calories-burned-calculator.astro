  <script>
    type Unit = 'lb' | 'kg';

    let unit: Unit = 'lb';

    // Canonical metric value — preserved across unit toggles to avoid
    // cumulative rounding loss from repeated conversions.
    let preservedKg: number | null = null;

    const LB_PER_KG = 2.2046226218;

    const unitLb = document.getElementById('unit-lb');
    const unitKg = document.getElementById('unit-kg');

    const weightInput = document.getElementById('weight') as HTMLInputElement | null;
    const weightLabel = document.getElementById('weight-label');
    const weightHelp = document.getElementById('weight-help');

    const activityInput = document.getElementById('activity') as HTMLSelectElement | null;
    const durationInput = document.getElementById('duration') as HTMLInputElement | null;
    const durationUnitInput = document.getElementById('duration-unit') as HTMLSelectElement | null;

    const calcBtn = document.getElementById('calc-btn');
    const calcError = document.getElementById('calc-error');

    const resultBox = document.getElementById('result-box');
    const resultTotal = document.getElementById('result-total');
    const resultActive = document.getElementById('result-active');
    const resultKcalMinute = document.getElementById('result-kcal-minute');
    const resultMet = document.getElementById('result-met');
    const resultFatLoss = document.getElementById('result-fat-loss');
    const realityText = document.getElementById('reality-text');
    const resultAnnouncement = document.getElementById('result-announcement');

    const round = (value: number, decimals = 1) => {
      const factor = Math.pow(10, decimals);
      return Math.round(value * factor) / factor;
    };

    // ---------- Preserved value sync ----------

    function syncPreservedWeight() {
      if (!weightInput) return;
      const raw = weightInput.value.trim();
      if (raw === '') { preservedKg = null; return; }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) { preservedKg = null; return; }
      preservedKg = unit === 'lb' ? value / LB_PER_KG : value;
    }

    // ---------- UI state ----------

    function resetResult() {
      clearError();
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
      if (resultAnnouncement) resultAnnouncement.textContent = '';
    }

    function setUnit(next: Unit) {
      if (next === unit) return;

      if (preservedKg !== null && preservedKg > 0 && weightInput) {
        weightInput.value = next === 'lb'
          ? (preservedKg * LB_PER_KG).toFixed(1)
          : preservedKg.toFixed(1);
      }

      unit = next;
      updateUnitUI();
      resetResult();
    }

    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle('active', unit === 'lb');
        unitLb.setAttribute('aria-pressed', String(unit === 'lb'));
      }
      if (unitKg) {
        unitKg.classList.toggle('active', unit === 'kg');
        unitKg.setAttribute('aria-pressed', String(unit === 'kg'));
      }

      if (weightLabel) {
        weightLabel.textContent = unit === 'lb' ? 'Body weight (lb)' : 'Body weight (kg)';
      }

      if (weightInput) {
        weightInput.placeholder = unit === 'lb' ? 'e.g. 180' : 'e.g. 82';
        weightInput.min = unit === 'lb' ? '44' : '20';
        weightInput.max = unit === 'lb' ? '772' : '350';
      }

      if (weightHelp) {
        weightHelp.textContent = unit === 'lb'
          ? 'Between 44 lb and 772 lb (approximately 20–350 kg).'
          : 'Between 20 kg and 350 kg (approximately 44–772 lb).';
      }
    }

    function showError(message: string) {
      if (!calcError) return;
      calcError.textContent = message;
      calcError.hidden = false;
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
    }

    function clearError() {
      if (!calcError) return;
      calcError.textContent = '';
      calcError.hidden = true;
    }

    function formatNumber(value: number, decimals = 0): string {
      return value.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    }

    // ---------- Event listeners ----------

    unitLb?.addEventListener('click', () => setUnit('lb'));
    unitKg?.addEventListener('click', () => setUnit('kg'));

    weightInput?.addEventListener('input', () => {
      syncPreservedWeight();
      resetResult();
    });

    activityInput?.addEventListener('change', resetResult);
    durationInput?.addEventListener('input', resetResult);
    durationUnitInput?.addEventListener('change', resetResult);

    // ---------- Calculate ----------

    calcBtn?.addEventListener('click', () => {
      clearError();

      if (preservedKg === null) syncPreservedWeight();

      if (!weightInput || !activityInput || !durationInput || !durationUnitInput) {
        return;
      }

      if (preservedKg === null || preservedKg < 20 || preservedKg > 350) {
        showError('Please enter a body weight between 20 and 350 kg (44 and 772 lb).');
        return;
      }

      const met = Number(activityInput.value);
      const durationValue = Number(durationInput.value);
      const durationUnit = durationUnitInput.value;

      if (!Number.isFinite(met) || met <= 0) {
        showError('Please select a valid activity.');
        return;
      }

      if (!Number.isFinite(durationValue) || durationValue <= 0) {
        showError('Please enter a valid workout duration.');
        return;
      }

      const durationMinutes = durationUnit === 'hours' ? durationValue * 60 : durationValue;

      if (!Number.isFinite(durationMinutes) || durationMinutes < 1 || durationMinutes > 1440) {
  showError('Please enter a workout duration between 1 minute and 24 hours.');
  return;
}

      const weightKg = preservedKg;

      const caloriesPerMinute = (met * 3.5 * weightKg) / 200;
      const totalCalories = caloriesPerMinute * durationMinutes;

      const activeCaloriesPerMinute = (Math.max(met - 1, 0) * 3.5 * weightKg) / 200;
      const totalActiveCalories = activeCaloriesPerMinute * durationMinutes;

      if (!Number.isFinite(totalCalories) || totalCalories <= 0) {
        showError('This combination of inputs did not produce a valid estimate. Please try different values.');
        return;
      }

      // Fat loss equivalent — based on exercise-attributable (active) calories,
// not total calories including resting metabolism.
// 1 kg body fat ≈ 7,700 kcal; 1 lb body fat ≈ 3,500 kcal
const fatLossKg = totalActiveCalories / 7700;
const fatLossLb = totalActiveCalories / 3500;
const fatLossGrams = (totalActiveCalories / 7700) * 1000;

if (resultTotal) {
        resultTotal.textContent = `${formatNumber(Math.round(totalCalories))} kcal`;
      }
      if (resultActive) {
        resultActive.textContent = `${formatNumber(Math.round(totalActiveCalories))} kcal`;
      }
      if (resultKcalMinute) {
        resultKcalMinute.textContent = formatNumber(caloriesPerMinute, 2);
      }
      if (resultMet) {
        resultMet.textContent = formatNumber(met, 1);
      }

      if (resultFatLoss) {
        if (unit === 'lb') {
          resultFatLoss.textContent = `≈ ${round(fatLossGrams, 1)} g fat (≈ ${round(fatLossLb, 3)} lb)`;
        } else {
          resultFatLoss.textContent = `≈ ${round(fatLossGrams, 1)} g fat (≈ ${round(fatLossKg, 3)} kg)`;
        }
      }

      if (realityText) {
        const selectedActivity =
          activityInput.options[activityInput.selectedIndex]?.text || 'this activity';

        if (met >= 5.8) {
          realityText.textContent = `For ${selectedActivity.toLowerCase()}, the selected MET represents a relatively vigorous activity level. If your session contains long rest periods or substantial setup time, your actual average energy expenditure across the full gym visit may be lower than this continuous-activity estimate.`;
        } else {
          realityText.textContent = 'This estimate assumes the selected activity is performed at approximately the selected intensity for the full duration. During a real gym session, rest periods, setup time, changing weights, walking between equipment, and conversation can reduce continuous exercise time.';
        }
      }

      if (resultBox) {
        resultBox.hidden = false;
        resultBox.classList.add('show');
      }

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Estimated total calories: ${formatNumber(Math.round(totalCalories))} kcal. Active calories: ${formatNumber(Math.round(totalActiveCalories))} kcal. Rate: ${formatNumber(caloriesPerMinute, 2)} kcal per minute at ${formatNumber(met, 1)} MET. Equivalent fat loss: approximately ${round(fatLossGrams, 1)} grams.`;
      }
    });

    // ---------- Initialize ----------

    updateUnitUI();
  </script>
