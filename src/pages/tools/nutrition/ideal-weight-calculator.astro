  },
  {
    question: 'What should I calculate after my ideal weight?',
    answer:
      'Use our <a href="/tools/nutrition/bmi-calculator/">BMI Calculator</a> to see where your current weight falls, our <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a> for body-composition context, or our <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a> for maintenance calorie estimates.',
  },
