---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'Ideal Weight Calculator' },
];

const faqs = [
  {
    question: 'What is my ideal weight for my height and age?',
    answer:
      'The four adult IBW formulas used here do not use age. They estimate a reference weight from height and sex. Your appropriate health or fitness target can depend on additional factors.',
  },
  {
    question: 'Which ideal body weight formula is most accurate?',
    answer:
      'There is no universally most accurate formula. Devine, Hamwi, Robinson, and Miller can produce different estimates, so comparing all four gives more context than treating one formula as definitive.',
  },
  {
    question: 'How much should a 5\'5 woman weigh?',
    answer:
      'There is no single ideal weight for every 5\'5 woman. This calculator provides four reference IBW estimates plus a BMI-based healthy weight range for comparison.',
  },
  {
    question: 'Does ideal weight include muscle mass?',
    answer:
      'No. Traditional IBW formulas do not directly account for above-average muscle mass. This is especially important for bodybuilders and strength athletes. For body-composition context, see our <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a> or <a href="/tools/nutrition/lean-body-mass-calculator/">Lean Body Mass Calculator</a>.',
  },
  {
