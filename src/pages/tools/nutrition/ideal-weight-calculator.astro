const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="Ideal Weight Calculator — 4 Reference Formulas | RepMaths"
  description="Free ideal weight calculator using 4 formulas (Devine, Robinson, Miller, Hamwi). Compare IBW estimates with a healthy BMI weight range."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <section class="hero">
    <h1>Ideal Weight Calculator</h1>
    <p>
      Compare four commonly used ideal body weight formulas with a healthy
      BMI-based weight range in pounds or kilograms.
    </p>
  </section>

  <aside class="quick-answer" aria-label="Ideal weight quick answer">
    <p>
      <strong>What is ideal body weight?</strong> Ideal body weight (IBW)
      is a reference estimate based on height and sex. This calculator
      compares four traditional formulas — Devine, Robinson, Miller, and
      Hamwi — and shows a BMI-based healthy weight range. These formulas
      were not designed to measure muscle mass or body fat, so they are
      best treated as reference estimates rather than individual targets.
    </p>
  </aside>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="calculator-heading">
      Calculate Your Ideal Weight Reference
    </h2>

    <div class="field">
      <span class="field-label" id="unit-label">Unit</span>
      <div class="unit-toggle" role="group" aria-labelledby="unit-label">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">
          lb / ft
        </button>
        <button type="button" id="unit-kg" aria-pressed="false">
          kg / cm
        </button>
      </div>
    </div>

    <div class="field">
      <span class="field-label" id="sex-label">Sex</span>
      <div class="unit-toggle" role="group" aria-labelledby="sex-label">
        <button type="button" id="sex-male" class="active" aria-pressed="true">
          Male
        </button>
        <button type="button" id="sex-female" aria-pressed="false">
          Female
        </button>
      </div>
    </div>

    <div id="imperial-height">
      <div class="field">
        <span class="field-label" id="imperial-height-label">Height</span>

        <div class="height-grid" role="group" aria-labelledby="imperial-height-label">
          <input
            type="number"
            id="height-ft"
            placeholder="5"
            inputmode="numeric"
            min="4"
            max="8"
            step="1"
            aria-label="Height in feet"
          />
          <span>ft</span>
          <input
            type="number"
            id="height-in"
            placeholder="9"
            inputmode="decimal"
            min="0"
            max="11.99"
            step="0.1"
            aria-label="Height in inches"
          />
          <span>in</span>
        </div>
      </div>
    </div>

    <div id="metric-height" hidden>
      <div class="field">
        <label for="height-cm">Height</label>
        <div class="height-single">
          <input
            type="number"
            id="height-cm"
            placeholder="175"
            inputmode="decimal"
            min="120"
            max="240"
            step="0.1"
            aria-label="Height in centimeters"
          />
          <span>cm</span>
        </div>
      </div>
    </div>

    <p class="field-help">
      Traditional IBW formulas use 5 feet (152 cm) as their baseline.
      Heights below 5 feet produce extrapolated reference estimates rather
      than values validated in the original clinical data.
    </p>

    <p id="input-error" class="input-error" role="alert" aria-live="assertive" hidden></p>

    <button type="button" class="btn-primary" id="calc-btn">
      Calculate Ideal Weight
    </button>

    <div class="result-box" id="result-box" hidden>
      <div
        id="result-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <div class="big-number" id="result-range">–</div>

      <div class="label">Four-Formula IBW Reference Range</div>

      <div class="lifter-note">
        <strong>Note for lifters:</strong> Traditional ideal body weight
        formulas do not measure muscle mass or body fat. If you lift
        regularly or have above-average lean mass, your healthy body weight
        may be higher than these reference estimates.
      </div>

      <table class="result-table">
        <caption>Ideal body weight estimates</caption>
        <thead>
          <tr>
            <th scope="col">Formula</th>
            <th scope="col">Reference Weight</th>
          </tr>
        </thead>
        <tbody id="formula-results"></tbody>
      </table>

      <div class="bmi-result">
        <h3>Healthy BMI Weight Range</h3>
        <div class="bmi-range" id="bmi-range">–</div>
        <p class="calc-note">
          This range corresponds to an adult BMI of 18.5–24.9. BMI is a
          screening measure and does not directly measure body fat, muscle
          mass, or fat distribution. For your own BMI, see our
          <a href="/tools/nutrition/bmi-calculator/">BMI Calculator</a>.
        </p>
      </div>

      <div class="result-summary" id="result-summary"></div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is an Ideal Weight Calculator?</h2>

    <p>
      An ideal weight calculator estimates a reference body weight from
      height and sex. Instead of presenting one number as a universal target,
      this calculator compares four commonly used ideal body weight (IBW)
      formulas: Devine, Robinson, Miller, and Hamwi.
    </p>

    <p>
      It also shows a BMI-based healthy weight range. This gives you two
      different reference points: traditional IBW equations provide
      formula-based estimates, while BMI provides a range of body weights
      corresponding to an adult BMI of 18.5–24.9.
    </p>

    <p>
      These approaches are not interchangeable, and neither should be treated
      as a precise definition of the weight every person should reach.
      Research and clinical reviews have highlighted important limitations
      in traditional IBW equations.
    </p>
  </article>

  <article class="article-section">
    <h2>How Is Ideal Body Weight Calculated?</h2>

    <p>
      The four formulas used here are traditional height-based equations.
      Most use a base weight at 5 feet and add a fixed amount for each inch
      above 5 feet. The equations produce different estimates because they
      were developed from different historical data and approaches.
    </p>

    <h3>Devine Formula (1974)</h3>

    <p>
      The Devine formula was published in 1974 and became widely used for
      ideal body weight estimation in clinical and drug-dosing contexts. It
      is the most commonly cited IBW equation in clinical pharmacology.
    </p>

    <ul>
      <li><strong>Men:</strong> 50.0 kg + 2.3 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 45.5 kg + 2.3 kg × each inch over 5 ft</li>
    </ul>

    <p>
      <strong>Worked example (men, 5'10"):</strong> 50 + 2.3 × 10 =
      <strong>73 kg (≈ 161 lb)</strong>.
    </p>

    <p>
      <strong>Best for:</strong> Clinical drug-dosing and pharmacokinetic
      calculations. It remains the standard reference in many medical
      contexts.
    </p>

    <p>
      <strong>Limitation:</strong> Because it was developed for drug dosing,
      it was not designed to identify healthy body-composition targets for
      athletes or the general population.
    </p>

    <h3>Hamwi Formula (1964)</h3>

    <p>
      The Hamwi method is traditionally expressed in pounds. This calculator
      calculates it in its common imperial form and converts the result to
      kilograms when metric output is selected.
    </p>

    <ul>
      <li><strong>Men:</strong> 106 lb + 6 lb × each inch over 5 ft</li>
      <li><strong>Women:</strong> 100 lb + 5 lb × each inch over 5 ft</li>
    </ul>

    <p>
      <strong>Worked example (men, 5'10"):</strong> 106 + 6 × 10 =
      <strong>166 lb (≈ 75.3 kg)</strong>.
    </p>

    <p>
      <strong>Best for:</strong> A widely recognized imperial reference.
      Sometimes used alongside Devine in clinical settings.
    </p>

    <p>
      <strong>Limitation:</strong> Hamwi often produces different estimates
      than Devine, and the direction and size of the difference varies with
      height and sex. It was developed before modern body-composition
      standards.
    </p>

    <h3>Robinson Formula (1983)</h3>

    <p>
      The Robinson equation was published in 1983 using height-weight data
      derived from Metropolitan Life Insurance Company tables.
    </p>

    <ul>
      <li><strong>Men:</strong> 52.0 kg + 1.9 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 49.0 kg + 1.7 kg × each inch over 5 ft</li>
    </ul>

    <p>
      <strong>Worked example (men, 5'10"):</strong> 52 + 1.9 × 10 =
      <strong>71 kg (≈ 156.5 lb)</strong>.
    </p>

    <p>
      <strong>Best for:</strong> A moderate estimate between Devine and
      Miller. Sometimes preferred when a slightly lower reference value is
      appropriate.
    </p>

    <p>
      <strong>Limitation:</strong> Also derived from historical insurance
      data that may not reflect modern body compositions.
    </p>

    <h3>Miller Formula (1983)</h3>

    <p>
      The Miller equation is another 1983 reference equation with different
      coefficients from Devine, Hamwi, and Robinson.
    </p>

    <ul>
      <li><strong>Men:</strong> 56.2 kg + 1.41 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 53.1 kg + 1.36 kg × each inch over 5 ft</li>
    </ul>

    <p>
      <strong>Worked example (men, 5'10"):</strong> 56.2 + 1.41 × 10 =
      <strong>70.3 kg (≈ 155 lb)</strong>.
    </p>

    <p>
      <strong>Best for:</strong> A reference estimate that tends to
      produce lower values than Devine or Hamwi for the same height.
    </p>

    <p>
      <strong>Limitation:</strong> Least commonly used in clinical settings.
      Same historical data limitations as the other formulas.
    </p>

    <h3>Below 5 Feet: Extrapolated Estimates</h3>

    <p>
      Traditional IBW equations use 5 feet (152 cm) as their baseline and
      add a fixed amount for each additional inch. For heights below
      5 feet, the calculation extrapolates below this baseline. The
      extrapolated values are reference estimates rather than results
      validated in the original clinical datasets.
    </p>

    <p>
      If your height is below 5 feet, treat the formula results with
      additional caution. A BMI-based range may provide a more useful
      secondary reference in this height range.
    </p>
  </article>

  <article class="article-section">
    <h2>Which Ideal Body Weight Formula Is Most Accurate?</h2>

    <p>
      There is no universally accepted "most accurate" IBW formula.
      Devine, Hamwi, Robinson, and Miller can produce different results for
      the same height because they were developed from different historical
      datasets and methods.
    </p>

    <p>
      Research comparing traditional IBW equations with BMI-based ranges
      has found that the formulas do not always align with the same BMI
      value across different heights. This is one reason a BMI-based range
      can provide useful additional context rather than relying on one
      formula alone.
    </p>

    <p>
      RepMaths therefore shows the four equations separately and reports
      their overall range. The calculator does not rank one formula as the
      universally correct answer.
    </p>
  </article>

  <article class="article-section">
    <h2>What Should I Weigh for My Height and Age?</h2>

    <p>
      For the adult IBW formulas on this page, age is not part of the
      calculation. Devine, Hamwi, Robinson, and Miller use height and sex
      rather than age.
    </p>

    <p>
      So a search such as "ideal weight by age" should not be interpreted
      as though every adult age has a separate IBW number from these
      equations. Age can matter when assessing health, body composition,
      or other individual factors, but it is not an input to these four
      classic IBW formulas.
    </p>

    <p>
      For adults, you can use the
      <a href="/tools/nutrition/bmi-calculator/">BMI Calculator</a>
      alongside this tool to see how weight relates to height using a
      BMI-based reference range.
    </p>
  </article>

  <article class="article-section">
    <h2>Ideal Weight vs Healthy Weight</h2>

    <p>
      "Ideal weight" and "healthy weight" are not interchangeable terms.
      Traditional IBW formulas return mathematical reference estimates,
      while a broader healthy-weight assessment can involve BMI, body
      composition, health history, physical activity, and other individual
      factors.
    </p>

    <p>
      A person can be above a traditional IBW estimate without having
      excess body fat, particularly when they have substantial muscle mass.
      Conversely, being within an IBW estimate does not automatically mean
      that a person has an optimal body composition or overall health.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Ideal Weight Include Muscle Mass?</h2>

    <p>
      No. Traditional IBW equations do not directly measure muscle mass,
      fat mass, skeletal size, or fat distribution. They primarily use
      height and sex.
    </p>

    <p>
      This limitation matters for bodybuilders, strength athletes, and
      muscular lifters. Someone who carries substantially more lean mass
      than the population represented by a traditional height-weight
      equation may weigh more than the calculated IBW while still having
      a healthy body composition.
    </p>

    <p>
      If you are a lifter, use the result as a reference rather than as a
      mandatory target. Our
      <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a>
      can provide additional body-composition context.
    </p>

    <p>
      You can also use the
      <a href="/tools/nutrition/lean-body-mass-calculator/">Lean Body Mass Calculator</a>
      to estimate fat-free mass, or the
      <a href="/tools/nutrition/ffmi-calculator/">FFMI Calculator</a>
      to put lean mass into a height-adjusted context.
    </p>
  </article>

  <article class="article-section">
    <h2>Ideal Weight for Bodybuilders and Lifters</h2>

    <p>
      If you lift weights regularly, an IBW calculator can produce a result
      that feels surprisingly low. That does not necessarily mean that you
      should lose weight to reach the calculated number.
    </p>

    <p>
      Traditional IBW equations were not designed to identify the ideal
      scale weight for a muscular athlete. They also do not distinguish
      how much of your body weight comes from muscle versus fat.
    </p>

    <p>
      For a fitness-focused assessment, consider your body-fat percentage,
      lean body mass, performance, health markers, and personal goals
      alongside scale weight.
    </p>

    <p>
      If your goal is to move toward a specific body weight, the
      <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a>
      can help estimate a calorie target and projected timeline.
    </p>

    <p>
      If your goal is nutrition planning rather than weight loss, the
      <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>
      can help you set starting protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is the Healthy BMI Weight Range?</h2>

    <p>
      For adults, a BMI of 18.5 through 24.9 is commonly used as the
      healthy-weight BMI category. Converting those BMI values back into
      body weight creates a height-specific reference range.
    </p>

    <p>
      The calculation is:
      <code>Weight = BMI × Height²</code>
      when height is expressed in meters and weight in kilograms.
    </p>

    <p>
      Unlike traditional IBW formulas, a BMI range gives you more than one
      target weight. However, BMI is a screening measure and cannot
      distinguish muscle mass from fat mass.
    </p>

    <p>
      For that reason, muscular athletes should not interpret BMI or
      traditional IBW as a complete body-composition assessment.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Do Different Ideal Weight Calculators Give Different Results?</h2>

    <p>
      Different calculators may use different equations. Some use Devine,
      some use Robinson or Miller, and others use Hamwi or BMI-based
      calculations.
    </p>

    <p>
      Even when two calculators use the same formula, differences can
      appear because of rounding, height conversion, unit conversion,
      or how heights around the 5-foot baseline are handled.
    </p>

    <p>
      RepMaths shows the four reference equations separately so you can
      see the calculation rather than hiding those differences behind
      one unexplained number.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    {faqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p set:html={faq.answer} />
      </div>
    ))}
  </article>

  <article class="article-section">
    <h2>Sources &amp; Methodology</h2>

    <p>
      RepMaths uses four commonly published adult ideal body weight
      reference equations: Devine, Hamwi, Robinson, and Miller. It also
      calculates a separate BMI-based weight range using BMI values of
      18.5 and 24.9.
    </p>

    <ul>
      <li>
        Devine BJ. <em>Gentamicin therapy.</em> Drug Intelligence and
        Clinical Pharmacy, 1974.
      </li>
      <li>
        Robinson JD, Lupkiewicz SM, Palenik L, Lopez LM, Ariet M.
        <em>Determination of ideal body weight for drug dosage calculations.</em>
        American Journal of Hospital Pharmacy, 1983.
      </li>
      <li>
        Pai MP, Paloucek FP.
        <em>The origin of the "ideal" body weight equations.</em>
        Annals of Pharmacotherapy, 2000.
      </li>
      <li>
        Peterson CM, Thomas DM, Blackburn GL, Heymsfield SB.
        <em>Universal equation for estimating ideal body weight and body
        weight at any given body mass index.</em>
        PLoS ONE, 2016.
      </li>
    </ul>

    <p>
      The formulas are presented as reference estimates for educational and
      fitness-planning purposes. They are not a diagnosis and should not be
      treated as a universal target or a substitute for individualized
      medical advice.
    </p>
  </article>

  <RelatedTools currentToolId="ideal-weight-calculator" />

  <style>
