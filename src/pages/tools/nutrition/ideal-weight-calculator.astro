  </style>

  <script>
    type Unit = 'lb' | 'kg';
    type Sex = 'male' | 'female';

    let unit: Unit = 'lb';
    let sex: Sex = 'male';

    // Canonical metric value — preserved across unit toggles to avoid
    // cumulative rounding loss from repeated conversions.
    let preservedCm: number | null = null;

    const unitLb = document.getElementById('unit-lb');
    const unitKg = document.getElementById('unit-kg');

    const sexMale = document.getElementById('sex-male');
    const sexFemale = document.getElementById('sex-female');

    const imperialHeight = document.getElementById('imperial-height');
    const metricHeight = document.getElementById('metric-height');

    const heightFt = document.getElementById('height-ft') as HTMLInputElement | null;
    const heightIn = document.getElementById('height-in') as HTMLInputElement | null;
    const heightCm = document.getElementById('height-cm') as HTMLInputElement | null;

    const calcBtn = document.getElementById('calc-btn');
    const inputError = document.getElementById('input-error');

    const resultBox = document.getElementById('result-box');
    const resultRange = document.getElementById('result-range');
    const formulaResults = document.getElementById('formula-results');
    const bmiRange = document.getElementById('bmi-range');
    const resultSummary = document.getElementById('result-summary');
    const resultAnnouncement = document.getElementById('result-announcement');

    const round = (value: number, decimals = 1) => {
      const factor = Math.pow(10, decimals);
      return Math.round(value * factor) / factor;
    };

    const kgToLb = (kg: number) => kg * 2.2046226218;
    const lbToKg = (lb: number) => lb / 2.2046226218;

    // ---------- Preserved value sync ----------

    function syncPreservedHeightFromImperial() {
      if (!heightFt || !heightIn) return;

      const feetRaw = heightFt.value.trim();
      const inchesRaw = heightIn.value.trim();

      if (feetRaw === '' && inchesRaw === '') {
        preservedCm = null;
        return;
      }

      const feet = feetRaw === '' ? 0 : Number(feetRaw);
      const inches = inchesRaw === '' ? 0 : Number(inchesRaw);

      if (!Number.isFinite(feet) || !Number.isFinite(inches)) {
        preservedCm = null;
        return;
      }

      if (feet < 0 || inches < 0 || inches >= 12) {
        preservedCm = null;
        return;
      }

      const totalInches = feet * 12 + inches;

      if (totalInches <= 0) {
        preservedCm = null;
        return;
      }

      preservedCm = totalInches * 2.54;
    }

    function syncPreservedHeightFromMetric() {
      if (!heightCm) return;

      const raw = heightCm.value.trim();

      if (raw === '') {
        preservedCm = null;
        return;
      }

      const value = Number(raw);

      if (!Number.isFinite(value) || value <= 0) {
        preservedCm = null;
        return;
      }

      preservedCm = value;
    }

    // ---------- UI state ----------

    function resetResult() {
      clearError();
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
      if (resultAnnouncement) {
        resultAnnouncement.textContent = '';
      }
    }

    function setUnit(next: Unit) {
      if (next === unit) return;

      // Render height from preserved cm value.
      if (preservedCm !== null && preservedCm > 0) {
        if (next === 'kg' && heightCm) {
          heightCm.value = preservedCm.toFixed(1);
        }

        if (next === 'lb' && heightFt && heightIn) {
          // Use decimal precision — do not round to whole inches.
          // This keeps the displayed imperial value aligned with the
          // original metric input.
          const totalInches = preservedCm / 2.54;
          const feet = Math.floor(totalInches / 12);
          const inches = totalInches - feet * 12;

          heightFt.value = String(feet);
          heightIn.value = inches.toFixed(1);
        }
      }

      unit = next;
      updateUnitUI();
      resetResult();
    }

    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle('active', unit === 'lb');
        unitLb.setAttribute('aria-pressed', String(unit === 'lb'));
      }
      if (unitKg) {
        unitKg.classList.toggle('active', unit === 'kg');
        unitKg.setAttribute('aria-pressed', String(unit === 'kg'));
      }
      if (imperialHeight) imperialHeight.hidden = unit !== 'lb';
      if (metricHeight) metricHeight.hidden = unit !== 'kg';
    }

    function setSex(next: Sex) {
      sex = next;

      if (sexMale) {
        sexMale.classList.toggle('active', sex === 'male');
        sexMale.setAttribute('aria-pressed', String(sex === 'male'));
      }
      if (sexFemale) {
        sexFemale.classList.toggle('active', sex === 'female');
        sexFemale.setAttribute('aria-pressed', String(sex === 'female'));
      }

      resetResult();
    }

    function showError(message: string) {
      if (!inputError) return;
      inputError.textContent = message;
      inputError.hidden = false;
      if (resultBox) {
        resultBox.hidden = true;
        resultBox.classList.remove('show');
      }
    }

    function clearError() {
      if (!inputError) return;
      inputError.textContent = '';
      inputError.hidden = true;
    }

    // ---------- Calculation helpers ----------

    function getHeightCm(): number | null {
      if (unit === 'kg') {
        const cm = Number(heightCm?.value ?? '');
        if (!Number.isFinite(cm) || cm <= 0) return null;
        return cm;
      }

      const feet = Number(heightFt?.value ?? '');
      const inches = Number(heightIn?.value ?? '');

      if (!Number.isFinite(feet) || !Number.isFinite(inches)) {
        return null;
      }

      if (feet < 4 || feet > 8 || inches < 0 || inches >= 12) {
        return null;
      }

      const totalInches = feet * 12 + inches;

      return totalInches * 2.54;
    }

    function formatWeight(kg: number): string {
      return unit === 'kg'
        ? `${round(kg, 1)} kg`
        : `${round(kgToLb(kg), 1)} lb`;
    }

    function formatDualWeight(kg: number): string {
      return `${round(kgToLb(kg), 1)} lb / ${round(kg, 1)} kg`;
    }

    function calculateIBW(heightInches: number, selectedSex: Sex) {
      const inchesOverFiveFeet = heightInches - 60;

      if (selectedSex === 'male') {
        return {
          devine: 50.0 + 2.3 * inchesOverFiveFeet,
          hamwi: lbToKg(106 + 6 * inchesOverFiveFeet),
          robinson: 52.0 + 1.9 * inchesOverFiveFeet,
          miller: 56.2 + 1.41 * inchesOverFiveFeet,
        };
      }

      return {
        devine: 45.5 + 2.3 * inchesOverFiveFeet,
        hamwi: lbToKg(100 + 5 * inchesOverFiveFeet),
        robinson: 49.0 + 1.7 * inchesOverFiveFeet,
        miller: 53.1 + 1.36 * inchesOverFiveFeet,
      };
    }

    function calculateBMIWeightRange(heightM: number) {
      return {
        min: 18.5 * heightM * heightM,
        max: 24.9 * heightM * heightM,
      };
    }

    // ---------- Event listeners ----------

    unitLb?.addEventListener('click', () => setUnit('lb'));
    unitKg?.addEventListener('click', () => setUnit('kg'));
    sexMale?.addEventListener('click', () => setSex('male'));
    sexFemale?.addEventListener('click', () => setSex('female'));

    heightFt?.addEventListener('input', () => {
      syncPreservedHeightFromImperial();
      resetResult();
    });

    heightIn?.addEventListener('input', () => {
      syncPreservedHeightFromImperial();
      resetResult();
    });

    heightCm?.addEventListener('input', () => {
      syncPreservedHeightFromMetric();
      resetResult();
    });

    // ---------- Calculate ----------

    calcBtn?.addEventListener('click', () => {
      clearError();

      // Only sync from input when no preserved value exists yet.
      // This keeps the original metric precision through unit toggles.
      if (preservedCm === null) {
        if (unit === 'lb') {
          syncPreservedHeightFromImperial();
        } else {
          syncPreservedHeightFromMetric();
        }
      }

      const heightCmValue = getHeightCm();

      if (
        heightCmValue === null ||
        !Number.isFinite(heightCmValue) ||
        heightCmValue < 120 ||
        heightCmValue > 240
      ) {
        showError('Please enter a valid adult height between 120 and 240 cm (approximately 4 ft – 8 ft).');
        return;
      }

      const heightInches = heightCmValue / 2.54;
      const heightM = heightCmValue / 100;

      const ibw = calculateIBW(heightInches, sex);
      const values = [ibw.devine, ibw.hamwi, ibw.robinson, ibw.miller];

      if (values.some((value) => !Number.isFinite(value) || value <= 0)) {
        showError('This height does not produce a valid reference estimate.');
        return;
      }

      const minimum = Math.min(...values);
      const maximum = Math.max(...values);
      const average = values.reduce((sum, value) => sum + value, 0) / values.length;

      const bmi = calculateBMIWeightRange(heightM);

      if (resultRange) {
        resultRange.textContent = `${formatWeight(minimum)} – ${formatWeight(maximum)}`;
      }

      if (formulaResults) {
        formulaResults.replaceChildren();

        const formulaRows = [
          { name: 'Devine', value: ibw.devine },
          { name: 'Hamwi', value: ibw.hamwi },
          { name: 'Robinson', value: ibw.robinson },
          { name: 'Miller', value: ibw.miller },
        ];

        for (const row of formulaRows) {
          const tr = document.createElement('tr');

          const nameCell = document.createElement('td');
          nameCell.textContent = row.name;

          const valueCell = document.createElement('td');
          valueCell.textContent = formatDualWeight(row.value);

          tr.append(nameCell, valueCell);
          formulaResults.appendChild(tr);
        }
      }

      if (bmiRange) {
        bmiRange.textContent = `${formatDualWeight(bmi.min)} – ${formatDualWeight(bmi.max)}`;
      }

      if (resultSummary) {
        resultSummary.innerHTML = `
          <p>
            The four formulas produce a reference range of
            <strong>${formatWeight(minimum)}</strong>
            to
            <strong>${formatWeight(maximum)}</strong>.
            Their arithmetic average is
            <strong>${formatWeight(average)}</strong>,
            but that average is shown only as a mathematical comparison,
            not as a medically validated "ideal" target.
          </p>
        `;
      }

      if (resultBox) {
        resultBox.hidden = false;
        resultBox.classList.add('show');
      }

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Ideal body weight reference range: ${formatWeight(minimum)} to ${formatWeight(maximum)}. Healthy BMI weight range: ${formatDualWeight(bmi.min)} to ${formatDualWeight(bmi.max)}.`;
      }
    });

    // ---------- Initialize ----------

    updateUnitUI();
    setSex('male');
  </script>
</Base>
