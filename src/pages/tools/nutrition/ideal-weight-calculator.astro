const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/ideal-weight-calculator/#calculator',
  name: 'RepMaths Ideal Weight Calculator',
  alternateName: 'IBW Calculator',
  url: 'https://repmaths.com/tools/nutrition/ideal-weight-calculator/',
  description:
    'Free ideal weight calculator using Devine, Robinson, Miller, and Hamwi formulas, alongside a BMI-based healthy weight range.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
