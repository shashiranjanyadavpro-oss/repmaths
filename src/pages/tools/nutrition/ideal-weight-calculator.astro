---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Ideal Weight Calculator — Find Your Target Weight (4 Formulas)"
  description="Free ideal weight calculator using Devine, Robinson, Miller, and Hamwi formulas. Compare reference body weights with a healthy BMI weight range in lb or kg."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Ideal Weight Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free ideal weight calculator that compares four commonly used ideal body weight formulas with a BMI-based healthy weight range."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is my ideal weight for my height and age?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For the adult IBW formulas used by this calculator, height and sex are the main inputs. Devine, Robinson, Miller, and Hamwi do not use age in their equations. A healthy weight target should also consider body composition, health status, and individual circumstances."
        }
      },
      {
        "@type": "Question",
        "name": "Which ideal body weight formula is most accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There is no universally most accurate IBW formula. Devine, Robinson, Miller, and Hamwi produce somewhat different reference estimates because they were developed from different datasets and approaches. Comparing several formulas alongside a BMI-based weight range provides more context than relying on one number."
        }
      },
      {
        "@type": "Question",
        "name": "How much should a 5'5 woman weigh?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There is no single ideal weight for every 5'5 woman. This calculator shows four reference IBW estimates and a BMI-based healthy weight range so you can compare the different approaches."
        }
      },
      {
        "@type": "Question",
        "name": "Does ideal weight include muscle mass?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Traditional IBW formulas are based primarily on height and sex and do not directly account for above-average muscle mass. This is particularly important for strength athletes, bodybuilders, and other muscular lifters."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between BMI and Ideal Body Weight?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IBW formulas estimate a reference body weight from height and sex. BMI relates body weight to height and provides a range rather than one target number. Neither measure directly distinguishes muscle from fat."
        }
      },
      {
        "@type": "Question",
        "name": "Are ideal weight formulas outdated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The classic formulas are old and have limitations, but they are still used as reference equations in clinical and fitness contexts. They should be treated as estimates rather than a universal definition of the weight a person should reach."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Ideal Weight Calculator — Find Your Target Weight</h1>
    <p>
      Compare four commonly used ideal body weight formulas with a
      healthy BMI-based weight range in pounds or kilograms.
    </p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="unit-lb"
          class="active"
          aria-pressed="true"
        >
          lb / ft
        </button>
        <button
          type="button"
          id="unit-kg"
          aria-pressed="false"
        >
          kg / cm
        </button>
      </div>
    </div>

    <div class="field">
      <label>Sex</label>
      <div class="unit-toggle">
        <button
          type="button"
          id="sex-male"
          class="active"
          aria-pressed="true"
        >
          Male
        </button>
        <button
          type="button"
          id="sex-female"
          aria-pressed="false"
        >
          Female
        </button>
      </div>
    </div>

    <div id="imperial-height">
      <div class="field">
        <label for="height-ft">Height</label>
        <div class="height-grid">
          <input
            type="number"
            id="height-ft"
            placeholder="5"
            inputmode="numeric"
            min="4"
            max="8"
            step="1"
            aria-label="Height in feet"
          />
          <span>ft</span>

          <input
            type="number"
            id="height-in"
            placeholder="9"
            inputmode="decimal"
            min="0"
            max="11.99"
            step="0.1"
            aria-label="Height in inches"
          />
          <span>in</span>
        </div>
      </div>
    </div>

    <div id="metric-height" hidden>
      <div class="field">
        <label for="height-cm">Height</label>
        <div class="height-single">
          <input
            type="number"
            id="height-cm"
            placeholder="175"
            inputmode="decimal"
            min="120"
            max="240"
            step="0.1"
            aria-label="Height in centimeters"
          />
          <span>cm</span>
        </div>
      </div>
    </div>

    <button class="btn-primary" id="calc-btn">
      Calculate Ideal Weight
    </button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-average">–</div>
      <div class="label">Average of 4 IBW Reference Estimates</div>

      <div class="lifter-note">
        <strong>Note for lifters:</strong>
        Traditional IBW formulas do not account for above-average muscle
        mass. If you train regularly, your healthy body weight may be
        higher than these reference estimates.
      </div>

      <table class="result-table">
        <caption>Ideal body weight estimates</caption>
        <thead>
          <tr>
            <th scope="col">Formula</th>
            <th scope="col">Weight</th>
          </tr>
        </thead>
        <tbody id="formula-results"></tbody>
      </table>

      <div class="bmi-result">
        <h3>Healthy BMI Weight Range</h3>
        <div class="bmi-range" id="bmi-range">–</div>
        <p>
          This range corresponds to a BMI of 18.5–24.9 for adults.
          BMI is a screening measure and does not directly measure body fat
          or muscle mass.
        </p>
      </div>

      <div class="result-summary" id="result-summary"></div>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is an Ideal Weight Calculator?</h2>

    <p>
      An ideal weight calculator estimates a reference body weight from
      your height and sex. Instead of presenting one number as a universal
      target, this calculator compares four commonly used ideal body weight
      (IBW) formulas: Devine, Robinson, Miller, and Hamwi.
    </p>

    <p>
      It also shows a BMI-based healthy weight range. That gives you two
      different ways to interpret your result: traditional IBW equations
      provide reference estimates, while BMI provides a range of body
      weights corresponding to the adult BMI range of 18.5–24.9.
    </p>

    <p>
      These approaches are not interchangeable and neither one should be
      treated as a precise definition of your personally ideal body weight.
    </p>
  </article>

  <article class="article-section">
    <h2>How Is Ideal Body Weight Calculated?</h2>

    <p>
      The four formulas used here estimate body weight from height and sex.
      They use a base weight at 5 feet and then add a fixed amount for
      each inch above 5 feet. The equations produce slightly different
      estimates because they were developed using different historical
      datasets and methods.
    </p>

    <h3>Devine Formula</h3>

    <p>
      The Devine formula was published in 1974 and became widely used for
      estimating ideal body weight in clinical and drug-dosing contexts.
    </p>

    <ul>
      <li><strong>Men:</strong> 50.0 kg + 2.3 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 45.5 kg + 2.3 kg × each inch over 5 ft</li>
    </ul>

    <h3>Hamwi Formula</h3>

    <p>
      The Hamwi formula dates to 1964 and is another traditional reference
      equation for estimating desirable body weight.
    </p>

    <ul>
      <li><strong>Men:</strong> 48.0 kg + 2.7 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 45.5 kg + 2.2 kg × each inch over 5 ft</li>
    </ul>

    <h3>Robinson Formula</h3>

    <p>
      The Robinson formula was published in 1983 using height-weight data
      to derive sex-specific ideal body weight equations.
    </p>

    <ul>
      <li><strong>Men:</strong> 52.0 kg + 1.9 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 49.0 kg + 1.7 kg × each inch over 5 ft</li>
    </ul>

    <h3>Miller Formula</h3>

    <p>
      The Miller formula is another 1983 reference equation and uses
      different coefficients from the Devine, Hamwi, and Robinson methods.
    </p>

    <ul>
      <li><strong>Men:</strong> 56.2 kg + 1.41 kg × each inch over 5 ft</li>
      <li><strong>Women:</strong> 53.1 kg + 1.36 kg × each inch over 5 ft</li>
    </ul>
  </article>

  <article class="article-section">
    <h2>Which Ideal Body Weight Formula Is Most Accurate?</h2>

    <p>
      There is no universally accepted “most accurate” IBW formula.
      Devine, Hamwi, Robinson, and Miller can produce different results for
      the same height because they were developed from different historical
      data and approaches.
    </p>

    <p>
      Research comparing IBW equations has found that the formulas do not
      always align with the same BMI value across different heights.
      For that reason, comparing multiple equations and looking at a
      healthy BMI-based range can provide more context than choosing one
      formula as the definitive answer.
    </p>

    <p>
      The four-formula comparison above is therefore a reference tool,
      not a ranking of which equation is universally correct.
    </p>
  </article>

  <article class="article-section">
    <h2>What Should I Weigh for My Height and Age?</h2>

    <p>
      For the adult IBW formulas on this page, age is not part of the
      calculation. Devine, Hamwi, Robinson, and Miller use height and sex
      rather than age.
    </p>

    <p>
      That means a search such as “ideal weight by age” should not be
      interpreted as though every adult age has a separate IBW number.
      Age can matter when assessing health, body composition, or other
      clinical factors, but it is not an input to these four classic IBW
      equations.
    </p>

    <p>
      For adults, you can use the
      <a href="/tools/nutrition/bmi-calculator">BMI Calculator</a>
      alongside this tool to see how your weight relates to height using
      a BMI-based range.
    </p>
  </article>

  <article class="article-section">
    <h2>Ideal Weight vs Healthy Weight</h2>

    <p>
      “Ideal weight” and “healthy weight” are not interchangeable terms.
      Traditional IBW formulas return a mathematical reference estimate,
      while a healthy-weight assessment can involve BMI, body composition,
      health history, physical activity, and other individual factors.
    </p>

    <p>
      A person can be above a traditional IBW estimate without having
      excess body fat, particularly when they have substantial muscle mass.
      Conversely, being within an IBW estimate does not automatically mean
      that a person has an optimal body composition or overall health.
    </p>
  </article>

  <article class="article-section">
    <h2>Does Ideal Weight Include Muscle Mass?</h2>

    <p>
      No. Traditional IBW equations do not directly measure muscle mass,
      fat mass, skeletal size, or other components of body composition.
      They primarily use height and sex.
    </p>

    <p>
      This limitation matters for bodybuilders, strength athletes, and
      muscular lifters. Someone who carries substantially more lean mass
      than the population represented by a traditional height-weight
      equation may weigh more than the calculated IBW while still having
      a healthy body composition.
    </p>

    <p>
      If you are a lifter, use the result as a reference rather than as a
      mandatory target. Our
      <a href="/tools/nutrition/body-fat-calculator">Body Fat Calculator</a>
      can provide additional body-composition context.
    </p>

    <p>
      You can also use the
      <a href="/tools/nutrition/lean-body-mass-calculator">
        Lean Body Mass Calculator
      </a>
      to estimate fat-free mass, or the
      <a href="/tools/nutrition/ffmi-calculator">FFMI Calculator</a>
      to put lean mass into a height-adjusted context.
    </p>
  </article>

  <article class="article-section">
    <h2>Ideal Weight for Bodybuilders and Lifters</h2>

    <p>
      If you lift weights regularly, an IBW calculator can produce a result
      that feels surprisingly low. That does not necessarily mean that you
      should lose weight to reach the calculated number.
    </p>

    <p>
      Traditional IBW equations were not designed to identify the ideal
      scale weight for a muscular athlete. They also do not account for
      how much of your body weight comes from muscle versus fat.
    </p>

    <p>
      For a fitness-focused assessment, consider your body-fat percentage,
      lean body mass, performance, health markers, and personal goals
      alongside scale weight.
    </p>

    <p>
      If your goal is to move toward a specific body weight, the
      <a href="/tools/nutrition/calorie-deficit-calculator">
        Calorie Deficit Calculator
      </a>
      can help estimate a calorie target and projected timeline. If your
      goal is nutrition planning rather than weight loss, the
      <a href="/tools/nutrition/macro-calculator">Macro Calculator</a>
      can help you set starting protein, carbohydrate, and fat targets.
    </p>
  </article>

  <article class="article-section">
    <h2>What Is the Healthy BMI Weight Range?</h2>

    <p>
      For adults, a BMI of 18.5 through 24.9 is commonly used as the
      “healthy weight” BMI category. Converting those BMI values back into
      body weight creates a height-specific weight range.
    </p>

    <p>
      The calculation is:
      <code>Weight = BMI × Height²</code>
      when height is expressed in meters and weight in kilograms.
    </p>

    <p>
      Unlike the traditional IBW formulas, a BMI range gives you more than
      one target weight. However, BMI also has an important limitation:
      it cannot distinguish muscle mass from fat mass.
    </p>

    <p>
      For that reason, muscular athletes should not interpret either BMI
      or traditional IBW as a complete body-composition assessment.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Do Different Ideal Weight Calculators Give Different Results?</h2>

    <p>
      Different calculators may use different equations. Some use Devine,
      some use Robinson or Miller, and others use Hamwi or BMI-based
      calculations.
    </p>

    <p>
      Even when two calculators use the same formula, differences can
      appear because of rounding, height conversion, unit conversion,
      or how heights below and above 5 feet are handled.
    </p>

    <p>
      RepMaths shows the four reference equations separately so you can
      see the calculation rather than hiding those differences behind
      one unexplained number.
    </p>
  </article>

  <article class="article-section">
    <h2>Sources & Methodology</h2>

    <p>
      RepMaths uses the commonly published Devine, Hamwi, Robinson, and
      Miller ideal body weight equations and calculates a separate BMI
      weight range using BMI values of 18.5 and 24.9.
    </p>

    <ul>
      <li>
        Robinson et al. (1983), ideal body weight equations derived from
        height-weight data.
      </li>
      <li>
        Pai & Paloucek (2000), historical review of the origin and use of
        ideal body weight equations.
      </li>
      <li>
        Peterson et al. (2016), research comparing IBW equations with BMI
        and proposing a universal height/BMI-based equation.
      </li>
    </ul>

    <p>
      These equations are presented for educational and fitness-planning
      purposes. They are not a diagnosis and should not be used as a
      substitute for individualized medical advice.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is my ideal weight for my height and age?</h3>
      <p>
        The adult IBW formulas used here do not use age. They estimate a
        reference weight from height and sex. Your health and appropriate
        target weight can depend on additional factors.
      </p>
    </div>

    <div class="faq-item">
      <h3>Which ideal body weight formula is most accurate?</h3>
      <p>
        There is no universally most accurate formula. Devine, Hamwi,
        Robinson, and Miller can produce different estimates, so comparing
        the four results gives more context than treating one formula as
        definitive.
      </p>
    </div>

    <div class="faq-item">
      <h3>How much should a 5'5 woman weigh?</h3>
      <p>
        There is no single ideal weight for every 5'5 woman. This calculator
        provides four reference IBW estimates plus a BMI-based healthy
        weight range.
      </p>
    </div>

    <div class="faq-item">
      <h3>Does ideal weight include muscle mass?</h3>
      <p>
        No. Traditional IBW formulas do not directly account for above-
        average muscle mass. This is especially important for bodybuilders
        and strength athletes.
      </p>
    </div>

    <div class="faq-item">
      <h3>What is the difference between BMI and Ideal Body Weight?</h3>
      <p>
        IBW formulas estimate a reference weight from height and sex.
        BMI relates weight to height and can be used to calculate a range
        of weights at a selected BMI. Neither directly measures body
        composition.
      </p>
    </div>

    <div class="faq-item">
      <h3>Are ideal weight formulas outdated?</h3>
      <p>
        The classic equations are old and have known limitations, but they
        remain useful as reference equations. They should not be treated
        as a universal definition of the weight every person should reach.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="ideal-weight-calculator" />

  <script>
    type Unit = "lb" | "kg";
    type Sex = "male" | "female";

    let unit: Unit = "lb";
    let sex: Sex = "male";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");

    const sexMale = document.getElementById("sex-male");
    const sexFemale = document.getElementById("sex-female");

    const imperialHeight = document.getElementById("imperial-height");
    const metricHeight = document.getElementById("metric-height");

    const heightFt = document.getElementById(
      "height-ft"
    ) as HTMLInputElement | null;

    const heightIn = document.getElementById(
      "height-in"
    ) as HTMLInputElement | null;

    const heightCm = document.getElementById(
      "height-cm"
    ) as HTMLInputElement | null;

    const calcBtn = document.getElementById("calc-btn");

    const resultBox = document.getElementById("result-box");
    const resultAverage = document.getElementById("result-average");
    const formulaResults = document.getElementById("formula-results");
    const bmiRange = document.getElementById("bmi-range");
    const resultSummary = document.getElementById("result-summary");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    if (sexMale) {
      sexMale.addEventListener("click", () => setSex("male"));
    }

    if (sexFemale) {
      sexFemale.addEventListener("click", () => setSex("female"));
    }

    function setUnit(newUnit: Unit) {
      if (newUnit === unit) return;

      if (unit === "lb" && newUnit === "kg") {
        if (
          heightFt &&
          heightIn &&
          heightCm &&
          Number.isFinite(parseFloat(heightFt.value)) &&
          Number.isFinite(parseFloat(heightIn.value))
        ) {
          const totalInches =
            parseFloat(heightFt.value) + parseFloat(heightIn.value) / 12;

          heightCm.value = (totalInches * 2.54).toFixed(1);
        }
      }

      if (unit === "kg" && newUnit === "lb") {
        if (
          heightCm &&
          heightFt &&
          heightIn &&
          Number.isFinite(parseFloat(heightCm.value))
        ) {
          const totalInches = parseFloat(heightCm.value) / 2.54;
          const feet = Math.floor(totalInches / 12);
          const inches = totalInches - feet * 12;

          heightFt.value = String(feet);
          heightIn.value = inches.toFixed(1);
        }
      }

      unit = newUnit;
      updateUnitUI();
    }

    function updateUnitUI() {
      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }

      if (imperialHeight) {
        imperialHeight.hidden = unit !== "lb";
      }

      if (metricHeight) {
        metricHeight.hidden = unit !== "kg";
      }
    }

    function setSex(newSex: Sex) {
      sex = newSex;

      if (sexMale) {
        sexMale.classList.toggle("active", sex === "male");
        sexMale.setAttribute("aria-pressed", String(sex === "male"));
      }

      if (sexFemale) {
        sexFemale.classList.toggle("active", sex === "female");
        sexFemale.setAttribute("aria-pressed", String(sex === "female"));
      }
    }

    function round(value: number, decimals = 1): number {
      const factor = Math.pow(10, decimals);
      return Math.round(value * factor) / factor;
    }

    function kgToLb(kg: number): number {
      return kg * 2.2046226218;
    }

    function lbToKg(lb: number): number {
      return lb / 2.2046226218;
    }

    function getHeightCm(): number | null {
      if (unit === "kg") {
        const cm = parseFloat(heightCm?.value || "");

        if (!Number.isFinite(cm)) return null;

        return cm;
      }

      const feet = parseFloat(heightFt?.value || "");
      const inches = parseFloat(heightIn?.value || "");

      if (!Number.isFinite(feet) || !Number.isFinite(inches)) {
        return null;
      }

      if (feet < 4 || feet > 8 || inches < 0 || inches >= 12) {
        return null;
      }

      return (feet * 12 + inches) * 2.54;
    }

    function formatWeight(kg: number): string {
      if (unit === "kg") {
        return `${round(kg, 1)} kg`;
      }

      return `${round(kgToLb(kg), 1)} lb`;
    }

    function formatDualWeight(kg: number): string {
      return `${round(kgToLb(kg), 1)} lb / ${round(kg, 1)} kg`;
    }

    function calculateIBW(
      heightInches: number,
      selectedSex: Sex
    ) {
      const inchesOverFiveFeet = heightInches - 60;

      let devine: number;
      let hamwi: number;
      let robinson: number;
      let miller: number;

      if (selectedSex === "male") {
        devine = 50.0 + 2.3 * inchesOverFiveFeet;
        hamwi = 48.0 + 2.7 * inchesOverFiveFeet;
        robinson = 52.0 + 1.9 * inchesOverFiveFeet;
        miller = 56.2 + 1.41 * inchesOverFiveFeet;
      } else {
        devine = 45.5 + 2.3 * inchesOverFiveFeet;
        hamwi = 45.5 + 2.2 * inchesOverFiveFeet;
        robinson = 49.0 + 1.7 * inchesOverFiveFeet;
        miller = 53.1 + 1.36 * inchesOverFiveFeet;
      }

      return {
        devine,
        hamwi,
        robinson,
        miller
      };
    }

    function calculateBMIWeightRange(heightM: number) {
      return {
        min: 18.5 * heightM * heightM,
        max: 24.9 * heightM * heightM
      };
    }

    function showError(message: string) {
      alert(message);
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        const heightCmValue = getHeightCm();

        if (
          heightCmValue === null ||
          !Number.isFinite(heightCmValue) ||
          heightCmValue < 120 ||
          heightCmValue > 240
        ) {
          showError(
            "Please enter a valid adult height between 120 and 240 cm."
          );
          return;
        }

        const heightInches = heightCmValue / 2.54;
        const heightM = heightCmValue / 100;

        const ibw = calculateIBW(heightInches, sex);

        const values = [
          ibw.devine,
          ibw.hamwi,
          ibw.robinson,
          ibw.miller
        ];

        if (values.some((value) => !Number.isFinite(value) || value <= 0)) {
          showError(
            "This height does not produce a valid reference estimate."
          );
          return;
        }

        const average =
          values.reduce((sum, value) => sum + value, 0) / values.length;

        const bmi = calculateBMIWeightRange(heightM);

        if (resultAverage) {
          resultAverage.textContent = formatWeight(average);
        }

        if (formulaResults) {
          formulaResults.innerHTML = `
            <tr>
              <td>Devine</td>
              <td>${formatDualWeight(ibw.devine)}</td>
            </tr>
            <tr>
              <td>Hamwi</td>
              <td>${formatDualWeight(ibw.hamwi)}</td>
            </tr>
            <tr>
              <td>Robinson</td>
              <td>${formatDualWeight(ibw.robinson)}</td>
            </tr>
            <tr>
              <td>Miller</td>
              <td>${formatDualWeight(ibw.miller)}</td>
            </tr>
          `;
        }

        if (bmiRange) {
          bmiRange.textContent =
            `${formatDualWeight(bmi.min)} – ${formatDualWeight(bmi.max)}`;
        }

        if (resultSummary) {
          resultSummary.innerHTML = `
            <p>
              The four IBW formulas give a reference range of
              <strong>${formatWeight(Math.min(...values))}</strong>
              to
              <strong>${formatWeight(Math.max(...values))}</strong>.
              The arithmetic average is shown above for comparison, not as
              a medically validated “ideal” target.
            </p>
          `;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }

    updateUnitUI();
    setSex("male");
  </script>

