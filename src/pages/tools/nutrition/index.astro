---
import Base from '../../../layouts/Base.astro';
import toolsData from '../../../data/tools.json';
const tools = toolsData.filter((t) => t.cluster === "nutrition");
---

<Base
  title="Nutrition & Body Composition Calculators | RepMaths"
  description="Free nutrition calculators: TDEE, BMR, BMI, macros, protein, body fat, FFMI, ideal weight, and water intake."
  breadcrumbs={[{ "name": "Home", "href": "/" }, { "name": "Tools", "href": "/tools/" }, { "name": "Nutrition & Body Composition" }]}
>
  <section class="hero">
    <h1>Nutrition & Body Composition</h1>
    <p>Dial in your calories, macros, and track your body composition accurately.</p>
  </section>

  <div class="tool-grid">
    {tools.map((tool) => (
      <a class="tool-card" href={tool.url}>
        <span class="icon" aria-hidden="true">{tool.icon}</span>
        <span class="name">{tool.name}</span>
        <span class="desc">{tool.shortDesc}</span>
      </a>
    ))}
  </div>

  <section class="seo-content">
    <h2>Master Your Diet & Body Composition</h2>
    <p>
      Whether your goal is to lose fat, build muscle, or maintain your current physique, nutrition is the foundation. Our free calculators help you determine your baseline metrics like <strong>BMR (Basal Metabolic Rate)</strong> and <strong>TDEE (Total Daily Energy Expenditure)</strong>. From there, you can easily break down your daily <strong>macronutrient</strong> and protein requirements, or track advanced metrics like Body Fat Percentage and FFMI (Fat-Free Mass Index) to monitor your true progress.
    </p>
  </section>

  <style>
    .hero {
      margin-bottom: 24px;
    }
    
    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 600px;
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin: 24px 0 48px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
    }

    /* SEO Content Styling */
    .seo-content {
      border-top: 1px solid var(--border);
      padding-top: 32px;
      margin-top: 32px;
    }

    .seo-content h2 {
      font-size: 1.25rem;
      color: var(--text);
      margin-bottom: 12px;
    }

    .seo-content p {
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 0.95rem;
    }
  </style>
</Base>
