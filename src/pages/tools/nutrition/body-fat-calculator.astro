    .result-box span,
    .result-box small {
      display: block;
      color: var(--text-muted);
      font-size: 0.76rem;
    }
    .result-box strong { display: block; margin: 5px 0; font-size: 1.18rem; }

    /* Fat Loss Target Box */
    .target-goal-box {
      margin-top: 14px;
      padding: 16px 18px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .target-goal-box[hidden] { display: none !important; }
    .target-goal-box h3 {
      margin: 0 0 8px;
      font-size: 0.98rem;
      color: var(--accent);
    }
    .target-select-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .target-select-row label {
      margin: 0;
      font-size: 0.88rem;
    }
    .target-select-row select {
      width: auto;
      min-height: 36px;
      padding: 4px 28px 4px 10px;
      font-size: 0.88rem;
    }
    .target-goal-box p {
      margin: 0 0 12px;
      font-size: 0.9rem;
      line-height: 1.5;
