    }
    .message.error {
      border: 1px solid #b94a48;
      background: rgba(185, 74, 72, 0.12);
    }
    .message.warning {
      border: 1px solid #b8860b;
      background: rgba(184, 134, 11, 0.12);
    }

    .calculator-note {
      margin: 16px 0 0;
      color: var(--text-muted);
      font-size: 0.78rem;
      line-height: 1.6;
    }

    .content-section { margin-top: 42px; }
    .content-section h2 {
      margin: 0 0 14px;
      font-size: 1.45rem;
      line-height: 1.25;
    }
    .content-section h3 { margin-top: 24px; }
    .content-section p,
    .content-section li {
      color: var(--text);
      line-height: 1.72;
    }
    .content-section p { margin: 0 0 15px; }
    .content-section ol,
    .content-section ul { padding-left: 22px; }
    .content-section a { color: var(--accent); font-weight: 650; }
    .content-section code {
      display: inline-block;
      padding: 2px 5px;
      border-radius: 4px;
      background: var(--surface-2);
      font-size: 0.86em;
      color: var(--accent);
    }

    .callout,
    .formula-box {
      margin: 18px 0;
      padding: 16px;
      background: var(--surface-2);
      border-left: 3px solid var(--accent);
      border-radius: 8px;
      line-height: 1.6;
    }

    .comparison-table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 620px; }
    caption {
      margin-bottom: 8px;
      font-size: 0.82rem;
      color: var(--text-muted);
      text-align: left;
    }
    th,
    td {
      padding: 12px;
      border: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
      line-height: 1.5;
    }
    th { background: var(--surface-2); font-size: 0.88rem; }
    td { font-size: 0.88rem; }

    .faq-list { display: grid; gap: 10px; }
    .faq-list details {
      padding: 14px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .faq-list summary {
      cursor: pointer;
      font-weight: 700;
      line-height: 1.5;
    }
    .faq-list p { margin: 10px 0 0; color: var(--text-muted); }

    .sources li { margin-bottom: 8px; }

    @media (max-width: 680px) {
      .calculator-card { padding: 17px; }
      .form-grid,
      .result-grid { grid-template-columns: 1fr 1fr; }
      .field.full { grid-column: 1 / -1; }
    }

    @media (max-width: 460px) {
      .form-grid,
      .result-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .result-primary { padding: 19px 12px; }
      .target-select-row { flex-direction: column; align-items: flex-start; gap: 4px; }
    }
  </style>

  <script>
    // ---------- Element refs ----------
    const heightEl = document.querySelector("#height") as HTMLInputElement;
    const neckEl = document.querySelector("#neck") as HTMLInputElement;
    const waistEl = document.querySelector("#waist") as HTMLInputElement;
    const hipEl = document.querySelector("#hip") as HTMLInputElement;
    const weightEl = document.querySelector("#weight") as HTMLInputElement;
    const ageEl = document.querySelector("#age") as HTMLInputElement;

    const heightLabel = document.querySelector("#height-label")!;
    const neckLabel = document.querySelector("#neck-label")!;
    const waistLabel = document.querySelector("#waist-label")!;
    const hipLabel = document.querySelector("#hip-label")!;
    const weightLabel = document.querySelector("#weight-label")!;
    const heightUnitSpan = document.querySelector("#height-unit-span")!;
    const neckUnitSpan = document.querySelector("#neck-unit-span")!;
    const waistUnitSpan = document.querySelector("#waist-unit-span")!;
    const hipUnitSpan = document.querySelector("#hip-unit-span")!;
    const weightUnitSpan = document.querySelector("#weight-unit-span")!;

    const neckField = document.querySelector("#neck-field") as HTMLElement;
    const waistField = document.querySelector("#waist-field") as HTMLElement;
    const hipField = document.querySelector("#hip-field") as HTMLElement;
    const ageField = document.querySelector("#age-field") as HTMLElement;

    const errorEl = document.querySelector("#error")!;
    const warningEl = document.querySelector("#warning")!;
    const resultBfEl = document.querySelector("#result-bf")!;
    const resultCategoryEl = document.querySelector("#result-category")!;
    const massGrid = document.querySelector("#mass-grid") as HTMLElement;
    const fatMassEl = document.querySelector("#fat-mass")!;
    const leanMassEl = document.querySelector("#lean-mass")!;
    const fatMassUnitEl = document.querySelector("#fat-mass-unit")!;
    const leanMassUnitEl = document.querySelector("#lean-mass-unit")!;
    const resultAnnouncement = document.querySelector("#result-announcement")!;
    const resultNoteEl = document.querySelector("#result-note")!;

    const targetGoalBox = document.querySelector("#target-goal-box") as HTMLElement;
    const targetGoalText = document.querySelector("#target-goal-text")!;
    const targetBfSelect = document.querySelector("#target-bf-select") as HTMLSelectElement;

    // ---------- State ----------
    type UnitSystem = "imperial" | "metric";
    type Sex = "male" | "female";
    type Method = "navy" | "bmi";

    let unitSystem: UnitSystem = "imperial";
    let sex: Sex = "male";
    let method: Method = "navy";

    // Preserved canonical values (always stored in inches / lb)
    let preservedHeightIn: number | null = null;
    let preservedNeckIn: number | null = null;
    let preservedWaistIn: number | null = null;
    let preservedHipIn: number | null = null;
    let preservedWeightLb: number | null = null;

    let showErrors = false;
    let calculateTimeout: number | null = null;
    const DEBOUNCE_MS = 300;

    const IN_TO_CM = 2.54;
    const LB_TO_KG = 0.45359237;
    const OPTIONAL_WEIGHT_MIN_LB = 66;
    const OPTIONAL_WEIGHT_MAX_LB = 660;

    const toInches = (v: number, u: UnitSystem) => (u === "metric" ? v / IN_TO_CM : v);
    const fromInches = (v: number, u: UnitSystem) => (u === "metric" ? v * IN_TO_CM : v);
    const toLb = (v: number, u: UnitSystem) => (u === "metric" ? v / LB_TO_KG : v);
    const fromLb = (v: number, u: UnitSystem) => (u === "metric" ? v * LB_TO_KG : v);

    // ---------- Helpers ----------
    const round1 = (v: number) => Math.round(v * 10) / 10;
    const hasScientificNotation = (input: HTMLInputElement) =>
      input.value.trim().toLowerCase().includes("e");

    function hideResults() {
      resultBfEl.textContent = "—";
      resultCategoryEl.textContent = "";
      fatMassEl.textContent = "—";
      leanMassEl.textContent = "—";
      massGrid.hidden = true;
      targetGoalBox.hidden = true;
    }

    function setError(msg: string) {
      errorEl.textContent = msg;
      errorEl.removeAttribute("hidden");
      hideResults();
      warningEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function silentFail() {
      hideResults();
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function fail(msg: string) {
      if (showErrors) setError(msg);
      else silentFail();
    }

    function clearMessages() {
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
    }

    function resetResult() {
      hideResults();
      clearMessages();
    }

    // ---------- Debounce helpers ----------
    function cancelScheduledCalculate() {
      if (calculateTimeout !== null) {
        clearTimeout(calculateTimeout);
        calculateTimeout = null;
      }
    }

    function scheduleCalculate() {
      cancelScheduledCalculate();
      calculateTimeout = window.setTimeout(() => {
        calculateTimeout = null;
        if (areRequiredFieldsFilled()) calculate();
      }, DEBOUNCE_MS);
    }

    function immediateCalculate() {
      cancelScheduledCalculate();
      if (areRequiredFieldsFilled()) calculate();
    }

    function forceCalculate() {
      cancelScheduledCalculate();
      calculate();
    }

    function areRequiredFieldsFilled(): boolean {
      if (method === "navy") {
        if (
          heightEl.value.trim() === "" ||
          neckEl.value.trim() === "" ||
          waistEl.value.trim() === ""
        ) return false;
        if (sex === "female" && hipEl.value.trim() === "") return false;
        return true;
      } else {
        if (
          heightEl.value.trim() === "" ||
          weightEl.value.trim() === "" ||
          ageEl.value.trim() === ""
        ) return false;
        return true;
      }
    }

    // ---------- Preserved-value sync ----------
    function syncPreservedNavy() {
      const read = (el: HTMLInputElement): number | null => {
        const raw = el.value.trim();
        if (raw === "") return null;
        if (raw.toLowerCase().includes("e")) return null;
        const v = Number(raw);
        if (!Number.isFinite(v) || v <= 0) return null;
        return toInches(v, unitSystem);
      };

      preservedHeightIn = read(heightEl);
      preservedNeckIn = read(neckEl);
      preservedWaistIn = read(waistEl);
      preservedHipIn = read(hipEl);
    }

    function syncPreservedWeight() {
      const raw = weightEl.value.trim();
      if (raw === "") {
        preservedWeightLb = null;
        return;
      }
      if (raw.toLowerCase().includes("e")) {
        preservedWeightLb = null;
        return;
      }
      const v = Number(raw);
      if (!Number.isFinite(v) || v <= 0) {
        preservedWeightLb = null;
        return;
      }
      preservedWeightLb = toLb(v, unitSystem);
    }

    // ---------- Unit system toggle ----------
    function setUnitSystem(next: UnitSystem) {
      if (next === unitSystem) return;

      // Sync BEFORE conversion to capture exact current precision
      syncPreservedNavy();
      syncPreservedWeight();

      const convertField = (el: HTMLInputElement, preserved: number | null) => {
        if (preserved === null || preserved <= 0) {
          el.value = "";
          return;
        }
        el.value = fromInches(preserved, next).toFixed(1);
      };

      convertField(heightEl, preservedHeightIn);
      convertField(neckEl, preservedNeckIn);
      convertField(waistEl, preservedWaistIn);
      convertField(hipEl, preservedHipIn);

      if (preservedWeightLb !== null && preservedWeightLb > 0) {
        weightEl.value = fromLb(preservedWeightLb, next).toFixed(1);
      } else {
        if (weightEl.value.trim() !== "") weightEl.value = "";
      }

      unitSystem = next;

      document.querySelectorAll("[data-unit]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.unit === next);
      });

      updateLabels();
      updateInputRanges();
      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // ---------- Sex toggle ----------
    function setSex(next: Sex) {
      if (next === sex) return;
      sex = next;

      document.querySelectorAll("[data-sex]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.sex === next);
      });

      if (method === "navy") {
        hipField.hidden = next !== "female";
      }
      
      updateTargetOptions();

      updateLabels();
      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // ---------- Method toggle ----------
    function setMethod(next: Method) {
      if (next === method) return;
      method = next;

      document.querySelectorAll("[data-method]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.method === next);
      });

      const isNavy = next === "navy";
      neckField.hidden = !isNavy;
      waistField.hidden = !isNavy;
      hipField.hidden = !isNavy || sex !== "female";
      ageField.hidden = isNavy;

      updateLabels();
      updateInputRanges();
      showErrors = false;
      resetResult();
      immediateCalculate();
    }

    // ---------- Dynamic Target Options ----------
    function updateTargetOptions() {
      const isMale = sex === "male";
      
      // Safety: Removed extreme low targets (6% for men, 14% for women)
      const options = isMale
        ? [
            { v: 8, t: "8% (Competition)" },
            { v: 10, t: "10% (Very Lean)" },
            { v: 12, t: "12% (Athletic)" },
            { v: 15, t: "15% (Fit)" },
            { v: 18, t: "18% (Average)" },
            { v: 20, t: "20% (Maintenance)" }
          ]
        : [
            { v: 16, t: "16% (Competition)" },
            { v: 18, t: "18% (Very Lean)" },
            { v: 20, t: "20% (Athletic)" },
            { v: 22, t: "22% (Fit)" },
            { v: 25, t: "25% (Average)" },
            { v: 28, t: "28% (Maintenance)" }
          ];

      targetBfSelect.innerHTML = options
        .map(opt => `<option value="${opt.v}">${opt.t}</option>`)
        .join("");

      // Default selection
      targetBfSelect.value = isMale ? "12" : "20";
    }

    // ---------- Labels ----------
    function updateLabels() {
      const u = unitSystem === "imperial" ? "in" : "cm";
      const wUnit = unitSystem === "imperial" ? "lb" : "kg";

      heightLabel.textContent = `Height (${u})`;
      neckLabel.textContent = `Neck (${u}, below larynx)`;
      waistLabel.textContent =
        sex === "male"
          ? `Waist (${u}, at navel)`
          : `Waist (${u}, narrowest point)`;
      hipLabel.textContent = `Hip (${u}, widest point)`;

      if (method === "navy") {
        weightLabel.textContent = `Weight (${wUnit}, optional)`;
      } else {
        weightLabel.textContent = `Weight (${wUnit})`;
      }

      heightUnitSpan.textContent = u;
      neckUnitSpan.textContent = u;
      waistUnitSpan.textContent = u;
      hipUnitSpan.textContent = u;
      weightUnitSpan.textContent = wUnit;

      heightEl.placeholder = unitSystem === "imperial" ? "e.g. 70" : "e.g. 178";
      neckEl.placeholder = unitSystem === "imperial" ? "e.g. 15" : "e.g. 38";
      waistEl.placeholder = unitSystem === "imperial" ? "e.g. 34" : "e.g. 86";
      hipEl.placeholder = unitSystem === "imperial" ? "e.g. 38" : "e.g. 97";
      weightEl.placeholder = unitSystem === "imperial" ? "e.g. 160" : "e.g. 73";
    }

    // ---------- Input ranges per unit system ----------
    function updateInputRanges() {
      if (unitSystem === "imperial") {
        heightEl.min = "48";
        heightEl.max = "96";
        neckEl.min = "8";
        neckEl.max = "30";
        waistEl.min = "15";
        waistEl.max = "80";
        hipEl.min = "20";
        hipEl.max = "90";
        weightEl.min = "66";
        weightEl.max = "660";
      } else {
        heightEl.min = "122";
        heightEl.max = "244";
        neckEl.min = "20";
        neckEl.max = "76";
        waistEl.min = "38";
        waistEl.max = "203";
        hipEl.min = "51";
        hipEl.max = "229";
        weightEl.min = "30";
        weightEl.max = "299";
      }
    }

    // ---------- Category classification ----------
    function getCategory(bf: number, s: Sex): string {
      if (s === "male") {
        if (bf < 6) return "Essential fat range";
        if (bf < 14) return "Athlete range";
        if (bf < 18) return "Fitness range";
        if (bf < 25) return "Typical non-athlete range";
        return "Obese range";
      } else {
        if (bf < 14) return "Essential fat range";
        if (bf < 21) return "Athlete range";
        if (bf < 25) return "Fitness range";
        if (bf < 32) return "Typical non-athlete range";
        return "Obese range";
      }
    }

    function isOptionalWeightValid(): boolean {
      if (preservedWeightLb === null) return false;
      return (
        preservedWeightLb >= OPTIONAL_WEIGHT_MIN_LB &&
        preservedWeightLb <= OPTIONAL_WEIGHT_MAX_LB
      );
    }

    // ---------- Calculate ----------
    function calculate() {
      clearMessages();

      const relevantInputs: HTMLInputElement[] = method === "navy"
        ? [heightEl, neckEl, waistEl, ...(sex === "female" ? [hipEl] : [])]
        : [heightEl, weightEl, ageEl];

      if (method === "navy" && weightEl.value.trim() !== "") {
        relevantInputs.push(weightEl);
      }

      if (relevantInputs.some(hasScientificNotation)) {
        fail("Please enter numbers without scientific notation.");
        return;
      }

      if (method === "navy") {
        if (
          heightEl.value.trim() === "" ||
          neckEl.value.trim() === "" ||
          waistEl.value.trim() === "" ||
          (sex === "female" && hipEl.value.trim() === "")
        ) {
          fail("Please fill in height, neck, waist" + (sex === "female" ? ", and hip." : "."));
          return;
        }

        if (
          preservedHeightIn === null ||
          preservedNeckIn === null ||
          preservedWaistIn === null ||
          (sex === "female" && preservedHipIn === null)
        ) {
          fail("Please enter valid measurements.");
          return;
        }

        const h = preservedHeightIn;
        const n = preservedNeckIn;
        const w = preservedWaistIn;
        const hp = preservedHipIn ?? 0;

        if (h < 48 || h > 96) {
          fail("Height is outside the calculator's expected adult range (4 ft – 8 ft / 122–244 cm).");
          return;
        }
        if (n < 8 || n > 30) {
          fail("Neck measurement is outside the expected adult range.");
          return;
        }
        if (w < 15 || w > 80) {
          fail("Waist measurement is outside the expected adult range.");
          return;
        }
        if (sex === "female" && (hp < 20 || hp > 90)) {
          fail("Hip measurement is outside the expected adult range.");
          return;
        }

        let bf: number;
        if (sex === "male") {
          const circ = w - n;
          if (circ <= 0) {
            fail("Waist must be greater than neck measurement.");
            return;
          }
          bf = 86.01 * Math.log10(circ) - 70.041 * Math.log10(h) + 36.76;
        } else {
          const circ = w + hp - n;
          if (circ <= 0) {
            fail("Combined waist and hip must exceed neck measurement.");
            return;
          }
          bf = 163.205 * Math.log10(circ) - 97.684 * Math.log10(h) - 78.387;
        }

        if (!Number.isFinite(bf) || bf < 0 || bf > 75) {
          fail("The measurements entered produced an unrealistic result. Please double-check your inputs.");
          return;
        }

        displayResult(bf, sex);
      } else {
        if (
          heightEl.value.trim() === "" ||
          weightEl.value.trim() === "" ||
          ageEl.value.trim() === ""
        ) {
          fail("Please fill in height, weight, and age.");
          return;
        }

        if (preservedHeightIn === null || preservedWeightLb === null) {
          fail("Please enter valid height and weight.");
          return;
        }

        const age = Number(ageEl.value);
        if (!Number.isFinite(age) || !Number.isInteger(age) || age < 18 || age > 90) {
          fail("Enter a whole-number age between 18 and 90.");
          return;
        }

        const hIn = preservedHeightIn;
        const wLb = preservedWeightLb;

        if (hIn < 48 || hIn > 96) {
          fail("Height is outside the calculator's expected adult range (4 ft – 8 ft / 122–244 cm).");
          return;
        }
        if (wLb < 66 || wLb > 660) {
          fail("Weight is outside the calculator's expected adult range (66–660 lb / 30–299 kg).");
          return;
        }

        // Exact metric conversion for BMI to avoid the 703 approximation
        const heightM = hIn * 0.0254;
        const weightKg = wLb * LB_TO_KG;
        const bmi = weightKg / (heightM * heightM);
        
        const sexFactor = sex === "male" ? 1 : 0;
        const bf = 1.2 * bmi + 0.23 * age - 10.8 * sexFactor - 5.4;

        if (!Number.isFinite(bf) || bf < 0 || bf > 75) {
          fail("The values entered produced an unrealistic result.");
          return;
        }

        displayResult(bf, sex);
      }
    }

    function displayResult(bf: number, s: Sex) {
      const rounded = round1(bf);
      resultBfEl.textContent = `${rounded}%`;
      resultCategoryEl.textContent = getCategory(bf, s);

      if (method === "navy") {
        resultNoteEl.textContent = "This is a circumference-based estimate, not a direct measurement of body fat. Individual accuracy varies.";
      } else {
        resultNoteEl.textContent = "This is a BMI-based estimate, which does not distinguish muscle from fat. It may be less accurate for athletes.";
      }

      const weightUsable = isOptionalWeightValid();

      if (weightUsable && preservedWeightLb !== null) {
        const fatLb = (bf / 100) * preservedWeightLb;
        const leanLb = preservedWeightLb - fatLb;

        const fatDisplay = unitSystem === "imperial" ? fatLb : fatLb * LB_TO_KG;
        const leanDisplay = unitSystem === "imperial" ? leanLb : leanLb * LB_TO_KG;
        const wUnit = unitSystem === "imperial" ? "lb" : "kg";

        fatMassEl.textContent = round1(fatDisplay).toFixed(1);
        leanMassEl.textContent = round1(leanDisplay).toFixed(1);
        fatMassUnitEl.textContent = wUnit;
        leanMassUnitEl.textContent = wUnit;
        massGrid.hidden = false;

        const targetBf = Number(targetBfSelect.value);
        
        if (bf > targetBf) {
          const leanMassRaw = preservedWeightLb * (1 - bf / 100);
          const targetWeightLb = leanMassRaw / (1 - targetBf / 100);
          const fatToLoseLb = preservedWeightLb - targetWeightLb;

          const fatToLoseDisplay = unitSystem === "imperial" ? fatToLoseLb : fatToLoseLb * LB_TO_KG;
          
          targetGoalText.innerHTML = `To reach <strong>${targetBf}% body fat</strong>, the estimated fat loss would be approximately <strong>${round1(fatToLoseDisplay).toFixed(1)} ${wUnit}</strong>.`;
          targetGoalBox.hidden = false;
        } else {
          targetGoalText.innerHTML = `You are already at or below your <strong>${targetBf}%</strong> target.`;
          targetGoalBox.hidden = false;
        }
      } else {
        fatMassEl.textContent = "—";
        leanMassEl.textContent = "—";
        massGrid.hidden = true;
        targetGoalBox.hidden = true;
      }

      if (bf < (s === "male" ? 5 : 13)) {
        warningEl.textContent =
          "Your estimate is in or below the essential fat range. Very low body fat can carry health risks. This is not a recommended target without professional guidance.";
        warningEl.removeAttribute("hidden");
      } else if (bf >= (s === "male" ? 25 : 32)) {
        warningEl.textContent =
          "Your estimate falls in the obese range. Body fat percentage is an estimate, but if the result is consistent across methods, consider discussing health risks with a qualified professional.";
        warningEl.removeAttribute("hidden");
      }

      // FIX: Include the target goal text in the screen reader announcement
      if (resultAnnouncement) {
        const massLine =
          weightUsable
            ? ` Fat mass: ${fatMassEl.textContent} ${fatMassUnitEl.textContent}. Lean mass: ${leanMassEl.textContent} ${leanMassUnitEl.textContent}.`
            : "";
        
        const targetLine = !targetGoalBox.hidden ? ` ${targetGoalText.textContent}` : "";

        resultAnnouncement.textContent =
          `Estimated body fat: ${rounded} percent. Category: ${getCategory(bf, s)}.${massLine}${targetLine}`;
      }
    }

    // ---------- Event wiring ----------
    document.querySelectorAll<HTMLButtonElement>("[data-unit]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setUnitSystem(btn.dataset.unit as UnitSystem)
      );
    });

    document.querySelectorAll<HTMLButtonElement>("[data-sex]").forEach((btn) => {
      btn.addEventListener("click", () => setSex(btn.dataset.sex as Sex));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-method]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setMethod(btn.dataset.method as Method)
      );
    });

    targetBfSelect.addEventListener("change", () => {
      resetResult();
      immediateCalculate();
    });

    [heightEl, neckEl, waistEl, hipEl].forEach((el) => {
      el.addEventListener("input", () => {
        syncPreservedNavy();
        showErrors = false;
        resetResult();
        scheduleCalculate();
      });
      el.addEventListener("blur", () => {
        syncPreservedNavy();
        showErrors = true;
        forceCalculate();
      });
    });

    weightEl.addEventListener("input", () => {
      syncPreservedWeight();
      showErrors = false;
      resetResult();
      scheduleCalculate();
    });
    weightEl.addEventListener("blur", () => {
      syncPreservedWeight();
      showErrors = true;
      forceCalculate();
    });

    ageEl.addEventListener("input", () => {
      showErrors = false;
      resetResult();
      scheduleCalculate();
    });
    ageEl.addEventListener("blur", () => {
      showErrors = true;
      forceCalculate();
    });

    document.querySelectorAll<HTMLInputElement>("input").forEach((el) => {
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          showErrors = true;
          if (method === "navy") syncPreservedNavy();
          syncPreservedWeight();
          forceCalculate();
        }
      });
    });

    // ---------- Init ----------
    updateLabels();
    updateInputRanges();
    updateTargetOptions(); // Populate dropdown & set default based on sex
    syncPreservedNavy();
    syncPreservedWeight();
  </script>
</Base>
