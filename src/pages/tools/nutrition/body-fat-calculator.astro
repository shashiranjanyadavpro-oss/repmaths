  <script>
    // ---------- Element refs ----------
    const heightEl = document.querySelector("#height") as HTMLInputElement;
    const neckEl = document.querySelector("#neck") as HTMLInputElement;
    const waistEl = document.querySelector("#waist") as HTMLInputElement;
    const hipEl = document.querySelector("#hip") as HTMLInputElement;
    const weightEl = document.querySelector("#weight") as HTMLInputElement;
    const ageEl = document.querySelector("#age") as HTMLInputElement;

    const heightLabel = document.querySelector("#height-label")!;
    const neckLabel = document.querySelector("#neck-label")!;
    const waistLabel = document.querySelector("#waist-label")!;
    const hipLabel = document.querySelector("#hip-label")!;
    const weightLabel = document.querySelector("#weight-label")!;
    const heightUnitSpan = document.querySelector("#height-unit-span")!;
    const neckUnitSpan = document.querySelector("#neck-unit-span")!;
    const waistUnitSpan = document.querySelector("#waist-unit-span")!;
    const hipUnitSpan = document.querySelector("#hip-unit-span")!;
    const weightUnitSpan = document.querySelector("#weight-unit-span")!;

    const neckField = document.querySelector("#neck-field") as HTMLElement;
    const waistField = document.querySelector("#waist-field") as HTMLElement;
    const hipField = document.querySelector("#hip-field") as HTMLElement;
    const ageField = document.querySelector("#age-field") as HTMLElement;

    const errorEl = document.querySelector("#error")!;
    const warningEl = document.querySelector("#warning")!;
    const resultBfEl = document.querySelector("#result-bf")!;
    const resultCategoryEl = document.querySelector("#result-category")!;
    const massGrid = document.querySelector("#mass-grid") as HTMLElement;
    const fatMassEl = document.querySelector("#fat-mass")!;
    const leanMassEl = document.querySelector("#lean-mass")!;
    const fatMassUnitEl = document.querySelector("#fat-mass-unit")!;
    const leanMassUnitEl = document.querySelector("#lean-mass-unit")!;
    const resultAnnouncement = document.querySelector("#result-announcement")!;

    // ---------- State ----------
    type UnitSystem = "imperial" | "metric";
    type Sex = "male" | "female";
    type Method = "navy" | "bmi";

    let unitSystem: UnitSystem = "imperial";
    let sex: Sex = "male";
    let method: Method = "navy";

    // Preserved canonical values (always stored in inches / lb)
    let preservedHeightIn: number | null = null;
    let preservedNeckIn: number | null = null;
    let preservedWaistIn: number | null = null;
    let preservedHipIn: number | null = null;
    let preservedWeightLb: number | null = null;

    const IN_TO_CM = 2.54;
    const LB_TO_KG = 0.45359237;

    const toInches = (v: number, u: UnitSystem) => (u === "metric" ? v / IN_TO_CM : v);
    const fromInches = (v: number, u: UnitSystem) => (u === "metric" ? v * IN_TO_CM : v);
    const toLb = (v: number, u: UnitSystem) => (u === "metric" ? v / LB_TO_KG : v);
    const fromLb = (v: number, u: UnitSystem) => (u === "metric" ? v * LB_TO_KG : v);

    // ---------- Helpers ----------
    const round1 = (v: number) => Math.round(v * 10) / 10;
    const hasScientificNotation = (input: HTMLInputElement) =>
      input.value.trim().toLowerCase().includes("e");

    function hideResults() {
      resultBfEl.textContent = "—";
      resultCategoryEl.textContent = "";
      fatMassEl.textContent = "—";
      leanMassEl.textContent = "—";
      massGrid.hidden = true;
    }

    function setError(msg: string) {
      errorEl.textContent = msg;
      errorEl.removeAttribute("hidden");
      hideResults();
      warningEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function clearMessages() {
      errorEl.setAttribute("hidden", "");
      warningEl.setAttribute("hidden", "");
    }

    function resetResult() {
      hideResults();
      clearMessages();
    }

    // ---------- Preserved-value sync ----------
    function syncPreservedNavy() {
      const read = (el: HTMLInputElement): number | null => {
        const raw = el.value.trim();
        if (raw === "") return null;
        const v = Number(raw);
        if (!Number.isFinite(v) || v <= 0) return null;
        return toInches(v, unitSystem);
      };

      preservedHeightIn = read(heightEl);
      preservedNeckIn = read(neckEl);
      preservedWaistIn = read(waistEl);
      preservedHipIn = read(hipEl);
    }

    function syncPreservedWeight() {
      const raw = weightEl.value.trim();
      if (raw === "") {
        preservedWeightLb = null;
        return;
      }
      const v = Number(raw);
      if (!Number.isFinite(v) || v <= 0) {
        preservedWeightLb = null;
        return;
      }
      preservedWeightLb = toLb(v, unitSystem);
    }

    // ---------- Unit system toggle ----------
    function setUnitSystem(next: UnitSystem) {
      if (next === unitSystem) return;

      const convertField = (el: HTMLInputElement, preserved: number | null) => {
        if (preserved === null || preserved <= 0) return;
        el.value = fromInches(preserved, next).toFixed(1);
      };

      convertField(heightEl, preservedHeightIn);
      convertField(neckEl, preservedNeckIn);
      convertField(waistEl, preservedWaistIn);
      convertField(hipEl, preservedHipIn);

      if (preservedWeightLb !== null && preservedWeightLb > 0) {
        weightEl.value = fromLb(preservedWeightLb, next).toFixed(1);
      }

      unitSystem = next;

      document.querySelectorAll("[data-unit]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.unit === next);
      });

      updateLabels();
      updateInputRanges();
      resetResult();
      calculate();
    }

    // ---------- Sex toggle ----------
    function setSex(next: Sex) {
      if (next === sex) return;
      sex = next;

      document.querySelectorAll("[data-sex]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.sex === next);
      });

      if (method === "navy") {
        hipField.hidden = next !== "female";
      }

      updateLabels();
      resetResult();
      calculate();
    }

    // ---------- Method toggle ----------
    function setMethod(next: Method) {
      if (next === method) return;
      method = next;

      document.querySelectorAll("[data-method]").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.method === next);
      });

      const isNavy = next === "navy";
      neckField.hidden = !isNavy;
      waistField.hidden = !isNavy;
      hipField.hidden = !isNavy || sex !== "female";
      ageField.hidden = isNavy;

      updateLabels();
      updateInputRanges();
      resetResult();
      calculate();
    }

    // ---------- Labels ----------
    function updateLabels() {
      const u = unitSystem === "imperial" ? "in" : "cm";
      const wUnit = unitSystem === "imperial" ? "lb" : "kg";

      heightLabel.textContent = `Height (${u})`;
      neckLabel.textContent = `Neck (${u}, below larynx)`;
      waistLabel.textContent =
        sex === "male"
          ? `Waist (${u}, at navel)`
          : `Waist (${u}, narrowest point)`;
      hipLabel.textContent = `Hip (${u}, widest point)`;

      if (method === "navy") {
        weightLabel.textContent = `Weight (${wUnit}, optional)`;
      } else {
        weightLabel.textContent = `Weight (${wUnit})`;
      }

      heightUnitSpan.textContent = u;
      neckUnitSpan.textContent = u;
      waistUnitSpan.textContent = u;
      hipUnitSpan.textContent = u;
      weightUnitSpan.textContent = wUnit;

      heightEl.placeholder = unitSystem === "imperial" ? "e.g. 70" : "e.g. 178";
      neckEl.placeholder = unitSystem === "imperial" ? "e.g. 15" : "e.g. 38";
      waistEl.placeholder = unitSystem === "imperial" ? "e.g. 34" : "e.g. 86";
      hipEl.placeholder = unitSystem === "imperial" ? "e.g. 38" : "e.g. 97";
      weightEl.placeholder = unitSystem === "imperial" ? "e.g. 160" : "e.g. 73";
    }

    // ---------- Input ranges per unit system ----------
    function updateInputRanges() {
      if (unitSystem === "imperial") {
        heightEl.min = "48";
        heightEl.max = "96";
        neckEl.min = "8";
        neckEl.max = "30";
        waistEl.min = "15";
        waistEl.max = "80";
        hipEl.min = "20";
        hipEl.max = "90";
        weightEl.min = "66";
        weightEl.max = "660";
      } else {
        heightEl.min = "122";
        heightEl.max = "244";
        neckEl.min = "20";
        neckEl.max = "76";
        waistEl.min = "38";
        waistEl.max = "203";
        hipEl.min = "51";
        hipEl.max = "229";
        weightEl.min = "30";
        weightEl.max = "300";
      }
    }

    // ---------- Category classification ----------
    function getCategory(bf: number, s: Sex): string {
      if (s === "male") {
        if (bf < 6) return "Essential fat range";
        if (bf < 14) return "Athlete range";
        if (bf < 18) return "Fitness range";
        if (bf < 25) return "Typical non-athlete range";
        return "Obese range";
      } else {
        if (bf < 14) return "Essential fat range";
        if (bf < 21) return "Athlete range";
        if (bf < 25) return "Fitness range";
        if (bf < 32) return "Typical non-athlete range";
        return "Obese range";
      }
    }

    // ---------- Calculate ----------
    function calculate() {
      clearMessages();

      const visibleNumericInputs = [heightEl, neckEl, waistEl, hipEl, weightEl, ageEl];
      if (visibleNumericInputs.some(hasScientificNotation)) {
        setError("Please enter numbers without scientific notation.");
        return;
      }

      if (method === "navy") {
        if (
          heightEl.value.trim() === "" ||
          neckEl.value.trim() === "" ||
          waistEl.value.trim() === "" ||
          (sex === "female" && hipEl.value.trim() === "")
        ) {
          setError("Please fill in height, neck, waist" +
            (sex === "female" ? ", and hip." : "."));
          return;
        }

        syncPreservedNavy();
        syncPreservedWeight();

        if (
          preservedHeightIn === null ||
          preservedNeckIn === null ||
          preservedWaistIn === null ||
          (sex === "female" && preservedHipIn === null)
        ) {
          setError("Please enter valid measurements.");
          return;
        }

        const h = preservedHeightIn;
        const n = preservedNeckIn;
        const w = preservedWaistIn;
        const hp = preservedHipIn ?? 0;

        if (h < 48 || h > 96) {
          setError("Height is outside the calculator's expected adult range (4 ft – 8 ft / 122–244 cm).");
          return;
        }
        if (n < 8 || n > 30) {
          setError("Neck measurement is outside the expected adult range.");
          return;
        }
        if (w < 15 || w > 80) {
          setError("Waist measurement is outside the expected adult range.");
          return;
        }
        if (sex === "female" && (hp < 20 || hp > 90)) {
          setError("Hip measurement is outside the expected adult range.");
          return;
        }

        let bf: number;
        if (sex === "male") {
          const circ = w - n;
          if (circ <= 0) {
            setError("Waist must be greater than neck measurement.");
            return;
          }
          bf = 86.01 * Math.log10(circ) - 70.041 * Math.log10(h) + 36.76;
        } else {
          const circ = w + hp - n;
          if (circ <= 0) {
            setError("Combined waist and hip must exceed neck measurement.");
            return;
          }
          bf = 163.205 * Math.log10(circ) - 97.684 * Math.log10(h) - 78.387;
        }

        if (!Number.isFinite(bf) || bf < 0 || bf > 75) {
          setError(
            "The measurements entered produced an unrealistic result. Please double-check your inputs."
          );
          return;
        }

        displayResult(bf, sex);
      } else {
        if (
          heightEl.value.trim() === "" ||
          weightEl.value.trim() === "" ||
          ageEl.value.trim() === ""
        ) {
          setError("Please fill in height, weight, and age.");
          return;
        }

        syncPreservedNavy();
        syncPreservedWeight();

        if (preservedHeightIn === null || preservedWeightLb === null) {
          setError("Please enter valid height and weight.");
          return;
        }

        const age = Number(ageEl.value);
        if (!Number.isFinite(age) || !Number.isInteger(age) || age < 18 || age > 90) {
          setError("Enter a whole-number age between 18 and 90.");
          return;
        }

        const hIn = preservedHeightIn;
        const wLb = preservedWeightLb;

        if (hIn < 48 || hIn > 96) {
          setError("Height is outside the calculator's expected adult range (4 ft – 8 ft / 122–244 cm).");
          return;
        }
        if (wLb < 66 || wLb > 660) {
          setError("Weight is outside the calculator's expected adult range (66–660 lb / 30–300 kg).");
          return;
        }

        const bmi = (703 * wLb) / (hIn * hIn);
        const sexFactor = sex === "male" ? 1 : 0;
        const bf = 1.2 * bmi + 0.23 * age - 10.8 * sexFactor - 5.4;

        if (!Number.isFinite(bf) || bf < 0 || bf > 75) {
          setError("The values entered produced an unrealistic result.");
          return;
        }

        displayResult(bf, sex);
      }
    }

    function displayResult(bf: number, s: Sex) {
      const rounded = round1(bf);
      resultBfEl.textContent = `${rounded}%`;
      resultCategoryEl.textContent = getCategory(rounded, s);

      if (preservedWeightLb !== null && preservedWeightLb > 0) {
        const fatLb = (bf / 100) * preservedWeightLb;
        const leanLb = preservedWeightLb - fatLb;

        const fatDisplay = unitSystem === "imperial"
          ? fatLb
          : fatLb * LB_TO_KG;
        const leanDisplay = unitSystem === "imperial"
          ? leanLb
          : leanLb * LB_TO_KG;
        const wUnit = unitSystem === "imperial" ? "lb" : "kg";

        fatMassEl.textContent = round1(fatDisplay).toFixed(1);
        leanMassEl.textContent = round1(leanDisplay).toFixed(1);
        fatMassUnitEl.textContent = wUnit;
        leanMassUnitEl.textContent = wUnit;
        massGrid.hidden = false;
      } else {
        fatMassEl.textContent = "—";
        leanMassEl.textContent = "—";
        massGrid.hidden = true;
      }

      if (rounded < (s === "male" ? 5 : 13)) {
        warningEl.textContent =
          "Your estimate is in or below the essential fat range. Very low body fat can carry health risks. This is not a recommended target without professional guidance.";
        warningEl.removeAttribute("hidden");
      } else if (rounded >= (s === "male" ? 25 : 32)) {
        warningEl.textContent =
          "Your estimate falls in the obese range. Body fat percentage is an estimate, but if the result is consistent across methods, consider discussing health risks with a qualified professional.";
        warningEl.removeAttribute("hidden");
      }

      if (resultAnnouncement) {
        const massLine =
          preservedWeightLb !== null
            ? ` Fat mass: ${fatMassEl.textContent} ${fatMassUnitEl.textContent}. Lean mass: ${leanMassEl.textContent} ${leanMassUnitEl.textContent}.`
            : "";
        resultAnnouncement.textContent =
          `Estimated body fat: ${rounded} percent. Category: ${getCategory(rounded, s)}.${massLine}`;
      }
    }

    // ---------- Event wiring ----------
    document.querySelectorAll<HTMLButtonElement>("[data-unit]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setUnitSystem(btn.dataset.unit as UnitSystem)
      );
    });

    document.querySelectorAll<HTMLButtonElement>("[data-sex]").forEach((btn) => {
      btn.addEventListener("click", () => setSex(btn.dataset.sex as Sex));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-method]").forEach((btn) => {
      btn.addEventListener("click", () =>
        setMethod(btn.dataset.method as Method)
      );
    });

    [heightEl, neckEl, waistEl, hipEl].forEach((el) => {
      el.addEventListener("input", () => {
        syncPreservedNavy();
        resetResult();
        calculate();
      });
    });

    weightEl.addEventListener("input", () => {
      syncPreservedWeight();
      resetResult();
      calculate();
    });

    ageEl.addEventListener("input", () => {
      resetResult();
      calculate();
    });

    document.querySelectorAll<HTMLInputElement>("input").forEach((el) => {
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          calculate();
        }
      });
    });

    // ---------- Init ----------
    updateLabels();
    updateInputRanges();
    syncPreservedNavy();
    syncPreservedWeight();
    calculate();
  </script>
</Base>
