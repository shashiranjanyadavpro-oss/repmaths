---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'Protein Calculator' },
];

const faqs = [
  {
    question: 'How much protein do I need per day?',
    answer:
      'Your daily protein needs depend on body weight, activity, training and goals. The adult RDA is 0.8 g/kg per day (a reference intake intended to prevent deficiency). For most exercising individuals aiming to build or maintain muscle, sports-nutrition guidance commonly cites 1.4–2.0 g/kg per day. Use the calculator for an individualized starting estimate based on your selected goal.',
  },
  {
    question: 'How do I calculate how much protein I need?',
    answer:
      'Multiply your body weight in kilograms by a protein factor in grams per kilogram. For example, an 80 kg person using the muscle-gain range of 1.4–2.0 g/kg gets approximately 112–160 grams of protein per day. The RepMaths calculator performs this conversion automatically for pounds or kilograms.',
  },
  {
    question: 'How much protein do I need to build muscle?',
    answer:
      'For most healthy exercising adults, approximately 1.4–2.0 grams of protein per kilogram of body weight per day (0.64–0.91 g/lb) is a commonly cited sports-nutrition range. Resistance training, sufficient energy intake and recovery also matter.',
  },
  {
    question: 'How much protein should I eat per pound of body weight?',
    answer:
      'The adult RDA is approximately 0.36 g/lb. For muscle gain or maintenance, a commonly cited sports-nutrition range is approximately 0.64–0.91 g/lb. Your appropriate target depends on activity, energy intake and individual circumstances.',
  },
  {
    question: 'How much protein should I eat for weight loss?',
    answer:
      'Higher protein intake may help support lean-mass retention during a calorie deficit, particularly alongside resistance training. This calculator uses an athlete-oriented cutting range of 1.6–2.4 g/kg of total body weight. Note that some contest-prep research expresses protein targets relative to <strong>fat-free mass</strong> rather than total body weight. It is not a universal requirement or medical prescription.',
  },
  {
    question: 'Is 1 gram of protein per pound necessary for muscle growth?',
    answer:
      'No. One gram per pound is a popular fitness guideline, but most exercising adults do not need to reach that exact amount. Research supports useful muscle-related outcomes across a range of intakes, including approximately 1.4–2.0 g/kg per day.',
  },
  {
    question: 'Can my body absorb more than 30 grams of protein per meal?',
    answer:
      'Yes. The idea that the body cannot absorb more than 30 grams of protein per meal is misleading. Your body can digest and use larger amounts. Total daily intake and a practical distribution across meals are generally more important than a strict 30-gram limit.',
  },
  {
    question: 'How much protein should I eat per meal?',
    answer:
      'Sports-nutrition research often cites a general range of approximately 0.25–0.4 g/kg of body weight per meal, or roughly 20–40 grams of high-quality protein, to support muscle protein synthesis. This is not a strict rule; individual response varies with body size, age, and training status.',
  },
  {
    question: 'Should I calculate protein using total body weight or lean body mass?',
    answer:
      'This calculator uses total body weight. For people with substantially higher body fat, a realistic goal weight or an appropriately assessed lean-body-mass approach may provide a more practical estimate. The higher protein recommendations sometimes used for lean, resistance-trained athletes during cutting may be expressed per kilogram of fat-free mass, not total body weight.',
  },
  {
    question: 'How much protein do I need if I weigh 130 pounds?',
    answer:
      'At 130 lb (approximately 59 kg), the adult RDA (reference intake) is about 47 g/day. The calculator muscle-gain range for exercising adults is approximately 83–118 g/day. Your actual needs depend on your activity, goals and circumstances.',
  },
  {
    question: 'Is whey protein required to reach my daily protein goal?',
    answer:
      'No. You can meet protein requirements through regular foods such as eggs, dairy, fish, meat, soy, beans and lentils. Whey or other protein supplements are optional conveniences rather than requirements. Because some plant proteins have a lower leucine content or different amino acid profiles, plant-based eaters may benefit from targeting the higher end of the protein range or combining different protein sources.',
  },
  {
    question: 'Is high protein intake safe for kidneys?',
    answer:
      'In healthy adults with normal kidney function, higher protein intakes (up to ~2.0–2.2 g/kg/day) have not been consistently linked to kidney harm in research. However, this is not a universal safety guarantee. People with chronic kidney disease or other kidney conditions must follow individualized clinical advice from a healthcare professional, as protein intake may need to be strictly controlled.',
  },
  {
    question: 'What should I calculate after my protein target?',
    answer:
      'Use the <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a> to estimate maintenance calories, the <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> to explore protein, carbohydrate and fat targets, the <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a> for a weight-loss planning estimate, or the <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a> to track body-composition changes.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/protein-calculator/#calculator',
  name: 'RepMaths Protein Calculator',
  alternateName: 'Protein Intake Calculator',
  url: 'https://repmaths.com/tools/nutrition/protein-calculator/',
  description:
    'Free daily protein calculator using body weight in pounds or kilograms and goals including general activity, muscle gain and cutting.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="Protein Calculator — Daily Protein Intake & Muscle Gain"
  description="Free protein calculator: find how much protein you need per day in grams. Calculate protein intake by body weight (lb or kg) for muscle gain, cutting and activity."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <div class="tool-page">
    <header class="tool-header">
      <p class="eyebrow">Nutrition &amp; Body Composition</p>
      <h1>Protein Calculator — Daily Intake for Muscle Gain &amp; Fat Loss</h1>
      <p class="intro">
        Calculate your daily protein intake in grams based on body weight,
        activity level and fitness goal. Supports pounds (lb) and kilograms (kg).
      </p>
    </header>

    <aside class="quick-answer" aria-label="Daily protein quick answer">
      <p>
        <strong>How much protein do you need per day?</strong>
        The adult Recommended Dietary Allowance (RDA) of <strong>0.8 g/kg (0.36 g/lb)</strong> 
        is a reference intake intended to meet the needs of nearly all healthy adults and prevent deficiency. 
        For most exercising adults aiming to build or maintain muscle, commonly cited sports-nutrition
        guidance suggests approximately
        <strong>1.4–2.0 g/kg (0.64–0.91 g/lb)</strong> per day.
        Enter your weight and goal below for a practical starting estimate.
      </p>
    </aside>

    <section class="calculator-card" aria-labelledby="calculator-heading">
      <h2 id="calculator-heading">Calculate Your Daily Protein Needs</h2>

      <div class="form-grid">
        <div class="field full">
          <span class="field-label">Weight unit</span>
          <div class="unit-toggle" role="group" aria-label="Weight unit">
            <button type="button" class="unit-btn active" data-unit="lb" aria-pressed="true">Pounds (lb)</button>
            <button type="button" class="unit-btn" data-unit="kg" aria-pressed="false">Kilograms (kg)</button>
          </div>
        </div>

        <div class="field full" id="weight-field">
          <label for="weight" id="weight-label">Body weight (lb)</label>
          <div class="input-with-unit">
            <input
              type="number"
              id="weight"
              placeholder="e.g. 180"
              inputmode="decimal"
              step="any"
              autocomplete="off"
              aria-describedby="weight-help error"
            />
            <span id="weight-unit-span">lb</span>
          </div>
          <p id="weight-help" class="field-help">
            Enter your body weight in pounds. Designed for healthy adults weighing 25–250 kg (approximately 55–551 lb).
          </p>
        </div>

        <div class="field full">
          <span class="field-label" id="goal-label">Activity level or fitness goal</span>
          <div class="unit-toggle goal-toggle" role="group" aria-labelledby="goal-label">
            <button type="button" class="unit-btn" data-goal="sedentary" aria-pressed="false">Sedentary (RDA)</button>
            <button type="button" class="unit-btn active" data-goal="active" aria-pressed="true">General Activity</button>
            <button type="button" class="unit-btn" data-goal="muscle" aria-pressed="false">Muscle Gain</button>
            <button type="button" class="unit-btn" data-goal="cutting" aria-pressed="false">Cutting / Fat Loss</button>
          </div>
          <p class="field-help">Select the option that best matches your current goal. These are planning estimates.</p>
        </div>
      </div>

      <p id="error" class="message error" role="alert" hidden></p>

      <div id="results" class="results">
        <div
          id="result-announcement"
          class="sr-only"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></div>

        <div class="result-primary">
          <span class="result-label">Estimated Daily Protein Intake</span>
          <strong id="result-protein">—</strong>
          <span class="result-unit">grams / day</span>
        </div>

        <div class="result-grid">
          <div class="result-box">
            <span>Goal</span>
            <strong id="result-goal-text">—</strong>
          </div>
          <div class="result-box">
            <span>Body Weight</span>
            <strong id="result-weight">—</strong>
          </div>
        </div>

        <p id="result-formula" class="calculator-note" style="text-align:center; margin-top: 12px;">
          —
        </p>

        <p class="calculator-note">
          This is a practical starting estimate. Your ideal intake may
          vary with training, body composition, total calorie intake
          and individual health.
        </p>

        <div class="result-actions">
          <a href="/tools/nutrition/tdee-calculator/" class="btn-primary">
            Calculate TDEE
          </a>
          <a href="/tools/nutrition/macro-calculator/" class="btn-secondary">
            Calculate Macros
          </a>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>How Much Protein Do I Need Per Day?</h2>

      <p>
        Your daily protein requirement depends on body weight, activity,
        training status, calorie intake and fitness goals. There is no
        single protein target that is optimal for every person.
      </p>

      <p>
        For generally healthy adults, the standard Recommended Dietary
        Allowance (RDA) is approximately <strong>0.8 grams per kilogram</strong>
        of body weight per day. This is a population-level reference intake 
        intended to prevent deficiency, not necessarily a target for maximizing resistance-training outcomes.
      </p>

      <p>
        The <a href="https://pubmed.ncbi.nlm.nih.gov/28642676/" target="_blank" rel="noopener noreferrer">International Society of Sports Nutrition (ISSN)</a> commonly cites
        <strong>1.4–2.0 g/kg/day</strong> as sufficient for building and
        maintaining muscle mass for most exercising individuals.
      </p>
    </section>

    <section class="content-section">
      <h2>Protein Intake by Goal: Daily Protein Requirements</h2>

      <div class="comparison-table-wrap">
        <table>
          <caption>Protein factors used by the RepMaths calculator</caption>
          <thead>
            <tr>
              <th scope="col">Goal</th>
              <th scope="col">Protein per day</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sedentary (adult RDA reference)</td>
              <td>0.8 g/kg<br />~0.36 g/lb</td>
            </tr>
            <tr>
              <td>General activity</td>
              <td>1.0–1.4 g/kg<br />~0.45–0.64 g/lb</td>
            </tr>
            <tr>
              <td>Muscle gain / maintenance</td>
              <td>1.4–2.0 g/kg<br />~0.64–0.91 g/lb</td>
            </tr>
            <tr>
              <td>Cutting / fat loss</td>
              <td>1.6–2.4 g/kg<br />~0.73–1.09 g/lb</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p>
        The cutting range is athlete-oriented and should not be interpreted as a
        universal requirement for weight loss. For people with substantially higher body fat, 
        a target based on total body weight may be unnecessarily high.
      </p>
    </section>

    <section class="content-section">
      <h2>High-Protein Foods (Reference Table)</h2>

      <p>
        Meeting your daily protein target is easier when you know which foods are most dense in protein. 
        Here are <strong>approximate</strong> protein values per 100g.
      </p>

      <div class="comparison-table-wrap">
        <table>
          <caption>Approximate protein content per 100g of common foods; preparation varies</caption>
          <thead>
            <tr>
              <th scope="col">Food</th>
              <th scope="col">Protein (per 100g)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Chicken Breast (cooked)</td><td>~31g</td></tr>
            <tr><td>Lean Beef (cooked)</td><td>~27g</td></tr>
            <tr><td>Tuna (canned)</td><td>~25g</td></tr>
            <tr><td>Salmon (cooked)</td><td>~23g</td></tr>
            <tr><td>Greek Yogurt</td><td>~10g</td></tr>
            <tr><td>Eggs</td><td>~13g</td></tr>
            <tr><td>Whey Protein Powder</td><td>~75g (brand dependent)</td></tr>
            <tr><td>Tofu (firm)</td><td>~16g</td></tr>
            <tr><td>Lentils (cooked)</td><td>~9g</td></tr>
          </tbody>
        </table>
      </div>
      
      <p class="calculator-note">
        Data is approximate and adapted from general food composition databases such as the 
        <a href="https://fdc.nal.usda.gov/" target="_blank" rel="noopener noreferrer">USDA FoodData Central</a>.
      </p>
    </section>

    <section class="content-section">
      <h2>How Much Protein Do I Need Based on My Weight?</h2>

      <p>
        The following examples use the muscle-gain range of 1.4–2.0 g/kg/day. Values are rounded to the nearest gram.
      </p>

      <div class="comparison-table-wrap">
        <table>
          <caption>Example daily protein targets by body weight</caption>
          <thead>
            <tr>
              <th scope="col">Body weight</th>
              <th scope="col">Protein per day</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>120 lb (54 kg)</td><td>76–109 g</td></tr>
            <tr><td>130 lb (59 kg)</td><td>83–118 g</td></tr>
            <tr><td>150 lb (68 kg)</td><td>95–136 g</td></tr>
            <tr><td>180 lb (82 kg)</td><td>114–163 g</td></tr>
            <tr><td>200 lb (91 kg)</td><td>127–181 g</td></tr>
            <tr><td>220 lb (100 kg)</td><td>140–200 g</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>Protein Calculator for Muscle Gain and Muscle Growth</h2>

      <p>
        Protein supplies amino acids used in muscle repair and adaptation.
        For most healthy exercising adults, approximately
        <strong>1.4–2.0 g/kg (0.64–0.91 g/lb)</strong> per day is a
        commonly cited range for building or maintaining muscle.
      </p>

      <p>
        A meta-analysis of resistance-training studies reported that
        additional protein benefits for fat-free-mass gains appeared
        to level off around a modeled intake of 1.62 g/kg/day, although
        individual responses and uncertainty vary. Protein intake alone does not build muscle. Progressive resistance training, appropriate calorie intake, sleep and recovery also matter.
      </p>
    </section>

    <section class="content-section">
      <h2>The "30 Grams Per Meal" Myth</h2>

      <p>
        The claim that your body can absorb only 20–30 grams of protein
        at one meal is an oversimplification. Digestion and absorption
        do not simply stop once a meal exceeds that amount.
      </p>

      <p>
        Sports-nutrition guidance often discusses approximately
        <strong>0.25–0.4 g/kg of body weight per meal</strong>, or
        roughly <strong>20–40 grams of high-quality protein</strong>,
        as a useful general range for supporting muscle protein
        synthesis. For an 80 kg (176 lb) person, this means aiming for roughly 20–32 grams of protein per meal.
      </p>
    </section>

    <section class="content-section">
      <h2>Is 1 Gram of Protein per Pound Necessary?</h2>

      <p>
        One gram of protein per pound of body weight is a popular
        bodybuilding guideline, but it is not a requirement for
        most healthy exercising adults.
      </p>

      <p>
        One gram per pound equals approximately 2.2 g/kg, which is
        slightly above the ISSN's commonly cited 1.4–2.0 g/kg/day
        range for most exercising individuals. More protein does not automatically produce more muscle growth.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Use This Protein Calculator</h2>

      <p>
        Getting your protein right is just one part of building your physique. Here is the step-by-step workflow:
      </p>

      <ol>
        <li><strong>Estimate Your Protein:</strong> Use this calculator to estimate your daily protein range based on your body weight and goal (cutting or bulking).</li>
        <li><strong>Estimate Calories:</strong> Use our <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a> to find your daily calorie needs.</li>
        <li><strong>Split Your Macros:</strong> Use our <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> to fill the rest of your calories with carbs and fats.</li>
        <li><strong>Track Your Lifts:</strong> Building muscle requires progressive overload. Use our <a href="/tools/strength/1rm-calculator/">1RM Calculator</a> to track your strength progress.</li>
      </ol>
    </section>

    <section class="content-section sources">
      <h2>Sources &amp; Methodology</h2>

      <ul>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/28642676/" target="_blank" rel="noopener noreferrer">
            Jäger et al. (2017) — International Society of Sports Nutrition Position Stand: Protein and Exercise. <em>J Int Soc Sports Nutr</em>.
          </a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/28698222/" target="_blank" rel="noopener noreferrer">
            Morton et al. (2018) — Protein Supplementation and Resistance-Training Adaptations. <em>Br J Sports Med</em>.
          </a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/24092765/" target="_blank" rel="noopener noreferrer">
            Helms et al. (2014) — Evidence-Based Recommendations for Natural Bodybuilding Contest Preparation. <em>J Int Soc Sports Nutr</em>.
          </a>
        </li>
        <li>
          <a href="https://pubmed.ncbi.nlm.nih.gov/24477298/" target="_blank" rel="noopener noreferrer">
            Mamerow et al. (2014) — Dietary Protein Distribution Positively Influences 24-h Muscle Protein Synthesis. <em>J Nutr</em>.
          </a>
        </li>
        <li>
          <a href="https://fdc.nal.usda.gov/" target="_blank" rel="noopener noreferrer">
            USDA FoodData Central — Food Composition Database
          </a>
        </li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Frequently Asked Questions</h2>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p set:html={faq.answer} />
          </details>
        ))}
      </div>
    </section>

    <RelatedTools currentToolId="protein-calculator" />
  </div>

  <style>
    .tool-page { max-width: 900px; margin: 0 auto; }
    .tool-header { margin-bottom: 28px; }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .tool-header h1 {
      margin: 0 0 16px;
      font-size: clamp(1.8rem, 4vw, 2.55rem);
      line-height: 1.12;
    }

    .intro {
      max-width: 760px;
      margin: 0;
      color: var(--text-muted);
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .quick-answer {
      background: var(--surface);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 16px 18px;
      margin: 0 0 24px;
    }
    .quick-answer p { 
      margin: 0; 
      color: var(--text-muted); 
      font-size: 0.92rem; 
      line-height: 1.6; 
    }
    .quick-answer strong { color: var(--accent); }

    .calculator-card {
      padding: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.14);
    }
    .calculator-card h2 { margin: 0 0 20px; font-size: 1.3rem; }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .field { min-width: 0; }
    .field.full { grid-column: 1 / -1; }

    label,
    .field-label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      min-height: 46px;
      padding: 10px 12px;
      color: var(--text);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      font: inherit;
    }

    input:focus,
    select:focus,
    button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .input-with-unit { display: flex; align-items: center; gap: 8px; }
    .input-with-unit input { flex: 1; min-width: 0; }
    .input-with-unit span {
      flex: 0 0 auto;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .unit-toggle {
      display: inline-flex;
      flex-wrap: wrap;
      margin-bottom: 8px;
      padding: 3px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .unit-btn {
      min-width: 58px;
      padding: 5px 10px;
      border: 0;
      border-radius: 7px;
      color: var(--text-muted);
      background: transparent;
      font: inherit;
      font-size: 0.78rem;
      font-weight: 800;
      cursor: pointer;
    }
    .unit-btn.active {
      color: var(--text);
      background: var(--surface);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
    }

    .hidden { display: none !important; }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .field-help {
      color: var(--text-muted);
      font-size: 0.83rem;
      line-height: 1.5;
      margin: 7px 0 0;
    }

    .goal-toggle {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }

    .goal-toggle button {
      min-width: 0;
      overflow-wrap: anywhere;
      min-height: 44px;
    }

    .results { margin-top: 22px; }

    .result-primary {
      padding: 22px;
      text-align: center;
      background: var(--surface-2);
      border: 1px solid var(--accent);
      border-radius: 14px;
    }

    .result-label {
      display: block;
      margin-bottom: 6px;
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .result-primary strong {
      display: block;
      font-size: clamp(2rem, 7vw, 3rem);
      line-height: 1;
    }

    .result-unit {
      display: block;
      margin-top: 7px;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .result-box {
      padding: 15px 10px;
      text-align: center;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .result-box span,
    .result-box small {
      display: block;
      color: var(--text-muted);
      font-size: 0.76rem;
    }
    .result-box strong { display: block; margin: 5px 0; font-size: 1.18rem; }

    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
    }
    .result-actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
    }
    .result-actions .btn-primary {
      background: var(--accent);
      color: #fff;
    }
    .result-actions .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .message {
      margin-top: 14px;
      padding: 13px 14px;
      border-radius: 10px;
      font-size: 0.88rem;
      line-height: 1.55;
    }
    .message.error {
      border: 1px solid #b94a48;
      background: rgba(185, 74, 72, 0.12);
    }

    .calculator-note {
      margin: 16px 0 0;
      color: var(--text-muted);
      font-size: 0.78rem;
      line-height: 1.6;
    }

    .content-section { margin-top: 42px; }
    .content-section h2 {
      margin: 0 0 14px;
      font-size: 1.45rem;
      line-height: 1.25;
    }
    .content-section h3 { margin-top: 24px; }
    .content-section p,
    .content-section li {
      color: var(--text);
      line-height: 1.72;
    }
    .content-section p { margin: 0 0 15px; }
    .content-section ol,
    .content-section ul { padding-left: 22px; }
    .content-section a { color: var(--accent); font-weight: 650; }

    .comparison-table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 520px; }
    caption {
      margin-bottom: 8px;
      font-size: 0.82rem;
      color: var(--text-muted);
      text-align: left;
    }
    th,
    td {
      padding: 12px;
      border: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
      line-height: 1.5;
    }
    th { background: var(--surface-2); font-size: 0.88rem; }
    td { font-size: 0.88rem; }

    .faq-list { display: grid; gap: 10px; }
    .faq-list details {
      padding: 14px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .faq-list summary {
      cursor: pointer;
      font-weight: 700;
      line-height: 1.5;
    }
    .faq-list p { margin: 10px 0 0; color: var(--text-muted); }

    .sources li { margin-bottom: 8px; }

    @media (max-width: 680px) {
      .calculator-card { padding: 17px; }
      .form-grid,
      .result-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 460px) {
      .form-grid,
      .result-grid,
      .goal-toggle { grid-template-columns: 1fr; }
      .result-primary { padding: 19px 12px; }
    }
  </style>

  <script>
    // ---------- Element refs ----------
    const weightEl = document.querySelector("#weight") as HTMLInputElement;
    const weightLabel = document.querySelector("#weight-label")!;
    const weightUnitSpan = document.querySelector("#weight-unit-span")!;
    const weightHelp = document.querySelector("#weight-help")!;
    const errorEl = document.querySelector("#error")!;
    
    const resultProteinEl = document.querySelector("#result-protein")!;
    const resultGoalTextEl = document.querySelector("#result-goal-text")!;
    const resultWeightEl = document.querySelector("#result-weight")!;
    const resultFormulaEl = document.querySelector("#result-formula")!;
    const resultAnnouncement = document.querySelector("#result-announcement")!;

    // ---------- State ----------
    type WeightUnit = "lb" | "kg";
    type ProteinGoal = "sedentary" | "active" | "muscle" | "cutting";

    let unit: WeightUnit = "lb";
    let goal: ProteinGoal = "active";
    
    let preservedKg: number | null = null;
    let showErrors = false;
    let calculateTimeout: number | null = null;
    const DEBOUNCE_MS = 300;

    const LB_PER_KG = 2.2046226218;
    const MIN_WEIGHT_KG = 25;
    const MAX_WEIGHT_KG = 250;

    const factorRanges: Record<ProteinGoal, [number, number]> = {
      sedentary: [0.8, 0.8],
      active: [1.0, 1.4],
      muscle: [1.4, 2.0],
      cutting: [1.6, 2.4],
    };

    const goalLabels: Record<ProteinGoal, string> = {
      sedentary: 'Sedentary — adult RDA',
      active: 'General activity — practical estimate',
      muscle: 'Muscle gain / maintenance — sports-nutrition range',
      cutting: 'Cutting / fat loss — athlete-oriented estimate',
    };

    // ---------- Helpers ----------
    const round0 = (v: number) => Math.round(v);
    const hasScientificNotation = (input: HTMLInputElement) =>
      input.value.trim().toLowerCase().includes("e");

    function hideResults() {
      resultProteinEl.textContent = "—";
      resultGoalTextEl.textContent = "—";
      resultWeightEl.textContent = "—";
      resultFormulaEl.textContent = "—";
    }

    function setError(msg: string) {
      errorEl.textContent = msg;
      errorEl.removeAttribute("hidden");
      hideResults();
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function silentFail() {
      hideResults();
      errorEl.setAttribute("hidden", "");
      if (resultAnnouncement) resultAnnouncement.textContent = "";
    }

    function fail(msg: string) {
      if (showErrors) setError(msg);
      else silentFail();
    }

    function resetResult() {
      hideResults();
      errorEl.setAttribute("hidden", "");
    }

    // ---------- Debounce helpers ----------
    function cancelScheduledCalculate() {
      if (calculateTimeout !== null) {
        clearTimeout(calculateTimeout);
        calculateTimeout = null;
      }
    }

    function scheduleCalculate() {
      cancelScheduledCalculate();
      calculateTimeout = window.setTimeout(() => {
        calculateTimeout = null;
        calculate();
      }, DEBOUNCE_MS);
    }

    function immediateCalculate() {
      cancelScheduledCalculate();
      calculate();
    }

    function forceCalculate() {
      cancelScheduledCalculate();
      calculate();
    }

    // ---------- Preserved-value sync ----------
    function syncPreservedWeight() {
      const raw = weightEl.value.trim();
      if (raw === "" || raw.toLowerCase().includes("e")) {
        preservedKg = null;
        return;
      }
      const value = Number(raw);
      if (!Number.isFinite(value) || value <= 0) {
        preservedKg = null;
        return;
      }
      preservedKg = unit === "lb" ? value / LB_PER_KG : value;
    }

    // ---------- Unit system toggle ----------
    function setUnitSystem(next: WeightUnit) {
      if (next === unit) return;

      syncPreservedWeight(); // Capture exact value before conversion

      if (preservedKg !== null && preservedKg > 0) {
        weightEl.value =
          next === "lb"
            ? (preservedKg * LB_PER_KG).toFixed(1)
            : preservedKg.toFixed(1);
      } else {
        if (weightEl.value.trim() === "") {
          weightEl.value = "";
        }
      }

      unit = next;

      document.querySelectorAll("[data-unit]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.unit === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      weightLabel.textContent = next === "lb" ? "Body weight (lb)" : "Body weight (kg)";
      weightUnitSpan.textContent = next === "lb" ? "lb" : "kg";
      weightEl.placeholder = next === "lb" ? "e.g. 180" : "e.g. 82";
      weightHelp.textContent =
        next === "lb"
          ? "Enter your body weight in pounds. Designed for healthy adults weighing 25–250 kg (approximately 55–551 lb)."
          : "Enter your body weight in kilograms. Designed for healthy adults weighing 25–250 kg.";

      // FIX: Only show error if there is text but it's invalid
      showErrors = weightEl.value.trim() !== "";
      resetResult();
      immediateCalculate();
    }

    // ---------- Goal toggle ----------
    function setGoal(next: ProteinGoal) {
      if (!Object.prototype.hasOwnProperty.call(factorRanges, next)) return;
      if (next === goal) return;

      goal = next;

      document.querySelectorAll("[data-goal]").forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.goal === next;
        btn.classList.toggle("active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      // FIX: Capture latest typing before recalculating, show error only if invalid text exists
      syncPreservedWeight();
      showErrors = weightEl.value.trim() !== "";
      resetResult();
      immediateCalculate();
    }

    // ---------- Calculate ----------
    function calculate() {
      errorEl.setAttribute("hidden", "");

      if (hasScientificNotation(weightEl)) {
        fail("Please enter numbers without scientific notation.");
        return;
      }

      if (weightEl.value.trim() === "") {
        fail("Please enter your body weight.");
        return;
      }

      if (preservedKg === null) {
        fail("Please enter a valid body weight greater than zero.");
        return;
      }

      const weightKg = preservedKg;

      if (weightKg < MIN_WEIGHT_KG || weightKg > MAX_WEIGHT_KG) {
        fail(
          unit === "lb"
            ? "Enter a body weight between approximately 55 and 551 lb."
            : "Enter a body weight between 25 and 250 kg."
        );
        return;
      }

      const range = factorRanges[goal];
      const [lowFactor, highFactor] = range;

      const lowProtein = round0(weightKg * lowFactor);
      const highProtein = round0(weightKg * highFactor);

      const lowPerLb = lowFactor / LB_PER_KG;
      const highPerLb = highFactor / LB_PER_KG;

      const proteinText =
        lowProtein === highProtein
          ? `${lowProtein.toLocaleString()} g/day`
          : `${lowProtein.toLocaleString()}–${highProtein.toLocaleString()} g/day`;

      const perKgText =
        lowFactor === highFactor
          ? `${lowFactor.toFixed(1)} g/kg`
          : `${lowFactor.toFixed(1)}–${highFactor.toFixed(1)} g/kg`;

      const perLbText =
        lowFactor === highFactor
          ? `${lowPerLb.toFixed(2)} g/lb`
          : `${lowPerLb.toFixed(2)}–${highPerLb.toFixed(2)} g/lb`;

      const displayWeight = `${weightKg.toFixed(1)} kg (${(weightKg * LB_PER_KG).toFixed(1)} lb)`;

      resultProteinEl.textContent = proteinText;
      resultGoalTextEl.textContent = goalLabels[goal];
      resultWeightEl.textContent = displayWeight;
      resultFormulaEl.textContent = `${perKgText} (${perLbText})`;

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Estimated daily protein target: ${proteinText}. Goal: ${goalLabels[goal]}.`;
      }
    }

    // ---------- Event wiring ----------
    document.querySelectorAll<HTMLButtonElement>("[data-unit]").forEach((btn) => {
      btn.addEventListener("click", () => setUnitSystem(btn.dataset.unit as WeightUnit));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-goal]").forEach((btn) => {
      btn.addEventListener("click", () => setGoal(btn.dataset.goal as ProteinGoal));
    });

    weightEl.addEventListener("input", () => {
      syncPreservedWeight();
      showErrors = false;
      resetResult();
      scheduleCalculate();
    });

    weightEl.addEventListener("blur", () => {
      syncPreservedWeight();
      showErrors = true;
      forceCalculate();
    });

    weightEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        showErrors = true;
        syncPreservedWeight();
        forceCalculate();
      }
    });

    // ---------- Init ----------
    // Blank state on load.
    syncPreservedWeight();
  </script>
</Base>
