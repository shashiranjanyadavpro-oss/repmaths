---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: 'Nutrition & Body Composition', href: '/tools/nutrition/' },
  { name: 'Protein Calculator' },
];

const faqs = [
  {
    question: 'How much protein do I need per day?',
    answer:
      'Your daily protein needs depend on body weight, activity, training and goals. The adult RDA is 0.8 g/kg per day. For most exercising individuals aiming to build or maintain muscle, sports-nutrition guidance commonly cites 1.4–2.0 g/kg per day. Use the calculator for an individualized starting estimate based on your selected goal.',
  },
  {
    question: 'How do I calculate how much protein I need?',
    answer:
      'Multiply your body weight in kilograms by a protein factor in grams per kilogram. For example, an 80 kg person using the muscle-gain range of 1.4–2.0 g/kg gets approximately 112–160 grams of protein per day. The RepMaths calculator performs this conversion automatically for pounds or kilograms.',
  },
  {
    question: 'How much protein do I need to build muscle?',
    answer:
      'For most healthy exercising adults, approximately 1.4–2.0 grams of protein per kilogram of body weight per day (0.64–0.91 g/lb) is a commonly cited sports-nutrition range. Resistance training, sufficient energy intake and recovery also matter.',
  },
  {
    question: 'How much protein should I eat per pound of body weight?',
    answer:
      'The adult RDA is approximately 0.36 g/lb. For muscle gain or maintenance, a commonly cited sports-nutrition range is approximately 0.64–0.91 g/lb. Your appropriate target depends on activity, energy intake and individual circumstances.',
  },
  {
    question: 'How much protein should I eat for weight loss?',
    answer:
      'Higher protein intake may help support lean-mass retention during a calorie deficit, particularly alongside resistance training. This calculator uses an illustrative athlete-oriented cutting range of 1.8–2.7 g/kg of total body weight. It is not a universal requirement or medical prescription.',
  },
  {
    question: 'Is 1 gram of protein per pound necessary for muscle growth?',
    answer:
      'No. One gram per pound is a popular fitness guideline, but most exercising adults do not need to reach that exact amount. Research supports useful muscle-related outcomes across a range of intakes, including approximately 1.4–2.0 g/kg per day.',
  },
  {
    question: 'Can my body absorb more than 30 grams of protein per meal?',
    answer:
      'Yes. The idea that the body cannot absorb more than 30 grams of protein per meal is misleading. Your body can digest and use larger amounts. Total daily intake and a practical distribution across meals are generally more important than a strict 30-gram limit.',
  },
  {
    question: 'How much protein should I eat per meal?',
    answer:
      'Sports-nutrition research often discusses approximately 0.25–0.4 g/kg of body weight per meal, or roughly 20–40 grams of high-quality protein, as a useful general range for supporting muscle protein synthesis. Individual response varies with body size, age, and training status.',
  },
  {
    question: 'Should I calculate protein using total body weight or lean body mass?',
    answer:
      'This calculator uses total body weight. For people with substantially higher body fat, a realistic goal weight or an appropriately assessed lean-body-mass approach may provide a more practical estimate. The higher protein recommendations sometimes used for lean, resistance-trained athletes during cutting may be expressed per kilogram of fat-free mass, not total body weight.',
  },
  {
    question: 'How much protein do I need if I weigh 130 pounds?',
    answer:
      'At 130 lb (approximately 59 kg), the adult RDA is about 47 g/day. The calculator muscle-gain range is approximately 83–118 g/day. Your actual needs depend on your activity, goals and circumstances.',
  },
  {
    question: 'Is whey protein required to reach my daily protein goal?',
    answer:
      'No. You can meet protein requirements through regular foods such as eggs, dairy, fish, meat, soy, beans and lentils. Whey or other protein supplements are optional conveniences rather than requirements. Plant-based eaters may benefit from targeting the higher end of the protein range due to lower leucine content in some plant proteins.',
  },
  {
    question: 'Is high protein intake safe for kidneys?',
    answer:
      'In healthy adults with normal kidney function, protein intakes up to approximately 2.0–2.2 g/kg per day have not been consistently linked to kidney harm in the populations studied. People with chronic kidney disease or other kidney conditions should follow individualized guidance from a qualified healthcare professional, as protein intake may need to be adjusted.',
  },
  {
    question: 'What should I calculate after my protein target?',
    answer:
      'Use the <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a> to estimate maintenance calories, the <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a> to explore protein, carbohydrate and fat targets, the <a href="/tools/nutrition/calorie-deficit-calculator/">Calorie Deficit Calculator</a> for a weight-loss planning estimate, or the <a href="/tools/nutrition/body-fat-calculator/">Body Fat Calculator</a> to track body-composition changes.',
  },
];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://repmaths.com/tools/nutrition/protein-calculator/#calculator',
  name: 'RepMaths Protein Calculator',
  alternateName: 'Protein Intake Calculator',
  url: 'https://repmaths.com/tools/nutrition/protein-calculator/',
  description:
    'Free daily protein calculator using body weight in pounds or kilograms and goals including general activity, muscle gain and cutting.',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@id': 'https://repmaths.com/#organization',
  },
  isPartOf: {
    '@id': 'https://repmaths.com/#website',
  },
};

const jsonLdSafe = (value: unknown) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base
  title="Protein Calculator — Daily Protein Intake & Muscle Gain"
  description="Free protein calculator: find how much protein you need per day in grams. Calculate protein intake by body weight (lb or kg) for muscle gain, cutting and activity."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <script
    type="application/ld+json"
    set:html={jsonLdSafe(appSchema)}
  />

  <section class="hero">
    <h1>Protein Calculator</h1>
    <p>
      Calculate your daily protein intake in grams based on body weight,
      activity level and fitness goal. Supports pounds (lb) and kilograms (kg).
    </p>
  </section>

  <aside class="quick-answer" aria-label="Daily protein quick answer">
    <p>
      <strong>How much protein do you need per day?</strong>
      The adult Recommended Dietary Allowance (RDA) is
      <strong>0.8 g/kg (0.36 g/lb)</strong>. For most exercising adults
      aiming to build or maintain muscle, commonly cited sports-nutrition
      guidance suggests approximately
      <strong>1.4–2.0 g/kg (0.64–0.91 g/lb)</strong> per day.
      Your individual needs can differ. Enter your weight and goal below
      for a practical starting estimate.
    </p>
  </aside>

  <section class="calc-card" aria-labelledby="calculator-heading">
    <h2 id="calculator-heading" class="calculator-heading">
      Calculate Your Daily Protein Needs
    </h2>

    <div class="field">
      <span class="field-label" id="unit-label">Weight unit</span>

      <div class="unit-toggle" role="group" aria-labelledby="unit-label">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">
          Pounds (lb)
        </button>

        <button type="button" id="unit-kg" aria-pressed="false">
          Kilograms (kg)
        </button>
      </div>
    </div>

    <div class="field">
      <label for="weight" id="weight-label">Body weight (lb)</label>

      <input
        type="number"
        id="weight"
        placeholder="e.g. 180"
        inputmode="decimal"
        min="1"
        step="any"
        autocomplete="off"
        required
        aria-describedby="weight-help calc-error"
      />

      <p id="weight-help" class="field-help">
        Enter your body weight in pounds. You can switch units anytime.
        Designed for healthy adults weighing 25–250 kg
        (approximately 55–551 lb).
      </p>
    </div>

    <div class="field">
      <span class="field-label" id="goal-label">
        Activity level or fitness goal
      </span>

      <div
        class="unit-toggle goal-toggle"
        role="group"
        aria-labelledby="goal-label"
      >
        <button type="button" id="goal-sedentary" aria-pressed="false">
          Sedentary (RDA)
        </button>

        <button type="button" id="goal-active" class="active" aria-pressed="true">
          General Activity
        </button>

        <button type="button" id="goal-muscle" aria-pressed="false">
          Muscle Gain
        </button>

        <button type="button" id="goal-cutting" aria-pressed="false">
          Cutting / Fat Loss
        </button>
      </div>

      <p class="field-help" id="goal-help">
        Select the option that best matches your current goal.
        These are planning estimates, not individualized prescriptions.
      </p>
    </div>

    <p id="calc-error" class="calc-error" role="alert" hidden></p>

    <button type="button" class="btn-primary" id="calc-btn">
      Calculate Protein Intake
    </button>

    <div class="result-box" id="result-box" aria-labelledby="result-heading">
      <div
        id="result-announcement"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>

      <h3 id="result-heading" class="result-heading">
        Your Estimated Daily Protein Intake
      </h3>

      <div class="big-number" id="result-protein">–</div>

      <div class="label">Grams of protein per day</div>

      <p class="result-range" id="result-range"></p>

      <p class="result-detail" id="result-formula"></p>

      <p class="result-detail" id="result-weight"></p>

      <p class="calc-note">
        This is a practical starting estimate. Your ideal intake may
        vary with training, body composition, total calorie intake
        and individual health.
      </p>

      <div class="result-actions">
        <a href="/tools/nutrition/tdee-calculator/" class="btn-primary">
          Calculate TDEE
        </a>

        <a href="/tools/nutrition/macro-calculator/" class="btn-primary">
          Calculate Macros
        </a>

        <a
          href="/tools/nutrition/calorie-deficit-calculator/"
          class="btn-primary"
        >
          Calorie Deficit
        </a>
      </div>
    </div>
  </section>

  <article class="article-section">
    <h2>How Much Protein Do I Need Per Day?</h2>

    <p>
      Your daily protein requirement depends on body weight, activity,
      training status, calorie intake and fitness goals. There is no
      single protein target that is optimal for every person.
    </p>

    <p>
      For generally healthy adults, the standard Recommended Dietary
      Allowance (RDA) is approximately <strong>0.8 grams per kilogram</strong>
      of body weight per day. This is a population-level reference
      intended to meet the needs of nearly all healthy adults, not
      necessarily a target for maximizing resistance-training outcomes.
    </p>

    <p>
      The International Society of Sports Nutrition (ISSN) commonly cites
      <strong>1.4–2.0 g/kg/day</strong> as sufficient for building and
      maintaining muscle mass for most exercising individuals.
    </p>

    <p>
      Use the protein intake calculator above to estimate your daily
      protein goal in grams without manually converting between
      pounds and kilograms.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Intake by Goal: Daily Protein Requirements</h2>

    <table class="result-table">
      <caption>Protein factors used by the RepMaths calculator</caption>

      <thead>
        <tr>
          <th scope="col">Goal</th>
          <th scope="col">Protein per day</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Sedentary (adult RDA)</td>
          <td>0.8 g/kg<br />~0.36 g/lb</td>
        </tr>

        <tr>
          <td>General activity</td>
          <td>1.0–1.4 g/kg<br />~0.45–0.64 g/lb</td>
        </tr>

        <tr>
          <td>Muscle gain / maintenance</td>
          <td>1.4–2.0 g/kg<br />~0.64–0.91 g/lb</td>
        </tr>

        <tr>
          <td>Cutting / fat loss</td>
          <td>1.8–2.7 g/kg<br />~0.82–1.22 g/lb</td>
        </tr>
      </tbody>
    </table>

    <p>
      These factors serve different purposes. The general-activity range
      is a practical planning estimate. The muscle-gain range reflects
      commonly cited sports-nutrition guidance. The higher cutting
      range is athlete-oriented and should not be interpreted as a
      universal requirement for weight loss.
    </p>

    <p>
      The higher <strong>2.3–3.1 g/kg</strong> recommendation sometimes
      discussed for lean, resistance-trained athletes during energy
      restriction refers to <strong>fat-free mass</strong> in specific
      contexts, rather than total body weight for everyone.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Calculate Protein Intake: Formula and Example</h2>

    <p>
      RepMaths calculates protein using your body weight in kilograms
      and the factor range associated with your selected goal.
    </p>

    <p class="formula">
      Daily protein (g) = Body weight (kg) × Protein factor (g/kg)
    </p>

    <p>
      If you enter your weight in pounds, the calculator first converts
      it into kilograms:
    </p>

    <p class="formula">
      Body weight (kg) = Body weight (lb) ÷ 2.2046226218
    </p>

    <h3>Example: Protein needs for an 80 kg person</h3>

    <p>
      For muscle gain, the calculator uses 1.4–2.0 g/kg/day:
    </p>

    <p class="formula">
      80 × 1.4 = 112 g/day<br />
      80 × 2.0 = 160 g/day
    </p>

    <p>
      The resulting estimated protein range is
      <strong>112–160 grams per day</strong>.
      This is a starting range rather than a guarantee of muscle growth.
    </p>
  </article>

  <article class="article-section">
    <h2>How Much Protein Do I Need Based on My Weight?</h2>

    <p>
      The following examples use the muscle-gain range of
      1.4–2.0 g/kg/day. Values are rounded to the nearest gram.
    </p>

    <table class="result-table">
      <caption>Example daily protein targets by body weight</caption>

      <thead>
        <tr>
          <th scope="col">Body weight</th>
          <th scope="col">Protein per day</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>120 lb</td>
          <td>76–109 g</td>
        </tr>
        <tr>
          <td>130 lb</td>
          <td>83–118 g</td>
        </tr>
        <tr>
          <td>150 lb</td>
          <td>95–136 g</td>
        </tr>
        <tr>
          <td>180 lb</td>
          <td>114–163 g</td>
        </tr>
        <tr>
          <td>200 lb</td>
          <td>127–181 g</td>
        </tr>
        <tr>
          <td>220 lb</td>
          <td>140–200 g</td>
        </tr>
      </tbody>
    </table>

    <p>
      These examples are not universal prescriptions. Enter your own
      weight in the calculator to see the estimate for your chosen goal.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Calculator for Muscle Gain and Muscle Growth</h2>

    <p>
      Protein supplies amino acids used in muscle repair and adaptation.
      For most healthy exercising adults, approximately
      <strong>1.4–2.0 g/kg (0.64–0.91 g/lb)</strong> per day is a
      commonly cited range for building or maintaining muscle.
    </p>

    <p>
      A meta-analysis of resistance-training studies reported that
      additional protein benefits for fat-free-mass gains appeared
      to level off around a modeled intake of 1.62 g/kg/day, although
      individual responses and uncertainty vary.
    </p>

    <p>
      Protein intake alone does not build muscle. Progressive resistance
      training, appropriate calorie intake, sleep and recovery also matter.
    </p>

    <p>
      To estimate your maintenance calories before planning a muscle-gain
      phase, use our
      <a href="/tools/nutrition/tdee-calculator/">TDEE Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Calculator for Weight Loss and Cutting</h2>

    <p>
      During a calorie deficit, adequate protein intake alongside
      resistance training may help preserve lean mass.
      Protein needs can be higher in some trained individuals during
      energy restriction.
    </p>

    <p>
      The RepMaths Cutting option uses an illustrative
      <strong>1.8–2.7 g/kg (0.82–1.22 g/lb)</strong> range based on
      total body weight. It is an athlete-oriented planning range,
      not a requirement for every person trying to lose weight.
    </p>

    <p>
      For people with substantially higher body fat, a target based
      on total body weight may be unnecessarily high. A realistic goal
      weight or an appropriately assessed lean-body-mass approach may
      be more practical.
    </p>

    <p>
      Combine your protein estimate with our
      <a href="/tools/nutrition/calorie-deficit-calculator/">
        Calorie Deficit Calculator
      </a>
      to explore an estimated calorie target.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein per Pound vs. Protein per Kilogram</h2>

    <p>
      Sports-nutrition studies generally express protein intake in
      grams per kilogram (g/kg). Many gym users, especially in the
      United States, prefer grams per pound (g/lb).
    </p>

    <p>
      Both methods describe the same underlying amount when converted
      correctly. For example:
    </p>

    <ul>
      <li>0.8 g/kg ≈ 0.36 g/lb</li>
      <li>1.4 g/kg ≈ 0.64 g/lb</li>
      <li>1.6 g/kg ≈ 0.73 g/lb</li>
      <li>2.0 g/kg ≈ 0.91 g/lb</li>
    </ul>

    <p>
      You do not need to calculate the conversion manually.
      Switch between lb and kg in the calculator above.
    </p>
  </article>

  <article class="article-section">
    <h2>Is 1 Gram of Protein per Pound Necessary?</h2>

    <p>
      One gram of protein per pound of body weight is a popular
      bodybuilding guideline, but it is not a requirement for
      most healthy exercising adults.
    </p>

    <p>
      One gram per pound equals approximately 2.2 g/kg, which is
      slightly above the ISSN's commonly cited 1.4–2.0 g/kg/day
      range for most exercising individuals.
    </p>

    <p>
      More protein does not automatically produce more muscle growth.
      The overall training program, energy intake and consistency
      remain important.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Per Meal: Leucine and Distribution</h2>

    <p>
      The claim that your body can absorb only 20–30 grams of protein
      at one meal is an oversimplification. Digestion and absorption
      do not simply stop once a meal exceeds that amount.
    </p>

    <p>
      Sports-nutrition guidance often discusses approximately
      <strong>0.25–0.4 g/kg of body weight per meal</strong>, or
      roughly <strong>20–40 grams of high-quality protein</strong>,
      as a useful general range for supporting muscle protein
      synthesis.
    </p>

    <p>
      Research also highlights <strong>leucine</strong>, an amino
      acid that plays a key role in stimulating muscle protein
      synthesis. The response depends on protein quality, total
      amino acid intake, meal size, age, and training status.
      While a leucine threshold is often discussed in sports-nutrition
      research, there is no single universal value that applies to
      every person. Animal proteins such as chicken, beef, eggs and
      whey are rich in leucine. Plant-protein sources generally
      contain less leucine, so vegans and vegetarians may benefit
      from targeting the higher end of the protein range.
    </p>

    <p>
      Distributing protein across 3–5 meals can make it easier to
      reach your daily goal. For most people, achieving an appropriate
      total daily intake is more important than following a rigid
      30-gram limit.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Sources: How to Reach Your Daily Goal</h2>

    <p>
      Protein can come from animal or plant foods. Common sources
      include eggs, milk, Greek yogurt, fish, poultry, lean meat,
      soy foods, tofu, beans, lentils and other legumes.
    </p>

    <p>
      Protein supplements such as whey or plant-based powders
      can be convenient, but they are not required if regular
      meals provide sufficient protein.
    </p>

    <p>
      To plan protein alongside carbohydrates and dietary fat,
      use the
      <a href="/tools/nutrition/macro-calculator/">Macro Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Calculator for Women and Older Adults</h2>

    <p>
      Protein needs vary across life stages. Women and older adults
      may have different requirements due to hormonal changes,
      muscle-mass preservation needs, and changes in protein
      metabolism.
    </p>

    <p>
      For older adults (65+), research organizations such as
      PROT-AGE and ESPEN suggest higher protein intakes —
      approximately <strong>1.0–1.5 g/kg/day</strong> — to help
      preserve muscle mass and function with age.
    </p>

    <p>
      For pregnant and breastfeeding women, protein needs are
      generally higher than the standard adult RDA. Individual
      guidance from a healthcare professional is recommended
      during these life stages.
    </p>

    <p>
      This calculator uses total body weight as a general starting
      point. Your individual needs may vary based on age, health
      status, and medical conditions.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Track Your Protein Intake</h2>

    <p>
      Hitting your daily protein target consistently matters more
      than hitting it perfectly on any single day. Research shows
      that people often underestimate their food intake when
      relying on memory alone.
    </p>

    <p>
      Practical tracking methods include:
    </p>

    <ul>
      <li>
        <strong>Food logging apps</strong> — MyFitnessPal, Cronometer,
        and similar tools help track daily intake with barcode scanning
        and verified food databases.
      </li>
      <li>
        <strong>Portion estimation</strong> — Learning common portion
        sizes (e.g., a palm-sized serving of meat contains roughly
        20–30 g of protein) can help without constant logging.
      </li>
      <li>
        <strong>Meal templates</strong> — Building 2–3 go-to meals
        with known protein amounts simplifies daily planning.
      </li>
      <li>
        <strong>Weekly averages</strong> — Tracking total intake
        across a week provides a more reliable picture than
        focusing on any single day.
      </li>
    </ul>

    <p>
      Building consistent tracking habits takes time, and the
      length varies from person to person. Many people find that
      less frequent tracking becomes sufficient once they develop
      a reliable sense of common portions and protein sources.
    </p>
  </article>

  <article class="article-section">
    <h2>Protein Safety and Kidney Health</h2>

    <p>
      In healthy adults with normal kidney function, protein intakes
      up to approximately <strong>2.0–2.2 g/kg per day</strong> have
      not been consistently linked to kidney harm in the populations
      studied.
    </p>

    <p>
      People with chronic kidney disease or other kidney conditions
      may need to adjust protein intake. If you have a kidney
      condition or other medical concern, follow individualized
      guidance from a qualified healthcare professional rather
      than relying on a general fitness calculator.
    </p>

    <p>
      This calculator provides general estimates for healthy adults.
      It is not a medical or dietary prescription.
    </p>
  </article>

  <article class="article-section">
    <h2>How Accurate Is a Protein Intake Calculator?</h2>

    <p>
      A protein calculator provides an estimate based on research-informed
      ranges. It cannot directly measure your individual physiological
      requirements or predict exact muscle growth.
    </p>

    <p>
      Your ideal target can vary with training experience, age, energy
      intake, body composition, dietary preferences and health.
      Total body weight is used here for simplicity.
    </p>

    <p>
      People with kidney disease or other conditions requiring
      individualized nutrition advice should follow guidance from
      a qualified healthcare professional rather than relying
      on a general fitness calculator.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    {faqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p set:html={faq.answer} />
      </div>
    ))}
  </article>

  <article class="article-section">
    <h2>Sources and Further Reading</h2>

    <p>
      The following research and reference materials inform the
      discussion above. RepMaths calculator ranges remain
      general estimates rather than clinical prescriptions.
    </p>

    <ul>
      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/28642676/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Jäger et al. (2017) — International Society of Sports Nutrition
          Position Stand: Protein and Exercise
        </a>
      </li>

      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/28698222/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Morton et al. (2018) — Protein Supplementation and
          Resistance-Training Adaptations: Systematic Review and Meta-Analysis
        </a>
      </li>

      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/24092765/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Helms et al. (2014) — Evidence-Based Recommendations for
          Natural Bodybuilding Contest Preparation
        </a>
      </li>

      <li>
        <a
          href="https://nap.nationalacademies.org/catalog/10490/dietary-reference-intakes-for-energy-carbohydrate-fiber-fat-fatty-acids-cholesterol-protein-and-amino-acids"
          target="_blank"
          rel="noopener noreferrer"
        >
          National Academies — Dietary Reference Intakes for Protein
          and Amino Acids
        </a>
      </li>

      <li>
        <a
          href="https://pubmed.ncbi.nlm.nih.gov/24477298/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Mamerow et al. (2014) — Dietary Protein Distribution Positively
          Influences 24-h Muscle Protein Synthesis
        </a>
      </li>
    </ul>
  </article>

  <p class="disclaimer-note">
    <strong>Important:</strong> This calculator is intended for general
    educational use by healthy adults. It is not individualized medical
    or dietary advice. Requirements may differ during pregnancy,
    breastfeeding, illness, recovery or when clinical nutrition
    restrictions apply.
  </p>

  <RelatedTools currentToolId="protein-calculator" />

  <style>
    .calculator-heading {
      font-size: 1.12rem;
      margin: 0 0 20px;
    }

    .quick-answer {
      background: var(--surface);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 16px 18px;
      margin: 0 0 24px;
    }

    .quick-answer p {
      margin: 0;
      color: #c7cbd2;
      font-size: 0.92rem;
      line-height: 1.6;
    }

    .quick-answer strong {
      color: var(--accent);
    }

    .field-help {
      color: var(--text-muted);
      font-size: 0.83rem;
      line-height: 1.5;
      margin: 7px 0 0;
    }

    .goal-toggle {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .goal-toggle button {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .calc-error {
      color: #ffb4a8;
      font-size: 0.9rem;
      margin: 10px 0;
      line-height: 1.5;
    }

    .result-heading {
      font-size: 1rem;
      margin: 0 0 12px;
      color: var(--text);
    }

    .result-detail {
      color: var(--text-muted);
      font-size: 0.87rem;
      margin: 8px 0;
      overflow-wrap: anywhere;
    }

    .calc-note {
      color: var(--text-muted);
      font-size: 0.84rem;
      line-height: 1.6;
      margin: 12px 0;
    }

    .formula {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
      font-weight: 600;
      overflow-wrap: anywhere;
      line-height: 1.8;
    }

    .result-range {
      margin-top: 10px;
      line-height: 1.6;
    }

    .result-table td:last-child {
      white-space: normal;
    }

    .disclaimer-note {
      color: var(--text-muted);
      font-size: 0.83rem;
      line-height: 1.6;
      margin-top: 24px;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 480px) {
      .goal-toggle {
        gap: 8px;
      }

      .goal-toggle button {
        font-size: 0.85rem;
        padding: 10px 6px;
      }
    }
  </style>

  <script>
    type WeightUnit = 'lb' | 'kg';
    type ProteinGoal = 'sedentary' | 'active' | 'muscle' | 'cutting';

    let unit: WeightUnit = 'lb';
    let goal: ProteinGoal = 'active';

    // Canonical metric value — preserved across unit toggles to avoid
    // cumulative rounding loss from repeated conversions.
    let preservedKg: number | null = null;

    const LB_PER_KG = 2.2046226218;
    const MIN_WEIGHT_KG = 25;
    const MAX_WEIGHT_KG = 250;

    const factorRanges: Record<ProteinGoal, [number, number]> = {
      sedentary: [0.8, 0.8],
      active: [1.0, 1.4],
      muscle: [1.4, 2.0],
      cutting: [1.8, 2.7],
    };

    const goalLabels: Record<ProteinGoal, string> = {
      sedentary: 'Sedentary — adult RDA',
      active: 'General activity — practical estimate',
      muscle: 'Muscle gain / maintenance — sports-nutrition range',
      cutting: 'Cutting / fat loss — athlete-oriented estimate',
    };

    const unitLb = document.getElementById('unit-lb');
    const unitKg = document.getElementById('unit-kg');

    const goalButtons: Record<ProteinGoal, HTMLElement | null> = {
      sedentary: document.getElementById('goal-sedentary'),
      active: document.getElementById('goal-active'),
      muscle: document.getElementById('goal-muscle'),
      cutting: document.getElementById('goal-cutting'),
    };

    const weightInput = document.getElementById(
      'weight'
    ) as HTMLInputElement | null;

    const weightLabel = document.getElementById('weight-label');
    const weightHelp = document.getElementById('weight-help');

    const calcBtn = document.getElementById('calc-btn');
    const calcError = document.getElementById('calc-error');

    const resultBox = document.getElementById('result-box');
    const resultProtein = document.getElementById('result-protein');
    const resultRange = document.getElementById('result-range');
    const resultFormula = document.getElementById('result-formula');
    const resultWeight = document.getElementById('result-weight');

    const resultAnnouncement = document.getElementById(
      'result-announcement'
    );

    const formatter = new Intl.NumberFormat('en-US', {
      maximumFractionDigits: 0,
    });

    function hideResult() {
      resultBox?.classList.remove('show');

      if (resultAnnouncement) {
        resultAnnouncement.textContent = '';
      }
    }

    function clearError() {
      if (calcError) {
        calcError.textContent = '';
        calcError.hidden = true;
      }

      weightInput?.removeAttribute('aria-invalid');
    }

    function showError(message: string) {
      clearError();

      if (calcError) {
        calcError.textContent = message;
        calcError.hidden = false;
      }

      weightInput?.setAttribute('aria-invalid', 'true');
      hideResult();
      weightInput?.focus();
    }

    function setPressed(button: HTMLElement | null, selected: boolean) {
      button?.classList.toggle('active', selected);
      button?.setAttribute('aria-pressed', String(selected));
    }

    // Update preserved metric value from current input (based on active unit).
    function syncPreservedWeight() {
      if (!weightInput) return;

      const raw = weightInput.value.trim();

      if (raw === '') {
        preservedKg = null;
        return;
      }

      const value = Number(raw);

      if (!Number.isFinite(value) || value <= 0) {
        preservedKg = null;
        return;
      }

      preservedKg = unit === 'lb' ? value / LB_PER_KG : value;
    }

    function setUnit(next: WeightUnit) {
      if (next === unit) return;

      // Render weight from preserved kg value.
      if (preservedKg !== null && preservedKg > 0 && weightInput) {
        weightInput.value =
          next === 'lb'
            ? (preservedKg * LB_PER_KG).toFixed(1)
            : preservedKg.toFixed(1);
      }

      unit = next;

      setPressed(unitLb, next === 'lb');
      setPressed(unitKg, next === 'kg');

      if (weightLabel) {
        weightLabel.textContent =
          next === 'lb' ? 'Body weight (lb)' : 'Body weight (kg)';
      }

      if (weightHelp) {
        weightHelp.textContent =
          next === 'lb'
            ? 'Enter your body weight in pounds. You can switch units anytime. Designed for healthy adults weighing 25–250 kg (approximately 55–551 lb).'
            : 'Enter your body weight in kilograms. You can switch units anytime. Designed for healthy adults weighing 25–250 kg.';
      }

      if (weightInput) {
        weightInput.placeholder = next === 'lb' ? 'e.g. 180' : 'e.g. 82';
      }

      clearError();
      hideResult();
    }

    function setGoal(next: ProteinGoal) {
      if (!Object.prototype.hasOwnProperty.call(factorRanges, next)) {
        return;
      }

      goal = next;

      for (const key of Object.keys(goalButtons) as ProteinGoal[]) {
        setPressed(goalButtons[key], key === next);
      }

      clearError();
      hideResult();
    }

    function calculateProtein() {
      if (!weightInput) return;

      clearError();

      // Only sync from input when no preserved value exists yet. This
      // prevents the rounded display value (after a unit toggle) from
      // overwriting the original precise metric value.
      if (preservedKg === null) {
        syncPreservedWeight();
      }

      if (preservedKg === null) {
        showError('Please enter a valid body weight greater than zero.');
        return;
      }

      const weightKg = preservedKg;

      if (weightKg < MIN_WEIGHT_KG || weightKg > MAX_WEIGHT_KG) {
        showError(
          unit === 'lb'
            ? 'Enter a body weight between approximately 55 and 551 lb.'
            : 'Enter a body weight between 25 and 250 kg.'
        );
        return;
      }

      const range = factorRanges[goal];

      if (!range) {
        showError('Please select a valid protein goal.');
        return;
      }

      const [lowFactor, highFactor] = range;

      const lowProtein = Math.round(weightKg * lowFactor);
      const highProtein = Math.round(weightKg * highFactor);

      const lowPerLb = lowFactor / LB_PER_KG;
      const highPerLb = highFactor / LB_PER_KG;

      const proteinText =
        lowProtein === highProtein
          ? `${formatter.format(lowProtein)} g/day`
          : `${formatter.format(lowProtein)}–${formatter.format(highProtein)} g/day`;

      const perKgText =
        lowFactor === highFactor
          ? `${lowFactor.toFixed(1)} g/kg`
          : `${lowFactor.toFixed(1)}–${highFactor.toFixed(1)} g/kg`;

      const perLbText =
        lowFactor === highFactor
          ? `${lowPerLb.toFixed(2)} g/lb`
          : `${lowPerLb.toFixed(2)}–${highPerLb.toFixed(2)} g/lb`;

      const displayWeight = `${weightKg.toFixed(1)} kg (${(weightKg * LB_PER_KG).toFixed(1)} lb)`;

      if (resultProtein) {
        resultProtein.textContent = proteinText;
      }

      if (resultRange) {
        resultRange.textContent = `${goalLabels[goal]} · ${perKgText} · ${perLbText}`;
      }

      if (resultFormula) {
        resultFormula.textContent =
          lowFactor === highFactor
            ? `Formula: ${weightKg.toFixed(1)} kg × ${lowFactor.toFixed(1)} g/kg ≈ ${formatter.format(lowProtein)} g/day`
            : `Formula: ${weightKg.toFixed(1)} kg × ${lowFactor.toFixed(1)}–${highFactor.toFixed(1)} g/kg ≈ ${formatter.format(lowProtein)}–${formatter.format(highProtein)} g/day`;
      }

      if (resultWeight) {
        resultWeight.textContent = `Body weight: ${displayWeight}`;
      }

      resultBox?.classList.add('show');

      if (resultAnnouncement) {
        resultAnnouncement.textContent = `Estimated daily protein target: ${proteinText}. ${goalLabels[goal]}.`;
      }
    }

    unitLb?.addEventListener('click', () => setUnit('lb'));
    unitKg?.addEventListener('click', () => setUnit('kg'));

    for (const key of Object.keys(goalButtons) as ProteinGoal[]) {
      goalButtons[key]?.addEventListener('click', () => setGoal(key));
    }

    calcBtn?.addEventListener('click', calculateProtein);

    weightInput?.addEventListener('input', () => {
      syncPreservedWeight();
      clearError();
      hideResult();
    });

    weightInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        calculateProtein();
      }
    });
  </script>
</Base>
