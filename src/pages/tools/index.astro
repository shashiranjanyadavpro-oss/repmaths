---
import Base from '../../layouts/Base.astro';
import toolsData from '../../data/tools.json';
const tools = toolsData;
---

<Base
  title="All Free Fitness & Strength Calculators | RepMaths"
  description="Browse the complete directory of RepMaths calculators: 1RM, strength standards, training programs, plate loading, and nutrition & body composition tools."
  breadcrumbs={[{ "name": "Home", "href": "/" }, { "name": "Tools" }]}
>
  <section class="hero">
    <h1>All Fitness Calculators</h1>
    <p>The complete directory of every free RepMaths tool in one place.</p>
  </section>

  <div class="tool-grid">
    {tools.map((tool) => (
      <a class="tool-card" href={tool.url}>
        <span class="icon" aria-hidden="true">{tool.icon}</span>
        <span class="name">{tool.name}</span>
        <span class="desc">{tool.shortDesc}</span>
      </a>
    ))}
  </div>

  <section class="seo-content">
    <h2>Your Complete Toolkit for Strength & Fitness</h2>
    <p>
      Whether you're calculating your true <strong>1 Rep Max</strong>, planning a powerlifting peaking block, or dialing in your <strong>macros and TDEE</strong>, our comprehensive suite of fitness calculators has you covered. Built on reliable formulas and completely free to use with no sign-ups required, RepMaths provides the accurate data you need to reach your strength and body composition goals.
    </p>
  </section>

  <style>
    .hero {
      margin-bottom: 24px;
    }
    
    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 600px;
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin: 24px 0 48px;
    }

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 14px;
      text-align: center;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .tool-card .name {
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      display: block;
      margin-bottom: 4px;
    }

    .tool-card .desc {
      color: var(--text-muted);
      font-size: 0.78rem;
    }

    /* SEO Content Styling */
    .seo-content {
      border-top: 1px solid var(--border);
      padding-top: 32px;
      margin-top: 32px;
    }

    .seo-content h2 {
      font-size: 1.25rem;
      color: var(--text);
      margin-bottom: 12px;
    }

    .seo-content p {
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 0.95rem;
    }
  </style>
</Base>
