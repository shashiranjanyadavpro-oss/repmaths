---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="5/3/1 Calculator — Wendler 531 Program Generator"
  description="Free Wendler 5/3/1 calculator. Enter your training max to generate all 4 weeks of working weights, AMRAP sets, deload, and Boring But Big assistance work."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "5/3/1 Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that generates the complete Wendler 5/3/1 four-week percentage program from a training max, including Boring But Big assistance work."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a Training Max (TM) in the 5/3/1 program?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Training Max is the foundation of the 5/3/1 program, commonly set at 90% of your true one-rep max. Using a submaximal TM lets you progress gradually without every session feeling maximal, which many lifters find easier to sustain over time."
        }
      },
      {
        "@type": "Question",
        "name": "Do I really have to do the deload week in 5/3/1?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Week 4 is the deload week in the standard 5/3/1 cycle, using 40%, 50%, and 60% of the Training Max for the main work."
        }
      },
      {
        "@type": "Question",
        "name": "What does AMRAP mean in Wendler's 5/3/1?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AMRAP stands for 'as many reps as possible.' In weeks 1, 2, and 3, the final working set of your main lift is an AMRAP set, marked with a plus sign like 5+, 3+, or 1+. It's generally treated as a rep-record and feedback tool rather than a maximal test — most guidance suggests stopping short of technical failure rather than grinding out the absolute last rep."
        }
      },
      {
        "@type": "Question",
        "name": "What is the Boring But Big (BBB) assistance template?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Boring But Big is a well-known assistance template for 5/3/1. After your main heavy sets, you perform 5 sets of 10 reps of the same lift, commonly in a 50% to 60% of Training Max range depending on the variation and your experience level. It's often used to add supplemental training volume alongside the main lifts."
        }
      },
      {
        "@type": "Question",
        "name": "How and when should I increase my 5/3/1 Training Max?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A common approach is to increase your Training Max after completing a full 4-week cycle — typically by 5 lb (2.5 kg) for upper body lifts (bench press, overhead press) and 10 lb (5 kg) for lower body lifts (squat, deadlift). Smaller, steady increases are generally favored over larger jumps, even if a cycle felt easy."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>5/3/1 Calculator</h1>
    <p>Enter your training max to generate the full Wendler 5/3/1 four-week cycle.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>
    <div class="field">
      <label>Input Type</label>
      <div class="unit-toggle">
        <button type="button" id="mode-tm" class="active" aria-pressed="true">Training Max</button>
        <button type="button" id="mode-1rm" aria-pressed="false">1RM (auto 90%)</button>
      </div>
    </div>
    <div class="field">
      <label for="input-weight" id="input-label">Training Max</label>
      <input type="number" id="input-weight" placeholder="e.g. 280" inputmode="decimal" min="0" step="any" />
    </div>
    <button class="btn-primary" id="calc-btn">Generate 5/3/1 Cycle</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-tm">–</div>
      <div class="label" id="result-label">Training Max Used</div>

      <table class="result-table" id="result-table">
        <thead><tr><th>Week 1 (5/5/5+)</th><th>Weight</th></tr></thead>
        <tbody id="week1-body"></tbody>
      </table>
      <table class="result-table" id="result-table-2">
        <thead><tr><th>Week 2 (3/3/3+)</th><th>Weight</th></tr></thead>
        <tbody id="week2-body"></tbody>
      </table>
      <table class="result-table" id="result-table-3">
        <thead><tr><th>Week 3 (5/3/1+)</th><th>Weight</th></tr></thead>
        <tbody id="week3-body"></tbody>
      </table>
      <table class="result-table" id="result-table-4">
        <thead><tr><th>Week 4 — Deload (5/5/5)</th><th>Weight</th></tr></thead>
        <tbody id="week4-body"></tbody>
      </table>
      <table class="result-table" id="result-table-5">
        <thead><tr><th>Boring But Big (5×10)</th><th>Weight</th></tr></thead>
        <tbody id="bbb-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is the 5/3/1 Program?</h2>
    <p>
      Wendler 5/3/1 is a percentage-based strength program built around four
      main lifts — squat, bench press, deadlift, and overhead press — each
      run off its own Training Max. Every working weight for the month
      comes from that single number, which is why getting your training max
      right (using our <a href="/tools/training/training-max-calculator">Training Max Calculator</a>)
      matters more than any other input in the program.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      If you already know your Training Max, enter it directly. If you only
      have your 1RM, switch to "1RM (auto 90%)" mode and the calculator will
      apply the standard 90% conversion automatically. If you need to
      estimate your 1RM first, use our
      <a href="/tools/strength/1rm-calculator">1RM Calculator</a>
      before converting it to a Training Max. Generate the cycle to see all
      four weeks of main work plus a Boring But Big assistance table, all
      rounded to the nearest 5 lb or 2.5 kg.
    </p>
  </article>

  <article class="article-section">
    <h2>The 5/3/1 Weekly Percentages</h2>
    <ul>
      <li><strong>Week 1 (5/5/5+):</strong> 65%, 75%, 85% of Training Max.</li>
      <li><strong>Week 2 (3/3/3+):</strong> 70%, 80%, 90% of Training Max.</li>
      <li><strong>Week 3 (5/3/1+):</strong> 75%, 85%, 95% of Training Max.</li>
      <li><strong>Week 4 — Deload (5/5/5):</strong> 40%, 50%, 60% of Training Max.</li>
    </ul>
    <p>
      The last set of each main week is an AMRAP set (marked with a "+").
      Treat it as a controlled rep-record set rather than a true 1RM test:
      perform quality reps and avoid taking the set to technical failure.
      The deload week is part of the standard 5/3/1 cycle structure. The
lighter workload provides a lower-intensity week before the next cycle.
    </p>
  </article>

  <article class="article-section">
    <h2>Boring But Big (BBB) Assistance</h2>
    <p>
      Boring But Big (BBB) is a well-known assistance template for 5/3/1:
      after your main lift, perform 5 sets of 10 reps. The exact percentage
      can vary by BBB variation and training experience. This calculator
      uses 50% of your Training Max as a conservative default.
    </p>
    <p>
      This adds substantial supplemental volume for lifters using BBB
      alongside their main 5/3/1 work. Start with a load that allows you
      to complete the prescribed sets with controlled technique and
      recover for your next session.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is a Training Max in the 5/3/1 program?</h3>
      <p>Commonly set at 90% of your true 1RM — the submaximal number every percentage in the program is calculated from.</p>
    </div>
    <div class="faq-item">
      <h3>Do I really have to do the deload week?</h3>
      <p>It's widely recommended and part of the standard structure — it lets fatigue dissipate before the next cycle.</p>
    </div>
    <div class="faq-item">
      <h3>What does AMRAP mean?</h3>
      <p>"As many reps as possible" — the final set of weeks 1-3, generally treated as a rep-record set rather than a true max effort.</p>
    </div>
    <div class="faq-item">
      <h3>What is Boring But Big (BBB)?</h3>
      <p>5 sets of 10 reps, commonly 50-60% of your Training Max depending on the variation, done after your main lift for added volume.</p>
    </div>
    <div class="faq-item">
      <h3>How and when should I increase my Training Max?</h3>
      <p>A common approach: after each full 4-week cycle, +5 lb (2.5 kg) upper body, +10 lb (5 kg) lower body.</p>
    </div>
  </article>

  <RelatedTools currentToolId="531-calculator" />

  <script>
    let unit = "lb";
    let mode = "tm";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const modeTM = document.getElementById("mode-tm");
    const mode1RM = document.getElementById("mode-1rm");
    const inputWeight = document.getElementById("input-weight") as HTMLInputElement | null;
    const inputLabel = document.getElementById("input-label");
    const calcBtn = document.getElementById("calc-btn");
    const resultTM = document.getElementById("result-tm");
    const resultLabel = document.getElementById("result-label");
    const resultBox = document.getElementById("result-box");

    if (unitLb) unitLb.addEventListener("click", () => setUnit("lb"));
    if (unitKg) unitKg.addEventListener("click", () => setUnit("kg"));
    if (modeTM) modeTM.addEventListener("click", () => setMode("tm"));
    if (mode1RM) mode1RM.addEventListener("click", () => setMode("1rm"));

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (inputWeight) {
        const currentVal = Number(inputWeight.value);
        if (Number.isFinite(currentVal) && currentVal > 0) {
          const converted = newUnit === "kg"
            ? currentVal / 2.20462
            : currentVal * 2.20462;
          inputWeight.value = converted.toFixed(1);
        }
      }

      unit = newUnit;
      if (unitLb) { unitLb.classList.toggle("active", unit === "lb"); unitLb.setAttribute("aria-pressed", String(unit === "lb")); }
      if (unitKg) { unitKg.classList.toggle("active", unit === "kg"); unitKg.setAttribute("aria-pressed", String(unit === "kg")); }
    }

    function setMode(newMode: string) {
      if (newMode !== "tm" && newMode !== "1rm") return;
      mode = newMode;

      if (modeTM) { modeTM.classList.toggle("active", mode === "tm"); modeTM.setAttribute("aria-pressed", String(mode === "tm")); }
      if (mode1RM) { mode1RM.classList.toggle("active", mode === "1rm"); mode1RM.setAttribute("aria-pressed", String(mode === "1rm")); }
      if (inputLabel) inputLabel.textContent = mode === "tm" ? "Training Max" : "1RM";
      if (inputWeight) inputWeight.placeholder = mode === "tm" ? "e.g. 280" : "e.g. 310";
    }

    function roundToNearest(value: number, step: number): number {
      return Math.round(value / step) * step;
    }

    function formatWeight(value: number): string {
      if (unit === "kg") return Number(value.toFixed(1)).toString();
      return Math.round(value).toString();
    }

    function fillTable(bodyId: string, pcts: number[], reps: string[], tm: number, roundStep: number) {
      const body = document.getElementById(bodyId);
      if (!body) return;
      const rows = pcts.map((p, i) => {
        const weight = roundToNearest(tm * (p / 100), roundStep);
        return `<tr><td>${p}% × ${reps[i]}</td><td>${formatWeight(weight)} ${unit}</td></tr>`;
      }).join("");
      body.innerHTML = rows;
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!inputWeight) return;
        const raw = Number(inputWeight.value);

        if (!Number.isFinite(raw) || raw <= 0) {
          alert("Please enter a valid Training Max or 1RM greater than 0.");
          return;
        }

        const roundStep = unit === "lb" ? 5 : 2.5;
        const tm = mode === "tm" ? raw : roundToNearest(raw * 0.9, roundStep);

        if (!Number.isFinite(tm) || tm <= 0) {
          alert("Unable to calculate a valid Training Max. Please check your input.");
          return;
        }

        if (resultTM) resultTM.textContent = `${formatWeight(tm)} ${unit}`;
        if (resultLabel) resultLabel.textContent = "Training Max Used";

        fillTable("week1-body", [65, 75, 85], ["5", "5", "5+"], tm, roundStep);
        fillTable("week2-body", [70, 80, 90], ["3", "3", "3+"], tm, roundStep);
        fillTable("week3-body", [75, 85, 95], ["5", "3", "1+"], tm, roundStep);
        fillTable("week4-body", [40, 50, 60], ["5", "5", "5"], tm, roundStep);
        fillTable("bbb-body", [50, 50, 50, 50, 50], ["10", "10", "10", "10", "10"], tm, roundStep);

        if (resultBox) resultBox.classList.add("show");
      });
    }
  </script>
</Base>
