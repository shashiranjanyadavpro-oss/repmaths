---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="Warm-Up Set Calculator — Ramp to Your Working Weight"
  description="Free warm-up set calculator. Enter your working weight to get a full barbell warm-up ramp from the empty bar to your first working set, with reps and rest guidance."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Warm-Up Set Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that generates a barbell warm-up ramp from the empty bar to a target working weight, with reps and rest time for each step."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many warm-up sets should I do before a heavy lift?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The number of warm-up sets depends on the exercise, working weight, training experience, and how prepared you feel. For a heavy compound lift, a short ramp of several progressively heavier sets can prepare you for the working weight while limiting unnecessary fatigue. This calculator provides a 5-step default ramp including the empty bar and four progressively heavier warm-up loads before the working set."
        }
      },
      {
        "@type": "Question",
        "name": "Why do warm-up reps decrease as the weight gets heavier?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "As warm-up loads increase, using fewer repetitions can provide practice with heavier weights while limiting unnecessary fatigue before the working sets. The exact number of repetitions should depend on the exercise, load, and individual response."
        }
      },
      {
        "@type": "Question",
        "name": "How long should I rest between warm-up sets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rest can be shorter during light warm-up sets and longer as the load approaches the working weight. This calculator uses approximately 30 to 45 seconds after the empty bar and progressively longer rest periods for heavier warm-up sets. Rest should be adjusted based on the exercise, load, and how recovered you feel."
        }
      },
      {
        "@type": "Question",
        "name": "Do warm-up sets count toward my training volume?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Warm-up sets are commonly tracked separately from working sets because their main purpose is preparation rather than accumulating the programmed working-set volume. However, warm-up sets still involve physical work and may contribute to overall training stress, especially when they become heavy or high in repetitions."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>Warm-Up Set Calculator</h1>
    <p>Enter your working weight to generate a full ramp from the empty bar to your first heavy set.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>

    <div class="field">
      <label for="working-weight">Working Weight</label>
      <input
        type="number"
        id="working-weight"
        placeholder="e.g. 225"
        inputmode="decimal"
        min="0"
        step="any"
      />
    </div>

    <button class="btn-primary" id="calc-btn">Generate Warm-Up Ramp</button>

    <div class="result-box" id="result-box">
      <div class="label">Your Warm-Up Ramp</div>

      <table class="result-table" id="result-table">
        <thead>
          <tr>
            <th>Set</th>
            <th>Weight</th>
            <th>Reps</th>
            <th>Rest After</th>
          </tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is a Warm-Up Set Calculator?</h2>
    <p>
      A warm-up set calculator generates a ramp of lighter sets you perform
      on the way to your working weight — starting with the empty bar and
      climbing through progressively heavier loads. The goal is preparation:
      rehearsing the movement, getting accustomed to the exercise and load,
      and preparing for the working sets without creating unnecessary fatigue.
    </p>
  </article>

  <article class="article-section">
    <h2>How to Use This Calculator</h2>
    <p>
      Enter the working weight for your first real set. If you need help
      estimating a strength reference, use our
      <a href="/tools/strength/1rm-calculator">1RM Calculator</a> and
      <a href="/tools/strength/1rm-percentage-calculator">1RM Percentage Calculator</a>
      if needed, then generate your ramp.
    </p>
    <p>
      The calculator rounds warm-up loads to the nearest 5 lb or 2.5 kg so
      the suggested weights are practical for common barbell plate
      combinations. Actual available plates may require a small adjustment.
    </p>
  </article>

  <article class="article-section">
    <h2>How Many Warm-Up Sets Do You Need?</h2>
    <p>
      There is no single number of warm-up sets that fits every lifter or
      exercise. A heavier compound lift may benefit from several progressively
      heavier preparation sets, while a lighter or later exercise may need
      fewer. Your training experience, working weight, exercise complexity,
      and how prepared you feel can all affect the appropriate warm-up.
    </p>
    <p>
      This calculator uses a simple default ramp: the empty bar, followed by
      approximately 40%, 60%, 80%, and 90% of the working weight. Repetitions
      decrease as the load increases to keep the later warm-up sets relatively
      low in volume. Treat this as a starting template rather than a universal
      prescription.
    </p>
    <p>
      Rest periods also increase as the load gets heavier. Light preparation
      sets may require only a short break, while heavier warm-up sets can
      justify longer rest before the working set. Adjust the rest interval
      if you still feel out of breath, fatigued, or insufficiently prepared.
    </p>
  </article>

  <article class="article-section">
    <h2>Do Warm-Up Sets Count as Training Volume?</h2>
    <p>
      Warm-up sets are commonly recorded separately from programmed working
      sets because they are primarily used for preparation rather than
      accumulating the planned training volume. That does not mean they have
      no physical training effect: heavier or higher-repetition warm-up sets
      still add work and can contribute to fatigue.
    </p>
    <p>
      If a warm-up becomes sufficiently challenging, it may be useful to
      consider its contribution to your overall training stress rather than
      treating every warm-up as completely negligible.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>How many warm-up sets should I do before a heavy lift?</h3>
      <p>
        It depends on the exercise, working weight, training experience, and
        how prepared you feel. This calculator provides a 5-step default ramp
        including the empty bar and progressively heavier warm-up loads.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why do warm-up reps decrease as the weight gets heavier?</h3>
      <p>
        Fewer reps at heavier warm-up loads provide exposure to the increasing
        weight while helping limit unnecessary fatigue before the working sets.
      </p>
    </div>

    <div class="faq-item">
      <h3>How long should I rest between warm-up sets?</h3>
      <p>
        Light sets generally need less rest, while heavier warm-up sets may
        need longer recovery. This calculator progressively increases rest as
        the load approaches your working weight.
      </p>
    </div>

    <div class="faq-item">
      <h3>Do warm-up sets count toward my training volume?</h3>
      <p>
        They are commonly tracked separately from programmed working sets,
        but they still contribute physical work and can add training stress,
        particularly when they are heavy or high in repetitions.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="warmup-set-calculator" />

  <script>
    let unit = "lb";

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const workingWeightInput =
      document.getElementById("working-weight") as HTMLInputElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (workingWeightInput) {
        const currentVal = Number(workingWeightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          const converted = newUnit === "kg"
            ? currentVal / 2.20462
            : currentVal * 2.20462;

          workingWeightInput.value = converted.toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }
    }

    function roundToNearest(value: number, step: number): number {
      return Math.round(value / step) * step;
    }

    function formatWeight(value: number): string {
      if (unit === "kg") {
        return Number(value.toFixed(1)).toString();
      }

      return Math.round(value).toString();
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!workingWeightInput) return;

        const workingWeight = Number(workingWeightInput.value);

        if (!Number.isFinite(workingWeight) || workingWeight <= 0) {
          alert("Please enter a valid working weight greater than 0.");
          return;
        }

        const barWeight = unit === "lb" ? 45 : 20;
        const roundStep = unit === "lb" ? 5 : 2.5;

        const steps = [
          { pct: 0, reps: 10, rest: "30-45 sec" },
          { pct: 40, reps: 5, rest: "45-60 sec" },
          { pct: 60, reps: 3, rest: "60-90 sec" },
          { pct: 80, reps: 2, rest: "90 sec-2 min" },
          { pct: 90, reps: 1, rest: "2-3 min" }
        ];

        const computed = steps.map((step) => {
          let weight = step.pct === 0
            ? barWeight
            : roundToNearest(workingWeight * (step.pct / 100), roundStep);

          if (weight < barWeight) weight = barWeight;

          return { weight, reps: step.reps, rest: step.rest, isBar: step.pct === 0 };
        });

        const deduped: typeof computed = [];
        for (const step of computed) {
          const last = deduped[deduped.length - 1];
          if (last && last.weight === step.weight) continue;
          deduped.push(step);
        }

        let warmupCount = 0;
        const rows = deduped.map((step) => {
          const label = step.isBar ? "Empty Bar" : `Warm-Up ${++warmupCount}`;
          return `
            <tr>
              <td>${label}</td>
              <td>${formatWeight(step.weight)} ${unit}</td>
              <td>${step.reps}</td>
              <td>${step.rest}</td>
            </tr>
          `;
        }).join("");

        const workingRow = `
          <tr>
            <td><strong>Working Set</strong></td>
            <td><strong>${formatWeight(workingWeight)} ${unit}</strong></td>
            <td>—</td>
            <td>—</td>
          </tr>
        `;

        if (resultTableBody) {
          resultTableBody.innerHTML = rows + workingRow;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
