---
import Base from '../../../layouts/Base.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
---
<Base
  title="RPE & RIR Calculator — Estimate Your Daily e1RM"
  description="Free RPE and RIR calculator. Convert a completed set into an estimated one-rep max using the validated RTS RPE chart, and see your weight at any target RPE."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "RPE & RIR Calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online calculator that converts a completed set's weight, reps, and RPE into an estimated one-rep max using the RTS RPE-to-percentage chart."
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between RPE and RIR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "RPE (Rate of Perceived Exertion) describes how difficult a completed set felt, while RIR (Reps in Reserve) estimates how many additional reps you could have performed. A common strength-training convention is that RPE 10 means 0 RIR, RPE 9 means about 1 RIR, and RPE 8 means about 2 RIR."
        }
      },
      {
        "@type": "Question",
        "name": "Why use RPE instead of traditional percentage-based training?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Percentage-based training uses a fixed reference such as a 1RM, while RPE can help adjust training loads according to how difficult a set feels on a particular day. Daily performance can vary with factors such as fatigue, stress, sleep, and nutrition."
        }
      },
      {
        "@type": "Question",
        "name": "How do you calculate estimated 1RM (e1RM) from an RPE set?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This calculator matches your completed reps and RPE to the RTS RPE-to-percentage chart. The corresponding percentage is used to estimate your one-rep max by dividing the weight lifted by that percentage."
        }
      },
      {
        "@type": "Question",
        "name": "Are RPE and RIR accurate for high-rep sets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "RPE and RIR are subjective estimates, and their precision can vary with the exercise, lifter, rep range, and experience. This calculator uses a 1-to-10 rep range, where the chart-based estimate should be treated as an estimate rather than an exact measurement."
        }
      }
    ]
  })} />

  <section class="hero">
    <h1>RPE &amp; RIR Calculator</h1>
    <p>Turn a completed set's weight, reps, and RPE into your estimated one-rep max for today.</p>
  </section>

  <section class="calc-card">
    <div class="field">
      <label>Unit</label>
      <div class="unit-toggle">
        <button type="button" id="unit-lb" class="active" aria-pressed="true">lb</button>
        <button type="button" id="unit-kg" aria-pressed="false">kg</button>
      </div>
    </div>

    <div class="field">
      <label for="weight">Weight Lifted</label>
      <input
        type="number"
        id="weight"
        placeholder="e.g. 225"
        inputmode="decimal"
        min="0"
        step="any"
      />
    </div>

    <div class="field">
      <label for="reps">Reps Completed (1-10)</label>
      <input
        type="number"
        id="reps"
        placeholder="e.g. 5"
        inputmode="numeric"
        min="1"
        max="10"
        step="1"
      />
    </div>

    <div class="field">
      <label for="rpe">RPE of That Set</label>
      <select id="rpe">
        <option value="10">RPE 10 (0 RIR — failure)</option>
        <option value="9.5">RPE 9.5 (0-1 RIR)</option>
        <option value="9" selected>RPE 9 (1 RIR)</option>
        <option value="8.5">RPE 8.5 (1-2 RIR)</option>
        <option value="8">RPE 8 (2 RIR)</option>
        <option value="7.5">RPE 7.5 (2-3 RIR)</option>
        <option value="7">RPE 7 (3 RIR)</option>
        <option value="6.5">RPE 6.5 (3-4 RIR)</option>
        <option value="6">RPE 6 (4 RIR)</option>
      </select>
    </div>

    <button class="btn-primary" id="calc-btn">Calculate e1RM</button>

    <div class="result-box" id="result-box">
      <div class="big-number" id="result-e1rm">–</div>
      <div class="label">Estimated 1RM (e1RM) for Today</div>

      <table class="result-table" id="result-table">
        <thead>
          <tr>
            <th>Target RPE</th>
            <th>Weight (5 reps)</th>
          </tr>
        </thead>
        <tbody id="result-table-body"></tbody>
      </table>
    </div>
  </section>

  <article class="article-section">
    <h2>What Is RPE and RIR?</h2>
    <p>
      RPE (Rate of Perceived Exertion) describes how difficult a completed
      set felt on a scale commonly used from 1 to 10. RIR (Reps in Reserve)
      describes how many additional reps you believe you could have
      completed. A common strength-training convention links the two:
      RPE 10 means no reps left, RPE 9 means about 1 rep left, and RPE 8
      means about 2 reps left. Exact RPE-to-RIR interpretation can vary
      between lifters and coaching systems.
    </p>
  </article>

  <article class="article-section">
    <h2>Why Use RPE Instead of Fixed Percentages?</h2>
    <p>
      Traditional percentage-based training sets a working weight from a
      reference such as your 1RM. RPE adds a subjective measure of how
      difficult the set actually feels on that day, which can help account
      for normal changes in performance caused by fatigue, stress, sleep,
      nutrition, and other factors.
    </p>
    <p>
      RPE can therefore be used as an autoregulation tool rather than relying
      entirely on a fixed percentage. The appropriate load still depends
      on the exercise, training goal, individual lifter, and programmed
      effort level.
    </p>
  </article>

  <article class="article-section">
    <h2>How This Calculator Works</h2>
    <p>
      This tool uses the RTS (Reactive Training Systems) RPE-to-percentage
      chart associated with Mike Tuchscherer rather than a generic
      one-rep-max formula. Your completed reps and RPE are matched to the
      chart's corresponding percentage of 1RM, then your lifted weight is
      divided by that percentage to estimate your e1RM for today.
    </p>
    <p>
      For example, if your completed set corresponds to 83.7% of 1RM,
      dividing the weight you lifted by 0.837 produces the estimated 1RM.
      Chart-based estimates and formula-based estimates can produce
      different results, so treat an e1RM as an estimate rather than an
      exact measurement.
    </p>
  </article>

  <article class="article-section">
    <h2>Using e1RM for Your Training</h2>
    <p>
      Your e1RM can be useful for tracking changes in estimated strength
      without repeatedly testing a true 1RM. It can also provide a reference
      for percentage-based programming and help you compare performance
      across training sessions.
    </p>
    <p>
      If you want to convert a known 1RM into specific percentage-based
      working weights, use our
      <a href="/tools/strength/1rm-percentage-calculator">1RM Percentage Calculator</a>.
      For a submaximal Training Max used in programs such as 5/3/1, use our
      <a href="/tools/training/training-max-calculator">Training Max Calculator</a>.
    </p>
  </article>

  <article class="article-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>What is the difference between RPE and RIR?</h3>
      <p>
        RPE describes how difficult a set felt, while RIR estimates how many
        reps were left before failure. A common convention is RPE 8 ≈ 2 RIR,
        RPE 9 ≈ 1 RIR, and RPE 10 ≈ 0 RIR.
      </p>
    </div>

    <div class="faq-item">
      <h3>Why use RPE instead of fixed percentages?</h3>
      <p>
        RPE provides a way to account for day-to-day differences in
        performance and perceived effort instead of relying only on a fixed
        1RM percentage.
      </p>
    </div>

    <div class="faq-item">
      <h3>How do you calculate e1RM from an RPE set?</h3>
      <p>
        Match your completed reps and RPE to the RTS chart's corresponding
        percentage, then divide the weight lifted by that percentage to
        estimate your e1RM.
      </p>
    </div>

    <div class="faq-item">
      <h3>Are RPE and RIR accurate for high-rep sets?</h3>
      <p>
        RPE and RIR are subjective estimates, and their precision can vary
        with the exercise, lifter, rep range, and experience. This calculator
        uses a 1-10 rep range, so its chart-based result should be treated as
        an estimate rather than an exact measurement.
      </p>
    </div>
  </article>

  <RelatedTools currentToolId="rpe-rir-calculator" />

  <script>
    let unit = "lb";

    // RTS/Tuchscherer chart: percentage of 1RM by [RPE][reps 1-10]
    const rpeChart: Record<string, number[]> = {
      "10":  [100, 95.5, 92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9],
      "9.5": [97.8, 93.9, 90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8],
      "9":   [95.5, 92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7],
      "8.5": [93.9, 90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7],
      "8":   [92.2, 89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4],
      "7.5": [90.7, 87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7, 68.5],
      "7":   [89.2, 86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4, 67.4],
      "6.5": [87.8, 85.0, 82.4, 79.9, 77.4, 75.1, 72.8, 70.7, 68.5, 66.4],
      "6":   [86.3, 83.7, 81.1, 78.6, 76.2, 73.9, 71.7, 69.4, 67.4, 65.3],
    };

    const allowedRPEs = new Set([
      "10",
      "9.5",
      "9",
      "8.5",
      "8",
      "7.5",
      "7",
      "6.5",
      "6"
    ]);

    const unitLb = document.getElementById("unit-lb");
    const unitKg = document.getElementById("unit-kg");
    const weightInput = document.getElementById("weight") as HTMLInputElement | null;
    const repsInput = document.getElementById("reps") as HTMLInputElement | null;
    const rpeSelect = document.getElementById("rpe") as HTMLSelectElement | null;
    const calcBtn = document.getElementById("calc-btn");
    const resultE1RM = document.getElementById("result-e1rm");
    const resultTableBody = document.getElementById("result-table-body");
    const resultBox = document.getElementById("result-box");

    if (unitLb) {
      unitLb.addEventListener("click", () => setUnit("lb"));
    }

    if (unitKg) {
      unitKg.addEventListener("click", () => setUnit("kg"));
    }

    function setUnit(newUnit: string) {
      if (newUnit !== "lb" && newUnit !== "kg") return;
      if (newUnit === unit) return;

      if (weightInput) {
        const currentVal = Number(weightInput.value);

        if (Number.isFinite(currentVal) && currentVal > 0) {
          const converted = newUnit === "kg"
            ? currentVal / 2.20462
            : currentVal * 2.20462;

          weightInput.value = converted.toFixed(1);
        }
      }

      unit = newUnit;

      if (unitLb) {
        unitLb.classList.toggle("active", unit === "lb");
        unitLb.setAttribute("aria-pressed", String(unit === "lb"));
      }

      if (unitKg) {
        unitKg.classList.toggle("active", unit === "kg");
        unitKg.setAttribute("aria-pressed", String(unit === "kg"));
      }
    }

    function formatWeight(value: number): string {
      if (unit === "kg") {
        return Number(value.toFixed(1)).toString();
      }

      return Math.round(value).toString();
    }

    if (calcBtn) {
      calcBtn.addEventListener("click", () => {
        if (!weightInput || !repsInput || !rpeSelect) return;

        const weight = Number(weightInput.value);
        const reps = Number(repsInput.value);
        const rpe = rpeSelect.value;

        if (!Number.isFinite(weight) || weight <= 0) {
          alert("Please enter a valid weight greater than 0.");
          return;
        }

        if (!Number.isInteger(reps) || reps < 1 || reps > 10) {
          alert("Please enter a whole-number rep count from 1 to 10.");
          return;
        }

        if (!allowedRPEs.has(rpe)) {
          alert("Please select a valid RPE.");
          return;
        }

        const rpeRow = rpeChart[rpe];

        if (!rpeRow || rpeRow.length < 10) {
          alert("Unable to find the selected RPE chart data.");
          return;
        }

        const chartPercentage = rpeRow[reps - 1];

        if (!Number.isFinite(chartPercentage) || chartPercentage <= 0) {
          alert("Unable to calculate a valid e1RM from these inputs.");
          return;
        }

        const pct = chartPercentage / 100;
        const e1rm = weight / pct;

        if (!Number.isFinite(e1rm) || e1rm <= 0) {
          alert("Unable to calculate a valid e1RM. Please check your inputs.");
          return;
        }

        const targetRPEs = ["10", "9", "8", "7", "6"];

        const rows = targetRPEs.map((targetRPE) => {
          const targetRow = rpeChart[targetRPE];

          if (!targetRow || !Number.isFinite(targetRow[4])) {
            return "";
          }

          const targetPct = targetRow[4] / 100;
          const targetWeight = e1rm * targetPct;

          if (!Number.isFinite(targetWeight) || targetWeight <= 0) {
            return "";
          }

          return `
            <tr>
              <td>RPE ${targetRPE}</td>
              <td>${formatWeight(targetWeight)} ${unit}</td>
            </tr>
          `;
        }).join("");

        if (resultE1RM) {
          resultE1RM.textContent = `${formatWeight(e1rm)} ${unit}`;
        }

        if (resultTableBody) {
          resultTableBody.innerHTML = rows;
        }

        if (resultBox) {
          resultBox.classList.add("show");
        }
      });
    }
  </script>
</Base>
