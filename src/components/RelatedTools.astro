---
import toolsData from '../data/tools.json';

export interface Props {
  currentToolId: string;
}

const { currentToolId } = Astro.props;

const current = toolsData.find((t) => t.id === currentToolId);
const related =
  current?.related
    ?.map((id) => toolsData.find((t) => t.id === id))
    .filter(Boolean) || [];
---

{related.length > 0 && (
  <section class="related-tools" aria-labelledby="related-tools-heading">
    <h2 id="related-tools-heading">Related Tools</h2>

    <div class="related-grid">
      {related.map((tool) => (
        <a class="tool-card" href={tool!.url}>
          <span class="icon" aria-hidden="true">{tool!.icon}</span>
          <span class="name">{tool!.name}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-tools {
    margin: 40px 0 48px;
  }

  .related-tools h2 {
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .related-tools .tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 132px;
    padding: 18px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  .related-tools .tool-card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .related-tools .tool-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .related-tools .tool-card .icon {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    margin: 0 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--accent);
    border-radius: 12px;
    color: var(--accent);
    font-size: 0.9rem !important;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .related-tools .tool-card .name {
    display: block;
    max-width: 100%;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .related-tools .tool-card:hover .name {
    color: var(--text);
  }

  @media (max-width: 420px) {
    .related-tools {
      margin-top: 36px;
    }

    .related-grid {
      gap: 10px;
    }

    .related-tools .tool-card {
      min-height: 124px;
      padding: 16px 10px;
    }

    .related-tools .tool-card .name {
      font-size: 0.86rem;
    }
  }
</style>
