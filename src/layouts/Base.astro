---
export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
  ogType?: "website" | "article";
  faqs?: FaqItem[];
}

const {
  title,
  description,
  breadcrumbs = [],
  noindex = false,
  ogType = "website",
  faqs = [],
} = Astro.props;

// Always use the production domain so preview hosts never become canonical.
const siteUrl = (Astro.site ?? new URL("https://repmaths.com")).origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
canonicalUrl.search = "";
canonicalUrl.hash = "";

// Keep the site's trailing-slash URL format consistent.
if (!canonicalUrl.pathname.endsWith("/")) {
  canonicalUrl.pathname += "/";
}

// Only output breadcrumb data when a real hierarchy is provided.
const hasBreadcrumbs = breadcrumbs.length >= 2;

// Resolve both root-relative and absolute hrefs against the production domain.
const normalizeHref = (href: string) => {
  const url = new URL(href, siteUrl);
  url.search = "";
  url.hash = "";
  if (!url.pathname.endsWith("/")) url.pathname += "/";
  return url.href;
};

const breadcrumbSchema = hasBreadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((item, index) => {
        const listItem: Record<string, unknown> = {
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
        };
        if (item.href) listItem.item = normalizeHref(item.href);
        return listItem;
      }),
    }
  : null;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: "RepMaths",
  url: siteUrl,
  inLanguage: "en",
  description: "Free strength, fitness, nutrition and training calculators with clear formulas and practical results.",
  publisher: { "@id": `${siteUrl}/#organization` },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "RepMaths",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/icon-512.png`,
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: "en",
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  ...(hasBreadcrumbs ? { breadcrumb: { "@id": `${canonicalUrl.href}#breadcrumbs` } } : {}),
};

const breadcrumbJsonLd = breadcrumbSchema
  ? { ...breadcrumbSchema, "@id": `${canonicalUrl.href}#breadcrumbs` }
  : null;

// Keep structured FAQ content aligned with FAQs visible on the page.
// FAQ rich-result display is controlled by search engines and is not guaranteed.

// FAQ structured data (AEO/GEO) — pages can pass their FAQ items.
const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      }
    : null;

// Prevent user-controlled text from accidentally closing a JSON-LD script tag.
const jsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- GA4: preconnect early, load async -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DC5Y64ZHYT"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DC5Y64ZHYT');
  </script>

  <meta name="theme-color" content="#0f1115" />
  <meta name="color-scheme" content="dark" />

  <!-- Favicon & PWA -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

  <link rel="canonical" href={canonicalUrl.href} />

  <!-- RepMaths machine-readable resources (GEO) -->
  <link
    rel="ard"
    href="/.well-known/ard.json"
    type="application/json"
  />

  <link
    rel="ai-catalog"
    href="/.well-known/ai-catalog.json"
    type="application/json"
  />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content="RepMaths" />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="RepMaths — Free strength and nutrition calculators" />
  <meta property="og:image:type" content="image/png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
  <meta name="twitter:image:alt" content="RepMaths — free strength, fitness and nutrition calculators" />

  <!-- Global and page-specific structured data; content must match the page. -->
  <script type="application/ld+json" set:html={jsonLd(websiteSchema)} />
  <script type="application/ld+json" set:html={jsonLd(organizationSchema)} />
  <script type="application/ld+json" set:html={jsonLd(webPageSchema)} />
  {breadcrumbJsonLd && <script type="application/ld+json" set:html={jsonLd(breadcrumbJsonLd)} />}
  {faqSchema && <script type="application/ld+json" set:html={jsonLd(faqSchema)} />}

  <style is:global>
    :root {
      --bg: #0f1115;
      --surface: #171a21;
      --surface-2: #1f232c;
      --border: #2a2f3a;
      --text: #e8eaed;
      --text-muted: #9aa1ac;
      --accent: #ff5b2e;
      --accent-hover: #ff7a52;
      --success: #3ecf8e;
      --radius: 14px;
      --max-width: 780px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 88px;
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.55;
    }

    img, video, iframe { max-width: 100%; }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      color: var(--accent-hover);
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      outline: 3px solid var(--accent-hover);
      outline-offset: 3px;
    }

    .skip-link {
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 1000;
      padding: 10px 14px;
      transform: translateY(-160%);
      background: var(--surface);
      color: var(--text);
      border: 2px solid var(--accent);
      border-radius: 8px;
    }

    .skip-link:focus { transform: translateY(0); }

    .container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ===== HEADER / FOOTER ===== */

    .site-header {
      border-bottom: 1px solid var(--border);
      padding: 16px 0;
      position: sticky;
      top: 0;
      background: rgba(15, 17, 21, 0.92);
      backdrop-filter: blur(8px);
      z-index: 50;
    }

    .site-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--text);
    }

    .logo span {
      color: var(--accent);
    }

    .site-footer {
      border-top: 1px solid var(--border);
      padding: 24px 0;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      margin-top: 48px;
    }

    .site-footer a {
      color: var(--text-muted);
      margin: 0 8px;
    }

    /* ===== BREADCRUMBS ===== */

    .breadcrumbs {
      padding: 16px 0 0;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .breadcrumbs li {
      display: inline-flex;
      align-items: center;
      min-width: 0;
    }

    .breadcrumbs li:not(:last-child)::after {
      content: "›";
      margin-left: 6px;
      color: var(--text-muted);
    }

    .breadcrumbs a {
      color: var(--text-muted);
    }

    .breadcrumbs a:hover {
      color: var(--accent);
    }

    .breadcrumbs [aria-current="page"] {
      color: var(--text);
      overflow-wrap: anywhere;
    }

    /* ===== SHARED CALCULATOR COMPONENTS ===== */

    .hero {
      padding: 28px 0 24px;
      text-align: center;
    }

    .hero h1 {
      font-size: 1.8rem;
      margin: 0 0 8px;
    }

    .hero p {
      color: var(--text-muted);
      margin: 0;
    }

    .calc-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      margin: 24px 0;
    }

    .field {
      margin-bottom: 16px;
    }

    .field label,
    .field-label {
      display: block;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 12px 14px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 1rem;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
      border-color: var(--accent);
    }

    .unit-toggle {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .unit-toggle button {
      flex: 1;
      min-width: 70px;
      min-height: 44px;
      padding: 10px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-muted);
      cursor: pointer;
    }

    .unit-toggle button.active {
      border-color: var(--accent);
      color: var(--text);
      background: rgba(255, 91, 46, 0.12);
    }

    .btn-primary {
      width: 100%;
      min-height: 44px;
      padding: 14px;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 8px;
    }

    .btn-primary:hover {
      background: var(--accent-hover);
    }

    .result-box {
      margin-top: 20px;
      padding: 20px;
      background: var(--surface-2);
      border-radius: 12px;
      text-align: center;
      display: none;
    }

    .result-box.show { display: block; }
    .result-box[hidden] { display: none !important; }

    .result-box .big-number {
      font-size: clamp(1.8rem, 7vw, 2.4rem);
      font-weight: 700;
      color: var(--success);
      overflow-wrap: anywhere;
    }

    .result-box .label {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 4px;
    }

    .result-table {
      width: 100%;
      margin-top: 16px;
      border-collapse: collapse;
      font-size: 0.88rem;
    }

    .result-table td {
      padding: 8px 6px;
      border-bottom: 1px solid var(--border);
    }

    .result-table caption {
      text-align: left;
      color: var(--text-muted);
      padding: 0 0 8px;
    }

    .result-table td:last-child {
      text-align: right;
      font-weight: 600;
    }

    .article-section {
      margin: 32px 0;
    }

    .article-section h2 {
      font-size: 1.2rem;
      margin-bottom: 10px;
    }

    .article-section p {
      color: #c7cbd2;
      font-size: 0.95rem;
    }

    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
    }

    .faq-item h3 {
      font-size: 0.98rem;
      margin: 0 0 6px;
    }

    .faq-item p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0;
    }

    .article-section ul {
      color: #c7cbd2;
      font-size: 0.95rem;
      padding-left: 20px;
      margin: 12px 0;
    }

    .article-section li {
      margin-bottom: 8px;
    }

    .article-section h3 {
      font-size: 1.05rem;
      margin: 20px 0 8px;
      color: var(--text);
    }

    .article-section code {
      background: var(--surface-2);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.88rem;
      color: var(--accent);
    }

    .result-table thead th {
      text-align: left;
      font-size: 0.8rem;
      color: var(--text-muted);
      padding: 6px;
      border-bottom: 1px solid var(--border);
    }

    .result-table thead th:last-child {
      text-align: right;
    }

    .tool-card .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      margin: 0 auto 10px;
      background: var(--surface-2);
      border: 1px solid var(--accent);
      border-radius: 12px;
      font-size: 0.95rem !important;
      font-weight: 800;
      letter-spacing: 0;
      color: var(--accent);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }

    .result-actions .btn-primary {
      flex: 1;
      text-decoration: none;
      text-align: center;
      font-size: 0.85rem;
    }

    .result-range {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .error-message {
      color: #ffb4a8;
      font-size: 0.9rem;
      margin-top: 8px;
    }

    @media (max-width: 480px) {
      .container { padding-left: 16px; padding-right: 16px; }
      .calc-card { padding: 18px; }
      .result-box { padding: 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo" aria-label="RepMaths home">Rep<span>Maths</span></a>
    </div>
  </header>

  <main id="main-content" class="container" tabindex="-1">
    {hasBreadcrumbs && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {breadcrumbs.map((item, index) => (
            <li>
              {item.href && index !== breadcrumbs.length - 1 ? (
                <a href={normalizeHref(item.href)}>{item.name}</a>
              ) : (
                <span aria-current="page">{item.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <nav aria-label="Footer">
      <a href="/tools/">All Tools</a>
      <a href="/about/">About</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/contact/">Contact</a>
      <a href="/disclaimer/">Disclaimer</a>
      <a href="/terms/">Terms</a>
      </nav>

      <p>
        &copy; 2026 RepMaths. Calculators use established, peer-referenced
        formulas for educational purposes only.
        <a href="/about/">See our methods</a>.
      </p>
    </div>
  </footer>
</body>
</html>
